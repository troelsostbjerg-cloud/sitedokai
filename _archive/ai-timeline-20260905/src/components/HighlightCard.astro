---
import CategoryPill from './CategoryPill.astro';
import { type Highlight } from '../data/timeline';

interface Props {
  highlight: Highlight;
}
const { highlight } = Astro.props;
---

<article class="glass card-hover h-full p-5">
  <div class="flex items-center justify-between gap-3">
    <CategoryPill category={highlight.category} />
    {highlight.date && <span class="font-mono text-xs text-text-dim">{highlight.date}</span>}
  </div>
  <h3 class="mt-3 font-display text-lg font-bold leading-snug text-text">
    {highlight.title}
  </h3>
  <p class="mt-2 text-sm leading-relaxed text-text-soft">{highlight.detail}</p>
  {
    highlight.source && (
      <a
        href={highlight.source.url}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-3 inline-flex items-center gap-1 text-xs font-medium text-cyan hover:text-cyan-bright"
      >
        {highlight.source.label}
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M7 17 L17 7 M9 7h8v8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    )
  }
</article>
