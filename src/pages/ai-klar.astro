---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { aiSelfTests, absoluteUrl, breadcrumbSchema } from '../data/aiContent';
import '../styles/global.css';

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${absoluteUrl('/ai-klar')}#webpage`,
    url: absoluteUrl('/ai-klar'),
    name: 'Sådan tester SiteDokAI sig selv for AI-synlighed',
    description: 'Synlig dokumentation for hvordan SiteDokAI gør sit eget website lettere at forstå for mennesker, søgemaskiner og AI-assistenter.',
    inLanguage: 'da-DK',
    about: ['AI search visibility', 'llms.txt', 'Schema.org', 'sitemap', 'AI discoverability'],
  },
  breadcrumbSchema([
    { name: 'Forside', path: '/' },
    { name: 'AI-klar', path: '/ai-klar' },
  ]),
];
---

<Layout
  title="Sådan tester vi os selv for AI-synlighed | SiteDokAI"
  description="SiteDokAI viser åbent hvordan siden er gjort lettere at forstå for mennesker, søgemaskiner og AI-assistenter."
  canonical="/ai-klar"
  structuredData={structuredData}
>
  <Nav />
  <main id="main" class="bg-canvas text-brand">
    <section class="mx-auto grid max-w-7xl gap-12 px-5 pb-16 pt-16 sm:px-6 md:pb-24 md:pt-24 lg:grid-cols-[0.72fr_1.28fr]">
      <aside class="text-sm leading-relaxed text-muted">
        <nav aria-label="Brødkrumme" class="text-xs">
          <ol class="flex flex-wrap gap-2">
            <li><a href="/" class="text-brand/55 transition-colors hover:text-brand">Forside</a></li>
            <li aria-hidden="true" class="text-brand/30">/</li>
            <li class="text-brand">AI-klar</li>
          </ol>
        </nav>
        <p class="mt-8 font-mono text-xs uppercase tracking-[0.22em] text-accent">AI-klar egen side</p>
        <p class="mt-8 max-w-xs">
          Vi skal ikke kun tale om AI-optimering. Sitet skal selv være struktureret, læsbart og nemt at citere.
        </p>
      </aside>

      <div>
        <h1 class="max-w-4xl font-display text-4xl font-semibold leading-[1.02] text-brand sm:text-5xl md:text-7xl">
          Sådan tester vi os selv for AI-synlighed.
        </h1>
        <p class="mt-8 max-w-2xl text-xl leading-relaxed text-brand/70">
          SiteDokAI er bygget, så både mennesker, søgemaskiner og AI-assistenter kan forstå hvad vi gør, hvem det er for, hvad det koster og hvad næste skridt er.
        </p>

        <section class="mt-12 rounded-[1.5rem] border border-accent/25 bg-accent/10 p-6 md:p-8">
          <p class="font-mono text-xs uppercase tracking-[0.22em] text-accent">Kort svar</p>
          <p class="mt-5 max-w-3xl text-lg leading-relaxed text-brand">
            Vi optimerer vores egen side med kanoniske servicesider, synlige svarblokke, struktureret data, sitemap, llms.txt og konkrete use cases. Målet er ikke at snyde algoritmer. Målet er at gøre indholdet klart nok til at blive forstået korrekt.
          </p>
        </section>

        <section class="mt-12 grid gap-4">
          {aiSelfTests.map((item) => (
            <article class="grid gap-4 rounded-[1.25rem] border border-brand/10 bg-panel-soft p-5 md:grid-cols-[0.8fr_0.35fr_1.2fr] md:items-start">
              <h2 class="text-lg font-semibold text-brand">{item.name}</h2>
              <p class="font-mono text-xs uppercase tracking-[0.18em] text-accent">{item.status}</p>
              <p class="text-sm leading-relaxed text-muted">{item.detail}</p>
            </article>
          ))}
        </section>

        <section class="mt-14 grid gap-5 md:grid-cols-2">
          <a href="/llms.txt" class="group rounded-[1.35rem] border border-brand/10 bg-panel-soft p-5 transition-colors hover:border-accent/35 hover:bg-white/[0.06] md:p-6">
            <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent">Maskinlæsbar profil</p>
            <h2 class="mt-4 text-2xl font-semibold text-brand group-hover:text-accent">Se llms.txt</h2>
            <p class="mt-4 text-sm leading-relaxed text-muted">Den korte profil, AI-assistenter og research-værktøjer kan bruge som startpunkt.</p>
          </a>
          <a href="/sitemap.xml" class="group rounded-[1.35rem] border border-brand/10 bg-panel-soft p-5 transition-colors hover:border-accent/35 hover:bg-white/[0.06] md:p-6">
            <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent">Indeksering</p>
            <h2 class="mt-4 text-2xl font-semibold text-brand group-hover:text-accent">Se sitemap</h2>
            <p class="mt-4 text-sm leading-relaxed text-muted">De kanoniske sider, use cases og proof-sider vi aktivt vil have fundet.</p>
          </a>
        </section>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
