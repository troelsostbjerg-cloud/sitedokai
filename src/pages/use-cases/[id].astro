---
export function getStaticPaths() {
  const redirects = {
    'moede-actions-opfoelgning': '/workflow-examples/meeting-actions-follow-up',
    'leverandoerstatus-undtagelser': '/workflow-examples/supplier-status-exceptions',
    'tilbudsanmodning-afklaring': '/workflow-examples/rfq-clarification',
    'ny-kunde-onboarding': '/workflow-examples/new-customer-onboarding',
    'crm-opfoelgning-naeste-skridt': '/workflow-examples/crm-follow-up-next-step',
    'reklamation-sagsoverblik': '/workflow-examples/complaint-case-brief',
    'procesdokumentation-interviews': '/workflow-examples/process-documentation',
  };

  return Object.entries(redirects).map(([id, destination]) => ({
    params: { id },
    props: { destination },
  }));
}

return Astro.redirect(Astro.props.destination, 301);
---
