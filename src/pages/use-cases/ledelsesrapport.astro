---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import AIUseCasePage from '../../components/site/AIUseCasePage.astro';
import { breadcrumbSchema, findUseCase, useCaseSchema } from '../../data/aiContent';
import '../../styles/global.css';

const useCase = findUseCase('ledelsesrapport');

if (!useCase) {
  throw new Error('Ledelsesrapport use case data missing');
}

const structuredData = [
  useCaseSchema(useCase),
  breadcrumbSchema([
    { name: 'Forside', path: '/' },
    { name: 'Use cases', path: '/use-cases' },
    { name: useCase.title, path: useCase.path },
  ]),
];
---

<Layout
  title={`${useCase.title} | SiteDokAI`}
  description={useCase.description}
  canonical={useCase.path}
  structuredData={structuredData}
>
  <Nav />
  <AIUseCasePage useCase={useCase} />
  <Footer />
</Layout>
