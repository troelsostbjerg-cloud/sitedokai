---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SubmitWorkflowForm from '../components/lab/SubmitWorkflowForm.astro';
import { absoluteUrl, siteBaseUrl } from '../data/labContent';
import '../styles/global.css';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${siteBaseUrl}/submit#webpage`,
  url: absoluteUrl('/submit'),
  name: 'Submit a workflow - SiteDokAILab',
  description:
    'Submit a recurring workflow, messy process or AI idea for a practical free mini-review from Troels Østbjerg.',
  inLanguage: 'en',
};
---

<Layout
  title="Submit a workflow - SiteDokAILab"
  description="Submit a recurring workflow, messy process or AI idea for a practical free mini-review from Troels Østbjerg."
  canonical="/submit"
  structuredData={structuredData}
>
  <Nav />
  <main id="main" class="bg-canvas text-brand">
    <section class="relative overflow-hidden border-b border-brand/10 px-5 py-16 sm:px-6 md:py-24">
      <div class="absolute inset-0 bg-[linear-gradient(rgba(30,38,31,0.045)_1px,transparent_1px),linear-gradient(90deg,rgba(30,38,31,0.045)_1px,transparent_1px)] bg-[size:56px_56px]" aria-hidden="true"></div>
      <div class="relative mx-auto grid max-w-7xl gap-10 lg:grid-cols-[0.7fr_1.3fr]">
        <aside class="text-sm leading-relaxed text-brand/64">
          <p class="font-mono text-xs uppercase tracking-[0.22em] text-accent">Submit a workflow</p>
          <p class="mt-8 max-w-xs">
            Send the recurring work that drains time, creates confusion or keeps almost becoming an AI idea.
          </p>
          <p class="mt-6 max-w-xs">
            Remove confidential data before submitting. Names, prices, secrets and customer details are not needed.
          </p>
        </aside>

        <div>
          <h1 class="max-w-4xl font-display text-4xl font-semibold leading-[1.02] text-brand sm:text-5xl md:text-7xl">
            Send the workflow that keeps coming back.
          </h1>
          <p class="mt-8 max-w-2xl text-xl leading-relaxed text-brand/70">
            I will review where the process breaks, whether AI belongs anywhere near it, and what the first practical step could be.
          </p>
          <div id="workflow-form" class="mt-12 rounded-[1.6rem] border border-brand/10 bg-panel p-5 shadow-soft md:p-8">
            <SubmitWorkflowForm sourcePage="/submit" />
          </div>
        </div>
      </div>
    </section>

    <section class="px-5 py-12 sm:px-6 md:py-16">
      <div class="mx-auto max-w-7xl rounded-[1.35rem] border border-brand/10 bg-canvas-soft p-5 md:p-6">
        <h2 class="text-2xl font-semibold text-brand">Workflow received.</h2>
        <p class="mt-3 max-w-3xl text-sm leading-relaxed text-brand/68">
          After submitting, you should see a confirmation on this page. If the case is a good fit, Troels replies with a practical mini-review. Public cases are only published if permission is given and details are anonymized.
        </p>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
