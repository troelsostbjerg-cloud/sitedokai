---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { absoluteUrl, aiReadinessItems, breadcrumbSchema } from '../data/aiContent';
import '../styles/global.css';

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${absoluteUrl('/ai-readiness')}#webpage`,
    url: absoluteUrl('/ai-readiness'),
    name: 'AI readiness — SiteDokAI',
    description:
      'How SiteDokAI makes its own site readable for humans, search engines and AI assistants.',
    inLanguage: 'en',
    about: ['AI readiness', 'llms.txt', 'structured data', 'sitemap', 'answer engine optimization'],
  },
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'AI readiness', path: '/ai-readiness' },
  ]),
];
---

<Layout
  title="AI readiness — How SiteDokAI is readable for humans and AI assistants"
  description="How SiteDokAI makes its own site readable for humans, search engines and AI assistants."
  canonical="/ai-readiness"
  structuredData={structuredData}
>
  <Nav />
  <main id="main" class="bg-canvas text-brand">
    <section class="mx-auto grid max-w-7xl gap-12 px-5 py-16 sm:px-6 md:py-24 lg:grid-cols-[0.72fr_1.28fr]">
      <aside class="text-sm leading-relaxed text-muted">
        <p class="font-mono text-xs uppercase tracking-[0.22em] text-accent">AI readiness</p>
        <p class="mt-8 max-w-xs">
          A proof-of-work page for clear service structure, not hidden AI trickery.
        </p>
      </aside>
      <div>
        <h1 class="max-w-4xl font-display text-4xl font-semibold leading-[1.02] text-brand sm:text-5xl md:text-7xl">
          How SiteDokAI makes its own site readable for humans, search engines and AI assistants.
        </h1>
        <p class="mt-8 max-w-2xl text-xl leading-relaxed text-brand/70">
          The same structure that helps AI assistants understand SiteDokAI should also help a buyer understand the offer faster: canonical service pages, visible answer blocks, structured data, sitemap, llms.txt and clear workflow examples.
        </p>
        <div class="mt-12 grid gap-4">
          {aiReadinessItems.map((item) => (
            <article class="grid gap-4 rounded-[1.25rem] border border-brand/10 bg-panel-soft p-5 md:grid-cols-[0.8fr_0.35fr_1.2fr] md:items-start">
              <h2 class="text-lg font-semibold text-brand">{item.name}</h2>
              <p class="font-mono text-xs uppercase tracking-[0.18em] text-accent">{item.status}</p>
              <p class="text-sm leading-relaxed text-muted">{item.detail}</p>
            </article>
          ))}
        </div>
        <section class="mt-14 grid gap-5 md:grid-cols-2">
          <a href="/llms.txt" class="group rounded-[1.35rem] border border-brand/10 bg-panel-soft p-5 transition-colors hover:border-accent/35 md:p-6">
            <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent">AI-readable profile</p>
            <h2 class="mt-4 text-2xl font-semibold text-brand group-hover:text-accent">View llms.txt</h2>
            <p class="mt-4 text-sm leading-relaxed text-muted">A short profile AI assistants and research tools can use as a starting point.</p>
          </a>
          <a href="/sitemap.xml" class="group rounded-[1.35rem] border border-brand/10 bg-panel-soft p-5 transition-colors hover:border-accent/35 md:p-6">
            <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent">Indexing</p>
            <h2 class="mt-4 text-2xl font-semibold text-brand group-hover:text-accent">View sitemap</h2>
            <p class="mt-4 text-sm leading-relaxed text-muted">Canonical English service, pricing, workflow example, contact and legal pages.</p>
          </a>
        </section>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
