---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AdvisoryPage from '../components/site/AdvisoryPage.astro';
import '../styles/global.css';
---

<Layout
  title="AI Operations Partner | SiteDokAI"
  description="Løbende hjælp til at holde AI-forbedringer i gang, optimere workflows og sikre at løsningerne faktisk bliver brugt."
  canonical="/visuelt-loeft"
>
  <Nav />
  <AdvisoryPage
    eyebrow="AI Operations Partner"
    title="Hold forbedringerne i gang efter den første workflow."
    text="Når den første AI-workflow virker, handler næste fase om backlog, adoption, dokumentation og små forbedringer, der faktisk bliver en del af driften."
    points={[
      'Månedlig AI- og procesbacklog.',
      'Optimering af eksisterende workflows og nye små automatiseringer.',
      'Træning, dokumentation og status på effekt.',
    ]}
    note="Fra 10.000 kr. pr. måned ekskl. moms. Bruges bedst når der allerede er konkrete workflows i gang."
    ctaLabel="Tal om løbende hjælp"
  />
  <Footer />
</Layout>
