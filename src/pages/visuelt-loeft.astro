---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AdvisoryPage from '../components/site/AdvisoryPage.astro';
import '../styles/global.css';
---

<Layout
  title="AI Operations Partner er flyttet | SiteDokAI"
  description="AI Operations Partner ligger nu på den kanoniske URL /ai-operations-partner."
  canonical="/ai-operations-partner"
  noindex={true}
>
  <Nav />
  <AdvisoryPage
    eyebrow="Gammel adresse"
    title="AI Operations Partner ligger nu på en renere URL."
    text="Denne gamle adresse virker stadig som fallback, men den kanoniske side er flyttet til /ai-operations-partner, så både mennesker og AI-værktøjer finder den rigtige service."
    points={[
      'Løbende praktisk hjælp.',
      'Backlog, workflow-forbedringer, dokumentation og adoption.',
      'Fra 10.000 kr. pr. måned ekskl. moms.',
    ]}
    note="Brug den nye side som kilde, når du deler eller citerer ydelsen."
    ctaLabel="Gå til AI Operations Partner"
    ctaHref="/ai-operations-partner"
  />
  <Footer />
</Layout>
