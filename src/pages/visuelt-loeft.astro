---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AdvisoryPage from '../components/site/AdvisoryPage.astro';
import '../styles/global.css';
---

<Layout
  title="Klarhed, trust og første indtryk | SiteDokAI"
  description="Rådgivning om hvordan website, indhold og beviser skaber tillid i agentic search og hos kunder."
  canonical="/visuelt-loeft"
>
  <Nav />
  <AdvisoryPage
    eyebrow="Trust"
    title="AI vælger ikke kun pæne sider. Den vælger tydelige kilder."
    text="Design og første indtryk betyder stadig noget, men i agentic search skal det visuelle støtte klarhed: hvem I hjælper, hvad I gør, hvorfor man kan stole på jer, og hvad næste skridt er."
    points={[
      'Mindre støj og tydeligere hierarki.',
      'Beviser, cases og trust-signaler tættere på beslutningen.',
      'Et website der føles roligt for mennesker og læsbart for AI.',
    ]}
    note="Hvis jeres visuelle udtryk står i vejen for tillid eller forståelse, kan det blive en del af forløbet efter screeningen."
  />
  <Footer />
</Layout>
