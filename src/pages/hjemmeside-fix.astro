---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AdvisoryPage from '../components/site/AdvisoryPage.astro';
import '../styles/global.css';
---

<Layout
  title="AI Workflow Sprint | SiteDokAI"
  description="På 10 arbejdsdage bygger SiteDokAI én konkret AI-workflow, der løser et reelt hverdagsproblem."
  canonical="/hjemmeside-fix"
>
  <Nav />
  <AdvisoryPage
    eyebrow="AI Workflow Sprint"
    title="Byg én konkret AI-workflow, der kan bruges i hverdagen."
    text="På 10 arbejdsdage vælger vi ét workflow, designer flowet fra trigger til output og bygger en prototype eller fungerende løsning i de værktøjer, I allerede bruger."
    points={[
      'Proceskort med trigger, input, regler, AI-logik, menneskelig godkendelse og fallback.',
      'Prototype eller workflow testet med de mennesker, der skal bruge den.',
      'Dokumentation, kort træning og måling af forventet effekt.',
    ]}
    note="Pris fra 35.000 kr. ekskl. moms. Sprintet er til virksomheder, der allerede har et konkret workflow med tydelig friktion."
    ctaLabel="Byg første workflow"
  />
  <Footer />
</Layout>
