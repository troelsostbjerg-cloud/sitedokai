---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/site/Button.astro';
import Container from '../components/site/Container.astro';
import SectionHeader from '../components/site/SectionHeader.astro';
import '../styles/global.css';

const fixes = [
  'Forsidetekst',
  'Herosektion',
  'Servicestruktur',
  'Kontaktknapper',
  'Trust sektion',
  'FAQ',
];

const outcomes = [
  {
    title: 'Klar og tydelig forside',
    text: 'Kunden forstår hurtigere, hvad du hjælper med, og hvorfor det er relevant.',
  },
  {
    title: 'Bedre struktur',
    text: 'Siden får en rækkefølge, der gør det lettere at læse og lettere at handle på.',
  },
  {
    title: 'Stærkere budskab',
    text: 'Teksten bliver mere konkret, mere tryghedsskabende og mindre intern.',
  },
  {
    title: 'Flere henvendelser',
    text: 'Kontaktknapper og næste skridt bliver tydeligere, så flere besøgende ved, hvad de skal gøre.',
  },
];

const process = [
  {
    title: 'AI Audit',
    text: 'Vi starter fra din AI Audit og prioriterer de vigtigste problemer.',
  },
  {
    title: 'Omskrivning',
    text: 'Vi omskriver forside, struktur og kontaktknapper, så budskabet bliver skarpere.'
  },
  {
    title: 'Levering',
    text: 'Du får en konkret tekst- og strukturpakke, klar til at blive lagt på siden.',
  },
];

const audience = [
  'Du har fået et tjek',
  'Du ved der er problemer',
  'Du vil have det fikset hurtigt',
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Hjemmeside-fix',
  provider: {
    '@type': 'Organization',
    name: 'SiteDokAI',
    url: 'https://sitedokai.com',
  },
  areaServed: {
    '@type': 'Country',
    name: 'Danmark',
  },
  offers: {
    '@type': 'Offer',
    priceSpecification: {
      '@type': 'PriceSpecification',
      minPrice: '6500',
      maxPrice: '12500',
      priceCurrency: 'DKK',
    },
  },
  description: 'Hjemmeside-fix retter tekst, struktur og kontaktknapper efter en AI Audit, så flere besøgende forstår siden og tager kontakt.'
};
---

<Layout
  title="Hjemmeside-fix | SiteDokAI"
  description="Vi omskriver din forside, struktur og kontaktknapper, så flere tager kontakt. Hjemmeside-fix koster typisk 6.500–12.500 kr."
  canonical="/hjemmeside-fix"
  structuredData={structuredData}
>
  <Nav />
  <main id="main" class="bg-canvas text-brand">
    <section class="relative mx-auto max-w-[1480px] px-4 pb-6 pt-4 sm:px-6 lg:px-10">
      <div class="relative overflow-hidden rounded-[1.8rem] border border-border-soft bg-surface/80 shadow-soft">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_12%_12%,rgba(255,255,255,0.94),transparent_34%),radial-gradient(circle_at_82%_18%,rgba(223,232,220,0.64),transparent_30%),linear-gradient(135deg,rgba(251,247,239,0.36),rgba(237,243,234,0.52))]"></div>
        <div class="relative grid gap-10 px-6 py-11 md:grid-cols-[0.96fr_1.04fr] md:items-center md:px-12 md:py-14 lg:px-14 lg:py-16">
          <div class="max-w-3xl">
            <p class="text-xs font-semibold uppercase tracking-[0.28em] text-accent-dark">Hjemmeside-fix · 6.500–12.500 kr.</p>
            <h1 class="mt-5 text-balance font-display text-5xl font-medium leading-[0.97] tracking-tight text-brand sm:text-6xl lg:text-7xl">
              Vi retter det, der får din hjemmeside til at miste kunder
            </h1>
            <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">
              Vi omskriver din forside, struktur og kontaktknapper, så flere tager kontakt.
            </p>
            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
              <Button href="/gratis-mini-tjek">Få gratis AI-tjek</Button>
              <Button href="/hjemmeside-tjek" variant="secondary">Start med AI Audit</Button>
            </div>
          </div>

          <div class="rounded-[1.45rem] border border-border-soft bg-white/72 p-5 shadow-[0_18px_50px_rgba(32,38,34,0.055)] md:p-7">
            <div class="rounded-[1.15rem] border border-accent/20 bg-accent-soft/52 p-5 md:p-6">
              <p class="text-sm font-semibold uppercase tracking-[0.22em] text-accent-dark">Efter tjekket</p>
              <p class="mt-4 font-display text-3xl font-medium leading-tight tracking-tight text-brand md:text-4xl">
                Fra problemer til en side, kunden kan forstå.
              </p>
              <p class="mt-4 text-base leading-relaxed text-muted">
                Hjemmeside-fix er ikke en ny visuel identitet. Det er en målrettet rettelse af tekst, rækkefølge og næste skridt.
              </p>
            </div>
            <div class="mt-4 grid gap-3 sm:grid-cols-2">
              <div class="rounded-[1rem] border border-border-soft bg-surface px-4 py-4">
                <p class="font-display text-3xl font-medium text-brand">6</p>
                <p class="mt-1 text-sm leading-snug text-muted">centrale dele af siden rettes</p>
              </div>
              <div class="rounded-[1rem] border border-border-soft bg-surface px-4 py-4">
                <p class="font-display text-3xl font-medium text-brand">1</p>
                <p class="mt-1 text-sm leading-snug text-muted">klart mål: flere henvendelser</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <Container id="hvad-vi-retter" class="pb-8 pt-8 md:pb-12">
      <SectionHeader
        label="Hvad vi retter"
        title="Vi gør de vigtigste dele af siden tydelige."
        text="Fokus er på det, kunden læser først, det der skaber tillid, og det der får dem videre til kontakt."
      />
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {fixes.map((fix, index) => (
          <article class="rounded-[1.15rem] border border-border-soft bg-white/70 p-5 shadow-soft transition duration-200 hover:-translate-y-0.5 hover:border-accent/28 hover:bg-white">
            <div class="flex items-start gap-4">
              <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-[0.8rem] border border-accent/20 bg-accent-soft font-mono text-sm font-semibold text-accent-dark">
                {String(index + 1).padStart(2, '0')}
              </span>
              <h2 class="font-display text-2xl font-medium leading-tight tracking-tight text-brand">{fix}</h2>
            </div>
          </article>
        ))}
      </div>
    </Container>

    <Container id="hvad-du-faar" class="py-8 md:py-12">
      <div class="grid gap-8 rounded-[1.55rem] border border-border-soft bg-white/58 p-6 shadow-soft md:p-9 lg:grid-cols-[0.76fr_1.24fr] lg:items-start">
        <SectionHeader
          label="Hvad du får"
          title="En side, der forklarer bedre og leder kunden videre."
          text="Leverancen er praktisk: klarere tekst, bedre rækkefølge og mere tydelige kontaktpunkter."
          align="left"
        />
        <div class="grid gap-4 sm:grid-cols-2">
          {outcomes.map((outcome) => (
            <article class="rounded-[1.1rem] border border-border-soft bg-surface/76 p-5">
              <h3 class="font-display text-2xl font-medium leading-tight tracking-tight text-brand">{outcome.title}</h3>
              <p class="mt-3 text-base leading-relaxed text-muted">{outcome.text}</p>
            </article>
          ))}
        </div>
      </div>
    </Container>

    <Container id="foer-efter" class="py-8 md:py-12">
      <SectionHeader
        label="Før / efter"
        title="Forskellen er ofte ikke mere tekst. Det er mere præcis tekst."
      />
      <div class="mt-8 grid gap-5 lg:grid-cols-2">
        <article class="rounded-[1.35rem] border border-border-soft bg-white/62 p-6 shadow-soft md:p-8">
          <p class="text-xs font-semibold uppercase tracking-[0.24em] text-muted">Før: uklar tekst</p>
          <h2 class="mt-5 font-display text-3xl font-medium leading-tight tracking-tight text-brand">
            “Vi tilbyder professionelle løsninger med fokus på kvalitet og god service.”
          </h2>
          <p class="mt-5 text-base leading-relaxed text-muted">
            Kunden kan godt læse det, men de kan ikke mærke, hvad virksomheden konkret hjælper med, hvem det er for, eller hvad næste skridt er.
          </p>
        </article>
        <article class="rounded-[1.35rem] border border-accent/28 bg-accent-soft/58 p-6 shadow-soft md:p-8">
          <p class="text-xs font-semibold uppercase tracking-[0.24em] text-accent-dark">Efter: konkret og tydelig</p>
          <h2 class="mt-5 font-display text-3xl font-medium leading-tight tracking-tight text-brand">
            “Få hurtig hjælp til stoppede afløb, utætte rør og mindre VVS-opgaver i Aarhus. Ring i dag, så finder vi en tid.”
          </h2>
          <p class="mt-5 text-base leading-relaxed text-muted">
            Kunden forstår ydelsen, området, situationen og handlingen. Det gør siden lettere at vælge og lettere at kontakte.
          </p>
        </article>
      </div>
    </Container>

    <Container id="proces" class="py-8 md:py-12">
      <SectionHeader
        label="Proces"
        title="Tre enkle trin fra tjek til færdig tekststruktur."
      />
      <div class="mt-8 grid gap-5 md:grid-cols-3">
        {process.map((step, index) => (
          <article class="rounded-[1.25rem] border border-border-soft bg-white/70 p-6 shadow-soft md:p-7">
            <p class="font-mono text-sm font-semibold text-accent-dark">0{index + 1}</p>
            <h2 class="mt-4 font-display text-3xl font-medium leading-tight tracking-tight text-brand">{step.title}</h2>
            <p class="mt-3 text-base leading-relaxed text-muted">{step.text}</p>
          </article>
        ))}
      </div>
    </Container>

    <Container id="hvem-det-er-til" class="py-8 md:py-12">
      <div class="grid gap-8 rounded-[1.55rem] border border-accent/24 bg-[linear-gradient(135deg,rgba(255,253,248,0.96),rgba(237,243,234,0.76))] p-6 shadow-soft md:p-9 lg:grid-cols-[0.88fr_1.12fr] lg:items-center">
        <SectionHeader
          label="Hvem det er til"
          title="Til dig, der ikke bare vil have en rapport, men have rettet det vigtigste."
          align="left"
        />
        <div class="grid gap-3">
          {audience.map((item) => (
            <div class="flex items-center gap-3 rounded-[1rem] border border-border-soft bg-white/70 px-4 py-4">
              <span class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-[0.65rem] border border-accent/20 bg-accent-soft text-accent-dark">
                <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" aria-hidden="true">
                  <path d="m6.8 12.4 3.1 3.1 7.3-7.8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
              <span class="text-base font-semibold text-brand">{item}</span>
            </div>
          ))}
        </div>
      </div>
    </Container>

    <Container id="faq" class="py-8 md:py-12">
      <SectionHeader label="FAQ" title="Kort om Hjemmeside-fix." />
      <div class="mx-auto mt-8 grid max-w-5xl gap-4 md:grid-cols-3">
        <article class="rounded-[1.2rem] border border-border-soft bg-white/70 p-5 shadow-soft">
          <h2 class="font-display text-2xl font-medium leading-tight tracking-tight text-brand">Er det et nyt website?</h2>
          <p class="mt-3 text-sm leading-relaxed text-muted">Nej. Hjemmeside-fix retter den eksisterende side: tekst, struktur, kontaktknapper og de vigtigste sektioner.</p>
        </article>
        <article class="rounded-[1.2rem] border border-border-soft bg-white/70 p-5 shadow-soft">
          <h2 class="font-display text-2xl font-medium leading-tight tracking-tight text-brand">Skal jeg have en audit først?</h2>
          <p class="mt-3 text-sm leading-relaxed text-muted">Oftest ja. AI Audit viser, hvad der bør rettes først, så fixet ikke bliver gætværk.</p>
        </article>
        <article class="rounded-[1.2rem] border border-border-soft bg-white/70 p-5 shadow-soft">
          <h2 class="font-display text-2xl font-medium leading-tight tracking-tight text-brand">Hvad med design?</h2>
          <p class="mt-3 text-sm leading-relaxed text-muted">Mindre visuelle justeringer kan indgå, men et større visuelt løft er en separat ydelse.</p>
        </article>
      </div>
    </Container>

    <Container id="faa-lavet-hjemmeside-fix" class="pb-16 pt-8 md:pb-20 md:pt-12">
      <div class="rounded-[1.65rem] border border-border-soft bg-brand px-6 py-10 text-white shadow-[0_24px_70px_rgba(32,38,34,0.12)] md:px-10 md:py-12">
        <div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.28em] text-white/62">Klar til næste skridt?</p>
            <h2 class="mt-5 max-w-3xl font-display text-4xl font-medium leading-[1.02] tracking-tight md:text-5xl">
              Få rettet tekst, struktur og kontaktknapper på din hjemmeside.
            </h2>
            <p class="mt-5 max-w-2xl text-base leading-relaxed text-white/68 md:text-lg">
              Hjemmeside-fix er til dig, der har fundet problemerne og vil have en konkret forbedring, som kan mærkes på henvendelserne.
            </p>
          </div>
          <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
            <a href="/gratis-mini-tjek" class="inline-flex items-center justify-center rounded-[0.9rem] border border-white bg-white px-6 py-3.5 text-sm font-semibold text-brand transition duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] hover:border-accent-light hover:bg-accent-light focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white active:translate-y-px">
              Få gratis AI-tjek
            </a>
            <a href="/hjemmeside-tjek" class="inline-flex items-center justify-center rounded-[0.9rem] border border-white/22 bg-white/8 px-6 py-3.5 text-sm font-semibold text-white transition duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] hover:border-white/38 hover:bg-white/12 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white active:translate-y-px">
              Start med AI Audit
            </a>
          </div>
        </div>
      </div>
    </Container>
  </main>
  <Footer />
</Layout>
