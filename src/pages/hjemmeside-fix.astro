---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AdvisoryPage from '../components/site/AdvisoryPage.astro';
import '../styles/global.css';
---

<Layout
  title="Implementering af agentic search-signaler | SiteDokAI"
  description="SiteDokAI hjælper med at gøre centrale sider, tekster og beviser lettere for AI-agenter at forstå og citere."
  canonical="/hjemmeside-fix"
>
  <Nav />
  <AdvisoryPage
    eyebrow="Implementering"
    title="Når siden skal gøres lettere at forstå for både mennesker og AI."
    text="Hvis diagnosen viser, at problemet ligger i uklar tekst, svage beviser eller manglende struktur, hjælper vi med at rette de dele, der gør jer mere valgbare."
    points={[
      'Klarere ydelsessider, cases og FAQ.',
      'Bedre beslutningssvar til B2B-research og lokale valg.',
      'Struktur, schema og kildegrundlag der kan citeres.',
    ]}
    note="Vi kalder det ikke et standard website-fix længere. Det er et målrettet forløb, hvor indhold og struktur bliver til et bedre kildegrundlag."
  />
  <Footer />
</Layout>
