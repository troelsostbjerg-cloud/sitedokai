---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AdvisoryPage from '../components/site/AdvisoryPage.astro';
import '../styles/global.css';
---

<Layout
  title="AI Workflow Sprint er flyttet | SiteDokAI"
  description="AI Workflow Sprint ligger nu på den kanoniske URL /ai-workflow-sprint."
  canonical="/ai-workflow-sprint"
  noindex={true}
>
  <Nav />
  <AdvisoryPage
    eyebrow="Gammel adresse"
    title="AI Workflow Sprint ligger nu på en renere URL."
    text="Denne gamle adresse virker stadig som fallback, men den kanoniske side er flyttet til /ai-workflow-sprint, så både mennesker og AI-værktøjer finder den rigtige service."
    points={[
      '10 arbejdsdage.',
      'Én konkret AI-workflow fra trigger til output.',
      'Pris fra 35.000 kr. ekskl. moms.',
    ]}
    note="Brug den nye side som kilde, når du deler eller citerer ydelsen."
    ctaLabel="Gå til AI Workflow Sprint"
    ctaHref="/ai-workflow-sprint"
  />
  <Footer />
</Layout>
