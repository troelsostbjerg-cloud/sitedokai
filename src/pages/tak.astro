---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const contactEmail = 'info@sitedokai.com';
const orderHelpMailto = `mailto:${contactEmail}?subject=${encodeURIComponent('AI Audit bestilling')}&body=${encodeURIComponent(`Hej SiteDokAI,

Jeg har bestilt eller forsøgt at bestille AI Audit + Client Room.

Navn:
Firma:
Hjemmeside:
Kort besked:

Tak.`)}`;
---

<Layout
  title="Tak for din bestilling | SiteDokAI"
  description="Tak for din bestilling hos SiteDokAI. Hvis betalingen er gennemført, sender Stripe kvittering, og vi sender AI Audit + Client Room når det er klar."
  noindex={true}
>
  <Nav />
  <main id="main">
    <section class="bg-white">
      <div class="mx-auto max-w-4xl px-6 py-20 md:py-28">
        <div class="rounded-[2rem] border border-[#dfd3c2] bg-[#f6efe3] p-8 text-center md:p-12">
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-accent">Tak for bestillingen</p>
          <h1 class="mt-5 font-display text-4xl font-extrabold tracking-tight text-brand md:text-6xl">
            Tak. Hvis betalingen er gennemført, er din AI Audit + Client Room bestilt.
          </h1>
          <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-brand/70">
            Stripe sender kvittering eller faktura til samme email. Når betalingen er registreret, gennemgår vi dine oplysninger og sender Client Room samt PDF-eksport inden for 48 timer på hverdage.
          </p>
        </div>

        <div class="mt-8 grid gap-5 md:grid-cols-3">
          <article class="rounded-[1.4rem] border border-[#e6ddd1] bg-white p-5">
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-accent">1</p>
            <h2 class="mt-3 font-display text-2xl font-bold tracking-tight text-brand">Vi tester AI-synlighed</h2>
            <p class="mt-3 text-sm leading-relaxed text-brand/70">AI-søgninger, kilder, konkurrenter, trust-signaler og de første tabte spørgsmål.</p>
          </article>
          <article class="rounded-[1.4rem] border border-[#e6ddd1] bg-white p-5">
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-accent">2</p>
            <h2 class="mt-3 font-display text-2xl font-bold tracking-tight text-brand">Du får Client Room</h2>
            <p class="mt-3 text-sm leading-relaxed text-brand/70">Score, tabte søgninger, konkurrentbillede, kilder og prioriterede næste skridt.</p>
          </article>
          <article class="rounded-[1.4rem] border border-[#e6ddd1] bg-white p-5">
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-accent">3</p>
            <h2 class="mt-3 font-display text-2xl font-bold tracking-tight text-brand">Du vælger næste skridt</h2>
            <p class="mt-3 text-sm leading-relaxed text-brand/70">Du kan selv rette tingene eller spørge SiteDokAI om Hjemmeside-fix eller Visuelt løft.</p>
          </article>
        </div>

        <p class="mx-auto mt-8 max-w-2xl rounded-[1.1rem] border border-[#e6ddd1] bg-white px-5 py-4 text-center text-sm leading-relaxed text-brand/72">
          Mangler du kvittering, eller drillede betalingen? Skriv til <a href={orderHelpMailto} class="font-semibold text-brand underline decoration-accent/45 underline-offset-4 hover:decoration-accent">{contactEmail}</a>, så håndterer vi bestillingen manuelt.
        </p>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
