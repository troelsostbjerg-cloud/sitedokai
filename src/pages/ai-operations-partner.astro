---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AIServicePage from '../components/site/AIServicePage.astro';
import { breadcrumbSchema, faqSchema, findService, serviceSchema } from '../data/aiContent';
import '../styles/global.css';

const service = findService('ai-operations-partner');

if (!service) {
  throw new Error('AI Operations Partner data missing');
}

const structuredData = [
  serviceSchema(service),
  faqSchema(service.path, service.faq),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Services', path: '/#services' },
    { name: service.name, path: service.path },
  ]),
];
---

<Layout
  title="AI Operations Partner — Keep AI improvements moving"
  description="Ongoing practical support for AI workflow backlog, improvements, documentation, adoption and effect measurement."
  canonical={service.path}
  structuredData={structuredData}
>
  <Nav />
  <AIServicePage service={service} />
  <Footer />
</Layout>
