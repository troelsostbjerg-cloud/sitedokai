---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/site/Button.astro';
import '../styles/global.css';
---

<Layout
  title="Tak for din henvendelse | SiteDokAI"
  description="Tak for din henvendelse til SiteDokAI. Vi vender tilbage med næste skridt."
  canonical="/tak-for-henvendelsen"
  noindex={true}
>
  <Nav />
  <main id="main" class="bg-canvas text-brand">
    <section class="mx-auto grid max-w-6xl gap-12 px-5 py-16 sm:px-6 md:py-24 lg:grid-cols-[0.72fr_1.28fr]">
      <aside class="text-sm leading-relaxed text-muted">
        <p class="font-mono text-xs uppercase tracking-[0.22em] text-brand/50">Modtaget</p>
      </aside>
      <div>
        <h1 class="max-w-4xl font-display text-5xl font-semibold leading-[0.98] tracking-[-0.035em] text-brand md:text-7xl">
          Tak. Vi har modtaget din henvendelse.
        </h1>
        <p class="mt-8 max-w-2xl text-xl leading-relaxed text-brand/68">
          Vi vender tilbage med et roligt næste skridt. Første samtale og screening er uden beregning.
        </p>
        <div class="mt-10">
          <Button href="/">Til forsiden</Button>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
