---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { absoluteUrl, contactEmail, linkedInUrl, roleCards, siteBaseUrl } from '../data/labContent';
import '../styles/global.css';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${siteBaseUrl}/hire#webpage`,
  url: absoluteUrl('/hire'),
  name: 'Hire Troels - SiteDokAILab',
  description:
    'Role-fit page for Troels Østbjerg across AI implementation, AI adoption, operations transformation and workflow automation.',
  inLanguage: 'en',
};
---

<Layout
  title="Hire Troels - SiteDokAILab"
  description="Role-fit page for Troels Østbjerg across AI implementation, AI adoption, operations transformation and workflow automation."
  canonical="/hire"
  structuredData={structuredData}
>
  <Nav />
  <main id="main" class="bg-canvas text-brand">
    <section class="border-b border-brand/10 px-5 py-16 sm:px-6 md:py-24">
      <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[0.82fr_1.18fr] lg:items-end">
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.22em] text-accent">Hire / contact Troels</p>
          <h1 class="mt-6 max-w-4xl font-display text-4xl font-semibold leading-[1.02] text-brand sm:text-5xl md:text-7xl">
            If this is the kind of thinking your company needs, we should talk.
          </h1>
        </div>
        <p class="max-w-2xl text-xl leading-relaxed text-brand/70">
          I am looking for the right role in AI implementation, operations transformation, workflow automation or practical AI adoption. SiteDokAILab is the proof-of-work layer.
        </p>
      </div>
    </section>

    <section id="role-fit" class="px-5 py-16 sm:px-6 md:py-24">
      <div class="mx-auto max-w-7xl">
        <div class="mb-10 max-w-3xl">
          <p class="font-mono text-xs uppercase tracking-[0.22em] text-accent">Role fit</p>
          <h2 class="mt-5 font-display text-4xl font-semibold leading-[1.02] text-brand md:text-6xl">
            Useful where AI has to survive contact with actual work.
          </h2>
        </div>

        <div class="grid gap-5 md:grid-cols-2">
          {roleCards.map((item) => (
            <article class="conversion-card rounded-[1.35rem] border border-brand/10 bg-panel p-5 md:p-6">
              <h3 class="text-2xl font-semibold leading-tight text-brand">{item.title}</h3>
              <p class="mt-4 text-base leading-relaxed text-brand/68">{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="border-y border-brand/10 bg-brand-dark px-5 py-16 text-canvas sm:px-6 md:py-24">
      <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[0.85fr_1.15fr]">
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.22em] text-accent-light">Why the Lab matters</p>
          <h2 class="mt-5 max-w-2xl font-display text-4xl font-semibold leading-[1.02] md:text-6xl">
            I build while I search.
          </h2>
        </div>
        <div class="grid gap-5 text-lg leading-relaxed text-canvas/72">
          <p>
            SiteDokAILab is deliberately practical: real companies can send messy workflows, and I turn the best fits into clear mini-reviews. That shows pattern recognition, operational judgement, AI fit, risk thinking and communication.
          </p>
          <p>
            It is also a good filter. If a team likes this kind of direct workflow thinking, there is probably something worth discussing.
          </p>
        </div>
      </div>
    </section>

    <section class="px-5 py-16 sm:px-6 md:py-24">
      <div class="mx-auto max-w-7xl overflow-hidden rounded-[1.75rem] border border-brand/10 bg-panel shadow-soft">
        <div class="grid gap-0 lg:grid-cols-[0.82fr_1.18fr]">
          <aside class="border-b border-brand/10 bg-canvas-soft p-6 md:p-8 lg:border-b-0 lg:border-r">
            <p class="font-mono text-xs uppercase tracking-[0.22em] text-accent">Contact</p>
            <h2 class="mt-5 max-w-xl font-display text-4xl font-semibold leading-[1.02] text-brand md:text-5xl">
              Start with the clearest next conversation.
            </h2>
            <p class="mt-6 max-w-xl text-base leading-relaxed text-brand/68">
              Best fit: AI implementation, AI adoption, operations transformation, workflow automation and practical project leadership.
            </p>
            <div class="mt-8 grid gap-3 text-sm leading-relaxed text-brand/70">
              <p class="rounded-xl border border-brand/10 bg-panel px-4 py-3">
                <span class="font-semibold text-brand">Hiring team?</span> Ask for CV, references or a short role-fit call.
              </p>
              <p class="rounded-xl border border-brand/10 bg-panel px-4 py-3">
                <span class="font-semibold text-brand">Company with workflow mess?</span> Send a process for a free mini-review.
              </p>
            </div>
          </aside>

          <div class="grid gap-0 md:grid-cols-2">
            <a href={`mailto:${contactEmail}?subject=${encodeURIComponent('Role conversation with Troels')}`} class="group border-b border-brand/10 bg-accent p-6 text-canvas transition-colors hover:bg-accent-bright focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-accent md:border-r">
              <span class="font-mono text-[0.68rem] uppercase tracking-[0.2em] text-canvas/62">Primary</span>
              <span class="mt-4 block text-2xl font-semibold leading-tight">Email Troels</span>
              <span class="mt-3 block text-sm leading-relaxed text-canvas/78">{contactEmail}</span>
              <span class="mt-6 inline-flex text-sm font-semibold text-canvas transition-transform group-hover:translate-x-1">Start a role conversation</span>
            </a>
            <a href={`mailto:${contactEmail}?subject=${encodeURIComponent('CV request for Troels Østbjerg')}`} class="group border-b border-brand/10 bg-panel p-6 transition-colors hover:bg-canvas focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-accent">
              <span class="font-mono text-[0.68rem] uppercase tracking-[0.2em] text-accent">Hiring material</span>
              <span class="mt-4 block text-2xl font-semibold leading-tight text-brand">Request CV</span>
              <span class="mt-3 block text-sm leading-relaxed text-brand/66">Get the current CV by email, without pretending a PDF is already wired into the site.</span>
              <span class="mt-6 inline-flex text-sm font-semibold text-brand transition-transform group-hover:translate-x-1">Ask for CV</span>
            </a>
            <a href={linkedInUrl} class="group border-b border-brand/10 bg-panel p-6 transition-colors hover:bg-canvas focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-accent md:border-b-0 md:border-r">
              <span class="font-mono text-[0.68rem] uppercase tracking-[0.2em] text-accent">Profile</span>
              <span class="mt-4 block text-2xl font-semibold leading-tight text-brand">Connect on LinkedIn</span>
              <span class="mt-3 block text-sm leading-relaxed text-brand/66">Copenhagen-based, Europe-friendly work, practical AI and operations focus.</span>
              <span class="mt-6 inline-flex text-sm font-semibold text-brand transition-transform group-hover:translate-x-1">Open LinkedIn</span>
            </a>
            <a href="/submit" class="group bg-panel p-6 transition-colors hover:bg-canvas focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-accent">
              <span class="font-mono text-[0.68rem] uppercase tracking-[0.2em] text-accent">Proof of work</span>
              <span class="mt-4 block text-2xl font-semibold leading-tight text-brand">Submit a workflow</span>
              <span class="mt-3 block text-sm leading-relaxed text-brand/66">Send a real process problem and see how I turn mess into a practical first step.</span>
              <span class="mt-6 inline-flex text-sm font-semibold text-brand transition-transform group-hover:translate-x-1">Send workflow</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
