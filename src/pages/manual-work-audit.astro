---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AIServicePage from '../components/site/AIServicePage.astro';
import { breadcrumbSchema, faqSchema, findService, serviceSchema } from '../data/aiContent';
import '../styles/global.css';

const service = findService('manual-work-audit');

if (!service) {
  throw new Error('Manual Work Audit data missing');
}

const structuredData = [
  serviceSchema(service),
  faqSchema(service.path, service.faq),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Services', path: '/#services' },
    { name: service.name, path: service.path },
  ]),
];
---

<Layout
  title="Manual Work Audit — Find the workflows where AI can help"
  description="A 5-business-day audit that maps recurring manual workflows, prioritizes AI opportunities and gives your team the top 3 workflows to start with."
  canonical={service.path}
  structuredData={structuredData}
>
  <Nav />
  <AIServicePage service={service} />
  <Footer />
</Layout>
