---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CaseLibrary from '../components/lab/CaseLibrary.astro';
import { absoluteUrl, siteBaseUrl } from '../data/labContent';
import '../styles/global.css';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${siteBaseUrl}/cases#webpage`,
  url: absoluteUrl('/cases'),
  name: 'Case library - SiteDokAILab',
  description:
    'Filterable example case cards showing how Troels diagnoses messy workflows, AI opportunities, risks and first steps.',
  inLanguage: 'en',
};
---

<Layout
  title="Case library - SiteDokAILab"
  description="Filter example workflow reviews and see how Troels turns process mess into AI fit, risk and first-step recommendations."
  canonical="/cases"
  structuredData={structuredData}
>
  <Nav />
  <main id="main" class="bg-canvas text-brand">
    <section class="border-b border-brand/10 px-5 py-16 sm:px-6 md:py-24">
      <div class="mx-auto max-w-7xl">
        <p class="font-mono text-xs uppercase tracking-[0.22em] text-accent">Public case library</p>
        <h1 class="mt-6 max-w-4xl font-display text-4xl font-semibold leading-[1.02] text-brand sm:text-5xl md:text-7xl">
          See how messy work becomes a useful first step.
        </h1>
        <p class="mt-8 max-w-2xl text-xl leading-relaxed text-brand/70">
          These are example cases, not real client stories. Real public cases should only appear after permission and anonymization.
        </p>
      </div>
    </section>

    <section class="px-5 py-16 sm:px-6 md:py-24">
      <div class="mx-auto max-w-7xl">
        <CaseLibrary />
      </div>
    </section>

    <section class="border-t border-brand/10 bg-panel px-5 py-14 sm:px-6">
      <div class="mx-auto flex max-w-7xl flex-col gap-5 md:flex-row md:items-center md:justify-between">
        <div>
          <h2 class="text-2xl font-semibold text-brand">Have a messier one?</h2>
          <p class="mt-2 max-w-2xl text-sm leading-relaxed text-brand/66">
            Send a real recurring process and I will tell you whether it looks like a useful mini-review candidate.
          </p>
        </div>
        <a href="/submit" class="inline-flex min-h-12 w-fit items-center justify-center rounded-xl border border-accent/50 bg-accent px-6 py-3 text-sm font-semibold text-canvas transition-colors hover:bg-accent-bright focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent active:translate-y-px">
          Submit a workflow
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
