---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AIServicePage from '../components/site/AIServicePage.astro';
import { breadcrumbSchema, faqSchema, findService, serviceSchema } from '../data/aiContent';
import '../styles/global.css';

const service = findService('ai-workflow-sprint');

if (!service) {
  throw new Error('AI Workflow Sprint data missing');
}

const structuredData = [
  serviceSchema(service),
  faqSchema(service.path, service.faq),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Services', path: '/#services' },
    { name: service.name, path: service.path },
  ]),
];
---

<Layout
  title="AI Workflow Sprint — Build one practical AI workflow"
  description="A 10-business-day sprint to design, build and test one human-approved AI workflow for a real operational problem."
  canonical={service.path}
  structuredData={structuredData}
>
  <Nav />
  <AIServicePage service={service} />
  <Footer />
</Layout>
