---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';

const pageTitle = 'Troels Østbjerg — Operations-led AI Implementation';
const pageDescription =
  'Clickable candidate profile for Troels Østbjerg: operations leader, AI implementation builder and process optimization specialist based in Copenhagen.';

const badges = [
  'Copenhagen / hybrid',
  '10+ years operations',
  'AI implementation',
  'Process optimization',
  'FMCG / supply chain / enterprise',
  'Built with AI, not just about AI',
];

const navItems = [
  { label: 'Role fit', href: '#role-fit' },
  { label: 'Proof', href: '#proof' },
  { label: 'Playbook', href: '#playbook' },
  { label: 'Erfaring', href: '#experience' },
  { label: '90 dage', href: '#days-90' },
  { label: 'Kontakt', href: '#kontakt' },
];

const roleFits = [
  {
    id: 'adoption',
    title: 'AI Implementation / Adoption',
    text:
      'Jeg passer bedst i roller hvor AI skal fra idé til hverdagsbrug. Jeg kan oversætte mellem forretning, drift og tekniske muligheder - og sørge for at løsningen ikke dør i PowerPoint.',
  },
  {
    id: 'operations',
    title: 'Operations Transformation',
    text:
      'Jeg ser hurtigt hvor processer knækker: manuelle flows, uklart ejerskab, svage KPI’er, dårlige overleveringer og beslutninger der drukner i statusmøder.',
  },
  {
    id: 'execution',
    title: 'Strategic Project / Program Execution',
    text:
      'Jeg trives med kompleksitet, mange interessenter og uklare problemer - så længe der er mandat til at skabe fremdrift.',
  },
];

const proofRows = [
  ['Problem', 'Virksomheder ved ikke hvordan AI-systemer forstår dem.'],
  ['Approach', 'Manual work audit, AI visibility og struktureret kommunikation.'],
  ['Build', 'Reports, workflows, prompts, llms.txt, sitemap, schema og genbrugelig proces.'],
  ['Value', 'Fra abstrakt AI-snak til konkret beslutningsgrundlag.'],
];

const playbook = [
  {
    title: 'Find friktionen',
    text:
      'Jeg starter ikke med værktøjet. Jeg starter med arbejdet: hvor mister folk tid, energi, overblik og kvalitet?',
  },
  {
    title: 'Kortlæg processen',
    text:
      'Hvem gør hvad, hvornår, i hvilket system, og hvor opstår ventetid eller dobbeltarbejde?',
  },
  {
    title: 'Byg små løsninger hurtigt',
    text:
      'Hellere en lille workflow-forbedring der bliver brugt end en stor transformation ingen ejer.',
  },
  {
    title: 'Få adoptionen til at hænge fast',
    text:
      'AI virker kun hvis mennesker stoler på det, forstår det og kan se værdien i deres egen hverdag.',
  },
  {
    title: 'Mål på reel effekt',
    text:
      'Tid sparet, færre fejl, kortere svartid, bedre beslutninger, mindre manuelt arbejde.',
  },
];

const experience = [
  {
    role: 'Advanced CMO Operations Manager',
    company: 'Novo Nordisk',
    points: [
      'Global CMO coordination',
      'Stakeholder alignment',
      'Complex regulated operations',
      'Learned what slow enterprise processes cost',
    ],
  },
  {
    role: 'Head of Operations Denmark',
    company: 'Vitamin Well',
    points: [
      '4+ years scaling operations',
      'FMCG, logistics, supply chain, suppliers and planning',
      'Built structure during growth',
      'Cross-functional execution',
    ],
  },
  {
    role: 'Supply Chain Coordinator / Manager',
    company: 'Premium Products',
    points: [
      'Hands-on operations foundation',
      'Warehousing, procurement, planning and distribution',
      'Business scaled into acquisition by Vitamin Well',
    ],
  },
  {
    role: 'SiteDokAI + job-search automation',
    company: 'Independent AI Projects',
    points: [
      'Built practical AI workflows',
      'Automated scanning, scoring, research, reporting and structured decision support',
      'Uses AI daily as operating layer',
    ],
  },
];

const differentiators = [
  {
    title: 'I understand operations before AI',
    text:
      'Jeg ved hvordan arbejde faktisk flyder gennem en organisation - og hvor det går i stykker.',
  },
  {
    title: 'I am not afraid of messy problems',
    text:
      'Uklare processer, mange stakeholders og halvfærdige systemer skræmmer mig ikke. Det er ofte der værdien ligger.',
  },
  {
    title: 'I build before I theorize',
    text:
      'Jeg vil hellere bygge en prototype, teste den og lære end bruge tre måneder på en strategi ingen bruger.',
  },
  {
    title: 'I care about adoption',
    text:
      'AI er ikke implementeret, før mennesker bruger det uden at skulle tvinges.',
  },
];

const ninetyDays = [
  {
    period: '0-30 dage',
    points: [
      'Lytte, observere, kortlægge workflows',
      'Identificere manuelle flaskehalse',
      'Forstå eksisterende tech stack og kultur',
      'Finde 3-5 use cases med høj sandsynlighed for adoption',
    ],
  },
  {
    period: '31-60 dage',
    points: [
      'Bygge/pilotere små AI-enabled workflows',
      'Definere ejerskab, KPI’er og governance',
      'Teste med rigtige brugere',
      'Fjerne det der ikke skaber værdi',
    ],
  },
  {
    period: '61-90 dage',
    points: [
      'Skalere de bedste workflows',
      'Dokumentere playbook',
      'Træne teams',
      'Måle effekt og bygge roadmap for næste fase',
    ],
  },
];

const bestFit = [
  'Moderne organisationer med tempo',
  'AI/adoption/operations/transformation',
  'Frihed under ansvar',
  'Roller hvor man må bygge, teste og forbedre',
  'Teams der hellere vil fremad end se perfekte ud',
];

const notFit = [
  'Tunge SOP-kulturer uden mandat',
  'Rent kode-tunge developer-roller',
  'Junior/koordinatorroller',
  'Organisationer der kun vil have AI som PR',
  'Miljøer hvor alt skal godkendes af 14 personer før man tester noget',
];

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': 'https://sitedokai.com/troels#person',
      name: 'Troels Østbjerg',
      url: 'https://sitedokai.com/troels',
      email: 'mailto:troelsostbjerg@gmail.com',
      telephone: '+45 52 38 84 86',
      jobTitle: 'Operations-led AI Implementation',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Copenhagen',
        addressCountry: 'DK',
      },
      sameAs: ['https://www.linkedin.com/in/troels-%C3%B8stbjerg-37757726/'],
      knowsAbout: [
        'AI implementation',
        'AI adoption',
        'Operations transformation',
        'Process optimization',
        'Digital transformation',
        'Workflow automation',
        'Supply chain',
        'FMCG operations',
      ],
      description:
        'Operations leader and practical AI implementation builder based in Copenhagen, with 10+ years in operations, supply chain, FMCG and enterprise coordination.',
    },
    {
      '@type': 'ProfilePage',
      '@id': 'https://sitedokai.com/troels#webpage',
      url: 'https://sitedokai.com/troels',
      name: pageTitle,
      description: pageDescription,
      inLanguage: 'da-DK',
      mainEntity: {
        '@id': 'https://sitedokai.com/troels#person',
      },
      primaryImageOfPage: {
        '@type': 'ImageObject',
        url: 'https://sitedokai.com/troels-ops-system.png',
        width: 1672,
        height: 941,
      },
    },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical="/troels"
  ogImage="/troels-ops-system.png"
  ogImageWidth={1672}
  ogImageHeight={941}
  ogLocale="da_DK"
  lang="da"
  themeColor="#121713"
  cookieTheme="dark"
  structuredData={structuredData}
>
  <main id="main" class="troels-page min-h-screen bg-[#121713] text-[#f3efe5]">
    <header class="sticky top-0 z-20 border-b border-white/10 bg-[#121713]/[0.88] px-5 backdrop-blur-xl sm:px-6">
      <nav class="mx-auto flex max-w-7xl items-center justify-between gap-4 py-4" aria-label="Kandidatprofil navigation">
        <a href="/troels" class="min-w-0 text-[#f3efe5]">
          <span class="block font-display text-xl font-semibold leading-none">Troels Østbjerg</span>
          <span class="mt-1 hidden font-mono text-[10px] uppercase tracking-[0.18em] text-[#b6c8b8]/[0.68] sm:block">
            Operations-led AI Implementation
          </span>
        </a>

        <div class="hidden items-center gap-5 lg:flex">
          {navItems.map((item) => (
            <a href={item.href} class="text-sm font-medium text-[#f3efe5]/[0.62] transition-colors hover:text-[#f3efe5]">
              {item.label}
            </a>
          ))}
        </div>

        <a
          href="/"
          class="hidden min-h-11 items-center justify-center rounded-xl border border-[#96b391]/[0.32] bg-[#f3efe5]/[0.06] px-4 py-2 text-sm font-semibold text-[#f3efe5] transition hover:border-[#96b391]/[0.54] hover:bg-[#f3efe5]/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#96b391] active:translate-y-px sm:inline-flex"
        >
          SiteDokAI
        </a>
      </nav>
    </header>

    <section class="relative overflow-hidden border-b border-white/10">
      <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(rgba(243,239,229,0.045)_1px,transparent_1px),linear-gradient(90deg,rgba(243,239,229,0.035)_1px,transparent_1px)] bg-[size:72px_72px]" aria-hidden="true"></div>
      <div class="pointer-events-none absolute inset-x-0 top-0 h-80 bg-[radial-gradient(circle_at_70%_10%,rgba(150,179,145,0.2),transparent_34rem)]" aria-hidden="true"></div>

      <div class="relative mx-auto grid max-w-7xl gap-10 px-5 pb-12 pt-12 sm:px-6 md:pb-20 md:pt-20 lg:grid-cols-[0.92fr_1.08fr] lg:items-center">
        <div>
          <h1 class="max-w-4xl font-display text-5xl font-semibold leading-[0.96] tracking-tight text-[#f3efe5] sm:text-6xl md:text-7xl">
            Troels Østbjerg
          </h1>
          <p class="mt-5 font-mono text-sm uppercase tracking-[0.18em] text-[#96b391]">
            Operations-led AI Implementation
          </p>
          <p class="mt-7 max-w-2xl text-lg leading-relaxed text-[#d8d2c5]/[0.82] md:text-xl">
            Jeg hjælper virksomheder med at gøre AI praktisk: finde de manuelle flaskehalse, bygge bedre workflows og få mennesker til faktisk at bruge de nye værktøjer.
          </p>

          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href="#playbook" class="inline-flex min-h-12 items-center justify-center rounded-xl border border-[#96b391]/[0.54] bg-[#96b391] px-6 py-3 text-sm font-semibold text-[#121713] transition hover:bg-[#b5c9ab] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#96b391] active:translate-y-px">
              Se hvordan jeg arbejder
            </a>
            <a href="#proof" class="inline-flex min-h-12 items-center justify-center rounded-xl border border-white/[0.14] bg-white/[0.07] px-6 py-3 text-sm font-semibold text-[#f3efe5] transition hover:border-[#96b391]/[0.44] hover:bg-white/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#96b391] active:translate-y-px">
              Se SiteDokAI som proof-of-work
            </a>
            <!-- TODO: add CV link -->
            <a href="#kontakt" class="inline-flex min-h-12 items-center justify-center rounded-xl border border-white/[0.14] px-6 py-3 text-sm font-semibold text-[#f3efe5]/[0.88] transition hover:border-[#96b391]/[0.44] hover:bg-white/[0.08] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#96b391] active:translate-y-px">
              Download / se CV
            </a>
            <a href="#kontakt" class="inline-flex min-h-12 items-center justify-center rounded-xl border border-transparent px-6 py-3 text-sm font-semibold text-[#b6c8b8] transition hover:text-[#f3efe5] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#96b391] active:translate-y-px">
              Kontakt mig
            </a>
          </div>

          <div class="mt-8 flex flex-wrap gap-2">
            {badges.map((badge) => (
              <span class="rounded-full border border-[#96b391]/20 bg-[#f3efe5]/[0.06] px-3 py-2 font-mono text-[0.68rem] uppercase tracking-[0.14em] text-[#d8d2c5]/[0.76]">
                {badge}
              </span>
            ))}
          </div>
        </div>

        <div class="hero-visual relative overflow-hidden rounded-[1.75rem] border border-white/10 bg-[#0f1310] shadow-[0_28px_90px_rgba(0,0,0,0.35)]">
          <picture>
            <source srcset="/troels-ops-system.webp" type="image/webp" />
            <img
              src="/troels-ops-system.png"
              alt="Abstrakt operations-workflow visual med proceslinjer og systemnoder"
              class="h-full min-h-[28rem] w-full object-cover opacity-[0.86]"
              width="1672"
              height="941"
              loading="eager"
              decoding="async"
            />
          </picture>
          <div class="absolute inset-x-0 bottom-0 border-t border-white/10 bg-[#121713]/[0.82] p-5 backdrop-blur-xl sm:p-6">
            <div class="grid gap-4 sm:grid-cols-3">
              <div>
                <p class="font-mono text-[0.68rem] uppercase tracking-[0.18em] text-[#96b391]">Core</p>
                <p class="mt-2 text-sm font-semibold text-[#f3efe5]">Ops + AI + adoption</p>
              </div>
              <div>
                <p class="font-mono text-[0.68rem] uppercase tracking-[0.18em] text-[#96b391]">Proof</p>
                <p class="mt-2 text-sm font-semibold text-[#f3efe5]">SiteDokAI workflows</p>
              </div>
              <div>
                <p class="font-mono text-[0.68rem] uppercase tracking-[0.18em] text-[#96b391]">Mode</p>
                <p class="mt-2 text-sm font-semibold text-[#f3efe5]">Build, test, adopt</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="px-5 py-14 sm:px-6 md:py-20">
      <div class="mx-auto grid max-w-7xl gap-6 lg:grid-cols-[0.7fr_1.3fr] lg:items-start">
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-[#96b391]">Why this site exists</p>
        </div>
        <div class="rounded-[1.5rem] border border-white/10 bg-white/[0.055] p-6 shadow-[inset_0_1px_0_rgba(255,255,255,0.06)] md:p-8">
          <p class="max-w-4xl font-display text-3xl font-semibold leading-tight tracking-tight text-[#f3efe5] md:text-5xl">
            Jeg kunne sende endnu et PDF-CV. I stedet har jeg lavet et lille system, der viser hvordan jeg tænker, prioriterer og bygger.
          </p>
          <p class="mt-5 max-w-3xl text-base leading-relaxed text-[#d8d2c5]/[0.76] md:text-lg">
            Fordi det er mere ærligt end buzzwords. En travl hiring manager skal kunne se min arbejdsmåde, mine cases og min rolle-fit på 2-4 minutter.
          </p>
        </div>
      </div>
    </section>

    <section id="role-fit" class="border-y border-white/10 bg-[#171d18] px-5 py-14 sm:px-6 md:py-20">
      <div class="mx-auto max-w-7xl">
        <div class="mb-9 max-w-3xl">
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-[#96b391]">Hvor jeg passer ind</p>
          <h2 class="mt-4 font-display text-4xl font-semibold leading-[1.02] tracking-tight text-[#f3efe5] md:text-6xl">
            Roller hvor AI skal blive til drift.
          </h2>
        </div>

        <div class="grid gap-4 lg:grid-cols-[1.18fr_0.82fr]">
          {roleFits.map((item, index) => (
            <a
              id={item.id}
              href={index === 0 ? '#proof' : index === 1 ? '#playbook' : '#days-90'}
              class:list={[
                'group block rounded-[1.45rem] border border-white/10 bg-[#f3efe5]/[0.055] p-6 transition hover:-translate-y-0.5 hover:border-[#96b391]/[0.46] hover:bg-[#f3efe5]/[0.075] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#96b391] md:p-7',
                index === 0 ? 'lg:row-span-2 lg:p-8' : '',
              ]}
            >
              <p class="font-mono text-[0.68rem] uppercase tracking-[0.18em] text-[#96b391]">
                {String(index + 1).padStart(2, '0')}
              </p>
              <h3 class:list={['mt-4 font-display font-semibold leading-tight tracking-tight text-[#f3efe5]', index === 0 ? 'text-3xl md:text-5xl' : 'text-2xl md:text-3xl']}>
                {item.title}
              </h3>
              <p class="mt-5 max-w-2xl text-base leading-relaxed text-[#d8d2c5]/[0.74]">
                {item.text}
              </p>
              <span class="mt-7 inline-flex items-center gap-2 font-mono text-[0.7rem] uppercase tracking-[0.16em] text-[#b6c8b8]">
                Åbn modul
                <svg viewBox="0 0 20 20" class="h-4 w-4 transition group-hover:translate-x-1" fill="none" aria-hidden="true">
                  <path d="M4 10h11m-4-4 4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section id="proof" class="px-5 py-14 sm:px-6 md:py-20">
      <div class="mx-auto grid max-w-7xl gap-8 lg:grid-cols-[0.76fr_1.24fr] lg:items-start">
        <aside class="lg:sticky lg:top-28">
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-[#96b391]">Proof of work</p>
          <h2 class="mt-4 font-display text-4xl font-semibold leading-[1.02] tracking-tight text-[#f3efe5] md:text-6xl">
            SiteDokAI - mit proof-of-work.
          </h2>
          <p class="mt-6 max-w-xl text-base leading-relaxed text-[#d8d2c5]/[0.74] md:text-lg">
            SiteDokAI startede som et praktisk projekt: Hvordan hjælper man virksomheder med at forstå, om de overhovedet er synlige i AI-søgning og LLM-svar?
          </p>
        </aside>

        <article class="rounded-[1.65rem] border border-[#96b391]/[0.22] bg-[#f3efe5]/[0.065] p-6 shadow-[inset_0_1px_0_rgba(255,255,255,0.08)] md:p-8">
          <p class="max-w-3xl text-lg leading-relaxed text-[#d8d2c5]/[0.82]">
            Projektet blev til en måde at teste AI workflows, automatiseret research, rapportgenerering, strukturering og AI-klar kommunikation. Det er ikke en teoretisk case. Det er bygget, brugt og gjort hostbart.
          </p>
          <div class="mt-8 grid gap-3">
            {proofRows.map(([label, text]) => (
              <div class="grid gap-3 rounded-2xl border border-white/10 bg-[#121713]/[0.58] p-4 sm:grid-cols-[8.5rem_1fr] sm:items-start">
                <p class="font-mono text-[0.68rem] uppercase tracking-[0.18em] text-[#96b391]">{label}</p>
                <p class="text-sm leading-relaxed text-[#d8d2c5]/[0.78]">{text}</p>
              </div>
            ))}
          </div>
          <a href="/" class="mt-8 inline-flex min-h-12 items-center justify-center rounded-xl border border-[#96b391]/[0.48] bg-[#96b391] px-6 py-3 text-sm font-semibold text-[#121713] transition hover:bg-[#b5c9ab] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#96b391] active:translate-y-px">
            Se SiteDokAI
          </a>
        </article>
      </div>
    </section>

    <section id="playbook" class="border-y border-white/10 bg-[#171d18] px-5 py-14 sm:px-6 md:py-20">
      <div class="mx-auto max-w-7xl">
        <div class="grid gap-8 lg:grid-cols-[0.72fr_1.28fr]">
          <aside>
            <p class="font-mono text-xs uppercase tracking-[0.2em] text-[#96b391]">How I work</p>
            <h2 class="mt-4 font-display text-4xl font-semibold leading-[1.02] tracking-tight text-[#f3efe5] md:text-6xl">
              En praktisk playbook.
            </h2>
          </aside>
          <div class="grid gap-3">
            {playbook.map((item, index) => (
              <article class="grid gap-4 rounded-[1.25rem] border border-white/10 bg-[#f3efe5]/[0.052] p-5 transition hover:border-[#96b391]/[0.38] hover:bg-[#f3efe5]/[0.07] md:grid-cols-[5rem_1fr] md:p-6">
                <p class="font-mono text-xl font-semibold text-[#96b391]">{String(index + 1).padStart(2, '0')}</p>
                <div>
                  <h3 class="font-display text-2xl font-semibold leading-tight tracking-tight text-[#f3efe5]">{item.title}</h3>
                  <p class="mt-3 max-w-3xl text-sm leading-relaxed text-[#d8d2c5]/[0.74] md:text-base">{item.text}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="experience" class="px-5 py-14 sm:px-6 md:py-20">
      <div class="mx-auto max-w-7xl">
        <div class="mb-10 max-w-3xl">
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-[#96b391]">Experience snapshot</p>
          <h2 class="mt-4 font-display text-4xl font-semibold leading-[1.02] tracking-tight text-[#f3efe5] md:text-6xl">
            Fra fysisk drift til AI som operating layer.
          </h2>
        </div>

        <div class="relative grid gap-4">
          {experience.map((item, index) => (
            <article class="relative rounded-[1.35rem] border border-white/10 bg-white/[0.052] p-5 md:p-6">
              <div class="grid gap-5 lg:grid-cols-[0.55fr_1fr] lg:items-start">
                <div>
                  <p class="font-mono text-[0.68rem] uppercase tracking-[0.18em] text-[#96b391]">{String(index + 1).padStart(2, '0')}</p>
                  <h3 class="mt-3 font-display text-2xl font-semibold leading-tight text-[#f3efe5]">{item.company}</h3>
                  <p class="mt-2 text-sm font-semibold text-[#d8d2c5]/[0.72]">{item.role}</p>
                </div>
                <ul class="grid gap-2 text-sm leading-relaxed text-[#d8d2c5]/[0.76] md:grid-cols-2">
                  {item.points.map((point) => (
                    <li class="rounded-xl border border-white/10 bg-[#121713]/[0.45] px-4 py-3">{point}</li>
                  ))}
