---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<Layout
  title="Accessibility — SiteDokAI"
  description="Accessibility statement for sitedokai.com."
  canonical="/accessibility"
>
  <Nav />
  <main id="main" class="bg-canvas text-brand">
    <section class="mx-auto max-w-3xl px-6 py-16 md:py-24">
      <p class="font-mono text-xs uppercase tracking-[0.22em] text-brand/50">Accessibility</p>
      <h1 class="mt-5 font-display text-4xl font-semibold leading-[1.04] text-brand md:text-5xl">
        Accessibility on sitedokai.com.
      </h1>
      <div class="mt-10 grid gap-8 text-base leading-relaxed text-brand/72">
        <section>
          <h2 class="text-2xl font-semibold text-brand">Goal</h2>
          <p class="mt-3">SiteDokAI aims to keep the website clear, readable and usable across mobile and desktop. The site uses semantic headings, visible links, keyboard focus states, form labels and high-contrast text.</p>
        </section>
        <section>
          <h2 class="text-2xl font-semibold text-brand">Current status</h2>
          <p class="mt-3">The site has been reviewed for basic accessibility during this redesign. Some areas may still need improvement as the site evolves.</p>
        </section>
        <section>
          <h2 class="text-2xl font-semibold text-brand">Feedback</h2>
          <p class="mt-3">If you experience an accessibility issue, email <a href="mailto:info@sitedokai.com" class="font-semibold underline decoration-brand/30 underline-offset-4">info@sitedokai.com</a> and include the page, device, browser and issue.</p>
        </section>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
