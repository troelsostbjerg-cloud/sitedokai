---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AdvisoryPage from '../components/site/AdvisoryPage.astro';
import '../styles/global.css';
---

<Layout
  title="Manual Work Audit i stedet for standardrapport | SiteDokAI"
  description="SiteDokAI kortlægger virkelige workflows og prioriterer konkrete AI-pilots frem for at levere generiske rapporter."
  canonical="/gratis-rapport"
>
  <Nav />
  <AdvisoryPage
    eyebrow="Rapporter"
    title="Vi starter med friktion, ikke med en standardrapport."
    text="En rapport skaber sjældent værdi, hvis ingen har kortlagt hvordan arbejdet faktisk foregår. Manual Work Audit starter med processen, menneskene og de steder, hvor tiden forsvinder."
    points={[
      'Proceskort over workflows, der stjæler tid.',
      'Prioriteret backlog med konkrete AI- og automationsmuligheder.',
      'Top 3 pilots og en simpel prototype-skitse på bedste case.',
    ]}
    ctaLabel="Book audit"
  />
  <Footer />
</Layout>
