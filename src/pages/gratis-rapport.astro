---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<Layout
  title="Gratis rapport er lukket | SiteDokAI"
  description="SiteDokAIs gamle gratis rapport er lukket. Start i stedet med Hjemmeside-tjek, hvis du vil finde problemerne på din hjemmeside."
  noindex={true}
>
  <Nav />
  <main id="main">
    <section class="bg-white">
      <div class="mx-auto max-w-3xl px-6 py-20 text-center md:py-28">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-accent">Opdateret ydelse</p>
        <h1 class="mt-5 font-display text-4xl font-extrabold tracking-tight text-brand md:text-6xl">
          Den gamle gratis rapport er lukket.
        </h1>
        <p class="mt-6 text-lg leading-relaxed text-brand/70">
          SiteDokAI fokuserer nu på Hjemmeside-tjek, Hjemmeside-fix og Visuelt løft. Hvis du vil finde de vigtigste problemer på din hjemmeside, er Hjemmeside-tjekket den rigtige start.
        </p>
        <div class="mt-8 flex flex-col justify-center gap-4 sm:flex-row">
          <a href="/hjemmeside-tjek#bestil" class="inline-flex items-center justify-center rounded-full bg-brand px-7 py-3 text-sm font-bold text-white transition-colors hover:bg-brand-light">
            Bestil Hjemmeside-tjek
          </a>
          <a href="/hjemmeside-tjek" class="inline-flex items-center justify-center rounded-full border border-[#d9cfbf] bg-[#fbf8f3] px-7 py-3 text-sm font-bold text-brand transition-colors hover:bg-white">
            Se hvad du får
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
