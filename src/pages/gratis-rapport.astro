---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AdvisoryPage from '../components/site/AdvisoryPage.astro';
import '../styles/global.css';
---

<Layout
  title="Gratis screening i stedet for rapport | SiteDokAI"
  description="SiteDokAI starter med en første samtale og screening uden beregning frem for en tung standardrapport."
  canonical="/gratis-rapport"
>
  <Nav />
  <AdvisoryPage
    eyebrow="Gratis start"
    title="Vi starter med screening, ikke med en rapport."
    text="En standardrapport kan hurtigt blive for tung. Derfor starter vi med en kort afklaring af om agentic search faktisk er et relevant problem for jer."
    points={[
      'Kort første vurdering uden beregning.',
      'Ingen binding og ingen automatisk salgspakke.',
      'Et konkret næste skridt, hvis der er noget at arbejde videre med.',
    ]}
    ctaHref="/kontakt#screening"
  />
  <Footer />
</Layout>
