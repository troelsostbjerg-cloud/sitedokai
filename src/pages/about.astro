---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { aboutBullets, absoluteUrl, siteBaseUrl } from '../data/labContent';
import '../styles/global.css';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  '@id': `${siteBaseUrl}/about#webpage`,
  url: absoluteUrl('/about'),
  name: 'About Troels Østbjerg - SiteDokAILab',
  description:
    'Troels Østbjerg turns operational mess into usable systems across AI implementation, operations transformation and workflow automation.',
  inLanguage: 'en',
  mainEntity: {
    '@type': 'Person',
    name: 'Troels Østbjerg',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Copenhagen',
      addressCountry: 'DK',
    },
    knowsAbout: [
      'AI implementation',
      'AI adoption',
      'Operations transformation',
      'Workflow automation',
      'Process improvement',
      'Supply chain',
      'FMCG operations',
    ],
  },
};
---

<Layout
  title="About Troels Østbjerg - SiteDokAILab"
  description="Troels Østbjerg turns operational mess into usable systems across AI implementation, operations transformation and workflow automation."
  canonical="/about"
  structuredData={structuredData}
>
  <Nav />
  <main id="main" class="bg-canvas text-brand">
    <section class="border-b border-brand/10 px-5 py-16 sm:px-6 md:py-24">
      <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[0.82fr_1.18fr] lg:items-end">
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.22em] text-accent">About Troels</p>
          <h1 class="mt-6 max-w-4xl font-display text-4xl font-semibold leading-[1.02] text-brand sm:text-5xl md:text-7xl">
            I turn operational mess into usable systems.
          </h1>
        </div>
        <p class="max-w-2xl text-xl leading-relaxed text-brand/70">
          I am Troels Østbjerg, based in Copenhagen. I have spent 10+ years in operations, supply chain, process improvement and stakeholder-heavy environments, from scaling FMCG operations at Vitamin Well to handling complex CMO coordination at Novo Nordisk.
        </p>
      </div>
    </section>

    <section class="px-5 py-16 sm:px-6 md:py-24">
      <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[0.95fr_1.05fr]">
        <div class="grid gap-6 text-lg leading-relaxed text-brand/72">
          <p>
            I am not a developer. I am an operations person who became deeply practical with AI because I got tired of watching people lose hours to manual work, repeated updates, scattered information and systems nobody enjoys using.
          </p>
          <p>
            My strength is not writing grand AI strategies. It is finding the messy workflow, understanding why people avoid it, simplifying it, and building the first useful version of something better.
          </p>
          <p class="rounded-[1.25rem] border border-brand/10 bg-panel p-5 text-base text-brand/70">
            I like tools. I just do not trust them as a starting point. Start with the work, then decide where AI should assist.
          </p>
        </div>

        <div class="grid gap-4 md:grid-cols-2">
          <article class="rounded-[1.35rem] border border-brand/10 bg-panel p-5">
            <h2 class="text-2xl font-semibold text-brand">What I bring</h2>
            <ul class="mt-5 grid gap-2 text-sm leading-relaxed text-brand/68">
              {aboutBullets.bring.map((item) => <li>{item}</li>)}
            </ul>
          </article>
          <article class="rounded-[1.35rem] border border-brand/10 bg-panel p-5">
            <h2 class="text-2xl font-semibold text-brand">Where I fit best</h2>
            <ul class="mt-5 grid gap-2 text-sm leading-relaxed text-brand/68">
              {aboutBullets.fit.map((item) => <li>{item}</li>)}
            </ul>
          </article>
          <article class="rounded-[1.35rem] border border-brand/10 bg-panel p-5 md:col-span-2">
            <h2 class="text-2xl font-semibold text-brand">How I work</h2>
            <div class="mt-5 flex flex-wrap gap-2">
              {aboutBullets.work.map((item) => (
                <span class="rounded-xl border border-brand/10 bg-canvas px-3 py-2 text-sm font-semibold text-brand/66">{item}</span>
              ))}
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="border-y border-brand/10 bg-brand-dark px-5 py-16 text-canvas sm:px-6 md:py-24">
      <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[0.85fr_1.15fr]">
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.22em] text-accent-light">Why the Lab exists</p>
          <h2 class="mt-5 max-w-2xl font-display text-4xl font-semibold leading-[1.02] md:text-6xl">
            Proof of work beats polished claims.
          </h2>
        </div>
        <div class="grid gap-5 text-lg leading-relaxed text-canvas/72">
          <p>
            SiteDokAILab lets companies get a useful mini-review and lets hiring teams see my operating brain in public. It is part service, part portfolio, part way to stay sharp while I look for the right role.
          </p>
          <p>
            The point is not to pretend I can fix every business process from a web form. The point is to show how I diagnose friction, where I think AI belongs, and where humans must stay in the loop.
          </p>
        </div>
      </div>
    </section>

    <section class="px-5 py-14 sm:px-6">
      <div class="mx-auto flex max-w-7xl flex-col gap-5 rounded-[1.35rem] border border-brand/10 bg-panel p-6 md:flex-row md:items-center md:justify-between">
        <div>
          <h2 class="text-2xl font-semibold text-brand">Want to see the role fit?</h2>
          <p class="mt-2 max-w-2xl text-sm leading-relaxed text-brand/66">
            The hire page translates this work into AI implementation, adoption, operations and transformation roles.
          </p>
        </div>
        <a href="/hire" class="inline-flex min-h-12 w-fit items-center justify-center rounded-xl border border-accent/50 bg-accent px-6 py-3 text-sm font-semibold text-canvas transition-colors hover:bg-accent-bright focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent active:translate-y-px">
          Talk about a role
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
