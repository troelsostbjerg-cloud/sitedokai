    <section id="days-90" class="px-5 py-14 sm:px-6 md:py-20">
      <div class="mx-auto max-w-7xl">
        <div class="mb-9 max-w-3xl">
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-[#96b391]">30 / 60 / 90</p>
          <h2 class="mt-4 font-display text-4xl font-semibold leading-[1.02] text-[#f3efe5] md:text-6xl">
            First 90 days, tuned by role.
          </h2>
        </div>
        <div class="grid gap-4 lg:grid-cols-3">
          {roleLenses.map((lens, index) => (
            <article data-plan-card={lens.id} class:list={['rounded-[1.45rem] border bg-[#f3efe5]/[0.052] p-6 md:p-7', index === 0 ? 'border-[#96b391]/[0.42]' : 'border-white/10']}>
              <p class="font-mono text-[0.68rem] uppercase tracking-[0.18em] text-[#96b391]">{lens.label}</p>
              <h3 class="mt-4 font-display text-2xl font-semibold leading-tight text-[#f3efe5]">{lens.headline.replace('For ', '')}</h3>
              <div class="mt-6 grid gap-3">
                {[
                  ['0-30', lens.plan90.days030],
                  ['31-60', lens.plan90.days3160],
                  ['61-90', lens.plan90.days6190],
                ].map(([period, text]) => (
                  <div class="rounded-2xl border border-white/10 bg-[#121713]/[0.45] p-4">
                    <p class="font-mono text-[0.68rem] uppercase tracking-[0.18em] text-[#96b391]">{period}</p>
                    <p class="mt-3 text-sm leading-relaxed text-[#d8d2c5]/[0.78]">{text}</p>
                  </div>
                ))}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="border-y border-white/10 bg-[#171d18] px-5 py-14 sm:px-6 md:py-20">
      <div class="mx-auto grid max-w-7xl gap-8 lg:grid-cols-[0.72fr_1.28fr]">
        <aside>
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-[#96b391]">How I work</p>
          <h2 class="mt-4 max-w-xl font-display text-4xl font-semibold leading-[1.02] text-[#f3efe5] md:text-6xl">
            Practical, direct and output-biased.
          </h2>
        </aside>
        <div class="grid gap-4 md:grid-cols-2">
          {workingStyle.map(([title, text]) => (
            <article class="rounded-[1.35rem] border border-white/10 bg-[#f3efe5]/[0.052] p-6">
              <h3 class="font-display text-2xl font-semibold leading-tight text-[#f3efe5]">{title}</h3>
              <p class="mt-4 text-sm leading-relaxed text-[#d8d2c5]/[0.74] md:text-base">{text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="contact" class="px-5 py-14 sm:px-6 md:py-20">
      <div class="mx-auto grid max-w-7xl gap-8 lg:grid-cols-[0.85fr_1.15fr] lg:items-stretch">
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-[#96b391]">Contact</p>
          <h2 class="mt-4 font-display text-4xl font-semibold leading-[1.02] text-[#f3efe5] md:text-6xl">
            Want the 20-minute version?
          </h2>
          <p class="mt-6 max-w-2xl text-lg leading-relaxed text-[#d8d2c5]/[0.78]">
            I can walk through one messy workflow from your team and show how I would turn it into a practical AI use-case map.
          </p>
          <p class="mt-5 max-w-2xl text-sm leading-relaxed text-[#d8d2c5]/[0.62]">
            Public contact is routed through SiteDokAI for now. Direct personal email, phone and hosted CV can be added when Troels confirms the preferred recruiter-facing details.
          </p>
        </div>

        <address class="not-italic rounded-[1.65rem] border border-[#96b391]/[0.24] bg-[#f3efe5]/[0.065] p-6 shadow-[inset_0_1px_0_rgba(255,255,255,0.08)] md:p-8">
          <p class="font-display text-3xl font-semibold tracking-tight text-[#f3efe5]">Troels Østbjerg</p>
          <p class="mt-2 text-sm text-[#d8d2c5]/[0.68]">Copenhagen, Denmark</p>
          <div class="mt-7 grid gap-3">
            <a href={`mailto:${contactEmail}?subject=Hiring%20Troels%20-%20quick%20conversation`} class="rounded-xl border border-white/10 bg-[#121713]/[0.48] px-4 py-3 text-sm font-semibold text-[#f3efe5] transition hover:border-[#96b391]/[0.42] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#96b391]">
              Email Troels via {contactEmail}
            </a>
            <a href={linkedInUrl} rel="noreferrer" target="_blank" class="rounded-xl border border-white/10 bg-[#121713]/[0.48] px-4 py-3 text-sm font-semibold text-[#f3efe5] transition hover:border-[#96b391]/[0.42] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#96b391]">
              Open LinkedIn
            </a>
            <a href="/" class="rounded-xl border border-white/10 bg-[#121713]/[0.48] px-4 py-3 text-sm font-semibold text-[#f3efe5] transition hover:border-[#96b391]/[0.42] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#96b391]">
              Back to SiteDokAI
            </a>
          </div>
        </address>
