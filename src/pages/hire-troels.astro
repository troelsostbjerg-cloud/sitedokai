      transition: none;
    }
  }

  @media print {
    :global(html) {
      scroll-behavior: auto;
    }

    .hire-page {
      background: #ffffff !important;
      color: #1e261f !important;
    }

    .hire-page section {
      border-color: rgba(30, 38, 31, 0.18) !important;
