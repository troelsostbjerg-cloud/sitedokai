<script is:inline>
  (function() {
    var selected = {
      workflow: 'Status reporting',
      frequency: 'Daily',
      pain: 'Time',
      risk: 'Low'
    };

    function setActiveButton(buttons, activeButton, activeClass, inactiveClass) {
      buttons.forEach(function(button) {
        var isActive = button === activeButton;
        button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        button.setAttribute('aria-selected', isActive ? 'true' : 'false');
        button.className = isActive ? activeClass : inactiveClass;
      });
    }

    var roleButtons = Array.prototype.slice.call(document.querySelectorAll('[data-role-trigger]'));
    var roleCards = Array.prototype.slice.call(document.querySelectorAll('[data-role-card]'));
    var planCards = Array.prototype.slice.call(document.querySelectorAll('[data-plan-card]'));
    var activeRoleClass = 'rounded-xl border border-[#96b391]/[0.5] bg-[#96b391] px-4 py-2 text-left text-sm font-semibold text-[#121713] transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#96b391]';
    var inactiveRoleClass = 'rounded-xl border border-white/10 bg-white/[0.055] px-4 py-2 text-left text-sm font-semibold text-[#d8d2c5]/[0.78] transition hover:border-[#96b391]/[0.42] hover:text-[#f3efe5] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#96b391]';

    roleButtons.forEach(function(button) {
      button.addEventListener('click', function() {
        var role = button.getAttribute('data-role-trigger');
        setActiveButton(roleButtons, button, activeRoleClass, inactiveRoleClass);
        roleCards.forEach(function(card) {
          var isActive = card.getAttribute('data-role-card') === role;
          card.classList.toggle('border-[#96b391]/[0.42]', isActive);
          card.classList.toggle('shadow-[0_22px_70px_rgba(0,0,0,0.18)]', isActive);
        });
        planCards.forEach(function(card) {
          var isActive = card.getAttribute('data-plan-card') === role;
          card.classList.toggle('border-[#96b391]/[0.42]', isActive);
        });
        var target = document.getElementById('lens-' + role);
        if (target) target.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });
    });

    var filterButtons = Array.prototype.slice.call(document.querySelectorAll('[data-proof-filter]'));
    var proofCards = Array.prototype.slice.call(document.querySelectorAll('[data-proof-card]'));
    var activeFilterClass = 'rounded-xl border border-[#96b391]/[0.5] bg-[#96b391] px-4 py-2 text-sm font-semibold text-[#121713] transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#96b391]';
    var inactiveFilterClass = 'rounded-xl border border-white/10 bg-white/[0.055] px-4 py-2 text-sm font-semibold text-[#d8d2c5]/[0.78] transition hover:border-[#96b391]/[0.42] hover:text-[#f3efe5] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#96b391]';

    filterButtons.forEach(function(button) {
      button.addEventListener('click', function() {
        var filter = button.getAttribute('data-proof-filter') || 'all';
        setActiveButton(filterButtons, button, activeFilterClass, inactiveFilterClass);
        proofCards.forEach(function(card) {
          var categories = card.getAttribute('data-categories') || '';
          var isVisible = filter === 'all' || categories.split('|').indexOf(filter) >= 0;
          card.hidden = !isVisible;
        });
      });
    });

    function workflowCopy() {
      var first = 'Map fixed inputs and recurring decision points.';
      var ai = 'Summarize, classify, extract actions and draft the next step.';
      var approval = 'Owner reviews before anything is sent or updated.';
      var measure = 'Time saved, fewer follow-ups, clearer ownership and faster decisions.';
      var fit = 'Good first AI candidate if inputs are recurring and ownership is clear.';

      if (selected.workflow === 'Supplier updates') {
        first = 'Collect the recurring supplier inputs, exception types and escalation owners.';
        ai = 'Extract changes, classify exceptions and draft a concise status summary.';
        measure = 'Fewer missed updates, faster exception handling and less manual chasing.';
      }
      if (selected.workflow === 'Customer requests') {
        first = 'Define request categories, context needed and the safe reply boundaries.';
        ai = 'Classify the request, prepare context and draft a reply for review.';
        measure = 'Shorter response time, more consistent quality and fewer reopened cases.';
      }
      if (selected.workflow === 'Meeting follow-up') {
        first = 'Standardise notes, decisions, owners, deadlines and follow-up rhythm.';
        ai = 'Extract actions, detect missing owners and draft follow-up messages.';
        measure = 'Fewer loose actions, clearer ownership and faster decision closure.';
      }
      if (selected.workflow === 'Handover') {
        first = 'Map what context is lost between teams, shifts or project phases.';
        ai = 'Turn source notes into a structured handover with risks and next steps.';
        measure = 'Fewer context gaps, less rework and smoother continuity.';
      }
      if (selected.workflow === 'CRM follow-up') {
        first = 'Define the trigger, customer state, owner and next-best-action logic.';
        ai = 'Summarize CRM notes, suggest next step and draft follow-up text.';
        measure = 'Fewer forgotten follow-ups and clearer commercial ownership.';
      }
      if (selected.workflow === 'Management reporting') {
        first = 'Separate stable inputs, variance explanations and decisions needed.';
        ai = 'Draft commentary, flag anomalies and prepare decision notes.';
        measure = 'Less reporting assembly work and more time for judgement.';
      }

      if (selected.pain === 'Errors') {
        first = 'Map error patterns and the control points where mistakes can be caught early.';
        measure = 'Fewer corrections, fewer missed steps and more consistent output quality.';
      }
      if (selected.pain === 'Ownership') {
        approval = 'Named owner approves task routing and unresolved exceptions.';
        measure = 'Clearer ownership, fewer orphan tasks and fewer status meetings.';
      }
      if (selected.pain === 'Decision delay') {
        ai = 'Prepare decision context, options, blockers and recommended next action.';
        measure = 'Shorter decision cycle and fewer meetings used only for status.';
      }
      if (selected.pain === 'Inconsistent quality') {
        approval = 'Human reviewer approves tone, quality and exceptions before release.';
        measure = 'More consistent outputs without removing professional judgement.';
      }

      if (selected.risk === 'Medium') {
        approval = 'Owner reviews before output is sent, logged or used in a decision.';
        fit = 'Good candidate if the pilot starts narrow and uses clear review rules.';
      }
      if (selected.risk === 'High') {
        approval = 'Human approval is mandatory, with source trace, fallback and review rhythm.';
        fit = 'Not a first automation candidate until data, ownership and approval rules are explicit.';
      }

      return { first: first, ai: ai, approval: approval, measure: measure, fit: fit };
    }

    function updateWorkflowOutput() {
      var copy = workflowCopy();
      var title = document.querySelector('[data-workflow-title]');
      var first = document.querySelector('[data-workflow-first]');
      var ai = document.querySelector('[data-workflow-ai]');
      var approval = document.querySelector('[data-workflow-approval]');
      var measure = document.querySelector('[data-workflow-measure]');
      var fit = document.querySelector('[data-workflow-fit]');

      if (title) title.textContent = selected.workflow + ', ' + selected.frequency.toLowerCase() + ', ' + selected.pain.toLowerCase() + ' pain, ' + selected.risk.toLowerCase() + ' risk';
      if (first) first.textContent = copy.first;
      if (ai) ai.textContent = copy.ai;
      if (approval) approval.textContent = copy.approval;
      if (measure) measure.textContent = copy.measure;
      if (fit) fit.textContent = copy.fit;
    }

    var optionButtons = Array.prototype.slice.call(document.querySelectorAll('[data-workflow-option]'));
    var activeOptionClass = 'rounded-xl border border-[#96b391]/[0.5] bg-[#96b391] px-4 py-2 text-sm font-semibold text-[#121713] transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#96b391]';
    var inactiveOptionClass = 'rounded-xl border border-white/10 bg-[#121713]/[0.4] px-4 py-2 text-sm font-semibold text-[#d8d2c5]/[0.78] transition hover:border-[#96b391]/[0.42] hover:text-[#f3efe5] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#96b391]';

    optionButtons.forEach(function(button) {
      button.addEventListener('click', function() {
        var key = button.getAttribute('data-workflow-option');
        var value = button.getAttribute('data-value');
        if (key && value) selected[key] = value;

        var group = optionButtons.filter(function(item) {
          return item.getAttribute('data-workflow-option') === key;
        });
        setActiveButton(group, button, activeOptionClass, inactiveOptionClass);
        updateWorkflowOutput();
      });
    });

    var printButton = document.querySelector('[data-print-profile]');
    if (printButton) {
      printButton.addEventListener('click', function() {
        window.print();
      });
    }
  })();
</script>

<style>
