---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
import {
  frequencies,
  operatingModel,
  painTypes,
  proofCards,
  proofFilters,
  riskLevels,
  roleLenses,
  workingStyle,
  workflowTypes,
} from '../data/hireTroels';

const pageTitle = 'Hire Troels Østbjerg — Operations-led AI Implementation';
const pageDescription =
  'Interactive proof profile for Troels Østbjerg: operations, AI workflow design, automation, adoption and practical execution.';

const linkedInUrl = 'https://www.linkedin.com/in/troels-%C3%B8stbjerg-37757726/';
const contactEmail = 'troelsostbjerg@gmail.com';

const modeLinks = [
  { label: '30 sec overview', href: '#overview' },
  { label: 'Role fit', href: '#role-lens' },
  { label: 'Proof library', href: '#proof-library' },
  { label: 'Deep dive', href: '#workflow-demo' },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': 'https://sitedokai.com/hire-troels#person',
      name: 'Troels Østbjerg',
      url: 'https://sitedokai.com/hire-troels',
      email: `mailto:${contactEmail}`,
      jobTitle: 'Operations-led AI Implementation',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Copenhagen',
        addressCountry: 'DK',
      },
      sameAs: [linkedInUrl],
      knowsAbout: [
        'AI implementation',
        'AI adoption',
        'Operations transformation',
        'Workflow automation',
        'Process optimization',
        'Supply chain',
        'Stakeholder translation',
        'Digital transformation',
      ],
      description:
        'Copenhagen-based operations leader and practical AI implementation builder with 10+ years in operations, supply chain and complex stakeholder environments.',
    },
    {
      '@type': 'ProfilePage',
      '@id': 'https://sitedokai.com/hire-troels#webpage',
      url: 'https://sitedokai.com/hire-troels',
      name: pageTitle,
      description: pageDescription,
      inLanguage: 'en',
      mainEntity: {
        '@id': 'https://sitedokai.com/hire-troels#person',
      },
      isPartOf: {
        '@type': 'WebSite',
        '@id': 'https://sitedokai.com/#website',
        name: 'SiteDokAI',
        url: 'https://sitedokai.com/',
      },
    },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical="/hire-troels"
  ogImage="/troels-ops-system.png"
  ogImageWidth={1672}
  ogImageHeight={941}
  themeColor="#121713"
  cookieTheme="dark"
  structuredData={structuredData}
>
  <main id="main" class="hire-page min-h-screen bg-[#121713] text-[#f3efe5]">
    <header class="sticky top-0 z-20 border-b border-white/10 bg-[#121713]/[0.9] px-5 backdrop-blur-xl sm:px-6 print:hidden">
      <nav class="mx-auto flex max-w-7xl items-center justify-between gap-4 py-4" aria-label="Candidate profile navigation">
        <a href="/hire-troels" class="min-w-0 text-[#f3efe5]">
          <span class="block font-display text-xl font-semibold leading-none">TroelsOS</span>
          <span class="mt-1 hidden font-mono text-[10px] uppercase tracking-[0.18em] text-[#b6c8b8]/[0.68] sm:block">
            The operator behind SiteDokAI
          </span>
        </a>

        <div class="hidden items-center gap-5 lg:flex">
          {modeLinks.map((item) => (
            <a href={item.href} class="text-sm font-medium text-[#f3efe5]/[0.62] transition-colors hover:text-[#f3efe5]">
              {item.label}
            </a>
          ))}
        </div>

        <div class="flex items-center gap-2">
          <button
            type="button"
            data-print-profile
            class="hidden min-h-11 items-center justify-center rounded-xl border border-white/[0.14] bg-white/[0.06] px-4 py-2 text-sm font-semibold text-[#f3efe5] transition hover:border-[#96b391]/[0.5] hover:bg-white/[0.1] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#96b391] active:translate-y-px sm:inline-flex"
          >
            Print profile
          </button>
          <a
            href="/"
            class="inline-flex min-h-11 items-center justify-center rounded-xl border border-[#96b391]/[0.32] bg-[#f3efe5]/[0.06] px-4 py-2 text-sm font-semibold text-[#f3efe5] transition hover:border-[#96b391]/[0.54] hover:bg-[#f3efe5]/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#96b391] active:translate-y-px"
          >
            SiteDokAI
          </a>
        </div>
      </nav>
    </header>

    <section id="overview" class="relative overflow-hidden border-b border-white/10">
      <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(rgba(243,239,229,0.045)_1px,transparent_1px),linear-gradient(90deg,rgba(243,239,229,0.035)_1px,transparent_1px)] bg-[size:72px_72px]" aria-hidden="true"></div>
      <div class="pointer-events-none absolute inset-x-0 top-0 h-96 bg-[radial-gradient(circle_at_76%_8%,rgba(150,179,145,0.22),transparent_34rem)]" aria-hidden="true"></div>

      <div class="relative mx-auto grid max-w-7xl gap-10 px-5 pb-12 pt-12 sm:px-6 md:pb-20 md:pt-20 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
        <div>
          <p class="max-w-2xl font-mono text-xs uppercase tracking-[0.2em] text-[#96b391]">
            Built for recruiters and hiring managers who want more than a CV.
          </p>
          <h1 class="mt-6 max-w-4xl font-display text-5xl font-semibold leading-[0.97] text-[#f3efe5] sm:text-6xl md:text-7xl">
            TroelsOS
          </h1>
          <p class="mt-4 font-display text-2xl font-semibold leading-tight text-[#d8d2c5] sm:text-3xl">
            The operator behind SiteDokAI.
          </p>
          <p class="mt-7 max-w-2xl text-lg leading-relaxed text-[#d8d2c5]/[0.82] md:text-xl">
            I help teams find the recurring manual work that slows them down, turn it into clear workflows, and use AI where it actually creates value.
          </p>
          <p class="mt-5 max-w-2xl text-base leading-relaxed text-[#d8d2c5]/[0.72] md:text-lg">
            10+ years in operations, supply chain and complex stakeholder environments. Now focused on operations-led AI implementation, workflow automation and adoption.
          </p>

          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href="#role-lens" class="inline-flex min-h-12 items-center justify-center rounded-xl border border-[#96b391]/[0.54] bg-[#96b391] px-6 py-3 text-sm font-semibold text-[#121713] transition hover:bg-[#b5c9ab] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#96b391] active:translate-y-px">
              Explore fit by role
            </a>
            <a href="#proof-library" class="inline-flex min-h-12 items-center justify-center rounded-xl border border-white/[0.14] bg-white/[0.07] px-6 py-3 text-sm font-semibold text-[#f3efe5] transition hover:border-[#96b391]/[0.44] hover:bg-white/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#96b391] active:translate-y-px">
              See proof points
            </a>
            <a href={`mailto:${contactEmail}?subject=Hiring%20Troels%20-%20quick%20conversation`} class="inline-flex min-h-12 items-center justify-center rounded-xl border border-transparent px-6 py-3 text-sm font-semibold text-[#b6c8b8] transition hover:text-[#f3efe5] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#96b391] active:translate-y-px">
              Contact Troels
            </a>
          </div>
        </div>

        <aside class="relative rounded-[1.75rem] border border-white/10 bg-[#0f1310] p-5 shadow-[0_28px_90px_rgba(0,0,0,0.35)] md:p-6">
          <div class="grid gap-3">
            {[
              ['Input', 'Messy operational work'],
              ['Method', 'Map friction, ownership, risk and output'],
              ['AI role', 'Draft, classify, summarize, route and prepare'],
              ['Control', 'Human approval where quality or responsibility matters'],
              ['Output', 'A workflow people can use on a busy Tuesday'],
            ].map(([label, text], index) => (
              <div class:list={['grid gap-3 rounded-[1.1rem] border border-white/10 bg-[#f3efe5]/[0.055] p-4 sm:grid-cols-[8rem_1fr] sm:items-start', index === 4 ? 'border-[#96b391]/[0.42] bg-[#96b391]/[0.12]' : '']}>
                <p class="font-mono text-[0.68rem] uppercase tracking-[0.18em] text-[#96b391]">{label}</p>
                <p class="text-sm font-semibold leading-relaxed text-[#f3efe5]">{text}</p>
              </div>
            ))}
          </div>
        </aside>
      </div>
    </section>

    <section class="border-b border-white/10 bg-[#171d18] px-5 py-7 sm:px-6 print:hidden">
      <div class="mx-auto flex max-w-7xl flex-col gap-3 md:flex-row md:items-center md:justify-between">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-[#96b391]">Recruiter mode</p>
        <div class="flex flex-wrap gap-2" aria-label="Recruiter mode shortcuts">
          {modeLinks.map((item) => (
            <a href={item.href} class="rounded-xl border border-white/10 bg-[#f3efe5]/[0.055] px-4 py-2 text-sm font-semibold text-[#d8d2c5]/[0.78] transition hover:border-[#96b391]/[0.42] hover:text-[#f3efe5] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#96b391]">
              {item.label}
            </a>
          ))}
        </div>
      </div>
    </section>

    <section id="role-lens" class="px-5 py-14 sm:px-6 md:py-20">
      <div class="mx-auto max-w-7xl">
        <div class="grid gap-7 lg:grid-cols-[0.72fr_1.28fr] lg:items-start">
          <aside class="lg:sticky lg:top-28">
            <p class="font-mono text-xs uppercase tracking-[0.2em] text-[#96b391]">Role lens</p>
            <h2 class="mt-4 max-w-xl font-display text-4xl font-semibold leading-[1.02] text-[#f3efe5] md:text-6xl">
              Choose what you are hiring for.
            </h2>
            <p class="mt-5 max-w-xl text-base leading-relaxed text-[#d8d2c5]/[0.74]">
              The same operating model shows up differently depending on the role: AI adoption, operations transformation or strategic project execution.
            </p>
            <div class="mt-7 flex flex-wrap gap-2 print:hidden" role="tablist" aria-label="Role lens selector">
              {roleLenses.map((lens, index) => (
                <button
                  type="button"
                  role="tab"
                  data-role-trigger={lens.id}
                  class:list={[
                    'rounded-xl border px-4 py-2 text-left text-sm font-semibold transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#96b391]',
                    index === 0 ? 'border-[#96b391]/[0.5] bg-[#96b391] text-[#121713]' : 'border-white/10 bg-white/[0.055] text-[#d8d2c5]/[0.78] hover:border-[#96b391]/[0.42] hover:text-[#f3efe5]',
                  ]}
                  aria-selected={index === 0 ? 'true' : 'false'}
                >
                  {lens.label}
                </button>
              ))}
            </div>
          </aside>

          <div class="grid gap-4">
            {roleLenses.map((lens, index) => (
              <article
                id={`lens-${lens.id}`}
                data-role-card={lens.id}
                class:list={[
                  'rounded-[1.45rem] border bg-[#f3efe5]/[0.055] p-6 transition md:p-7',
                  index === 0 ? 'border-[#96b391]/[0.42] shadow-[0_22px_70px_rgba(0,0,0,0.18)]' : 'border-white/10',
                ]}
              >
                <p class="font-mono text-[0.68rem] uppercase tracking-[0.18em] text-[#96b391]">{lens.eyebrow}</p>
                <h3 class="mt-4 font-display text-3xl font-semibold leading-tight text-[#f3efe5] md:text-4xl">{lens.headline}</h3>
                <p class="mt-5 max-w-3xl text-base leading-relaxed text-[#d8d2c5]/[0.78] md:text-lg">{lens.summary}</p>
                <ul class="mt-6 grid gap-3 text-sm leading-relaxed text-[#d8d2c5]/[0.76] md:grid-cols-2">
                  {lens.valueBullets.map((bullet) => (
                    <li class="rounded-xl border border-white/10 bg-[#121713]/[0.42] px-4 py-3">{bullet}</li>
                  ))}
                </ul>
                <div class="mt-6">
                  <p class="font-mono text-[0.68rem] uppercase tracking-[0.18em] text-[#96b391]">Proof to inspect first</p>
                  <div class="mt-3 flex flex-wrap gap-2">
                    {lens.proofIds.map((proofId) => {
                      const proof = proofCards.find((card) => card.id === proofId);
                      return proof ? (
                        <a href={`#proof-${proof.id}`} class="rounded-full border border-[#96b391]/20 bg-[#96b391]/[0.09] px-3 py-2 text-xs font-semibold text-[#d8d2c5]/[0.8] transition hover:border-[#96b391]/[0.5] hover:text-[#f3efe5]">
                          {proof.title}
                        </a>
                      ) : null;
                    })}
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="proof-library" class="border-y border-white/10 bg-[#171d18] px-5 py-14 sm:px-6 md:py-20">
      <div class="mx-auto max-w-7xl">
        <div class="mb-9 grid gap-6 lg:grid-cols-[0.8fr_1.2fr] lg:items-end">
          <div>
            <p class="font-mono text-xs uppercase tracking-[0.2em] text-[#96b391]">Proof library</p>
            <h2 class="mt-4 font-display text-4xl font-semibold leading-[1.02] text-[#f3efe5] md:text-6xl">
              Concrete examples, not generic claims.
            </h2>
          </div>
          <div class="flex flex-wrap gap-2 print:hidden" aria-label="Proof filters">
            <button type="button" data-proof-filter="all" aria-pressed="true" class="rounded-xl border border-[#96b391]/[0.5] bg-[#96b391] px-4 py-2 text-sm font-semibold text-[#121713] transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#96b391]">
              All proof
            </button>
            {proofFilters.map((filter) => (
              <button type="button" data-proof-filter={filter} aria-pressed="false" class="rounded-xl border border-white/10 bg-white/[0.055] px-4 py-2 text-sm font-semibold text-[#d8d2c5]/[0.78] transition hover:border-[#96b391]/[0.42] hover:text-[#f3efe5] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#96b391]">
                {filter}
              </button>
            ))}
          </div>
        </div>

        <div class="grid gap-4 lg:grid-cols-2">
          {proofCards.map((card, index) => (
            <article id={`proof-${card.id}`} data-proof-card data-categories={card.categories.join('|')} class="proof-card rounded-[1.45rem] border border-white/10 bg-[#f3efe5]/[0.052] p-6 transition hover:border-[#96b391]/[0.38] hover:bg-[#f3efe5]/[0.07] md:p-7">
              <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                <div>
                  <p class="font-mono text-[0.68rem] uppercase tracking-[0.18em] text-[#96b391]">{String(index + 1).padStart(2, '0')}</p>
                  <h3 class="mt-4 font-display text-2xl font-semibold leading-tight text-[#f3efe5] md:text-3xl">{card.title}</h3>
                </div>
                <div class="flex flex-wrap gap-2 sm:justify-end">
                  {card.categories.slice(0, 3).map((category) => (
                    <span class="rounded-full border border-[#96b391]/20 bg-[#96b391]/[0.09] px-3 py-1.5 font-mono text-[0.62rem] uppercase tracking-[0.14em] text-[#d8d2c5]/[0.76]">
                      {category}
                    </span>
                  ))}
                </div>
              </div>
              <div class="mt-6 grid gap-3">
                {[
                  ['Problem spotted', card.problem],
                  ['Built / did', card.built],
                  ['Value demonstrated', card.value],
                  ['Recruiter takeaway', card.takeaway],
                ].map(([label, text]) => (
                  <div class="grid gap-3 rounded-2xl border border-white/10 bg-[#121713]/[0.45] p-4 sm:grid-cols-[10rem_1fr]">
                    <p class="font-mono text-[0.68rem] uppercase tracking-[0.18em] text-[#96b391]">{label}</p>
                    <p class="text-sm leading-relaxed text-[#d8d2c5]/[0.78]">{text}</p>
                  </div>
                ))}
                {card.talkTrack && (
                  <p class="rounded-2xl border border-[#96b391]/[0.22] bg-[#96b391]/[0.08] p-4 text-sm leading-relaxed text-[#d8d2c5]/[0.82]">
                    <span class="font-semibold text-[#f3efe5]">Talk track:</span> {card.talkTrack}
                  </p>
                )}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="px-5 py-14 sm:px-6 md:py-20">
      <div class="mx-auto max-w-7xl">
        <div class="grid gap-8 lg:grid-cols-[0.75fr_1.25fr]">
          <aside>
            <p class="font-mono text-xs uppercase tracking-[0.2em] text-[#96b391]">If I were a company</p>
            <h2 class="mt-4 max-w-xl font-display text-4xl font-semibold leading-[1.02] text-[#f3efe5] md:text-6xl">
              This would be the operating model.
            </h2>
          </aside>
          <div class="grid gap-4 md:grid-cols-2">
            {operatingModel.map(([title, text]) => (
              <article class="rounded-[1.35rem] border border-white/10 bg-[#f3efe5]/[0.052] p-6">
                <p class="font-mono text-[0.68rem] uppercase tracking-[0.18em] text-[#96b391]">{title}</p>
                <p class="mt-4 text-lg font-semibold leading-snug text-[#f3efe5]">{text}</p>
              </article>
            ))}
            <article class="rounded-[1.35rem] border border-white/10 bg-[#b95a54]/[0.08] p-6 md:col-span-2">
              <p class="font-mono text-[0.68rem] uppercase tracking-[0.18em] text-[#d99b90]">Bad fit</p>
              <p class="mt-4 text-lg font-semibold leading-snug text-[#f3efe5]">
                Big strategy theatre, tool-first AI, workshops without output, automating chaos and corporate performance art.
              </p>
            </article>
          </div>
        </div>
      </div>
    </section>

    <section id="workflow-demo" class="border-y border-white/10 bg-[#171d18] px-5 py-14 sm:px-6 md:py-20">
      <div class="mx-auto grid max-w-7xl gap-8 lg:grid-cols-[0.72fr_1.28fr] lg:items-start">
        <aside class="lg:sticky lg:top-28">
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-[#96b391]">Workflow thinking demo</p>
          <h2 class="mt-4 font-display text-4xl font-semibold leading-[1.02] text-[#f3efe5] md:text-6xl">
            Click a messy workflow. See the first move.
          </h2>
          <p class="mt-5 max-w-xl text-base leading-relaxed text-[#d8d2c5]/[0.74]">
            Rule-based and front-end only. No external AI API. The point is to show the operating logic: trigger, input, AI role, human approval and measurement.
          </p>
        </aside>

        <div class="grid gap-5">
          <div class="grid gap-4 rounded-[1.45rem] border border-white/10 bg-[#f3efe5]/[0.052] p-5 md:p-6">
            {[
              ['Workflow type', workflowTypes, 'workflow'],
              ['Frequency', frequencies, 'frequency'],
              ['Pain', painTypes, 'pain'],
              ['Risk level', riskLevels, 'risk'],
            ].map(([label, values, key]) => (
              <div>
                <p class="font-mono text-[0.68rem] uppercase tracking-[0.18em] text-[#96b391]">{label}</p>
                <div class="mt-3 flex flex-wrap gap-2" role="group" aria-label={label}>
                  {(values as string[]).map((value, index) => (
                    <button
                      type="button"
                      data-workflow-option={key}
                      data-value={value}
                      class:list={[
                        'rounded-xl border px-4 py-2 text-sm font-semibold transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#96b391]',
                        index === 0 ? 'border-[#96b391]/[0.5] bg-[#96b391] text-[#121713]' : 'border-white/10 bg-[#121713]/[0.4] text-[#d8d2c5]/[0.78] hover:border-[#96b391]/[0.42] hover:text-[#f3efe5]',
                      ]}
                      aria-pressed={index === 0 ? 'true' : 'false'}
                    >
                      {value}
                    </button>
                  ))}
                </div>
              </div>
            ))}
          </div>

          <article class="rounded-[1.45rem] border border-[#96b391]/[0.32] bg-[#96b391]/[0.09] p-6 md:p-7" aria-live="polite">
            <p class="font-mono text-[0.68rem] uppercase tracking-[0.18em] text-[#96b391]">Suggested workflow map</p>
            <h3 data-workflow-title class="mt-4 font-display text-3xl font-semibold leading-tight text-[#f3efe5]">
              Status reporting, daily, time pain, low risk
            </h3>
            <div class="mt-6 grid gap-3">
              <div class="grid gap-3 rounded-2xl border border-white/10 bg-[#121713]/[0.45] p-4 sm:grid-cols-[11rem_1fr]">
                <p class="font-mono text-[0.68rem] uppercase tracking-[0.18em] text-[#96b391]">First step</p>
                <p data-workflow-first class="text-sm leading-relaxed text-[#d8d2c5]/[0.78]">Map fixed inputs and recurring decision points.</p>
              </div>
              <div class="grid gap-3 rounded-2xl border border-white/10 bg-[#121713]/[0.45] p-4 sm:grid-cols-[11rem_1fr]">
                <p class="font-mono text-[0.68rem] uppercase tracking-[0.18em] text-[#96b391]">AI role</p>
                <p data-workflow-ai class="text-sm leading-relaxed text-[#d8d2c5]/[0.78]">Summarize, classify, extract actions and draft the next step.</p>
              </div>
              <div class="grid gap-3 rounded-2xl border border-white/10 bg-[#121713]/[0.45] p-4 sm:grid-cols-[11rem_1fr]">
                <p class="font-mono text-[0.68rem] uppercase tracking-[0.18em] text-[#96b391]">Human approval</p>
                <p data-workflow-approval class="text-sm leading-relaxed text-[#d8d2c5]/[0.78]">Owner reviews before anything is sent or updated.</p>
              </div>
              <div class="grid gap-3 rounded-2xl border border-white/10 bg-[#121713]/[0.45] p-4 sm:grid-cols-[11rem_1fr]">
                <p class="font-mono text-[0.68rem] uppercase tracking-[0.18em] text-[#96b391]">Measure</p>
                <p data-workflow-measure class="text-sm leading-relaxed text-[#d8d2c5]/[0.78]">Time saved, fewer follow-ups, clearer ownership and faster decisions.</p>
              </div>
              <div class="grid gap-3 rounded-2xl border border-white/10 bg-[#121713]/[0.45] p-4 sm:grid-cols-[11rem_1fr]">
                <p class="font-mono text-[0.68rem] uppercase tracking-[0.18em] text-[#96b391]">Candidate quality</p>
                <p data-workflow-fit class="text-sm leading-relaxed text-[#d8d2c5]/[0.78]">Good first AI candidate if inputs are recurring and ownership is clear.</p>
              </div>
            </div>
          </article>
