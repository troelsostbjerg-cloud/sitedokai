---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AIFitChecker from '../components/lab/AIFitChecker.astro';
import MethodStepper from '../components/lab/MethodStepper.astro';
import { absoluteUrl, siteBaseUrl } from '../data/labContent';
import '../styles/global.css';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${siteBaseUrl}/method#webpage`,
  url: absoluteUrl('/method'),
  name: 'Method - SiteDokAILab',
  description:
    'The SiteDokAILab method: Mess, Map, Simplify, Assist, Approve and Measure.',
  inLanguage: 'en',
};
---

<Layout
  title="Method - SiteDokAILab"
  description="How Troels reviews workflows: Mess, Map, Simplify, Assist, Approve and Measure."
  canonical="/method"
  structuredData={structuredData}
>
  <Nav />
  <main id="main" class="bg-canvas text-brand">
    <section class="border-b border-brand/10 px-5 py-16 sm:px-6 md:py-24">
      <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[0.82fr_1.18fr] lg:items-end">
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.22em] text-accent">Method</p>
          <h1 class="mt-6 max-w-4xl font-display text-4xl font-semibold leading-[1.02] text-brand sm:text-5xl md:text-7xl">
            Mess. Map. Simplify. Assist. Approve. Measure.
          </h1>
        </div>
        <p class="max-w-2xl text-xl leading-relaxed text-brand/70">
          Start with the workflow, not the tool. If the process is unclear, AI will not save it. It will just make the confusion look more modern.
        </p>
      </div>
    </section>

    <section class="px-5 py-16 sm:px-6 md:py-24">
      <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[0.65fr_1.35fr]">
        <aside>
          <p class="font-mono text-xs uppercase tracking-[0.22em] text-accent">Review framework</p>
          <h2 class="mt-5 max-w-xl font-display text-4xl font-semibold leading-[1.02] text-brand md:text-5xl">
            The boring sequence that prevents bad automation.
          </h2>
          <p class="mt-6 max-w-xl text-base leading-relaxed text-brand/68">
            AI belongs after the work is visible. That means mapping reality, simplifying what can be removed, and making the approval point explicit.
          </p>
        </aside>
        <MethodStepper />
      </div>
    </section>

    <section class="border-y border-brand/10 bg-canvas-soft px-5 py-16 sm:px-6 md:py-24">
      <div class="mx-auto max-w-7xl">
        <AIFitChecker />
      </div>
    </section>

    <section class="px-5 py-14 sm:px-6">
      <div class="mx-auto flex max-w-7xl flex-col gap-5 rounded-[1.35rem] border border-brand/10 bg-panel p-6 md:flex-row md:items-center md:justify-between">
        <div>
          <h2 class="text-2xl font-semibold text-brand">Want me to apply this to your process?</h2>
          <p class="mt-2 max-w-2xl text-sm leading-relaxed text-brand/66">
            Send the recurring work. Keep the sensitive data out. The review starts with friction, not tool choice.
          </p>
        </div>
        <a href="/submit" class="inline-flex min-h-12 w-fit items-center justify-center rounded-xl border border-accent/50 bg-accent px-6 py-3 text-sm font-semibold text-canvas transition-colors hover:bg-accent-bright focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent active:translate-y-px">
          Submit a workflow
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
