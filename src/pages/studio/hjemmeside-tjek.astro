---
import Layout from '../../layouts/Layout.astro';
import '../../styles/global.css';

const statusOptions = ['Ikke startet', 'Under analyse', 'Klar til review', 'Færdig'];
const recommendationOptions = [
  'Kun små tekstrettelser',
  'Hjemmeside-fix',
  'Visuelt løft',
  'Ny struktur anbefales',
  'Ny hjemmeside bør overvejes',
];
---

<Layout
  title="Internt Hjemmeside-tjek studio | SiteDokAI"
  description="Internt audit-studio til manuelle SiteDokAI Hjemmeside-tjek."
  canonical="/studio/hjemmeside-tjek"
  noindex={true}
>
  <main id="main" class="min-h-screen bg-canvas px-4 py-6 text-brand sm:px-6 lg:px-10">
    <div class="mx-auto max-w-[1480px]">
      <header class="rounded-[1.6rem] border border-border-soft bg-surface/86 p-6 shadow-soft md:p-8">
        <div class="grid gap-6 lg:grid-cols-[1fr_auto] lg:items-center">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.28em] text-accent-dark">Internt værktøj</p>
            <h1 class="mt-4 font-display text-4xl font-medium leading-[1.02] tracking-tight text-brand md:text-6xl">
              Hjemmeside-tjek studio
            </h1>
            <p class="mt-4 max-w-3xl text-base leading-relaxed text-muted md:text-lg">
              Et manuelt audit-værktøj til at oprette, redigere og kvalitetssikre professionelle Hjemmeside-tjek til små danske servicevirksomheder.
            </p>
          </div>
          <div class="flex flex-wrap gap-3">
            <button type="button" data-action="show-dashboard" class="inline-flex items-center justify-center rounded-[0.9rem] border border-accent bg-accent px-5 py-3 text-sm font-semibold text-white transition hover:border-accent-dark hover:bg-accent-dark">
              Dashboard
            </button>
            <button type="button" data-action="show-create" class="inline-flex items-center justify-center rounded-[0.9rem] border border-border-soft bg-white px-5 py-3 text-sm font-semibold text-brand transition hover:border-accent/35 hover:bg-accent-soft">
              Opret nyt tjek
            </button>
          </div>
        </div>
        <div class="mt-6 grid gap-3 md:grid-cols-3">
          <div class="rounded-[1rem] border border-accent/18 bg-accent-soft/55 px-4 py-3 text-sm leading-relaxed text-brand/76">Data gemmes lokalt i denne browser via localStorage.</div>
          <div class="rounded-[1rem] border border-accent/18 bg-accent-soft/55 px-4 py-3 text-sm leading-relaxed text-brand/76">Ingen crawler, AI-generering eller ekstern sending i MVP’en.</div>
          <div class="rounded-[1rem] border border-accent/18 bg-accent-soft/55 px-4 py-3 text-sm leading-relaxed text-brand/76">Fokus: klarhed, tillid, handling og flere henvendelser.</div>
        </div>
      </header>

      <section id="dashboard-view" class="mt-6 rounded-[1.45rem] border border-border-soft bg-white/72 p-5 shadow-soft md:p-7">
        <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.24em] text-accent-dark">Dashboard</p>
            <h2 class="mt-3 font-display text-3xl font-medium tracking-tight text-brand md:text-4xl">Hjemmeside-tjek</h2>
            <p class="mt-2 text-sm leading-relaxed text-muted">Oversigt over kunder, status og næste tjek der skal åbnes.</p>
          </div>
          <button type="button" data-action="show-create" class="inline-flex items-center justify-center rounded-[0.9rem] border border-accent bg-accent px-5 py-3 text-sm font-semibold text-white transition hover:border-accent-dark hover:bg-accent-dark">
            Opret nyt Hjemmeside-tjek
          </button>
        </div>

        <div id="dashboard-list" class="mt-6"></div>
      </section>

      <section id="create-view" class="mt-6 hidden rounded-[1.45rem] border border-border-soft bg-white/72 p-5 shadow-soft md:p-7">
        <div class="mb-6 flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.24em] text-accent-dark">Nyt tjek</p>
            <h2 class="mt-3 font-display text-3xl font-medium tracking-tight text-brand md:text-4xl">Opret Hjemmeside-tjek</h2>
            <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted">Start med kundeinfo. Alt kan redigeres bagefter i rapport-editoren.</p>
          </div>
          <button type="button" data-action="show-dashboard" class="rounded-[0.85rem] border border-border-soft bg-surface px-4 py-2.5 text-sm font-semibold text-brand hover:border-accent/35">
            Tilbage til dashboard
          </button>
        </div>

        <form id="create-form" class="grid gap-4">
          <div class="grid gap-4 md:grid-cols-2">
            <label class="grid gap-2 text-sm font-semibold text-brand">Kundenavn *
              <input name="clientName" required class="rounded-[0.95rem] border border-border-soft bg-surface px-4 py-3 font-normal text-brand outline-none transition focus:border-accent focus:ring-2 focus:ring-accent/16" />
            </label>
            <label class="grid gap-2 text-sm font-semibold text-brand">Website-URL *
              <input name="website" required inputmode="url" placeholder="https://dinvirksomhed.dk" class="rounded-[0.95rem] border border-border-soft bg-surface px-4 py-3 font-normal text-brand outline-none transition focus:border-accent focus:ring-2 focus:ring-accent/16" />
            </label>
          </div>

          <div class="grid gap-4 md:grid-cols-2">
            <label class="grid gap-2 text-sm font-semibold text-brand">Branche
              <input name="industry" placeholder="Fx VVS, klinik, maler" class="rounded-[0.95rem] border border-border-soft bg-surface px-4 py-3 font-normal text-brand outline-none transition focus:border-accent focus:ring-2 focus:ring-accent/16" />
            </label>
            <label class="grid gap-2 text-sm font-semibold text-brand">Lokation
              <input name="location" placeholder="Fx Odense, Aarhus, Sjælland" class="rounded-[0.95rem] border border-border-soft bg-surface px-4 py-3 font-normal text-brand outline-none transition focus:border-accent focus:ring-2 focus:ring-accent/16" />
            </label>
          </div>

          <div class="grid gap-4 md:grid-cols-2">
            <label class="grid gap-2 text-sm font-semibold text-brand">Primære ydelser
              <textarea name="primaryServices" rows="4" placeholder="Fx akut VVS, badeværelser, serviceaftaler" class="resize-y rounded-[0.95rem] border border-border-soft bg-surface px-4 py-3 font-normal text-brand outline-none transition focus:border-accent focus:ring-2 focus:ring-accent/16"></textarea>
            </label>
            <label class="grid gap-2 text-sm font-semibold text-brand">Målgruppe
              <textarea name="targetAudience" rows="4" placeholder="Fx private boligejere, erhverv, lokale kunder" class="resize-y rounded-[0.95rem] border border-border-soft bg-surface px-4 py-3 font-normal text-brand outline-none transition focus:border-accent focus:ring-2 focus:ring-accent/16"></textarea>
            </label>
          </div>

          <label class="grid gap-2 text-sm font-semibold text-brand">Noter fra kunden
            <textarea name="customerNotes" rows="5" placeholder="Hvad skal siden især hjælpe med? Hvad er kunden i tvivl om?" class="resize-y rounded-[0.95rem] border border-border-soft bg-surface px-4 py-3 font-normal text-brand outline-none transition focus:border-accent focus:ring-2 focus:ring-accent/16"></textarea>
          </label>

          <div class="flex flex-wrap gap-3 pt-2">
            <button type="submit" class="inline-flex items-center justify-center rounded-[0.9rem] border border-accent bg-accent px-6 py-3.5 text-sm font-semibold text-white transition hover:border-accent-dark hover:bg-accent-dark">
              Opret og åbn editor
            </button>
            <button type="button" data-action="show-dashboard" class="inline-flex items-center justify-center rounded-[0.9rem] border border-border-soft bg-white px-6 py-3.5 text-sm font-semibold text-brand transition hover:border-accent/35 hover:bg-accent-soft">
              Annullér
            </button>
          </div>
        </form>
      </section>

      <section id="editor-view" class="mt-6 hidden">
        <div id="editor-shell"></div>
      </section>

      <section id="report-view" class="mt-6 hidden">
        <div id="report-shell"></div>
      </section>

      <section id="video-view" class="mt-6 hidden">
        <div id="video-shell"></div>
      </section>
    </div>
  </main>

  <style is:global>
    .report-page {
      color: #202622;
    }

    .report-cover {
      min-height: auto;
    }

    .report-section,
    .report-card,
    .report-problem,
    .report-hero-preview {
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .report-score-bar {
      height: 0.65rem;
      overflow: hidden;
      border-radius: 999px;
      background: #e8ded0;
    }

    .report-score-fill {
      height: 100%;
      border-radius: 999px;
      background: linear-gradient(90deg, #6f8a72 0%, #435c47 100%);
    }

    .video-script-body {
      min-height: 62vh;
      line-height: 1.78;
    }

    @media print {
      @page {
        size: A4;
        margin: 14mm;
      }

      html,
      body {
        background: #ffffff !important;
      }

      body {
        color: #202622 !important;
        padding-bottom: 0 !important;
      }

      body > header,
      body > footer,
      footer,
      #cookie-banner,
      .cookie-banner,
      [data-cookie-banner],
      main > div > header,
      #dashboard-view,
      #create-view,
      #editor-view,
      #video-view,
      .report-warning,
      .report-actions {
        display: none !important;
      }

      main {
        min-height: auto !important;
        background: #ffffff !important;
        padding: 0 !important;
      }

      main > div {
        max-width: none !important;
        margin: 0 !important;
      }

      #report-view {
        display: block !important;
        margin: 0 !important;
      }

      .report-page {
        width: 100% !important;
        margin: 0 !important;
        border: 0 !important;
        border-radius: 0 !important;
        background: #ffffff !important;
        box-shadow: none !important;
      }

      .report-section {
        margin-top: 18mm !important;
      }

      .report-cover {
        min-height: auto !important;
        padding-top: 4mm !important;
      }

      .report-problem {
        margin-top: 7mm !important;
      }

      a {
        color: inherit !important;
        text-decoration: none !important;
      }
    }
  </style>

  <script is:inline define:vars={{ statusOptions, recommendationOptions }}>
    (function () {
      const STORAGE_KEY = 'sitedokai.websiteChecks.v1';
      const STATUS_OPTIONS = statusOptions;
      const RECOMMENDATION_OPTIONS = recommendationOptions;
      const EFFECT_OPTIONS = ['Flere henvendelser', 'Mere tillid', 'Bedre klarhed', 'Mere handling'];
      const PRIORITY_OPTIONS = ['Høj', 'Medium', 'Lav'];

      const dashboardView = document.getElementById('dashboard-view');
      const createView = document.getElementById('create-view');
      const editorView = document.getElementById('editor-view');
      const reportView = document.getElementById('report-view');
      const videoView = document.getElementById('video-view');
      const dashboardList = document.getElementById('dashboard-list');
      const editorShell = document.getElementById('editor-shell');
      const reportShell = document.getElementById('report-shell');
      const videoShell = document.getElementById('video-shell');
      const createForm = document.getElementById('create-form');

      const emptyIssue = () => ({ title: '', why: '', change: '', priority: 'Medium', effect: 'Flere henvendelser' });

      const defaultCheck = (form) => {
        const id = typeof crypto !== 'undefined' && crypto.randomUUID ? crypto.randomUUID() : String(Date.now());
        return {
          id,
          createdAt: new Date().toISOString(),
          updatedAt: new Date().toISOString(),
          status: 'Ikke startet',
          client: {
            name: form.clientName || '',
            website: normalizeWebsite(form.website || ''),
            industry: form.industry || '',
            location: form.location || '',
            primaryServices: form.primaryServices || '',
            targetAudience: form.targetAudience || '',
            notes: form.customerNotes || '',
          },
          firstImpression: {
            fiveSecondUnderstanding: '',
            serviceClarity: '',
            audienceClarity: '',
            nextActionClarity: '',
          },
          scores: {
            clarity: 50,
            trust: 50,
            visibility: 50,
          },
          issues: [emptyIssue(), emptyIssue(), emptyIssue(), emptyIssue(), emptyIssue()],
          heroSuggestion: {
            headline: '',
            subtext: '',
            primaryCta: 'Kontakt os',
            secondaryCta: 'Se ydelser',
            rationale: '',
          },
          serviceStructure: {
            primaryPages: '',
            secondaryPages: '',
            homepageBlocks: '',
            faqTopics: '',
            contactSection: '',
          },
          recommendation: 'Hjemmeside-fix',
          report: {
            summary: '',
            closingCta: '',
          },
          videoScript: {
            body: '',
            updatedAt: '',
          },
        };
      };

      let state = loadState();
      let activeId = state.checks[0]?.id || null;

      function loadState() {
        try {
          const parsed = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
          return { checks: Array.isArray(parsed.checks) ? parsed.checks : [] };
        } catch (error) {
          return { checks: [] };
        }
      }

      function saveState() {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
      }

      function normalizeWebsite(value) {
        const trimmed = String(value || '').trim();
        if (!trimmed) return '';
        return /^[a-zA-Z][a-zA-Z\d+\-.]*:\/\//.test(trimmed) ? trimmed : `https://${trimmed.replace(/^\/+/, '')}`;
      }

      function escapeHtml(value) {
        return String(value ?? '')
          .replaceAll('&', '&amp;')
          .replaceAll('<', '&lt;')
          .replaceAll('>', '&gt;')
          .replaceAll('"', '&quot;')
          .replaceAll("'", '&#039;');
      }

      function cleanText(value) {
        return String(value ?? '').replace(/\s+/g, ' ').trim();
      }

      function isPlaceholderText(value) {
        const text = cleanText(value).toLowerCase();
        if (!text) return false;
        return [
          /^problem\s+\d+\s+mangler titel$/,
          /udfyld hvorfor dette kan koste henvendelser/,
          /udfyld den konkrete ændring kunden bør prioritere/,
          /^skriv en tydelig overskrift her$/,
          /^skriv en kort undertekst/,
          /^hovedydelse\s+\d+$/,
        ].some((pattern) => pattern.test(text));
      }

      function hasRealText(value) {
        return cleanText(value).length > 0 && !isPlaceholderText(value);
      }

      function textOrFallback(value, fallback = 'Denne sektion er endnu ikke udfyldt.') {
        const clean = String(value ?? '').trim();
        return hasRealText(clean) ? clean : fallback;
      }

      function scoreIsFilled(value) {
        const score = Number(value);
        return Number.isFinite(score) && score >= 1 && score <= 100;
      }

      function formatDate(value) {
        if (!value) return '—';
        try {
          return new Intl.DateTimeFormat('da-DK', { dateStyle: 'medium' }).format(new Date(value));
        } catch (error) {
          return String(value).slice(0, 10);
        }
      }

      function getActiveCheck() {
        return state.checks.find((check) => check.id === activeId) || null;
      }

      function getByPath(target, path) {
        return path.split('.').reduce((current, key) => current?.[key], target);
      }

      function setByPath(target, path, value) {
        const parts = path.split('.');
        const finalKey = parts.pop();
        const parent = parts.reduce((current, key) => current[key], target);
        parent[finalKey] = value;
      }

      function optionList(options, selected) {
        return options.map((option) => `<option value="${escapeHtml(option)}" ${option === selected ? 'selected' : ''}>${escapeHtml(option)}</option>`).join('');
      }

      function show(view) {
        dashboardView.classList.toggle('hidden', view !== 'dashboard');
        createView.classList.toggle('hidden', view !== 'create');
        editorView.classList.toggle('hidden', view !== 'editor');
        reportView.classList.toggle('hidden', view !== 'report');
        videoView.classList.toggle('hidden', view !== 'video');
        if (view === 'dashboard') renderDashboard();
        if (view === 'editor') renderEditor();
        if (view === 'report') renderReport();
        if (view === 'video') renderVideoScript();
        if (view === 'report') {
          window.history.replaceState(null, '', '#rapport');
        } else if (view === 'video') {
          window.history.replaceState(null, '', '#video-script');
        } else if (window.location.hash === '#rapport' || window.location.hash === '#video-script') {
          window.history.replaceState(null, '', window.location.pathname);
        }
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }

      function statusTone(status) {
        if (status === 'Færdig') return 'bg-accent-soft text-accent-dark border-accent/20';
        if (status === 'Klar til review') return 'bg-white text-brand border-accent/28';
        if (status === 'Under analyse') return 'bg-[#fff7e8] text-[#7a4b12] border-[#e4c98f]';
        return 'bg-surface text-muted border-border-soft';
      }

      function renderDashboard() {
        if (!dashboardList) return;
        if (!state.checks.length) {
          dashboardList.innerHTML = `
            <div class="rounded-[1.25rem] border border-dashed border-accent/28 bg-accent-soft/38 p-8 text-center">
              <h3 class="font-display text-3xl font-medium text-brand">Ingen hjemmeside-tjek endnu.</h3>
              <p class="mx-auto mt-3 max-w-xl text-sm leading-relaxed text-muted">Opret første tjek, så kan du udfylde scores, problemer, hero-forslag og anbefalet næste skridt manuelt.</p>
              <button type="button" data-action="show-create" class="mt-6 inline-flex items-center justify-center rounded-[0.9rem] border border-accent bg-accent px-5 py-3 text-sm font-semibold text-white transition hover:border-accent-dark hover:bg-accent-dark">Opret første tjek</button>
            </div>`;
          return;
        }

        const rows = state.checks
          .slice()
          .sort((a, b) => String(b.updatedAt || b.createdAt).localeCompare(String(a.updatedAt || a.createdAt)))
          .map((check) => `
            <article class="grid gap-4 rounded-[1.15rem] border border-border-soft bg-surface/72 p-5 md:grid-cols-[1.1fr_1fr_0.8fr_0.7fr_auto] md:items-center">
              <div>
                <h3 class="font-display text-2xl font-medium tracking-tight text-brand">${escapeHtml(check.client?.name || 'Uden navn')}</h3>
                <a href="${escapeHtml(check.client?.website || '#')}" target="_blank" rel="noreferrer" class="mt-1 block break-all text-sm font-semibold text-accent-dark underline decoration-accent/35 underline-offset-4">${escapeHtml(check.client?.website || 'Intet website')}</a>
              </div>
              <div class="text-sm leading-relaxed text-muted">
                <div><span class="font-semibold text-brand/74">Branche:</span> ${escapeHtml(check.client?.industry || '—')}</div>
                <div><span class="font-semibold text-brand/74">Lokation:</span> ${escapeHtml(check.client?.location || '—')}</div>
              </div>
              <div>
                <span class="inline-flex rounded-full border px-3 py-1.5 text-xs font-bold ${statusTone(check.status)}">${escapeHtml(check.status || 'Ikke startet')}</span>
              </div>
              <div class="text-sm text-muted">${formatDate(check.createdAt)}</div>
              <div class="flex flex-wrap gap-2">
                <button type="button" data-action="open-check" data-id="${escapeHtml(check.id)}" class="inline-flex items-center justify-center rounded-[0.85rem] border border-accent bg-accent px-4 py-2.5 text-sm font-semibold text-white transition hover:border-accent-dark hover:bg-accent-dark">Åbn tjek</button>
                <button type="button" data-action="show-report" data-id="${escapeHtml(check.id)}" class="inline-flex items-center justify-center rounded-[0.85rem] border border-border-soft bg-white px-4 py-2.5 text-sm font-semibold text-brand transition hover:border-accent/35 hover:bg-accent-soft">Rapport</button>
              </div>
            </article>
          `)
          .join('');

        dashboardList.innerHTML = `<div class="grid gap-3">${rows}</div>`;
      }

      function inputField(label, path, options = {}) {
        const check = getActiveCheck();
        const value = getByPath(check, path) ?? '';
        const type = options.type || 'text';
        const help = options.help ? `<p class="text-xs leading-relaxed text-muted">${escapeHtml(options.help)}</p>` : '';
        if (options.textarea) {
          return `
            <label class="grid gap-2 text-sm font-semibold text-brand">${escapeHtml(label)}
              <textarea rows="${options.rows || 4}" data-path="${escapeHtml(path)}" class="resize-y rounded-[0.95rem] border border-border-soft bg-surface px-4 py-3 font-normal text-brand outline-none transition focus:border-accent focus:ring-2 focus:ring-accent/16">${escapeHtml(value)}</textarea>
              ${help}
            </label>`;
        }
        return `
          <label class="grid gap-2 text-sm font-semibold text-brand">${escapeHtml(label)}
            <input type="${type}" min="${options.min || ''}" max="${options.max || ''}" data-path="${escapeHtml(path)}" value="${escapeHtml(value)}" class="rounded-[0.95rem] border border-border-soft bg-surface px-4 py-3 font-normal text-brand outline-none transition focus:border-accent focus:ring-2 focus:ring-accent/16" />
            ${help}
          </label>`;
      }

      function selectField(label, path, options) {
        const check = getActiveCheck();
        const value = getByPath(check, path) ?? '';
        return `
          <label class="grid gap-2 text-sm font-semibold text-brand">${escapeHtml(label)}
            <select data-path="${escapeHtml(path)}" class="rounded-[0.95rem] border border-border-soft bg-surface px-4 py-3 font-normal text-brand outline-none transition focus:border-accent focus:ring-2 focus:ring-accent/16">
              ${optionList(options, value)}
            </select>
          </label>`;
      }

      function card(title, body, note = '') {
        return `
          <section class="rounded-[1.25rem] border border-border-soft bg-white/76 p-5 shadow-[0_14px_36px_rgba(32,38,34,0.035)] md:p-6">
            <div class="mb-5">
              <h3 class="font-display text-3xl font-medium tracking-tight text-brand">${escapeHtml(title)}</h3>
              ${note ? `<p class="mt-2 text-sm leading-relaxed text-muted">${escapeHtml(note)}</p>` : ''}
            </div>
            ${body}
          </section>`;
      }

      function renderIssues(check) {
        return check.issues.map((issue, index) => `
          <article class="rounded-[1.1rem] border border-border-soft bg-surface/72 p-4">
            <div class="mb-4 flex items-center justify-between gap-3">
              <h4 class="font-display text-2xl font-medium text-brand">Problem ${index + 1}</h4>
              <span class="rounded-full border border-accent/18 bg-accent-soft px-3 py-1 text-xs font-bold text-accent-dark">Top 5</span>
            </div>
            <div class="grid gap-4 md:grid-cols-2">
              ${inputField('Titel', `issues.${index}.title`)}
              ${selectField('Prioritet', `issues.${index}.priority`, PRIORITY_OPTIONS)}
            </div>
            <div class="mt-4 grid gap-4 md:grid-cols-2">
              ${inputField('Hvorfor det er et problem', `issues.${index}.why`, { textarea: true, rows: 4 })}
              ${inputField('Hvad der bør ændres', `issues.${index}.change`, { textarea: true, rows: 4 })}
            </div>
            <div class="mt-4">
              ${selectField('Forventet effekt', `issues.${index}.effect`, EFFECT_OPTIONS)}
            </div>
          </article>
        `).join('');
      }

      function isCompleteIssue(issue) {
        return Boolean(issue && hasRealText(issue.title) && hasRealText(issue.why) && hasRealText(issue.change));
      }

      function getCompleteIssues(check) {
        return (check?.issues || []).filter(isCompleteIssue);
      }

      function checkReportReadiness(check) {
        const client = check?.client || {};
        const scores = check?.scores || {};
        const hero = check?.heroSuggestion || {};
        const structure = check?.serviceStructure || {};
        const completeIssues = getCompleteIssues(check);
        const items = [
          { key: 'client', label: 'Kundeinfo udfyldt', ok: hasRealText(client.name) && hasRealText(client.website) && hasRealText(client.industry) && hasRealText(client.location) },
          { key: 'scores', label: 'Scores udfyldt', ok: scoreIsFilled(scores.clarity) && scoreIsFilled(scores.trust) && scoreIsFilled(scores.visibility) },
          { key: 'issues', label: 'Mindst 3 problemer udfyldt', ok: completeIssues.length >= 3 },
          { key: 'hero', label: 'Hero-forslag udfyldt', ok: hasRealText(hero.headline) && hasRealText(hero.subtext) && hasRealText(hero.primaryCta) && hasRealText(hero.rationale) },
          { key: 'structure', label: 'Servicestruktur udfyldt', ok: hasRealText(structure.primaryPages) && hasRealText(structure.homepageBlocks) && hasRealText(structure.contactSection) },
          { key: 'recommendation', label: 'Anbefalet næste skridt valgt', ok: RECOMMENDATION_OPTIONS.includes(check?.recommendation) },
        ];
        return { ready: items.every((item) => item.ok), items, completeIssues };
      }

      function renderReadinessChecklist(check) {
        const readiness = checkReportReadiness(check);
        const tone = readiness.ready
          ? 'border-accent/24 bg-accent-soft/58 text-accent-dark'
          : 'border-[#e8c884] bg-[#fff8e7] text-[#755116]';
        const message = readiness.ready
          ? 'Rapporten er klar til gennemgang og PDF.'
          : 'Rapporten mangler stadig vigtige felter, før den bør sendes til kunden.';
        const rows = readiness.items.map((item) => `
          <li class="flex items-start gap-2 rounded-[0.85rem] border border-white/55 bg-white/62 px-3 py-2 text-sm font-semibold text-brand/78">
            <span class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full ${item.ok ? 'bg-accent text-white' : 'bg-[#f1d9a3] text-[#755116]'}">${item.ok ? '✓' : '!'}</span>
            <span>${escapeHtml(item.label)}</span>
          </li>
        `).join('');
        return `
          <section class="mt-5 rounded-[1.15rem] border p-4 ${tone}">
            <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
              <div>
                <p class="text-xs font-bold uppercase tracking-[0.18em]">Rapport-klar status</p>
                <p class="mt-2 text-sm font-semibold leading-relaxed">${escapeHtml(message)}</p>
              </div>
              <p class="rounded-full border border-white/65 bg-white/72 px-3 py-1.5 text-xs font-bold text-brand/72">${readiness.completeIssues.length}/5 komplette problemer</p>
            </div>
            <ul class="mt-4 grid gap-2 md:grid-cols-2 lg:grid-cols-3">${rows}</ul>
            <div class="mt-4 flex flex-wrap gap-3">
              <button type="button" data-action="show-report" class="rounded-[0.85rem] border border-accent bg-accent px-4 py-2.5 text-sm font-semibold text-white hover:border-accent-dark hover:bg-accent-dark">Vis PDF-rapport</button>
              <button type="button" data-action="show-video" class="rounded-[0.85rem] border border-border-soft bg-white px-4 py-2.5 text-sm font-semibold text-brand hover:border-accent/35 hover:bg-accent-soft">Lav video-script</button>
            </div>
          </section>`;
      }

      function renderEditor() {
        const check = getActiveCheck();
        if (!check) {
          editorShell.innerHTML = `<div class="rounded-[1.25rem] border border-border-soft bg-white/76 p-6">Vælg eller opret et tjek først.</div>`;
          return;
        }

        editorShell.innerHTML = `
          <div class="rounded-[1.45rem] border border-border-soft bg-surface/86 p-5 shadow-soft md:p-7">
            <div class="grid gap-5 lg:grid-cols-[1fr_auto] lg:items-start">
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.24em] text-accent-dark">Rapport-editor</p>
                <h2 class="mt-3 font-display text-4xl font-medium tracking-tight text-brand md:text-5xl">${escapeHtml(check.client?.name || 'Hjemmeside-tjek')}</h2>
                <p class="mt-2 break-all text-sm font-semibold text-accent-dark">${escapeHtml(check.client?.website || '')}</p>
                <p class="mt-2 text-xs font-semibold uppercase tracking-[0.18em] text-muted">Gemmes automatisk i denne browser</p>
              </div>
              <div class="flex flex-wrap gap-3">
                <button type="button" data-action="show-dashboard" class="rounded-[0.85rem] border border-border-soft bg-white px-4 py-2.5 text-sm font-semibold text-brand hover:border-accent/35">Dashboard</button>
                <button type="button" data-action="duplicate-check" class="rounded-[0.85rem] border border-border-soft bg-white px-4 py-2.5 text-sm font-semibold text-brand hover:border-accent/35">Duplikér</button>
                <button type="button" data-action="delete-check" class="rounded-[0.85rem] border border-[#e4c7c7] bg-[#fff7f7] px-4 py-2.5 text-sm font-semibold text-[#8b2d2d] hover:border-[#c78686]">Slet</button>
              </div>
            </div>
            <div class="mt-5 grid gap-4 md:grid-cols-3">
              ${selectField('Status', 'status', STATUS_OPTIONS)}
              ${inputField('Klarheds-score', 'scores.clarity', { type: 'number', min: 1, max: 100 })}
              ${inputField('Tillids-score', 'scores.trust', { type: 'number', min: 1, max: 100 })}
            </div>
            <div class="mt-4 max-w-md">
              ${inputField('Handlings-score', 'scores.visibility', { type: 'number', min: 1, max: 100 })}
            </div>
            ${renderReadinessChecklist(check)}
          </div>

          <div class="mt-6 grid gap-5">
            ${card('A. Kundeinfo', `
              <div class="grid gap-4 md:grid-cols-2">
                ${inputField('Kundenavn', 'client.name')}
                ${inputField('Website', 'client.website')}
                ${inputField('Branche', 'client.industry')}
                ${inputField('Lokation', 'client.location')}
              </div>
              <div class="mt-4 grid gap-4 md:grid-cols-2">
                ${inputField('Primære ydelser', 'client.primaryServices', { textarea: true, rows: 4 })}
                ${inputField('Målgruppe', 'client.targetAudience', { textarea: true, rows: 4 })}
              </div>
              <div class="mt-4">${inputField('Noter', 'client.notes', { textarea: true, rows: 5 })}</div>
            `)}

            ${card('B. Førstehåndsindtryk', `
              <div class="grid gap-4 md:grid-cols-2">
                ${inputField('Hvad forstår man på 5 sekunder?', 'firstImpression.fiveSecondUnderstanding', { textarea: true, rows: 4 })}
                ${inputField('Er ydelsen tydelig?', 'firstImpression.serviceClarity', { textarea: true, rows: 4 })}
                ${inputField('Er målgruppen tydelig?', 'firstImpression.audienceClarity', { textarea: true, rows: 4 })}
                ${inputField('Er næste handling tydelig?', 'firstImpression.nextActionClarity', { textarea: true, rows: 4 })}
              </div>
            `, 'Skriv i almindeligt dansk. Fokusér på hvad en ny kunde forstår — ikke interne website-termer.')}

            ${card('C. Scores', `
              <div class="grid gap-4 md:grid-cols-3">
                ${inputField('Klarheds-score 1–100', 'scores.clarity', { type: 'number', min: 1, max: 100, help: 'Forstår kunden hurtigt hvad virksomheden tilbyder?' })}
                ${inputField('Tillids-score 1–100', 'scores.trust', { type: 'number', min: 1, max: 100, help: 'Føles siden tryg og professionel nok til kontakt?' })}
                ${inputField('Handlings-score 1–100', 'scores.visibility', { type: 'number', min: 1, max: 100, help: 'Forstår kunden næste skridt, og føles det nemt og naturligt at kontakte virksomheden?' })}
              </div>
            `)}

            ${card('D. Top 5 problemer', `<div class="grid gap-4">${renderIssues(check)}</div>`, 'Prioritér de problemer der sandsynligvis koster flest henvendelser først.')}

            ${card('E. Ny hero-tekst', `
              <div class="grid gap-4 md:grid-cols-2">
                ${inputField('Overskrift', 'heroSuggestion.headline', { textarea: true, rows: 3 })}
                ${inputField('Undertekst', 'heroSuggestion.subtext', { textarea: true, rows: 3 })}
                ${inputField('Primær CTA', 'heroSuggestion.primaryCta')}
                ${inputField('Sekundær CTA', 'heroSuggestion.secondaryCta')}
              </div>
              <div class="mt-4">${inputField('Hvorfor den nye hero virker bedre', 'heroSuggestion.rationale', { textarea: true, rows: 4 })}</div>
            `)}

            ${card('F. Forslag til servicestruktur', `
              <div class="grid gap-4 md:grid-cols-2">
                ${inputField('Primære servicesider', 'serviceStructure.primaryPages', { textarea: true, rows: 4 })}
                ${inputField('Sekundære servicesider', 'serviceStructure.secondaryPages', { textarea: true, rows: 4 })}
                ${inputField('Forsideblokke', 'serviceStructure.homepageBlocks', { textarea: true, rows: 4 })}
                ${inputField('FAQ-emner', 'serviceStructure.faqTopics', { textarea: true, rows: 4 })}
              </div>
              <div class="mt-4">${inputField('Kontaktsektion', 'serviceStructure.contactSection', { textarea: true, rows: 4 })}</div>
            `)}

            ${card('G. Anbefalet næste skridt', `
              <div class="grid gap-4 md:grid-cols-[0.8fr_1.2fr]">
                ${selectField('Anbefaling', 'recommendation', RECOMMENDATION_OPTIONS)}
                ${inputField('Kort samlet vurdering til rapporten', 'report.summary', { textarea: true, rows: 4 })}
              </div>
              <div class="mt-4">${inputField('Afsluttende CTA / næste handling', 'report.closingCta', { textarea: true, rows: 3 })}</div>
            `, 'Hold anbefalingen lavt pres: hvad bør kunden gøre først for at få flere henvendelser?')}
          </div>
        `;
      }

      function nl2br(value) {
        return escapeHtml(value).replace(/\n/g, '<br>');
      }

      function clampScore(value) {
        const number = Number(value);
        if (!Number.isFinite(number)) return 50;
        return Math.max(1, Math.min(100, Math.round(number)));
      }

      function scoreExplanation(scoreKey, score) {
        const level = score >= 75 ? 'stærkt' : score >= 55 ? 'fornuftigt, men med tydelige forbedringsmuligheder' : 'et vigtigt forbedringsområde';
        if (scoreKey === 'clarity') {
          return `Klarhed handler om, hvor hurtigt en ny besøgende forstår, hvad virksomheden hjælper med, og hvad næste skridt er. Niveauet er ${level}.`;
        }
        if (scoreKey === 'trust') {
          return `Tillid handler om, om siden føles tryg, professionel og konkret nok til, at en ny kunde tør tage kontakt. Niveauet er ${level}.`;
        }
        return `Handling handler om, om kunden nemt forstår næste skridt og får lyst til at kontakte virksomheden. Niveauet er ${level}.`;
      }

      function reportSummary(check) {
        if (String(check.report?.summary || '').trim()) {
          return nl2br(check.report.summary);
        }
        const firstIssue = getCompleteIssues(check)[0];
        const firstIssueText = firstIssue ? ` Det første oplagte fokuspunkt er: ${escapeHtml(firstIssue.title)}.` : '';
        return `Hjemmeside-tjekket peger på, at den største gevinst ligger i at gøre siden tydeligere, mere tillidsvækkende og lettere at handle på.${firstIssueText}<br><br>Start med de ændringer, der gør det nemmere for en ny besøgende at forstå ydelsen, mærke tryghed og tage næste skridt uden friktion.`;
      }

      function recommendationExplanation(recommendation) {
        if (recommendation === 'Hjemmeside-fix') {
          return 'Hjemmeside-tjekket viser, at den største gevinst ligger i at rette tekst, struktur og kontaktknapper, så siden bliver tydeligere og mere salgsorienteret.';
        }
        if (recommendation === 'Visuelt løft') {
          return 'Hjemmeside-tjekket viser, at førstehåndsindtryk, layout, billeder og professionelt udtryk bør styrkes for at skabe mere tillid.';
        }
        if (recommendation === 'Kun små tekstrettelser') {
          return 'Der er ikke nødvendigvis brug for en stor løsning. De vigtigste forbedringer kan starte med tydeligere tekst, stærkere kontaktknapper og bedre struktur.';
        }
        if (recommendation === 'Ny struktur anbefales') {
          return 'Siden vil sandsynligvis få mest ud af en tydeligere opbygning, hvor ydelser, målgruppe og næste handling bliver lettere at forstå.';
        }
        return 'Hvis siden både mangler klarhed, tillid og struktur, bør en ny hjemmeside overvejes som næste skridt i stedet for små lapperier.';
      }

      function upsellCta(recommendation) {
        if (recommendation === 'Hjemmeside-fix') {
          return 'Næste oplagte skridt er et Hjemmeside-fix, hvor tekst, struktur og CTA’er rettes, så siden bliver tydeligere og mere salgsorienteret.';
        }
        if (recommendation === 'Visuelt løft') {
          return 'Næste oplagte skridt er et Visuelt løft, hvor førstehåndsindtryk, billeder, layout og professionelt udtryk forbedres.';
        }
        if (recommendation === 'Kun små tekstrettelser') {
          return 'Der er ikke nødvendigvis brug for en stor løsning. De vigtigste forbedringer kan starte med tydeligere tekst, stærkere CTA’er og bedre struktur.';
        }
        return 'Næste skridt bør være at få gjort siden tydeligere, mere tillidsvækkende og lettere at handle på — før der bruges flere penge på trafik eller annoncering.';
      }

      function splitList(value) {
        return String(value || '')
          .split(/\n|;/)
          .map((item) => item.trim())
          .filter(Boolean);
      }

      function reportList(value) {
        const items = splitList(value).filter(hasRealText);
        if (!items.length) {
          return `<p class="mt-4 rounded-[0.85rem] border border-border-soft bg-white/72 px-4 py-3 text-sm leading-relaxed text-brand/66">Denne sektion er endnu ikke udfyldt.</p>`;
        }
        return `<ul class="mt-4 grid gap-2 text-sm leading-relaxed text-brand/78">${items.map((item) => `<li class="rounded-[0.85rem] border border-border-soft bg-white/72 px-4 py-3">${escapeHtml(item)}</li>`).join('')}</ul>`;
      }

      function reportTextCard(label, value, fallback) {
        return `
          <div class="report-card rounded-[1rem] border border-border-soft bg-white/78 p-4">
            <h4 class="text-xs font-bold uppercase tracking-[0.18em] text-accent-dark">${escapeHtml(label)}</h4>
            <p class="mt-3 text-sm leading-relaxed text-brand/78">${nl2br(textOrFallback(value, fallback))}</p>
          </div>`;
      }

      function renderScoreCard(title, scoreKey, value) {
        const score = clampScore(value);
        return `
          <article class="report-card rounded-[1.1rem] border border-border-soft bg-white/82 p-5">
            <div class="flex items-start justify-between gap-4">
              <h4 class="font-display text-2xl font-medium text-brand">${escapeHtml(title)}</h4>
              <strong class="text-3xl font-semibold text-accent-dark">${score}</strong>
            </div>
            <div class="report-score-bar mt-4"><div class="report-score-fill" style="width: ${score}%"></div></div>
            <p class="mt-4 text-sm leading-relaxed text-brand/74">${escapeHtml(scoreExplanation(scoreKey, score))}</p>
          </article>`;
      }

      function renderReportIssue(issue, index) {
        const priority = hasRealText(issue.priority) ? issue.priority : 'Medium';
        const effect = hasRealText(issue.effect) ? issue.effect : 'Flere henvendelser';
        return `
          <article class="report-problem rounded-[1.15rem] border border-border-soft bg-white/84 p-5">
            <div class="flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
              <div>
                <p class="text-xs font-bold uppercase tracking-[0.18em] text-accent-dark">Problem ${index + 1}</p>
                <h4 class="mt-2 font-display text-2xl font-medium leading-tight text-brand">${escapeHtml(issue.title)}</h4>
              </div>
              <div class="flex flex-wrap gap-2">
                <span class="rounded-full border border-accent/22 bg-accent-soft px-3 py-1.5 text-xs font-bold text-accent-dark">${escapeHtml(priority)}</span>
                <span class="rounded-full border border-border-soft bg-surface px-3 py-1.5 text-xs font-bold text-brand/72">${escapeHtml(effect)}</span>
              </div>
            </div>
            <div class="mt-5 grid gap-4 md:grid-cols-2">
              <div class="rounded-[0.95rem] border border-border-soft bg-surface/72 p-4">
                <h5 class="text-sm font-bold text-brand">Hvorfor det er et problem</h5>
                <p class="mt-2 text-sm leading-relaxed text-brand/74">${nl2br(issue.why)}</p>
              </div>
              <div class="rounded-[0.95rem] border border-border-soft bg-surface/72 p-4">
                <h5 class="text-sm font-bold text-brand">Hvad der bør ændres</h5>
                <p class="mt-2 text-sm leading-relaxed text-brand/74">${nl2br(issue.change)}</p>
              </div>
            </div>
          </article>`;
      }

      function renderServiceStructure(check) {
        const structure = check.serviceStructure || {};
        const boxes = [
          ['Primære servicesider', structure.primaryPages],
          ['Sekundære servicesider', structure.secondaryPages],
          ['Forsideblokke', structure.homepageBlocks],
          ['FAQ-emner', structure.faqTopics],
          ['Kontaktsektion', structure.contactSection],
        ];
        return boxes.map(([title, value]) => `
          <div class="report-card rounded-[1rem] border border-border-soft bg-white/78 p-4">
            <h4 class="font-display text-xl font-medium text-brand">${escapeHtml(title)}</h4>
            ${reportList(value)}
          </div>
        `).join('');
      }

      function renderReport() {
        const check = getActiveCheck() || (state.checks.length === 1 ? state.checks[0] : null);
        if (check && !activeId) activeId = check.id;
        if (!reportShell) return;
        if (!check) {
          reportShell.innerHTML = `
            <div class="rounded-[1.25rem] border border-border-soft bg-white/76 p-6">
              <h2 class="font-display text-3xl font-medium text-brand">Ingen rapport endnu.</h2>
              <p class="mt-3 text-sm leading-relaxed text-muted">Opret et Hjemmeside-tjek først, så kan rapporten vises her.</p>
              <button type="button" data-action="show-create" class="mt-5 rounded-[0.9rem] border border-accent bg-accent px-5 py-3 text-sm font-semibold text-white">Opret tjek</button>
            </div>`;
          return;
        }

        const reportDate = formatDate(check.updatedAt || check.createdAt || new Date().toISOString());
        const client = check.client || {};
        const hero = check.heroSuggestion || {};
        const recommendation = check.recommendation || 'Hjemmeside-fix';
        const issues = getCompleteIssues(check);
        const readiness = checkReportReadiness(check);
        const reportWarning = readiness.ready ? '' : `
          <div class="report-warning mx-auto mb-4 max-w-[980px] rounded-[1rem] border border-[#e8c884] bg-[#fff8e7] p-4 text-sm font-semibold leading-relaxed text-[#755116] shadow-soft">
            Rapporten er ikke helt udfyldt endnu. Tjek indholdet før du gemmer som PDF.
          </div>`;
        const issueSection = issues.length ? `
            <section class="report-section mt-8">
              <p class="text-xs font-bold uppercase tracking-[0.22em] text-accent-dark">Top problemer</p>
              <h2 class="mt-3 font-display text-4xl font-medium leading-tight tracking-tight text-brand">Det der sandsynligvis koster henvendelser</h2>
              <div class="mt-5 grid gap-5">${issues.map((issue, index) => renderReportIssue(issue, index)).join('')}</div>
            </section>` : '';

        reportShell.innerHTML = `
          <div class="report-actions mx-auto mb-4 flex max-w-[980px] flex-wrap items-center justify-between gap-3 rounded-[1.1rem] border border-border-soft bg-white/80 p-4 shadow-soft">
            <div>
              <p class="text-xs font-bold uppercase tracking-[0.18em] text-accent-dark">PDF-rapport</p>
              <p class="mt-1 text-sm text-muted">Brug browserens printdialog til at gemme som PDF.</p>
            </div>
            <div class="flex flex-wrap gap-2">
              <button type="button" data-action="back-to-editor" class="rounded-[0.85rem] border border-border-soft bg-surface px-4 py-2.5 text-sm font-semibold text-brand hover:border-accent/35">Tilbage til editor</button>
              <button type="button" data-action="show-video" class="rounded-[0.85rem] border border-border-soft bg-white px-4 py-2.5 text-sm font-semibold text-brand hover:border-accent/35 hover:bg-accent-soft">Se video-script</button>
              <button type="button" data-action="print-report" class="rounded-[0.85rem] border border-accent bg-accent px-4 py-2.5 text-sm font-semibold text-white hover:border-accent-dark hover:bg-accent-dark">Print / Gem som PDF</button>
            </div>
          </div>

          ${reportWarning}

          <article class="report-page mx-auto max-w-[980px] rounded-[1.5rem] border border-border-soft bg-surface/92 p-6 shadow-soft md:p-10">
            <section class="report-cover grid gap-8 rounded-[1.25rem] border border-border-soft bg-white/78 p-7 md:p-10">
              <div>
                <p class="text-xs font-bold uppercase tracking-[0.28em] text-accent-dark">SiteDokAI</p>
                <h1 class="mt-5 font-display text-5xl font-medium leading-[0.98] tracking-tight text-brand md:text-7xl">Hjemmeside-tjek</h1>
                <p class="mt-6 max-w-2xl text-lg leading-relaxed text-brand/76">Denne rapport viser de vigtigste ting på hjemmesiden, som kan påvirke klarhed, tillid, handling og antallet af henvendelser.</p>
              </div>
              <div class="grid gap-3 rounded-[1.1rem] border border-accent/18 bg-accent-soft/55 p-5 md:grid-cols-2">
                <div><p class="text-xs font-bold uppercase tracking-[0.16em] text-accent-dark">Kunde</p><p class="mt-1 text-lg font-semibold text-brand">${escapeHtml(textOrFallback(client.name))}</p></div>
                <div><p class="text-xs font-bold uppercase tracking-[0.16em] text-accent-dark">Website</p><p class="mt-1 break-all text-lg font-semibold text-brand">${escapeHtml(textOrFallback(client.website))}</p></div>
                <div><p class="text-xs font-bold uppercase tracking-[0.16em] text-accent-dark">Branche</p><p class="mt-1 text-lg font-semibold text-brand">${escapeHtml(textOrFallback(client.industry))}</p></div>
                <div><p class="text-xs font-bold uppercase tracking-[0.16em] text-accent-dark">Dato</p><p class="mt-1 text-lg font-semibold text-brand">${escapeHtml(reportDate)}</p></div>
              </div>
            </section>

            <section class="report-section mt-8 rounded-[1.25rem] border border-border-soft bg-white/78 p-6">
              <p class="text-xs font-bold uppercase tracking-[0.22em] text-accent-dark">Samlet vurdering</p>
              <h2 class="mt-3 font-display text-4xl font-medium leading-tight tracking-tight text-brand">Hvad bør rettes først?</h2>
              <p class="mt-5 text-base leading-relaxed text-brand/78">${reportSummary(check)}</p>
            </section>

            <section class="report-section mt-8">
              <p class="text-xs font-bold uppercase tracking-[0.22em] text-accent-dark">Scores</p>
              <h2 class="mt-3 font-display text-4xl font-medium tracking-tight text-brand">Klarhed, tillid og handling</h2>
              <div class="mt-5 grid gap-4 md:grid-cols-3">
                ${renderScoreCard('Klarheds-score', 'clarity', check.scores?.clarity)}
                ${renderScoreCard('Tillids-score', 'trust', check.scores?.trust)}
                ${renderScoreCard('Handlings-score', 'visibility', check.scores?.visibility)}
              </div>
            </section>

            <section class="report-section mt-8 rounded-[1.25rem] border border-border-soft bg-surface/72 p-6">
              <p class="text-xs font-bold uppercase tracking-[0.22em] text-accent-dark">Førstehåndsindtryk</p>
              <h2 class="mt-3 font-display text-4xl font-medium tracking-tight text-brand">Hvad møder kunden først?</h2>
              <div class="mt-5 grid gap-4 md:grid-cols-2">
                ${reportTextCard('Hvad forstår man på 5 sekunder?', check.firstImpression?.fiveSecondUnderstanding, 'Denne sektion er endnu ikke udfyldt.')}
                ${reportTextCard('Er ydelsen tydelig?', check.firstImpression?.serviceClarity, 'Denne sektion er endnu ikke udfyldt.')}
                ${reportTextCard('Er målgruppen tydelig?', check.firstImpression?.audienceClarity, 'Denne sektion er endnu ikke udfyldt.')}
                ${reportTextCard('Er næste handling tydelig?', check.firstImpression?.nextActionClarity, 'Denne sektion er endnu ikke udfyldt.')}
              </div>
            </section>

            ${issueSection}

            <section class="report-section mt-8 rounded-[1.25rem] border border-border-soft bg-white/78 p-6">
              <p class="text-xs font-bold uppercase tracking-[0.22em] text-accent-dark">Ny hero-tekst</p>
              <h2 class="mt-3 font-display text-4xl font-medium leading-tight tracking-tight text-brand">Forslag til første sektion</h2>
              <div class="report-hero-preview mt-5 rounded-[1.2rem] border border-accent/22 bg-accent-soft/58 p-6 md:p-8">
                <p class="text-xs font-bold uppercase tracking-[0.22em] text-accent-dark">Forslag til ny forsidehero</p>
                <h3 class="mt-4 max-w-3xl font-display text-4xl font-medium leading-tight text-brand md:text-5xl">${escapeHtml(textOrFallback(hero.headline))}</h3>
                <p class="mt-4 max-w-2xl text-base leading-relaxed text-brand/74">${nl2br(textOrFallback(hero.subtext))}</p>
                <div class="mt-6 flex flex-wrap gap-3">
                  <span class="rounded-[0.85rem] bg-accent px-4 py-3 text-sm font-bold text-white">${escapeHtml(textOrFallback(hero.primaryCta, 'Kontakt os'))}</span>
                  <span class="rounded-[0.85rem] border border-accent/28 bg-white/72 px-4 py-3 text-sm font-bold text-brand">${escapeHtml(textOrFallback(hero.secondaryCta, 'Se ydelser'))}</span>
                </div>
              </div>
              <div class="mt-5 rounded-[1rem] border border-border-soft bg-surface/72 p-4">
                <h4 class="text-sm font-bold text-brand">Hvorfor denne hero virker bedre</h4>
                <p class="mt-2 text-sm leading-relaxed text-brand/74">${nl2br(textOrFallback(hero.rationale))}</p>
              </div>
            </section>

            <section class="report-section mt-8 rounded-[1.25rem] border border-border-soft bg-surface/72 p-6">
              <p class="text-xs font-bold uppercase tracking-[0.22em] text-accent-dark">Servicestruktur</p>
              <h2 class="mt-3 font-display text-4xl font-medium tracking-tight text-brand">Forslag til en tydeligere opbygning</h2>
              <div class="mt-5 grid gap-4 md:grid-cols-2">${renderServiceStructure(check)}</div>
            </section>

            <section class="report-section mt-8 grid gap-5 md:grid-cols-[0.9fr_1.1fr]">
              <div class="rounded-[1.25rem] border border-accent/22 bg-accent-soft/62 p-6">
                <p class="text-xs font-bold uppercase tracking-[0.22em] text-accent-dark">Anbefalet næste skridt</p>
                <h2 class="mt-3 font-display text-4xl font-medium tracking-tight text-brand">${escapeHtml(recommendation)}</h2>
                <p class="mt-4 text-sm leading-relaxed text-brand/76">${escapeHtml(recommendationExplanation(recommendation))}</p>
              </div>
              <div class="rounded-[1.25rem] border border-border-soft bg-white/84 p-6">
                <p class="text-xs font-bold uppercase tracking-[0.22em] text-accent-dark">Afslutning</p>
                <h2 class="mt-3 font-display text-3xl font-medium tracking-tight text-brand">Næste handling</h2>
                <p class="mt-4 text-base leading-relaxed text-brand/78">${escapeHtml(upsellCta(recommendation))}</p>
                <p class="mt-4 text-sm leading-relaxed text-brand/64">${nl2br(textOrFallback(check.report?.closingCta, 'Hvis du vil videre, kan næste skridt aftales ud fra de vigtigste problemer i rapporten.'))}</p>
              </div>
            </section>
          </article>
        `;
      }

      function joinReadableList(items) {
        const cleanItems = items.map(cleanText).filter(hasRealText);
        if (!cleanItems.length) return '';
        if (cleanItems.length === 1) return cleanItems[0];
        if (cleanItems.length === 2) return `${cleanItems[0]} og ${cleanItems[1]}`;
        return `${cleanItems.slice(0, -1).join(', ')} og ${cleanItems[cleanItems.length - 1]}`;
      }

      function scoreScriptText(label, scoreKey, value) {
        const score = clampScore(value);
        const level = score >= 75 ? 'et stærkt udgangspunkt' : score >= 55 ? 'et fornuftigt udgangspunkt' : 'et område, der bør prioriteres';
        if (scoreKey === 'clarity') {
          return `${label} ligger på ${score}. Det betyder, at siden har ${level}, men at en ny besøgende stadig skal kunne forstå hurtigere, hvad I konkret hjælper med, hvem I hjælper, og hvad næste skridt er. Det vigtigste at forbedre her er mere tydelig tekst, færre løse budskaber og en klarere vej til kontakt.`;
        }
        if (scoreKey === 'trust') {
          return `${label} ligger på ${score}. Det handler om, hvor tryg og professionel siden føles for en ny kunde. Kunden skal forstå, at I er et sikkert valg, og derfor bør siden vise mere konkret dokumentation, tydeligere proces og flere tillidssignaler.`;
        }
        return `${label} ligger på ${score}. Det handler om, hvor nemt kunden forstår næste skridt og får lyst til at kontakte virksomheden. Det vigtigste er at gøre kontaktvejen tydelig, tryg og naturlig.`;
      }

      function recommendationVideoReason(recommendation) {
        if (recommendation === 'Hjemmeside-fix') return 'det retter de vigtigste tekster, strukturen og kontaktvejen uden at starte helt forfra';
        if (recommendation === 'Visuelt løft') return 'førstehåndsindtrykket og det professionelle udtryk ser ud til at være en vigtig del af udfordringen';
        if (recommendation === 'Kun små tekstrettelser') return 'siden allerede har et brugbart fundament, og de hurtigste forbedringer ligger i klarere formuleringer og tydeligere næste skridt';
        if (recommendation === 'Ny struktur anbefales') return 'siden bliver lettere at forstå, når ydelser og vigtige sektioner får en mere logisk opbygning';
        return 'der er flere grundlæggende ting med klarhed, tillid og struktur, som bør løses samlet';
      }

      function firstImpressionText(check) {
        const first = check?.firstImpression || {};
        return [
          first.fiveSecondUnderstanding,
          first.serviceClarity,
          first.audienceClarity,
          first.nextActionClarity,
        ].map(cleanText).filter(hasRealText).join(' ');
      }

      function getVideoScriptStatus(check) {
        const client = check?.client || {};
        const scores = check?.scores || {};
        const hero = check?.heroSuggestion || {};
        const structure = check?.serviceStructure || {};
        const completeIssues = getCompleteIssues(check);
        const overviewReady = hasRealText(check?.report?.summary) || hasRealText(firstImpressionText(check));
        const items = [
          { key: 'client', label: 'Kundeinfo klar', ok: hasRealText(client.name) && hasRealText(client.website) },
          { key: 'overview', label: 'Samlet vurdering eller førstehåndsindtryk udfyldt', ok: overviewReady },
          { key: 'scores', label: 'Scores klar', ok: scoreIsFilled(scores.clarity) && scoreIsFilled(scores.trust) && scoreIsFilled(scores.visibility) },
          { key: 'issues', label: 'Mindst 3 problemer klar', ok: completeIssues.length >= 3 },
          { key: 'hero', label: 'Hero-forslag klar', ok: hasRealText(hero.headline) && hasRealText(hero.subtext) && hasRealText(hero.primaryCta) && hasRealText(hero.rationale) },
          { key: 'structure', label: 'Servicestruktur klar', ok: hasRealText(structure.primaryPages) && hasRealText(structure.homepageBlocks) && hasRealText(structure.contactSection) },
          { key: 'recommendation', label: 'Anbefalet næste skridt valgt', ok: RECOMMENDATION_OPTIONS.includes(check?.recommendation) },
        ];
        return { ready: items.every((item) => item.ok), items, completeIssues };
      }

      function buildVideoScript(check) {
        const clientName = cleanText(check.client?.name) || 'kunden';
        const scores = check.scores || {};
        const hero = check.heroSuggestion || {};
        const structure = check.serviceStructure || {};
        const issues = getCompleteIssues(check).slice(0, 5);
        const overview = hasRealText(check.report?.summary)
          ? cleanText(check.report.summary)
          : 'Når jeg ser på siden samlet, er der et brugbart udgangspunkt, men der er også nogle tydelige steder, hvor siden kan blive lettere at forstå og lettere at handle på.';
        const firstText = firstImpressionText(check);
        const primaryPages = splitList(structure.primaryPages).filter(hasRealText);
        const secondaryPages = splitList(structure.secondaryPages).filter(hasRealText);
        const homepageBlocks = splitList(structure.homepageBlocks).filter(hasRealText);
        const faqTopics = splitList(structure.faqTopics).filter(hasRealText);
        const recommendation = check.recommendation || 'Hjemmeside-fix';

        const issueScript = issues.map((issue, index) => {
          const ordinal = ['første', 'andet', 'tredje', 'fjerde', 'femte'][index] || 'næste';
          return `Problem ${index + 1}: ${cleanText(issue.title)}\nDet ${ordinal} jeg ville kigge på er ${cleanText(issue.title)}. Det betyder noget, fordi ${cleanText(issue.why)} Det jeg konkret ville ændre er: ${cleanText(issue.change)} Effekten kan være ${cleanText(issue.effect || 'flere henvendelser').toLowerCase()}, fordi siden bliver nemmere at forstå og nemmere at reagere på.`;
        }).join('\n\n');

        const serviceLines = [
          primaryPages.length ? `De vigtigste servicesider jeg ville prioritere er: ${joinReadableList(primaryPages)}.` : '',
          secondaryPages.length ? `Derudover kan det give mening at samle de mindre eller supplerende ydelser omkring: ${joinReadableList(secondaryPages)}.` : '',
          homepageBlocks.length ? `På forsiden ville jeg bygge flowet op omkring: ${joinReadableList(homepageBlocks)}.` : '',
          faqTopics.length ? `FAQ-delen kan bruge emner som: ${joinReadableList(faqTopics)}.` : '',
          hasRealText(structure.contactSection) ? `Kontaktsektionen bør især gøre dette tydeligt: ${cleanText(structure.contactSection)}.` : '',
        ].filter(Boolean).join('\n');

        return [
          `INTRO\nHej ${clientName}. Her får du en kort gennemgang af jeres hjemmeside og de vigtigste ting, jeg ville rette først for at skabe mere klarhed, mere tillid og flere henvendelser.`,
          `KORT OVERORDNET VURDERING\n${overview}${firstText ? `\n\nMit førstehåndsindtryk er: ${firstText}` : ''}\n\nNår en potentiel kunde lander på siden, skal de hurtigt kunne forstå hvad I hjælper med, hvorfor de kan stole på jer, og hvad de skal gøre som næste skridt.`,
          `SCORE-GENNEMGANG\n${scoreScriptText('Klarheds-scoren', 'clarity', scores.clarity)}\n\n${scoreScriptText('Tillids-scoren', 'trust', scores.trust)}\n\n${scoreScriptText('Handlings-scoren', 'visibility', scores.visibility)}`,
          `TOP-PROBLEMER\n${issueScript}`,
          `NY HERO-TEKST\nHer foreslår jeg en ny første sektion, hvor kunden hurtigere kan se, hvad I hjælper med, hvor I hjælper, og hvordan de tager kontakt.\n\nOverskrift: ${cleanText(hero.headline)}\nUndertekst: ${cleanText(hero.subtext)}\nPrimær CTA: ${cleanText(hero.primaryCta)}\nSekundær CTA: ${cleanText(hero.secondaryCta)}\n\nGrunden til at heroen virker bedre er: ${cleanText(hero.rationale)}`,
          `SERVICESTRUKTUR\n${serviceLines}\n\nPointen er at gøre siden lettere at forstå. Når ydelserne er samlet mere klart, bliver det nemmere for kunden at finde sig selv i indholdet, og det gør også siden lettere for Google at forstå uden at vi gør teksten teknisk.`,
          `ANBEFALET NÆSTE SKRIDT\nMit anbefalede næste skridt er derfor ${recommendation}, fordi ${recommendationVideoReason(recommendation)}. Det er her, I hurtigst kan få mest effekt.`,
          `AFRUNDING\nDet var de vigtigste pointer. Målet er ikke at gøre siden mere kompliceret, men at gøre det nemmere for en potentiel kunde at forstå jer, stole på jer og tage kontakt.`,
        ].join('\n\n').replace(/\n{3,}/g, '\n\n').trim();
      }

      function renderVideoChecklist(status) {
        return status.items.map((item) => `
          <li class="flex items-start gap-2 rounded-[0.85rem] border border-white/55 bg-white/64 px-3 py-2 text-sm font-semibold text-brand/78">
            <span class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full ${item.ok ? 'bg-accent text-white' : 'bg-[#f1d9a3] text-[#755116]'}">${item.ok ? '✓' : '!'}</span>
            <span>${escapeHtml(item.label)}</span>
          </li>
        `).join('');
      }

      function renderVideoScript() {
        const check = getActiveCheck() || (state.checks.length === 1 ? state.checks[0] : null);
        if (check && !activeId) activeId = check.id;
        if (!videoShell) return;
        if (!check) {
          videoShell.innerHTML = `
            <div class="rounded-[1.25rem] border border-border-soft bg-white/76 p-6">
              <h2 class="font-display text-3xl font-medium text-brand">Intet video-script endnu.</h2>
              <p class="mt-3 text-sm leading-relaxed text-muted">Opret et Hjemmeside-tjek først.</p>
              <button type="button" data-action="show-create" class="mt-5 rounded-[0.9rem] border border-accent bg-accent px-5 py-3 text-sm font-semibold text-white">Opret tjek</button>
            </div>`;
          return;
        }

        const status = getVideoScriptStatus(check);
        const savedScript = hasRealText(check.videoScript?.body) ? check.videoScript.body : '';
        const generatedScript = status.ready ? buildVideoScript(check) : '';
        const scriptBody = savedScript || generatedScript;
        const fallbackMessage = status.ready
          ? 'Video-scriptet er klar til redigering, kopiering og optagelse.'
          : status.completeIssues.length < 3
            ? 'Udfyld flere problemer i rapporten, før video-scriptet er klar.'
            : 'Udfyld rapporten mere, før video-scriptet er klar.';
        const tone = status.ready ? 'border-accent/24 bg-accent-soft/58 text-accent-dark' : 'border-[#e8c884] bg-[#fff8e7] text-[#755116]';
        const savedMeta = savedScript
          ? `<p class="mt-2 text-sm leading-relaxed text-muted">Der findes et gemt script fra ${escapeHtml(formatDate(check.videoScript?.updatedAt))}. Det overskrives ikke automatisk. Brug “Gendan script fra rapportdata”, hvis du vil erstatte det.</p>`
          : '';

        videoShell.innerHTML = `
          <div class="mx-auto max-w-[1120px] rounded-[1.45rem] border border-border-soft bg-surface/86 p-5 shadow-soft md:p-7">
            <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.24em] text-accent-dark">Internt arbejdsredskab</p>
                <h2 class="mt-3 font-display text-4xl font-medium tracking-tight text-brand md:text-5xl">Video-script</h2>
                <p class="mt-2 text-sm leading-relaxed text-muted">Brug rapportdata til en 5–10 minutters gennemgang. Scriptet er internt og kan redigeres frit.</p>
                ${savedMeta}
              </div>
              <div class="flex flex-wrap gap-2">
                <button type="button" data-action="back-to-editor" class="rounded-[0.85rem] border border-border-soft bg-white px-4 py-2.5 text-sm font-semibold text-brand hover:border-accent/35">Tilbage til editor</button>
                <button type="button" data-action="show-report" class="rounded-[0.85rem] border border-border-soft bg-white px-4 py-2.5 text-sm font-semibold text-brand hover:border-accent/35 hover:bg-accent-soft">Se PDF-rapport</button>
              </div>
            </div>

            <section class="mt-5 rounded-[1.15rem] border p-4 ${tone}">
              <p class="text-xs font-bold uppercase tracking-[0.18em]">Video-script status</p>
              <p class="mt-2 text-sm font-semibold leading-relaxed">${escapeHtml(fallbackMessage)}</p>
              <ul class="mt-4 grid gap-2 md:grid-cols-2 lg:grid-cols-3">${renderVideoChecklist(status)}</ul>
            </section>

            ${scriptBody ? `
              <section class="mt-5 rounded-[1.25rem] border border-border-soft bg-white/76 p-5">
                <label class="grid gap-3 text-sm font-semibold text-brand">Redigérbart video-script
                  <textarea id="video-script-text" class="video-script-body resize-y rounded-[1rem] border border-border-soft bg-surface px-4 py-4 font-normal text-brand outline-none transition focus:border-accent focus:ring-2 focus:ring-accent/16">${escapeHtml(scriptBody)}</textarea>
                </label>
                <p id="video-status-message" class="mt-3 text-sm leading-relaxed text-muted">${savedScript ? 'Gemte script er indlæst.' : 'Scriptet er genereret fra rapportdata. Gem det, hvis du vil bevare manuelle ændringer.'}</p>
                <div class="mt-4 flex flex-wrap gap-3">
                  <button type="button" data-action="copy-script" class="rounded-[0.85rem] border border-accent bg-accent px-4 py-2.5 text-sm font-semibold text-white hover:border-accent-dark hover:bg-accent-dark">Kopiér script</button>
                  <button type="button" data-action="save-script" class="rounded-[0.85rem] border border-border-soft bg-surface px-4 py-2.5 text-sm font-semibold text-brand hover:border-accent/35">Gem script</button>
                  <button type="button" data-action="regenerate-script" class="rounded-[0.85rem] border border-border-soft bg-white px-4 py-2.5 text-sm font-semibold text-brand hover:border-accent/35 hover:bg-accent-soft">Gendan script fra rapportdata</button>
                </div>
              </section>` : `
              <section class="mt-5 rounded-[1.25rem] border border-dashed border-accent/28 bg-white/70 p-6 text-center">
                <h3 class="font-display text-3xl font-medium text-brand">Udfyld rapporten mere, før video-scriptet er klar.</h3>
                <p class="mx-auto mt-3 max-w-2xl text-sm leading-relaxed text-muted">Scriptet bliver først vist, når der er kunde, scores, mindst 3 færdige problemer, hero-forslag, servicestruktur og anbefalet næste skridt.</p>
              </section>`}
          </div>`;
      }

      function setVideoMessage(message, ok = true) {
        const element = document.getElementById('video-status-message');
        if (!element) return;
        element.textContent = message;
        element.className = `mt-3 text-sm font-semibold leading-relaxed ${ok ? 'text-accent-dark' : 'text-[#8b2d2d]'}`;
      }

      function fallbackCopy(textarea) {
        textarea.focus();
        textarea.select();
        document.execCommand('copy');
        setVideoMessage('Scriptet er kopieret.');
      }

      function updateFromField(field) {
        const check = getActiveCheck();
        if (!check || !field.dataset.path) return;
        let value = field.value;
        if (field.type === 'number') {
          value = Math.max(1, Math.min(100, Number(value || 1)));
          field.value = String(value);
        }
        if (field.dataset.path === 'client.website') {
          value = normalizeWebsite(value);
        }
        setByPath(check, field.dataset.path, value);
        check.updatedAt = new Date().toISOString();
        saveState();
      }

      document.addEventListener('click', (event) => {
        const actionTarget = event.target.closest('[data-action]');
        if (!actionTarget) return;
        const action = actionTarget.dataset.action;

        if (action === 'show-dashboard') show('dashboard');
        if (action === 'show-create') show('create');
        if (action === 'back-to-editor') show('editor');
        if (action === 'print-report') window.print();
        if (action === 'open-check') {
          activeId = actionTarget.dataset.id;
          show('editor');
        }
        if (action === 'show-report') {
          if (actionTarget.dataset.id) activeId = actionTarget.dataset.id;
          show('report');
        }
        if (action === 'show-video') {
          if (actionTarget.dataset.id) activeId = actionTarget.dataset.id;
          show('video');
        }
        if (action === 'save-script') {
          const check = getActiveCheck();
          const textarea = document.getElementById('video-script-text');
          if (!check || !textarea) return;
          const value = String(textarea.value || '').trim();
          if (!value) {
            setVideoMessage('Scriptet er tomt og blev ikke gemt.', false);
            return;
          }
          check.videoScript = {
            ...(check.videoScript || {}),
            body: value,
            updatedAt: new Date().toISOString(),
          };
          check.updatedAt = new Date().toISOString();
          saveState();
          renderVideoScript();
          setVideoMessage('Scriptet er gemt.');
        }
        if (action === 'copy-script') {
          const textarea = document.getElementById('video-script-text');
          if (!textarea) return;
          if (navigator.clipboard?.writeText) {
            let settled = false;
            const fallbackTimer = window.setTimeout(() => {
              if (!settled) fallbackCopy(textarea);
            }, 500);
            navigator.clipboard.writeText(textarea.value).then(
              () => {
                settled = true;
                window.clearTimeout(fallbackTimer);
                setVideoMessage('Scriptet er kopieret.');
              },
              () => {
                settled = true;
                window.clearTimeout(fallbackTimer);
                fallbackCopy(textarea);
              },
            );
          } else {
            fallbackCopy(textarea);
          }
        }
        if (action === 'regenerate-script') {
          const check = getActiveCheck();
          const textarea = document.getElementById('video-script-text');
          if (!check || !textarea) return;
          const status = getVideoScriptStatus(check);
          if (!status.ready) {
            setVideoMessage(status.completeIssues.length < 3 ? 'Udfyld flere problemer i rapporten, før video-scriptet er klar.' : 'Udfyld rapporten mere, før video-scriptet er klar.', false);
            return;
          }
          const regenerated = buildVideoScript(check);
          const currentText = String(textarea.value || '').trim();
          if (currentText && currentText !== regenerated) {
            const confirmed = confirm('Det nuværende script bliver erstattet. Vil du fortsætte?');
            if (!confirmed) return;
          }
          textarea.value = regenerated;
          setVideoMessage('Scriptet er gendannet fra rapportdata. Husk at gemme, hvis du vil beholde versionen.');
        }
        if (action === 'delete-check') {
          const check = getActiveCheck();
          if (!check) return;
          if (!confirm(`Slet Hjemmeside-tjek for ${check.client?.name || 'kunden'}?`)) return;
          state.checks = state.checks.filter((item) => item.id !== check.id);
          activeId = state.checks[0]?.id || null;
          saveState();
          show('dashboard');
        }
        if (action === 'duplicate-check') {
          const check = getActiveCheck();
          if (!check) return;
          const copy = JSON.parse(JSON.stringify(check));
          copy.id = typeof crypto !== 'undefined' && crypto.randomUUID ? crypto.randomUUID() : String(Date.now());
          copy.client.name = `${copy.client.name || 'Kunde'} (kopi)`;
          copy.status = 'Ikke startet';
          copy.createdAt = new Date().toISOString();
          copy.updatedAt = new Date().toISOString();
          state.checks.unshift(copy);
          activeId = copy.id;
          saveState();
          show('editor');
        }
      });

      if (createForm) {
        createForm.addEventListener('submit', (event) => {
          event.preventDefault();
          const data = Object.fromEntries(new FormData(createForm).entries());
          const check = defaultCheck(data);
          state.checks.unshift(check);
          activeId = check.id;
          saveState();
          createForm.reset();
          show('editor');
        });
      }

      if (editorShell) {
        editorShell.addEventListener('input', (event) => {
          const field = event.target.closest('[data-path]');
          if (field) updateFromField(field);
        });
        editorShell.addEventListener('change', (event) => {
          const field = event.target.closest('[data-path]');
          if (field) {
            updateFromField(field);
            renderEditor();
          }
        });
      }

      if ((window.location.hash === '#rapport' || window.location.hash === '#video-script') && state.checks.length) {
        if (!activeId && state.checks.length === 1) activeId = state.checks[0].id;
        show(window.location.hash === '#video-script' ? 'video' : 'report');
      } else {
        renderDashboard();
      }
    })();
  </script>
</Layout>
