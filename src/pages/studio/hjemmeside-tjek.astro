---
import Layout from '../../layouts/Layout.astro';
import '../../styles/global.css';

const statusOptions = ['Ikke startet', 'Under analyse', 'Klar til review', 'Færdig'];
const recommendationOptions = [
  'Kun små tekstrettelser',
  'Hjemmeside-fix',
  'Visuelt løft',
  'Ny struktur anbefales',
  'Ny hjemmeside bør overvejes',
];
const dashboardFilterOptions = ['Alle', ...statusOptions];
---

<Layout
  title="SiteDok Operations CRM | AI Audit"
  description="Internt CRM og audit-studio til manuelle SiteDokAI AI Audits."
  canonical="/studio/hjemmeside-tjek"
  noindex={true}
>
  <main id="main" class="studio-enterprise min-h-[100dvh] px-3 py-3 text-brand sm:px-4 lg:px-5">
    <div class="enterprise-shell mx-auto max-w-[1720px]">
      <aside class="enterprise-rail" aria-label="SiteDok CRM navigation">
        <div>
          <a href="/" class="enterprise-brand" aria-label="SiteDokAI forside">
            <span class="enterprise-brand-mark">SD</span>
            <span>
              <strong>SiteDok</strong>
              <small>Operations CRM</small>
            </span>
          </a>

          <nav class="enterprise-nav" aria-label="Studio">
            <button type="button" data-action="show-dashboard" data-nav-view="dashboard" class="enterprise-nav-link is-active">Oversigt</button>
            <button type="button" data-action="show-create" data-nav-view="create" class="enterprise-nav-link">Ny sag</button>
            <button type="button" data-action="back-to-editor" data-nav-view="editor" class="enterprise-nav-link">Editor</button>
            <button type="button" data-action="show-report" data-nav-view="report" class="enterprise-nav-link">Rapport</button>
            <button type="button" data-action="show-analytics" data-nav-view="analytics" class="enterprise-nav-link">Rapporter</button>
            <button type="button" data-action="show-video" data-nav-view="video" class="enterprise-nav-link">Video-script</button>
          </nav>
        </div>

        <div class="enterprise-rail-card">
          <p class="enterprise-label">Driftsstatus</p>
          <strong>Lokal arbejdsflade</strong>
          <span>Data gemmes i denne browsers localStorage. Ingen crawler, ekstern sending eller AI-generering i denne MVP.</span>
        </div>
      </aside>

      <div class="enterprise-workspace">
        <header class="enterprise-topbar">
          <div>
            <p class="enterprise-kicker">Internt arbejdsrum</p>
            <h1>AI Audit CRM</h1>
            <p>Opret, styr og kvalitetssikre professionelle AI Audits med samme rolige kontrol som et dyrt enterprise-system.</p>
          </div>
          <div class="enterprise-topbar-actions">
            <button type="button" data-action="show-dashboard" class="enterprise-button enterprise-button-secondary">Dashboard</button>
            <button type="button" data-action="show-analytics" class="enterprise-button enterprise-button-secondary">Rapporter</button>
            <button type="button" data-action="show-create" class="enterprise-button enterprise-button-primary">Opret nyt tjek</button>
          </div>
        </header>

        <section class="enterprise-metrics" aria-label="CRM status">
          <article>
            <span>Alle sager</span>
            <strong id="dashboard-total">0</strong>
            <small>Lokale tjek</small>
          </article>
          <article>
            <span>I produktion</span>
            <strong id="dashboard-active">0</strong>
            <small>Under analyse</small>
          </article>
          <article>
            <span>QA-kø</span>
            <strong id="dashboard-review">0</strong>
            <small>Klar til review</small>
          </article>
          <article>
            <span>Færdige</span>
            <strong id="dashboard-done">0</strong>
            <small>Leveret internt</small>
          </article>
        </section>

        <section id="dashboard-view" class="enterprise-panel">
          <div class="enterprise-section-head">
            <div>
              <p class="enterprise-label">Dashboard</p>
              <h2>Pipeline for AI Audit</h2>
              <p>Oversigt over kunder, status og næste tjek der skal åbnes.</p>
            </div>
            <button type="button" data-action="show-create" class="enterprise-button enterprise-button-primary">
              Opret ny AI Audit
            </button>
          </div>

          <div class="enterprise-command-bar">
            <label class="enterprise-search">
              <span>Søg i sager</span>
              <input id="dashboard-search" type="search" placeholder="Kunde, website, branche eller lokation" autocomplete="off" />
            </label>
            <div id="dashboard-filters" class="enterprise-filter-group" aria-label="Filtrer efter status">
              {dashboardFilterOptions.map((option) => (
                <button type="button" data-dashboard-filter={option} class:list={['enterprise-filter', option === 'Alle' && 'is-active']}>{option}</button>
              ))}
            </div>
          </div>

          <div id="dashboard-list" class="mt-5"></div>
        </section>

        <section id="create-view" class="enterprise-panel hidden">
        <div class="mb-6 flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.24em] text-accent-dark">Nyt tjek</p>
            <h2 class="mt-3 font-display text-3xl font-medium tracking-tight text-brand md:text-4xl">Opret AI Audit</h2>
            <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted">Start med kundeinfo. Alt kan redigeres bagefter i rapport-editoren.</p>
          </div>
          <button type="button" data-action="show-dashboard" class="rounded-[0.85rem] border border-border-soft bg-surface px-4 py-2.5 text-sm font-semibold text-brand hover:border-accent/35">
            Tilbage til dashboard
          </button>
        </div>

        <form id="create-form" class="grid gap-4">
          <div class="grid gap-4 md:grid-cols-2">
            <label class="grid gap-2 text-sm font-semibold text-brand">Kundenavn *
              <input name="clientName" required class="rounded-[0.95rem] border border-border-soft bg-surface px-4 py-3 font-normal text-brand outline-none transition focus:border-accent focus:ring-2 focus:ring-accent/16" />
            </label>
            <label class="grid gap-2 text-sm font-semibold text-brand">Website-URL *
              <input name="website" required inputmode="url" placeholder="https://dinvirksomhed.dk" class="rounded-[0.95rem] border border-border-soft bg-surface px-4 py-3 font-normal text-brand outline-none transition focus:border-accent focus:ring-2 focus:ring-accent/16" />
            </label>
          </div>

          <div class="grid gap-4 md:grid-cols-2">
            <label class="grid gap-2 text-sm font-semibold text-brand">Branche
              <input name="industry" placeholder="Fx VVS, klinik, maler" class="rounded-[0.95rem] border border-border-soft bg-surface px-4 py-3 font-normal text-brand outline-none transition focus:border-accent focus:ring-2 focus:ring-accent/16" />
            </label>
            <label class="grid gap-2 text-sm font-semibold text-brand">Lokation
              <input name="location" placeholder="Fx Odense, Aarhus, Sjælland" class="rounded-[0.95rem] border border-border-soft bg-surface px-4 py-3 font-normal text-brand outline-none transition focus:border-accent focus:ring-2 focus:ring-accent/16" />
            </label>
          </div>

          <div class="grid gap-4 md:grid-cols-2">
            <label class="grid gap-2 text-sm font-semibold text-brand">Primære ydelser
              <textarea name="primaryServices" rows="4" placeholder="Fx akut VVS, badeværelser, serviceaftaler" class="resize-y rounded-[0.95rem] border border-border-soft bg-surface px-4 py-3 font-normal text-brand outline-none transition focus:border-accent focus:ring-2 focus:ring-accent/16"></textarea>
            </label>
            <label class="grid gap-2 text-sm font-semibold text-brand">Målgruppe
              <textarea name="targetAudience" rows="4" placeholder="Fx private boligejere, erhverv, lokale kunder" class="resize-y rounded-[0.95rem] border border-border-soft bg-surface px-4 py-3 font-normal text-brand outline-none transition focus:border-accent focus:ring-2 focus:ring-accent/16"></textarea>
            </label>
          </div>

          <label class="grid gap-2 text-sm font-semibold text-brand">Noter fra kunden
            <textarea name="customerNotes" rows="5" placeholder="Hvad skal siden især hjælpe med? Hvad er kunden i tvivl om?" class="resize-y rounded-[0.95rem] border border-border-soft bg-surface px-4 py-3 font-normal text-brand outline-none transition focus:border-accent focus:ring-2 focus:ring-accent/16"></textarea>
          </label>

          <div class="flex flex-wrap gap-3 pt-2">
            <button type="submit" class="inline-flex items-center justify-center rounded-[0.9rem] border border-accent bg-accent px-6 py-3.5 text-sm font-semibold text-white transition hover:border-accent-dark hover:bg-accent-dark">
              Opret og åbn editor
            </button>
            <button type="button" data-action="show-dashboard" class="inline-flex items-center justify-center rounded-[0.9rem] border border-border-soft bg-white px-6 py-3.5 text-sm font-semibold text-brand transition hover:border-accent/35 hover:bg-accent-soft">
              Annullér
            </button>
          </div>
        </form>
      </section>

      <section id="editor-view" class="mt-6 hidden">
        <div id="editor-shell"></div>
      </section>

      <section id="report-view" class="mt-6 hidden">
        <div id="report-shell"></div>
      </section>

      <section id="analytics-view" class="mt-6 hidden">
        <div id="analytics-shell"></div>
      </section>

      <section id="video-view" class="mt-6 hidden">
        <div id="video-shell"></div>
      </section>
      </div>
    </div>
  </main>

  <style is:global>
    .studio-enterprise {
      --crm-blue-900: #18385f;
      --crm-blue-800: #1f4d7c;
      --crm-blue-700: #2f6fb2;
      --crm-blue-600: #3e80c2;
      --crm-blue-100: #eaf4ff;
      --crm-blue-050: #f5f9ff;
      --crm-ink: #172233;
      --crm-muted: rgba(23, 34, 51, 0.62);
      --crm-border: rgba(89, 119, 157, 0.18);
      --crm-surface: rgba(255, 255, 255, 0.84);
      --crm-soft-surface: rgba(247, 251, 255, 0.78);
      min-height: 100dvh;
      background:
        radial-gradient(circle at 94% 2%, rgba(84, 151, 215, 0.18), transparent 28rem),
        radial-gradient(circle at 6% 88%, rgba(191, 220, 244, 0.34), transparent 28rem),
        linear-gradient(135deg, #edf4fb 0%, #f7fbff 48%, #eef5fb 100%);
      font-family: Outfit, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    .enterprise-shell {
      display: grid;
      grid-template-columns: 282px minmax(0, 1fr);
      gap: 14px;
      align-items: start;
    }

    .enterprise-rail,
    .enterprise-topbar,
    .enterprise-panel,
    .enterprise-metrics article {
      border: 1px solid var(--crm-border);
      background: var(--crm-surface);
      box-shadow: 0 24px 60px rgba(38, 74, 112, 0.09);
      backdrop-filter: blur(18px);
    }

    .enterprise-rail {
      position: sticky;
      top: 12px;
      display: flex;
      min-height: calc(100dvh - 24px);
      flex-direction: column;
      justify-content: space-between;
      border-radius: 22px;
      padding: 14px;
    }

    .enterprise-brand {
      display: grid;
      grid-template-columns: 42px minmax(0, 1fr);
      gap: 12px;
      align-items: center;
      border-radius: 16px;
      padding: 10px;
      color: var(--crm-ink);
      text-decoration: none;
    }

    .enterprise-brand-mark {
      display: inline-flex;
      height: 42px;
      width: 42px;
      align-items: center;
      justify-content: center;
      border-radius: 12px;
      background: linear-gradient(135deg, var(--crm-blue-900), var(--crm-blue-600));
      color: #f7fbff;
      font-family: "JetBrains Mono", ui-monospace, monospace;
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.02em;
    }

    .enterprise-brand strong,
    .enterprise-brand small {
      display: block;
    }

    .enterprise-brand strong {
      font-size: 1rem;
      font-weight: 700;
      letter-spacing: -0.01em;
    }

    .enterprise-brand small {
      margin-top: 2px;
      color: var(--crm-muted);
      font-size: 0.76rem;
      font-weight: 600;
    }

    .enterprise-nav {
      display: grid;
      gap: 6px;
      margin-top: 18px;
    }

    .enterprise-nav-link {
      width: 100%;
      border: 0;
      border-radius: 13px;
      background: transparent;
      color: rgba(23, 34, 51, 0.68);
      cursor: pointer;
      font-size: 0.9rem;
      font-weight: 700;
      padding: 11px 12px;
      text-align: left;
      transition:
        background-color 180ms ease,
        color 180ms ease,
        transform 180ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .enterprise-nav-link:hover,
    .enterprise-nav-link.is-active {
      background: rgba(62, 128, 194, 0.1);
      color: var(--crm-blue-900);
    }

    .enterprise-nav-link:active,
    .enterprise-button:active,
    .enterprise-filter:active,
    .studio-enterprise button:active {
      transform: translateY(1px) scale(0.99);
    }

    .enterprise-rail-card {
      border: 1px solid rgba(62, 128, 194, 0.22);
      border-radius: 18px;
      background: linear-gradient(180deg, rgba(234, 244, 255, 0.88), rgba(255, 255, 255, 0.78));
      padding: 14px;
    }

    .enterprise-rail-card strong,
    .enterprise-rail-card span {
      display: block;
    }

    .enterprise-rail-card strong {
      margin-top: 7px;
      color: var(--crm-ink);
      font-size: 0.96rem;
      line-height: 1.25;
    }

    .enterprise-rail-card span {
      margin-top: 8px;
      color: var(--crm-muted);
      font-size: 0.78rem;
      font-weight: 600;
      line-height: 1.55;
    }

    .enterprise-workspace {
      min-width: 0;
    }

    .enterprise-topbar {
      display: flex;
      justify-content: space-between;
      gap: 24px;
      align-items: center;
      border-radius: 24px;
      padding: clamp(18px, 2vw, 26px);
    }

    .enterprise-kicker,
    .enterprise-label {
      color: var(--crm-blue-800);
      font-family: "JetBrains Mono", ui-monospace, monospace;
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    .enterprise-topbar h1,
    .enterprise-section-head h2 {
      color: var(--crm-ink);
      font-family: Outfit, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      font-weight: 700;
      letter-spacing: -0.025em;
      line-height: 1.02;
    }

    .enterprise-topbar h1 {
      margin-top: 10px;
      font-size: clamp(1.9rem, 3.1vw, 3.35rem);
    }

    .enterprise-topbar p:not(.enterprise-kicker),
    .enterprise-section-head p:not(.enterprise-label) {
      max-width: 68ch;
      color: var(--crm-muted);
      font-size: 0.96rem;
      font-weight: 500;
      line-height: 1.65;
    }

    .enterprise-topbar p:not(.enterprise-kicker) {
      margin-top: 12px;
    }

    .enterprise-topbar-actions,
    .enterprise-section-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }

    .enterprise-topbar-actions {
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    .enterprise-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 42px;
      border-radius: 12px;
      cursor: pointer;
      font-size: 0.86rem;
      font-weight: 800;
      padding: 0.72rem 1rem;
      text-decoration: none;
      transition:
        border-color 180ms ease,
        background-color 180ms ease,
        color 180ms ease,
        transform 180ms cubic-bezier(0.16, 1, 0.3, 1),
        box-shadow 180ms ease;
      white-space: nowrap;
    }

    .enterprise-button-primary {
      border: 1px solid var(--crm-blue-800);
      background: linear-gradient(180deg, var(--crm-blue-700), var(--crm-blue-800));
      color: #f7fbff;
      box-shadow: 0 14px 30px rgba(31, 77, 124, 0.22);
    }

    .enterprise-button-primary:hover {
      background: linear-gradient(180deg, var(--crm-blue-600), var(--crm-blue-800));
      border-color: var(--crm-blue-900);
    }

    .enterprise-button-secondary {
      border: 1px solid rgba(89, 119, 157, 0.18);
      background: rgba(255, 255, 255, 0.82);
      color: var(--crm-ink);
    }

    .enterprise-button-secondary:hover {
      border-color: rgba(62, 128, 194, 0.34);
      background: rgba(234, 244, 255, 0.82);
    }

    .enterprise-metrics {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 12px;
      margin-top: 14px;
    }

    .enterprise-metrics article {
      border-radius: 18px;
      padding: 16px;
    }

    .enterprise-metrics span,
    .enterprise-metrics small {
      display: block;
      color: rgba(23, 34, 51, 0.56);
      font-size: 0.74rem;
      font-weight: 700;
    }

    .enterprise-metrics strong {
      display: block;
      margin-top: 9px;
      color: var(--crm-ink);
      font-family: "JetBrains Mono", ui-monospace, monospace;
      font-size: clamp(1.7rem, 3vw, 2.45rem);
      font-variant-numeric: tabular-nums;
      line-height: 1;
    }

    .enterprise-metrics small {
      margin-top: 8px;
    }

    .enterprise-panel {
      margin-top: 14px;
      border-radius: 24px;
      padding: clamp(18px, 2vw, 28px);
    }

    .enterprise-section-head {
      align-items: flex-end;
    }

    .enterprise-section-head h2 {
      margin-top: 8px;
      font-size: clamp(1.6rem, 2.5vw, 2.35rem);
    }

    .enterprise-section-head p:not(.enterprise-label) {
      margin-top: 8px;
    }

    .enterprise-command-bar {
      display: grid;
      grid-template-columns: minmax(260px, 420px) minmax(0, 1fr);
      gap: 12px;
      align-items: end;
      margin-top: 22px;
      border: 1px solid rgba(89, 119, 157, 0.16);
      border-radius: 18px;
      background: rgba(244, 249, 255, 0.76);
      padding: 12px;
    }

    .enterprise-search {
      display: grid;
      gap: 7px;
      color: rgba(23, 34, 51, 0.62);
      font-size: 0.74rem;
      font-weight: 800;
    }

    .enterprise-search input,
    .studio-enterprise input,
    .studio-enterprise textarea,
    .studio-enterprise select {
      border-color: rgba(89, 119, 157, 0.23) !important;
      background-color: rgba(255, 255, 255, 0.82) !important;
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.72);
    }

    .enterprise-search input {
      width: 100%;
      border: 1px solid rgba(89, 119, 157, 0.23);
      border-radius: 12px;
      color: var(--crm-ink);
      font-size: 0.93rem;
      font-weight: 600;
      outline: none;
      padding: 0.8rem 0.9rem;
    }

    .enterprise-search input:focus,
    .studio-enterprise input:focus,
    .studio-enterprise textarea:focus,
    .studio-enterprise select:focus {
      border-color: rgba(62, 128, 194, 0.62) !important;
      box-shadow: 0 0 0 3px rgba(62, 128, 194, 0.16) !important;
    }

    .enterprise-filter-group {
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: 8px;
    }

    .enterprise-filter {
      border: 1px solid rgba(89, 119, 157, 0.17);
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.62);
      color: rgba(23, 34, 51, 0.64);
      cursor: pointer;
      font-size: 0.78rem;
      font-weight: 800;
      padding: 0.58rem 0.76rem;
      transition:
        background-color 180ms ease,
        border-color 180ms ease,
        color 180ms ease,
        transform 180ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .enterprise-filter:hover,
    .enterprise-filter.is-active {
      border-color: rgba(31, 77, 124, 0.22);
      background: var(--crm-blue-800);
      color: #f7fbff;
    }

    .crm-table-shell {
      overflow: hidden;
      border: 1px solid rgba(89, 119, 157, 0.16);
      border-radius: 18px;
      background: rgba(255, 255, 255, 0.7);
    }

    .crm-table-scroll {
      overflow-x: auto;
    }

    .crm-enterprise-table {
      width: 100%;
      min-width: 860px;
      border-collapse: collapse;
    }

    .crm-enterprise-table th,
    .crm-enterprise-table td {
      border-bottom: 1px solid rgba(89, 119, 157, 0.13);
      padding: 14px 16px;
      text-align: left;
      vertical-align: middle;
    }

    .crm-enterprise-table th {
      background: rgba(244, 249, 255, 0.86);
      color: rgba(23, 34, 51, 0.54);
      font-family: "JetBrains Mono", ui-monospace, monospace;
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .crm-enterprise-table td {
      color: rgba(23, 34, 51, 0.76);
      font-size: 0.9rem;
      font-weight: 600;
    }

    .crm-enterprise-table tr:last-child td {
      border-bottom: 0;
    }

    .crm-enterprise-table tbody tr {
      transition: background-color 150ms ease;
    }

    .crm-enterprise-table tbody tr:hover {
      background: rgba(234, 244, 255, 0.62);
    }

    .crm-primary-cell strong,
    .crm-primary-cell a {
      display: block;
    }

    .crm-primary-cell strong {
      color: var(--crm-ink);
      font-size: 0.98rem;
      letter-spacing: -0.01em;
    }

    .crm-primary-cell a {
      margin-top: 4px;
      color: var(--crm-blue-800);
      font-size: 0.78rem;
      font-weight: 800;
      text-decoration-color: rgba(82, 107, 85, 0.28);
      text-underline-offset: 4px;
    }

    .crm-muted-line {
      color: rgba(23, 34, 51, 0.52);
      font-size: 0.78rem;
      font-weight: 700;
    }

    .crm-actions {
      display: flex;
      justify-content: flex-end;
      gap: 8px;
    }

    .crm-action {
      border-radius: 11px;
      font-size: 0.78rem;
      font-weight: 800;
      padding: 0.58rem 0.75rem;
    }

    .status-chip {
      display: inline-flex;
      align-items: center;
      border: 1px solid rgba(89, 119, 157, 0.2);
      border-radius: 999px;
      font-family: "JetBrains Mono", ui-monospace, monospace;
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.02em;
      padding: 0.42rem 0.62rem;
      white-space: nowrap;
    }

    .status-chip--done {
