---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import AdvisoryPage from '../../components/site/AdvisoryPage.astro';
import '../../styles/global.css';
---

<Layout
  title="Når virksomheden er bedre end hjemmesiden viser | SiteDokAI"
  description="Om klarhed, trust og første indtryk som del af agentic search."
  canonical="/blog/vi-hjaelper-ogsaa-med-hjemmesider-og-brand-assets"
>
  <Nav />
  <AdvisoryPage
    eyebrow="Note"
    title="Hvis hjemmesiden føles uklar, bliver virksomheden sværere at vælge."
    text="Visuelt udtryk er ikke pynt i agentic search. Det støtter tillid, klarhed og det kildegrundlag, som både mennesker og AI vurderer jer ud fra."
    points={[
      'Færre støjende elementer og tydeligere hierarki.',
      'Bedre sammenhæng mellem tekst, beviser og kontaktvej.',
      'Et første indtryk der matcher virksomhedens reelle niveau.',
    ]}
  />
  <Footer />
</Layout>
