---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import AdvisoryPage from '../../components/site/AdvisoryPage.astro';
import '../../styles/global.css';
---

<Layout
  title="Når hverdagen holdes sammen af manuelle overleveringer | SiteDokAI"
  description="Om de små huller i arbejdsgange, der skaber friktion, fejl og opfølgningsarbejde."
  canonical="/blog/vi-hjaelper-ogsaa-med-hjemmesider-og-brand-assets"
>
  <Nav />
  <AdvisoryPage
    eyebrow="Note"
    title="Hvis hverdagen kun virker, fordi folk husker detaljerne, er processen for skrøbelig."
    text="Manuelle overleveringer, løse noter og statusjagt virker ofte længe nok til, at problemet bliver usynligt. Men det stjæler tid, skaber fejl og gør nye medarbejdere afhængige af mundtlig viden."
    points={[
      'Gør input, ansvar og næste handling tydelige.',
      'Lad AI strukturere udkast, opsummeringer og afvigelser.',
      'Behold menneskelig godkendelse på de steder, hvor vurdering betyder noget.',
    ]}
    ctaLabel="Send workflow"
  />
  <Footer />
</Layout>
