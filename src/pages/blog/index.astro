---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';

const posts = [
  {
    title: 'Google I/O 2026: agentic search rykker ind i Search',
    description: 'Google har annonceret Search agents og en intelligent Search box. Her er hvad det betyder for synlighed, B2B-research og lokale valg.',
    href: '/blog/google-agentic-search-2026',
    tag: 'Agentic search',
  },
  {
    title: 'Synlighed starter med en hjemmeside der kan forstås',
    description: 'Hvis siden ikke forklarer ydelser, beviser og næste skridt tydeligt, mister den både kunder og synlighed.',
    href: '/blog/geo-hvad-er-det',
    tag: 'Synlighed',
  },
  {
    title: 'Visuelt løft: når virksomheden er bedre end hjemmesiden viser',
    description: 'Om hjemmesider, billeder og brandflader der skal føles mere klare, troværdige og professionelle.',
    href: '/blog/vi-hjaelper-ogsaa-med-hjemmesider-og-brand-assets',
    tag: 'Visuelt løft',
  },
];
---

<Layout
  title="Blog | SiteDokAI"
  description="Korte tekster om agentic search, AI-synlighed, hjemmesider, klarhed, tillid, struktur, CTA og visuelt løft."
>
  <Nav />
  <main id="main">
    <section class="border-b border-[#e6ddd1] bg-white">
      <div class="mx-auto max-w-6xl px-6 py-20 md:py-28">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-accent">Blog</p>
        <h1 class="mt-5 max-w-4xl font-display text-4xl font-extrabold tracking-tight text-brand md:text-6xl">
          Praktiske noter om synlighed i AI, agentic search og hjemmesider der skal skabe mere tillid.
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-brand/70">
          Ingen tung teori. Bare konkrete vinkler på de ting, der gør en virksomhed lettere at finde, forstå, stole på og handle på.
        </p>
      </div>
    </section>

    <section class="bg-[#f6f1e8]">
      <div class="mx-auto grid max-w-6xl gap-5 px-6 py-16 md:grid-cols-2 md:py-24">
        {posts.map((post) => (
          <a href={post.href} class="group rounded-[1.8rem] border border-[#ddd1bf] bg-white p-7 transition-colors hover:bg-[#fbf8f3]">
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-accent">{post.tag}</p>
            <h2 class="mt-4 font-display text-3xl font-bold tracking-tight text-brand">{post.title}</h2>
            <p class="mt-4 text-base leading-relaxed text-brand/70">{post.description}</p>
            <span class="mt-6 inline-flex text-sm font-bold text-brand group-hover:text-accent">Læs artiklen</span>
          </a>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</Layout>
