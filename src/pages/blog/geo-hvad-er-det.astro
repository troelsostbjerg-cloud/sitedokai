---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import AdvisoryPage from '../../components/site/AdvisoryPage.astro';
import '../../styles/global.css';
---

<Layout
  title="Klar struktur før værktøjer | SiteDokAI"
  description="Hvorfor AI først skaber værdi, når processen bag er forståelig."
  canonical="/blog/geo-hvad-er-det"
>
  <Nav />
  <AdvisoryPage
    eyebrow="Note"
    title="AI virker bedst, når processen kan forklares."
    text="Mange starter med værktøjet. Men hvis trigger, input, ansvar, regler, godkendelse og output er uklare, bliver AI bare endnu et løst lag oven på en uklar proces."
    points={[
      'Find først hvor arbejdet går i stå.',
      'Kortlæg det faktiske workflow, ikke den pæne proces på papiret.',
      'Byg én lille løsning med menneskelig godkendelse hvor det giver mening.',
    ]}
    ctaLabel="Send workflow"
  />
  <Footer />
</Layout>
