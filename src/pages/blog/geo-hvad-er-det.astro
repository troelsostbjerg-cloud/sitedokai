---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import AdvisoryPage from '../../components/site/AdvisoryPage.astro';
import '../../styles/global.css';
---

<Layout
  title="Synlighed starter med klarhed | SiteDokAI"
  description="Hvorfor agentic search kræver klare ydelser, beviser og næste skridt."
  canonical="/blog/geo-hvad-er-det"
>
  <Nav />
  <AdvisoryPage
    eyebrow="Note"
    title="Synlighed starter med en hjemmeside, der kan forstås."
    text="AI kan ikke anbefale det, den ikke kan forklare. Derfor er klarhed om ydelser, målgrupper, beviser og næste skridt stadig det vigtigste sted at starte."
    points={[
      'Skriv så en kunde og en AI-agent kan forstå det uden forklaring.',
      'Gør beviser, cases og lokation tydelige.',
      'Svar på de spørgsmål der afgør valget.',
    ]}
  />
  <Footer />
</Layout>
