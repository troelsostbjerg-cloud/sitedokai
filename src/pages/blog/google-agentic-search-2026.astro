---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import AdvisoryPage from '../../components/site/AdvisoryPage.astro';
import '../../styles/global.css';
---

<Layout
  title="Proof-of-work: AI-søgning som procesprojekt | SiteDokAI"
  description="Et tidligere SiteDokAI-projekt om AI-søgning bruges nu som proof-of-work for praktisk AI-procesbygning."
  canonical="/blog/google-agentic-search-2026"
>
  <Nav />
  <AdvisoryPage
    eyebrow="Proof-of-work"
    title="Et tidligere AI-søgningsprojekt blev bygget som en workflow, ikke som marketingteori."
    text="SiteDokAI startede med en pipeline, der undersøgte hvordan virksomheder blev forstået i AI-svar. Det er nu proof-of-work for arbejdsformen: find et uklart problem, kortlæg processen, byg en konkret workflow og lever et beslutningsgrundlag."
    points={[
      'Problem: virksomheder vidste ikke hvordan AI-svar beskrev dem.',
      'Workflow: testspørgsmål, svarindsamling, strukturering, vurdering og rapport.',
      'Læring: værdien lå i proceskortlægning og brugbart beslutningsgrundlag.',
    ]}
    note="Agentic search er derfor ikke længere SiteDokAIs hovedprodukt. Det er et eksempel på, hvordan praktiske AI-workflows kan bygges rundt om et rigtigt problem."
    ctaLabel="Send workflow"
  />
  <Footer />
</Layout>
