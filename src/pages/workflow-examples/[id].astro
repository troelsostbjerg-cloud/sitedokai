---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import WorkflowExamplePage from '../../components/site/WorkflowExamplePage.astro';
import { breadcrumbSchema, workflowExamples, workflowExampleSchema, type WorkflowExample } from '../../data/aiContent';
import '../../styles/global.css';

interface Props {
  workflowExample: WorkflowExample;
}

export function getStaticPaths() {
  return workflowExamples.map((workflowExample) => ({
    params: { id: workflowExample.id },
    props: { workflowExample },
  }));
}

const { workflowExample } = Astro.props;

const structuredData = [
  workflowExampleSchema(workflowExample),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Workflow examples', path: '/workflow-examples' },
    { name: workflowExample.title, path: workflowExample.path },
  ]),
];
---

<Layout
  title={`${workflowExample.title} — SiteDokAI`}
  description={workflowExample.description}
  canonical={workflowExample.path}
  structuredData={structuredData}
>
  <Nav />
  <WorkflowExamplePage workflowExample={workflowExample} />
  <Footer />
</Layout>
