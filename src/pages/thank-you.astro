---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/site/Button.astro';
import '../styles/global.css';
---

<Layout
  title="Thanks — SiteDokAI"
  description="Thanks for sending your workflow to SiteDokAI."
  canonical="/thank-you"
  noindex={true}
>
  <Nav />
  <main id="main" class="bg-canvas text-brand">
    <section class="mx-auto grid min-h-[70dvh] max-w-7xl content-center gap-12 px-5 py-16 sm:px-6 md:py-24 lg:grid-cols-[0.72fr_1.28fr]">
      <aside class="text-sm leading-relaxed text-muted">
        <p class="font-mono text-xs uppercase tracking-[0.22em] text-accent">Received</p>
      </aside>
      <div>
        <h1 class="max-w-4xl font-display text-5xl font-semibold leading-[1.02] text-brand md:text-7xl">
          Thanks. We received your workflow.
        </h1>
        <p class="mt-8 max-w-2xl text-xl leading-relaxed text-brand/70">
          SiteDokAI will reply with a practical next step, including if AI is not the right first step.
        </p>
        <div class="mt-10">
          <Button href="/">Back to home</Button>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
