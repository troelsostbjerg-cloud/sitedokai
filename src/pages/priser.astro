---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const services = [
  {
    tag: 'Hovedprodukt',
    title: 'AI Audit + Client Room',
    price: '2.495 kr',
    purpose: 'Find ud af om virksomheden bliver fundet og anbefalet i AI.',
    included: [
      'privat Client Room',
      'AI-synlighedsscore',
      'ChatGPT, Gemini, Claude og Google AI',
      'tabte søgninger',
      'konkurrentbillede',
      'kilder og trust',
      'prioriterede handlinger',
      'Executive PDF',
    ],
    cta: { label: 'Bestil AI Audit', href: '/hjemmeside-tjek#bestil' },
  },
  {
    tag: 'Sekundær ydelse',
    title: 'Hjemmeside-fix',
    price: '6.500-12.500 kr',
    purpose: 'Ret tekst, struktur og CTA.',
    included: [
      'omskrivning af forside',
      'ny hero-sektion',
      'serviceblokke',
      'trust-sektion',
      'FAQ',
      'CTAer',
      'tekststruktur',
    ],
    cta: { label: 'Se Hjemmeside-fix', href: '/hjemmeside-fix' },
  },
  {
    tag: 'Sekundær ydelse',
    title: 'Visuelt løft',
    price: 'Fra 9.500 kr',
    purpose: 'Ret design, billeder og professionelt udtryk.',
    included: [
      'visuelt førstehåndsindtryk',
      'billedstil',
      'layoutforbedringer',
      'brand-assets',
      'før/efter-præsentation',
      'mere professionelt udtryk',
    ],
    cta: { label: 'Se Visuelt løft', href: '/visuelt-loeft' },
  },
];

const faqs = [
  {
    q: 'Hvad skal jeg starte med?',
    a: 'Start med gratis AI-tjek, hvis du ikke ved om problemet findes. Gå videre til AI Audit + Client Room, Hjemmeside-fix eller Visuelt løft, når problemet er tydeligt.',
  },
  {
    q: 'Er AI Audit bare en rapport?',
    a: 'Nej. Client Room er hovedleverancen. PDFen er kun den korte eksport, når status og næste handlinger skal deles.',
  },
  {
    q: 'Kan I også rette siden bagefter?',
    a: 'Ja. Hjemmeside-fix retter tekst, struktur og CTA. Visuelt løft retter design, billeder og professionelt udtryk.',
  },
];
---

<Layout
  title="Ydelser og priser | SiteDokAI"
  description="AI Audit + Client Room til 2.495 kr, Hjemmeside-fix til 6.500-12.500 kr og Visuelt løft fra 9.500 kr."
>
  <Nav />
  <main id="main">
    <section class="border-b border-[#e6ddd1] bg-white">
      <div class="mx-auto max-w-6xl px-6 py-20 md:py-28">
        <div class="max-w-3xl">
          <p class="mb-4 text-sm font-semibold uppercase tracking-[0.18em] text-accent">Ydelser og priser</p>
          <h1 class="font-display text-4xl font-extrabold tracking-tight text-brand md:text-6xl">
            Først findbarhed i AI. Derefter rettelser.
          </h1>
          <p class="mt-6 text-lg leading-relaxed text-brand/70">
            Start med at se om virksomheden bliver fundet, nævnt og anbefalet i AI. Ret derefter tekst, kilder, struktur eller visuelt udtryk, hvis det er det næste rigtige skridt.
          </p>
        </div>
      </div>
    </section>

    <section class="border-b border-[#e6ddd1] bg-[#f6f1e8]">
      <div class="mx-auto max-w-6xl px-6 py-20 md:py-28">
        <div class="grid gap-5 lg:grid-cols-3">
          {services.map((service) => (
            <article class="flex flex-col rounded-xl border border-[#e0d6c8] bg-white p-7 shadow-[0_18px_46px_rgba(31,42,51,0.04)]">
              <p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent">{service.tag}</p>
              <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-brand">{service.title}</h2>
              <div class="mt-4 font-display text-3xl font-bold tracking-tight text-brand/80">{service.price}</div>
              <p class="mt-4 text-base leading-relaxed text-brand/70">
                <strong class="font-semibold text-brand">Formål:</strong> {service.purpose}
              </p>
              <div class="mt-6 grid gap-2">
                {service.included.map((item) => (
                  <div class="rounded-lg border border-[#e6ddd1] bg-[#fbf8f3] px-4 py-3 text-sm text-brand/70">{item}</div>
                ))}
              </div>
              <a href={service.cta.href} class="mt-6 inline-flex items-center justify-center rounded-md bg-brand px-5 py-3 text-sm font-bold text-white transition-colors hover:bg-brand-light">
                {service.cta.label}
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-white">
      <div class="mx-auto max-w-4xl px-6 py-20 md:py-24">
        <h2 class="font-display text-3xl font-bold tracking-tight text-brand md:text-4xl">Ofte stillede spørgsmål</h2>
        <div class="mt-10 space-y-8">
          {faqs.map((faq) => (
            <article class="border-b border-[#e6ddd1] pb-8">
              <h3 class="font-display text-xl font-bold tracking-tight text-brand">{faq.q}</h3>
              <p class="mt-3 text-base leading-relaxed text-brand/68">{faq.a}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
