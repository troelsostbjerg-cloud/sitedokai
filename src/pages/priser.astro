---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AdvisoryPage from '../components/site/AdvisoryPage.astro';
import '../styles/global.css';
---

<Layout
  title="Forløb og pris | SiteDokAI"
  description="Priser for Manual Work Audit, AI Workflow Sprint og AI Operations Partner hos SiteDokAI."
  canonical="/priser"
>
  <Nav />
  <AdvisoryPage
    eyebrow="Pris"
    title="Start småt. Bevis værdien. Byg videre."
    text="SiteDokAI arbejder med tre enkle forløb, så I kan starte med en konkret proces i stedet for et stort AI-roadmap."
    points={[
      'Manual Work Audit: fra 15.000 kr. ekskl. moms.',
      'AI Workflow Sprint: fra 35.000 kr. ekskl. moms.',
      'AI Operations Partner: fra 10.000 kr. pr. måned.',
    ]}
    note="Priserne er startpunkter. Scope afhænger af antal workflows, adgang til værktøjer, testbehov og hvor meget forankring der kræves."
    ctaLabel="Send workflow"
  />
  <Footer />
</Layout>
