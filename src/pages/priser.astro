---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AdvisoryPage from '../components/site/AdvisoryPage.astro';
import '../styles/global.css';
---

<Layout
  title="Forløb og pris | SiteDokAI"
  description="SiteDokAI starter med en første samtale og screening uden beregning. Et eventuelt forløb aftales efter behov."
  canonical="/priser"
>
  <Nav />
  <AdvisoryPage
    eyebrow="Pris"
    title="Vi prissætter ikke problemet, før vi ved hvad problemet er."
    text="Agentic search kan være et lille klarhedsproblem eller et større strategisk forløb. Derfor starter vi med en gratis screening og anbefaler først et betalt forløb, hvis der er en konkret opgave."
    points={[
      'Første samtale og screening: uden beregning.',
      'Diagnose eller workshop: aftales efter scope.',
      'Implementering: kun hvis der er tydelige ændringer at lave.',
    ]}
    note="Den vigtigste pointe er, at vi ikke sælger en stor pakke, før vi ved om det giver mening."
  />
  <Footer />
</Layout>
