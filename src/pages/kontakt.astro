---
import Layout from '../layouts/Layout.astro';

const email = 'info@sitedokai.com';
const subject = 'En konkret AI-udfordring fra vores hverdag';
const body = `Hej Troels,

Vi vil gerne tale om en konkret AI-udfordring.

Virksomhed og team:

Opgaven eller arbejdsgangen:

Det har vi allerede prøvet:

Det vil være værdifuldt, hvis:

Bedste måde at kontakte mig på:

Venlig hilsen`;
const mailHref = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
const linkedInHref = 'https://www.linkedin.com/in/troels-%C3%B8stbjerg-37757726';
---

<Layout
  title="Kontakt Troels | SiteDokAI"
  description="Fortæl Troels om den konkrete arbejdsgang, AI-udfordring eller adoptionsopgave, I gerne vil flytte fra ambition til praksis."
  canonical="/kontakt/"
>
  <section class="section-shell">
    <div class="container-page grid gap-12 lg:grid-cols-[minmax(0,1.2fr)_minmax(19rem,0.8fr)] lg:items-start lg:gap-20">
      <div class="reveal">
        <p class="eyebrow">Kontakt</p>
        <h1 class="mt-5 max-w-4xl font-display text-4xl leading-[1.02] tracking-[-0.045em] sm:text-5xl lg:text-6xl">
          Fortæl mig, hvor AI-arbejdet møder virkeligheden.
        </h1>
        <p class="mt-7 max-w-2xl text-lg leading-relaxed text-muted sm:text-xl">
          Det behøver ikke være et færdigt projekt. En genstridig arbejdsgang, et pilotforsøg der
          står stille eller et team, der mangler en praktisk vej ind i AI, er et godt sted at starte.
        </p>

        <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a class="btn btn-primary" href={mailHref}>Skriv til mig</a>
          <a class="btn btn-secondary" href={linkedInHref} target="_blank" rel="noopener noreferrer">Find mig på LinkedIn</a>
        </div>

        <p class="mt-6 text-sm text-muted">
          Mailen åbner med en kort skabelon. Du kan også skrive direkte til{' '}
          <a class="rule-link" href={`mailto:${email}`}>{email}</a>.
        </p>
      </div>

      <aside class="paper-panel reveal p-7 sm:p-9" aria-labelledby="send-heading">
        <p class="eyebrow">Gør første svar bedre</p>
        <h2 id="send-heading" class="mt-4 font-display text-3xl leading-tight tracking-[-0.035em]">Send gerne fire ting</h2>
        <ol class="mt-7 divide-y divide-brand/10 border-y border-brand/10">
          <li class="grid grid-cols-[2rem_1fr] gap-3 py-4">
            <span class="number-mark" aria-hidden="true">01</span>
            <p class="leading-relaxed text-muted">Hvilken virksomhed og hvilket team det handler om.</p>
          </li>
          <li class="grid grid-cols-[2rem_1fr] gap-3 py-4">
            <span class="number-mark" aria-hidden="true">02</span>
            <p class="leading-relaxed text-muted">Den konkrete opgave eller arbejdsgang, der skal fungere bedre.</p>
          </li>
          <li class="grid grid-cols-[2rem_1fr] gap-3 py-4">
            <span class="number-mark" aria-hidden="true">03</span>
            <p class="leading-relaxed text-muted">Hvad I allerede har prøvet, og hvor det går i stå.</p>
          </li>
          <li class="grid grid-cols-[2rem_1fr] gap-3 py-4">
            <span class="number-mark" aria-hidden="true">04</span>
            <p class="leading-relaxed text-muted">Hvad der konkret ville være lettere eller bedre, hvis det lykkes.</p>
          </li>
        </ol>
        <p class="mt-6 text-sm leading-relaxed text-muted">
          Jeg læser selv din besked og svarer selv. Hvis AI ikke er det rigtige første skridt, siger
          jeg det også.
        </p>
      </aside>
    </div>
  </section>

  <section class="section-shell border-t border-brand/10">
    <div class="container-page">
      <div class="reveal max-w-3xl">
        <p class="eyebrow">Ingen formular og ingen salgstragt</p>
        <h2 class="mt-3 font-display text-3xl leading-tight tracking-[-0.035em]">Bare en direkte samtale med den rådgiver, der skal hjælpe.</h2>
      </div>
    </div>
  </section>
</Layout>
