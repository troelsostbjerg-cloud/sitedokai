---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const contactEmail = 'info@sitedokai.com';
const contactFormAction = `https://formsubmit.co/${contactEmail}`;
const contactAjaxAction = `https://formsubmit.co/ajax/${contactEmail}`;
const contactNextUrl = 'https://sitedokai.com/tak-for-henvendelsen?type=kontakt';
const directContactMailto = `mailto:${contactEmail}?subject=${encodeURIComponent('SiteDokAI henvendelse')}&body=${encodeURIComponent(`Hej SiteDokAI,

Jeg vil gerne høre om:

Navn:
Firma:
Hjemmeside:
Branche:
Kort besked:

Tak.`)}`;

const entryCards = [
  {
    title: 'Gratis AI-tjek',
    text: 'Hvis du vil vide om virksomheden bliver fundet og nævnt i AI, er dette den enkleste start.',
    cta: 'Gå til gratis AI-tjek',
    href: '/gratis-mini-tjek',
  },
  {
    title: 'AI Audit',
    text: 'Hvis du vil have fuld test, Client Room, konkurrentbillede, kilder og Executive PDF.',
    cta: 'Se AI Audit',
    href: '/hjemmeside-tjek',
  },
  {
    title: 'Hjemmeside-fix',
    text: 'Hvis tekst, struktur og kontaktknapper skal rettes, efter problemerne er fundet.',
    cta: 'Se Hjemmeside-fix',
    href: '/hjemmeside-fix',
  },
  {
    title: 'Visuelt løft',
    text: 'Hvis design, billeder og førstehåndsindtryk skal virke mere professionelt.',
    cta: 'Se Visuelt løft',
    href: '/visuelt-loeft',
  },
];
---

<Layout
  title="Kontakt os | SiteDokAI"
  description="Er du i tvivl om, hvor du skal starte? Kontakt SiteDokAI eller begynd med et gratis AI-tjek af din hjemmeside."
  canonical="/kontakt"
>
  <Nav />
  <main id="main" class="bg-canvas text-brand">
    <section class="border-b border-border-soft bg-surface/72">
      <div class="mx-auto max-w-5xl px-5 pb-11 pt-12 sm:px-6 md:pb-14 md:pt-16">
        <p class="text-xs font-semibold uppercase tracking-[0.28em] text-accent-dark">Kontakt</p>
        <h1 class="mt-5 font-display text-5xl font-medium leading-[0.98] tracking-tight text-brand md:text-6xl">
          Kontakt os
        </h1>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted">
          Er du i tvivl om, hvor du skal starte? Vi hjælper dig med at finde ud af, om AI kan finde og anbefale virksomheden.
        </p>
      </div>
    </section>

    <section class="border-b border-border-soft">
      <div class="mx-auto max-w-5xl px-5 pb-12 pt-7 sm:px-6 md:pb-15 md:pt-9">
        <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
          {entryCards.map((card) => (
            <article class="flex min-h-[14rem] flex-col rounded-[1.25rem] border border-border-soft bg-white/76 p-5 shadow-[0_14px_36px_rgba(32,38,34,0.035)] sm:p-6">
              <h2 class="font-display text-2xl font-medium tracking-tight text-brand">{card.title}</h2>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{card.text}</p>
              <a
                href={card.href}
                class="mt-6 inline-flex items-center justify-center rounded-[0.9rem] border border-accent bg-accent px-5 py-3 text-sm font-semibold text-white transition duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] hover:border-accent-dark hover:bg-accent-dark focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent active:translate-y-px"
              >
                {card.cta}
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="formular" class="border-b border-border-soft">
      <div class="mx-auto grid max-w-5xl gap-8 px-5 py-12 sm:px-6 md:py-16 lg:grid-cols-[0.74fr_1.26fr] lg:items-start">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.28em] text-accent-dark">Skriv her</p>
          <h2 class="mt-4 font-display text-4xl font-medium leading-tight tracking-tight text-brand">
            Send besked
          </h2>
          <p class="mt-4 max-w-xl text-base leading-relaxed text-muted">
            Skriv hvad du vil starte med. Hvis du er i tvivl, vælg gratis AI-tjek og send dit link.
          </p>
          <p class="mt-5 max-w-xl rounded-[0.95rem] border border-accent/18 bg-white/70 px-4 py-3 text-sm leading-relaxed text-brand/76">
            Virker knappen ikke? Send direkte til info@sitedokai.com med link til din hjemmeside.
          </p>
        </div>

        <form
          action={contactFormAction}
          method="POST"
          data-ajax-email-form
          data-ajax-action={contactAjaxAction}
          data-lead-backup-action="/api/leads"
          data-lead-type="kontakt"
          data-pending-label="Sender..."
          class="grid gap-4 rounded-[1.25rem] border border-border-soft bg-white/76 p-5 shadow-[0_14px_36px_rgba(32,38,34,0.045)] md:p-6"
        >
          <input type="hidden" name="_subject" value="Ny henvendelse fra sitedokai.com" />
          <input type="hidden" name="_template" value="table" />
          <input type="hidden" name="_captcha" value="false" />
          <input type="hidden" name="_next" value={contactNextUrl} />
          <input type="hidden" name="source_page" value="/kontakt" />
          <input type="text" name="_honey" tabindex="-1" autocomplete="off" class="hidden" />
          <noscript>
            <p class="rounded-[0.85rem] border border-accent/18 bg-accent-soft/45 px-4 py-3 text-sm leading-relaxed text-brand/74">
              Formularen virker bedst med JavaScript. Du kan også sende direkte til <a href={directContactMailto} class="font-semibold underline decoration-accent/45 underline-offset-4">info@sitedokai.com</a> med link til din hjemmeside.
            </p>
          </noscript>

          <div>
            <label for="interest" class="mb-2 block text-sm font-semibold text-brand">Hvad handler det om? *</label>
            <select id="interest" name="interest" required class="w-full rounded-[0.95rem] border border-border-soft bg-surface px-4 py-3 text-brand transition-colors focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/16">
              <option value="Gratis AI-tjek">Gratis AI-tjek</option>
              <option value="AI Audit + Client Room">AI Audit + Client Room</option>
              <option value="Hjemmeside-fix">Hjemmeside-fix</option>
              <option value="Visuelt løft">Visuelt løft</option>
            </select>
          </div>

          <div class="grid gap-4 md:grid-cols-2">
            <div>
              <label for="mini_check_name" class="mb-2 block text-sm font-semibold text-brand">Navn *</label>
              <input type="text" id="mini_check_name" name="name" required autocomplete="name" class="w-full rounded-[0.95rem] border border-border-soft bg-surface px-4 py-3 text-brand placeholder:text-muted/45 transition-colors focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/16" />
            </div>

            <div>
              <label for="mini_check_email" class="mb-2 block text-sm font-semibold text-brand">Email *</label>
              <input type="email" id="mini_check_email" name="email" required autocomplete="email" class="w-full rounded-[0.95rem] border border-border-soft bg-surface px-4 py-3 text-brand placeholder:text-muted/45 transition-colors focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/16" />
            </div>
          </div>

          <div>
            <label for="mini_check_website" class="mb-2 block text-sm font-semibold text-brand">Hjemmeside-link *</label>
            <input type="text" id="mini_check_website" name="website" required inputmode="url" autocomplete="url" autocapitalize="none" spellcheck="false" placeholder="dinvirksomhed.dk" class="w-full rounded-[0.95rem] border border-border-soft bg-surface px-4 py-3 text-brand placeholder:text-muted/45 transition-colors focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/16" />
          </div>

          <div>
            <label for="mini_check_industry" class="mb-2 block text-sm font-semibold text-brand">Branche</label>
            <input type="text" id="mini_check_industry" name="branche" autocomplete="organization-title" placeholder="Fx klinik, rådgiver eller håndværker" class="w-full rounded-[0.95rem] border border-border-soft bg-surface px-4 py-3 text-brand placeholder:text-muted/45 transition-colors focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/16" />
          </div>

          <div>
            <label for="mini_check_message" class="mb-2 block text-sm font-semibold text-brand">Kort besked</label>
            <textarea id="mini_check_message" name="message" rows="4" placeholder="Skriv gerne hvad siden især skal hjælpe med." class="w-full resize-y rounded-[0.95rem] border border-border-soft bg-surface px-4 py-3 text-brand placeholder:text-muted/45 transition-colors focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/16"></textarea>
          </div>

          <div>
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
              <button type="submit" data-ajax-submit class="inline-flex w-full items-center justify-center rounded-[0.9rem] border border-accent bg-accent px-6 py-3.5 text-sm font-semibold text-white shadow-[0_14px_30px_rgba(83,112,88,0.18)] transition duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] hover:border-accent-dark hover:bg-accent-dark focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent active:translate-y-px disabled:cursor-wait disabled:opacity-75 sm:w-auto">
                Send henvendelse
              </button>
              <a href={directContactMailto} class="inline-flex w-full items-center justify-center rounded-[0.9rem] border border-border-soft bg-white px-6 py-3.5 text-sm font-semibold text-brand transition duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] hover:border-accent/35 hover:bg-accent-soft focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent active:translate-y-px sm:w-auto">
                Send direkte mail
              </a>
            </div>
            <p data-ajax-form-pending hidden aria-live="polite" class="mt-3 rounded-[0.85rem] border border-accent/22 bg-accent-soft/64 px-4 py-3 text-sm leading-relaxed text-brand/78">
              Sender din besked sikkert...
            </p>
            <p data-ajax-form-success hidden aria-live="polite" class="mt-3 rounded-[0.85rem] border border-accent/22 bg-accent-soft/64 px-4 py-3 text-sm leading-relaxed text-brand/78">
              Tak. Vi har modtaget din besked og vender tilbage med næste bedste skridt.
            </p>
            <p data-ajax-form-error hidden aria-live="polite" data-default-error="Der skete en fejl. Prøv igen, eller brug direkte mail-linket." class="mt-3 rounded-[0.85rem] border border-[#e8cfc9] bg-[#fff8f5] px-4 py-3 text-sm leading-relaxed text-[#794035]">
              Der skete en fejl. Prøv igen, eller brug direkte mail-linket.
            </p>
            <p class="mt-3 text-sm leading-relaxed text-muted">
              Vi svarer inden for 1-2 hverdage. Gratis AI-tjek er uforpligtende og kræver ikke salgsmøde.
            </p>
            <p class="mt-3 rounded-[0.85rem] border border-accent/18 bg-accent-soft/45 px-4 py-3 text-sm leading-relaxed text-brand/74">
              Virker knappen ikke? Send direkte til info@sitedokai.com med link til din hjemmeside.
            </p>
          </div>
        </form>
      </div>
    </section>

    <section>
      <div class="mx-auto max-w-5xl px-5 py-9 sm:px-6 md:py-11">
        <div class="grid gap-3 text-sm leading-relaxed text-muted sm:grid-cols-2">
          <p>
            Email: <a href={`mailto:${contactEmail}`} class="font-semibold text-brand underline decoration-accent/40 underline-offset-4 hover:decoration-accent">{contactEmail}</a>
          </p>
          <p>Vi svarer inden for 1–2 hverdage.</p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
