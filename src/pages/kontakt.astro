---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ScreeningForm from '../components/site/ScreeningForm.astro';
import '../styles/global.css';
---

<Layout
  title="Kontakt | SiteDokAI"
  description="Kontakt SiteDokAI om AI-drevet procesoptimering, Manual Work Audit og praktiske AI-workflows."
  canonical="/kontakt"
>
  <Nav />
  <main id="main" class="bg-canvas text-brand">
    <section class="mx-auto grid max-w-7xl gap-12 px-5 pb-16 pt-16 sm:px-6 md:pb-24 md:pt-24 lg:grid-cols-[0.72fr_1.28fr]">
      <aside class="text-sm leading-relaxed text-muted">
        <p class="font-mono text-xs uppercase tracking-[0.22em] text-accent">Kontakt</p>
        <p class="mt-8 max-w-xs">
          Send det workflow, der irriterer jer mest. Vi svarer normalt inden for 1-2 hverdage.
        </p>
      </aside>

      <div>
        <h1 class="max-w-4xl font-display text-5xl font-semibold leading-[0.98] text-brand md:text-7xl">
          Lad os kortlægge det manuelle arbejde, der stjæler tid.
        </h1>
        <p class="mt-8 max-w-2xl text-xl leading-relaxed text-brand/70">
          Skriv kort hvad I bruger for meget tid på i mails, Excel, opfølgninger, rapportering eller handovers. Så tager vi den første vurdering roligt og konkret.
        </p>

        <div id="screening" class="mt-14">
          <ScreeningForm sourcePage="/kontakt" />
        </div>

        <div class="mt-12 border-t border-brand/10 pt-6 text-sm leading-relaxed text-muted">
          <p>
            Direkte mail: <a href="mailto:info@sitedokai.com" class="font-semibold text-brand underline decoration-brand/20 underline-offset-4 hover:decoration-brand">info@sitedokai.com</a>
          </p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
