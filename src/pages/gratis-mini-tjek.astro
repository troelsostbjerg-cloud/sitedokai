---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AdvisoryPage from '../components/site/AdvisoryPage.astro';
import '../styles/global.css';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Første samtale og screening',
  serviceType: 'Gratis screening af agentic search og AI-synlighed',
  provider: {
    '@type': 'Organization',
    name: 'SiteDokAI',
    url: 'https://sitedokai.com',
    email: 'info@sitedokai.com',
  },
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'DKK',
  },
};
---

<Layout
  title="Gratis screening af agentic search | SiteDokAI"
  description="Book en første samtale og screening uden beregning. SiteDokAI vurderer om din virksomhed bør arbejde konkret med agentic search og AI-synlighed."
  canonical="/gratis-mini-tjek"
  structuredData={structuredData}
>
  <Nav />
  <AdvisoryPage
    eyebrow="Gratis screening"
    title="Første samtale og screening uden beregning."
    text="Vi starter ikke med en stor rapport. Vi starter med at afklare, om AI-agenter overhovedet kan finde, forstå og vælge virksomheden i de situationer, der betyder noget."
    points={[
      'Send hjemmeside, firma og kort note.',
      'Vi vurderer de første agentic search-signaler.',
      'Du får et ærligt forslag til næste skridt eller besked om, at der ikke er et oplagt forløb.',
    ]}
    note="Screeningen er til både B2B-virksomheder og lokale virksomheder, hvor kunder begynder at bruge AI til research, sammenligning og valg."
    showForm={true}
    sourcePage="/gratis-mini-tjek"
  />
  <Footer />
</Layout>
