---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AdvisoryPage from '../components/site/AdvisoryPage.astro';
import '../styles/global.css';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Workflow-vurdering',
  serviceType: 'Indledende vurdering af manuel proces og AI-workflow potentiale',
  provider: {
    '@type': 'Organization',
    name: 'SiteDokAI',
    url: 'https://sitedokai.com',
    email: 'info@sitedokai.com',
  },
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'DKK',
  },
};
---

<Layout
  title="Send workflow | SiteDokAI"
  description="Send den manuelle proces, der irriterer jer mest. SiteDokAI vurderer nøgternt, om den egner sig til en praktisk AI-workflow."
  canonical="/gratis-mini-tjek"
  structuredData={structuredData}
>
  <Nav />
  <AdvisoryPage
    eyebrow="Gratis start"
    title="Send det workflow, der irriterer jer mest."
    text="Vi starter med virkeligheden: statusmails, rapporter, opfølgninger, kundehenvendelser, handovers eller noget andet, der gentages for meget."
    points={[
      'Beskriv processen kort og konkret.',
      'Vi vurderer om den egner sig til AI-workflow, automatisering eller bare bedre struktur.',
      'Du får et roligt forslag til næste skridt eller besked om, at det ikke er oplagt.',
    ]}
    note="Det er ikke en gratis workshop. Det er en kort, praktisk vurdering af om der er noget reelt at arbejde videre med."
    showForm={true}
    sourcePage="/gratis-mini-tjek"
    ctaLabel="Send workflow"
  />
  <Footer />
</Layout>
