---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AbstractLandscapeVisual from '../components/site/AbstractLandscapeVisual.astro';
import Badge from '../components/site/Badge.astro';
import Button from '../components/site/Button.astro';
import Container from '../components/site/Container.astro';
import FeatureCard from '../components/site/FeatureCard.astro';
import MiniCheckPreview from '../components/site/MiniCheckPreview.astro';
import MiniCheckBenefitStrip from '../components/site/MiniCheckBenefitStrip.astro';
import PaidAuditCard from '../components/site/PaidAuditCard.astro';
import ProcessStepCard from '../components/site/ProcessStepCard.astro';
import SectionHeader from '../components/site/SectionHeader.astro';
import TrustProofStrip from '../components/site/TrustProofStrip.astro';
import '../styles/global.css';

const steps = [
  {
    title: 'Du sender link og branche',
    text: 'Kun det nødvendige: navn, email, hjemmeside og evt. hvad siden skal hjælpe med.',
  },
  {
    title: 'Vi kigger på de første barrierer',
    text: 'Vi vurderer klarhed, tillid og om næste skridt er let at forstå for en ny kunde.',
  },
  {
    title: 'Du får 3 konkrete observationer',
    text: 'Kort og brugbart — ikke en teknisk rapport og ikke et langt salgsmøde.',
  },
  {
    title: 'Du får anbefalet næste skridt',
    text: 'Hvis problemerne er tydelige, kan du vælge et fuldt Hjemmeside-tjek til 2.495 kr.',
  },
];

const miniCheckProblemCards = [
  {
    title: 'Uklart budskab',
    text: 'Kunden forstår ikke hurtigt nok, hvad du tilbyder.',
    icon: 'message',
    position: 'left-[5%] top-[9%] md:left-[14%] md:top-[8%]',
  },
  {
    title: 'Tillid kan styrkes',
    text: 'Siden giver ikke nok tryghed til at tage kontakt.',
    icon: 'shield',
    position: 'left-[5%] top-[39%] md:left-[3%] md:top-[39%]',
  },
  {
    title: 'Svær at finde eller forstå',
    text: 'Google og kunder forstår ikke hurtigt nok, hvad du tilbyder.',
    icon: 'search',
    position: 'right-[5%] bottom-[9%] md:right-[3%] md:bottom-[11%]',
  },
];

const industries = [
  'Håndværkere',
  'Klinikker',
  'Rådgivere',
  'Behandlere',
  'Installatører',
  'Rengøring',
  'Byggeri',
  'Lokale servicevirksomheder',
];

const goals = [
  'Flere henvendelser',
  'Flere bookinger',
  'Flere opkald',
  'Flere tilbudsanmodninger',
  'Mere tillid',
  'Jeg ved ikke endnu',
];

const miniCheckEmail = 'info@sitedokai.com';
const miniCheckFormAction = `https://formsubmit.co/ajax/${miniCheckEmail}`;
const miniCheckDirectMailto = `mailto:${miniCheckEmail}?subject=${encodeURIComponent('Gratis mini-tjek')}&body=${encodeURIComponent(`Hej SiteDokAI,

Jeg vil gerne have et gratis mini-tjek.

Navn:
Firma:
Hjemmeside:
Branche:
Kort note:

Tak.`)}`;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://sitedokai.com/#organization',
      name: 'SiteDokAI',
      url: 'https://sitedokai.com',
      email: 'info@sitedokai.com',
      contactPoint: {
        '@type': 'ContactPoint',
        email: 'info@sitedokai.com',
        contactType: 'customer service',
        availableLanguage: ['da-DK'],
        areaServed: 'DK',
      },
    },
    {
      '@type': 'Service',
      '@id': 'https://sitedokai.com/gratis-mini-tjek#service',
      name: 'Gratis mini-tjek af hjemmeside',
      serviceType: 'Gratis mini-tjek af hjemmeside for små virksomheder',
      provider: {
        '@id': 'https://sitedokai.com/#organization',
      },
      areaServed: {
        '@type': 'Country',
        name: 'Danmark',
      },
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'DKK',
        availability: 'https://schema.org/InStock',
      },
      description: 'Få 3 konkrete observationer på, hvad der gør hjemmesiden uklar, utroværdig eller svær at handle på.',
    },
    {
      '@type': 'FAQPage',
      '@id': 'https://sitedokai.com/gratis-mini-tjek#faq',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'Hvad får jeg i et gratis mini-tjek?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Du får 3 konkrete observationer på klarhed, tillid og næste skridt på din hjemmeside.',
          },
        },
        {
          '@type': 'Question',
          name: 'Hvornår får jeg svar?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Du får svar inden for 1-2 hverdage.',
          },
        },
        {
          '@type': 'Question',
          name: 'Er mini-tjekket bindende?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Nej. Mini-tjekket er gratis og uforpligtende.',
          },
        },
      ],
    },
  ],
};
---

<Layout
  title="Gratis mini-tjek af din hjemmeside | SiteDokAI"
  description="Mister din hjemmeside kunder? Få 3 konkrete observationer på, hvad der gør siden uklar, utroværdig eller svær at handle på."
  canonical="/gratis-mini-tjek"
  structuredData={structuredData}
>
  <Nav />
  <main id="main" class="bg-canvas text-brand">
    <section class="relative mx-auto max-w-[1480px] px-4 pb-6 pt-4 sm:px-6 lg:px-10">
      <div class="relative overflow-hidden rounded-[1.8rem] border border-border-soft bg-surface/78 shadow-soft">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_15%_8%,rgba(255,255,255,0.92),transparent_34%),radial-gradient(circle_at_82%_16%,rgba(223,232,220,0.62),transparent_28%)]"></div>
        <div class="relative grid min-w-0 gap-8 px-6 py-10 md:grid-cols-[0.94fr_1.06fr] md:items-center md:px-12 md:py-12 lg:px-14">
          <div class="min-w-0 max-w-3xl">
            <p class="text-xs font-semibold uppercase tracking-[0.28em] text-accent-dark">Gratis mini-tjek af din hjemmeside</p>
            <h1 class="mt-5 text-balance font-display text-5xl font-medium leading-[0.97] tracking-tight text-brand sm:text-6xl lg:text-7xl">
              Mister din hjemmeside kunder?
            </h1>
            <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">
              Få 3 konkrete observationer på, hvad der gør siden uklar, utroværdig eller svær at handle på.
            </p>

            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
              <Button href="#faa-gratis-mini-tjek">Få gratis mini-tjek</Button>
              <Button href="/hjemmeside-tjek" variant="secondary">Se fuldt Hjemmeside-tjek</Button>
            </div>

            <div class="mt-6 flex flex-col gap-3 text-muted sm:flex-row">
              <Badge>
                <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" aria-hidden="true">
                  <path d="m6.8 12.4 3.1 3.1 7.3-7.8" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round" />
                  <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.25" opacity="0.55" />
                </svg>
                Gratis første vurdering
              </Badge>
              <Badge tone="plain">
                <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" aria-hidden="true">
                  <path d="M7 12.2 10.4 15.6 17.5 8" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round" />
                  <path d="M5.5 5.5h13v13h-13z" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round" opacity="0.55" />
                </svg>
                Ingen binding
              </Badge>
              <Badge tone="plain">
                <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" aria-hidden="true">
                  <circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.35" opacity="0.62" />
                  <path d="M12 7.5V12l3 2.2" stroke="currentColor" stroke-width="1.45" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                Svar inden 1–2 hverdage
              </Badge>
            </div>
          </div>

          <AbstractLandscapeVisual problemCards={miniCheckProblemCards} />
        </div>
      </div>
    </section>

    <TrustProofStrip class="pb-5 pt-1" />

    <Container id="det-kigger-vi-efter" class="pb-4 pt-1">
      <SectionHeader label="Det kigger vi efter" />
      <div class="mt-6 grid gap-5 md:grid-cols-3">
        <FeatureCard
          icon="clarity"
          title="Klarhed"
          text="Forstår kunden hurtigt, hvad du tilbyder?"
        />
        <FeatureCard
          icon="trust"
          title="Tillid"
          text="Virker siden professionel og tryg nok til kontakt?"
        />
        <FeatureCard
          icon="visibility"
          title="Handling"
          text="Er det nemt og naturligt at kontakte dig?"
        />
      </div>
    </Container>

    <Container id="det-faar-du-gratis" class="pb-7 pt-3">
      <SectionHeader label="Det får du gratis" uppercase={false} />
      <div class="mt-6">
        <MiniCheckBenefitStrip />
      </div>
    </Container>

    <MiniCheckPreview ctaHref="#faa-gratis-mini-tjek" class="pb-7 pt-3" />

    <Container id="hvem-det-er-for" class="py-7">
      <div class="rounded-[1.45rem] border border-border-soft bg-surface/72 px-6 py-9 shadow-soft md:px-10 md:py-11">
        <div class="grid gap-8 lg:grid-cols-[0.92fr_1.08fr] lg:items-end">
          <SectionHeader
            label="For små virksomheder"
            title="Til små virksomheder, der får for få henvendelser fra hjemmesiden."
            text="Mini-tjekket er lavet til lokale servicevirksomheder, hvor hjemmesiden skal skabe tillid, forklare ydelsen hurtigt og gøre det let at tage kontakt."
            align="left"
          />
          <div class="flex flex-wrap gap-2.5 lg:justify-end">
            {industries.map((industry) => (
              <span class="rounded-[0.85rem] border border-accent/18 bg-accent-soft/72 px-3.5 py-2 text-sm leading-none text-accent-dark">
                {industry}
              </span>
            ))}
          </div>
        </div>
      </div>
    </Container>

    <Container id="saadan-foregaar-det" class="py-7">
      <SectionHeader label="Sådan foregår det" />
      <div class="mt-7 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
        {steps.map((step, index) => (
          <ProcessStepCard step={index + 1} title={step.title} text={step.text} />
        ))}
      </div>
    </Container>

    <Container id="fuld-gennemgang" class="pb-16 pt-7 md:pb-20">
      <SectionHeader
        label="Hvis mini-tjekket viser tydelige problemer"
        text="Så er Hjemmeside-tjek til 2.495 kr. det naturlige næste skridt."
        uppercase={false}
      />
      <div class="mt-7">
        <PaidAuditCard ctaHref="/hjemmeside-tjek" />
      </div>
    </Container>

    <Container id="faa-gratis-mini-tjek" class="pb-16 pt-0 md:pb-20">
      <div class="grid gap-8 rounded-[1.55rem] border border-accent/26 bg-[linear-gradient(135deg,rgba(255,253,248,0.96),rgba(237,243,234,0.74))] px-6 py-9 shadow-soft md:px-10 md:py-11 lg:grid-cols-[0.78fr_1.22fr] lg:items-start">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.28em] text-accent-dark">Gratis og uforpligtende</p>
          <h2 class="mt-5 font-display text-4xl font-medium leading-[1.02] tracking-tight text-brand md:text-5xl">
            Få gratis mini-tjek
          </h2>
          <p class="mt-5 max-w-lg text-base leading-relaxed text-muted md:text-lg">
            Send dit link, så kigger vi hurtigt på siden og giver dig 3 konkrete observationer.
          </p>
          <div class="mt-5 grid gap-3">
            <div class="rounded-[1rem] border border-accent/18 bg-white/62 px-4 py-3 text-sm leading-relaxed text-brand/74">Du får svar inden for 1–2 hverdage.</div>
            <div class="rounded-[1rem] border border-accent/18 bg-white/62 px-4 py-3 text-sm leading-relaxed text-brand/74">Hvis der ikke er et oplagt næste skridt, siger vi det direkte.</div>
            <div class="rounded-[1rem] border border-accent/18 bg-white/62 px-4 py-3 text-sm leading-relaxed text-brand/74">Vi bruger kun dine oplysninger til at lave mini-tjekket og svare dig tilbage.</div>
            <div class="rounded-[1rem] border border-accent/18 bg-white/62 px-4 py-3 text-sm leading-relaxed text-brand/74">Virker knappen ikke? Send direkte til info@sitedokai.com med link til din hjemmeside.</div>
          </div>
          <p class="mt-5 max-w-lg text-sm leading-relaxed text-muted">
            Mini-tjekket er gratis, fordi det er den letteste måde at vurdere, om siden har tydelige problemer, før du bruger penge på en større gennemgang.
          </p>
        </div>

        <form
          action={miniCheckFormAction}
          method="POST"
          data-ajax-email-form
          data-pending-label="Sender..."
          class="grid gap-4 rounded-[1.25rem] border border-border-soft bg-white/72 p-5 shadow-[0_14px_36px_rgba(32,38,34,0.045)] md:p-6"
        >
          <input type="hidden" name="_subject" value="Gratis mini-tjek fra sitedokai.com" />
          <input type="hidden" name="_template" value="table" />
          <input type="hidden" name="_captcha" value="false" />
          <input type="hidden" name="source_page" value="/gratis-mini-tjek" />
          <input type="text" name="_honey" tabindex="-1" autocomplete="off" class="hidden" />

          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="mini_check_name" class="mb-2 block text-sm font-semibold text-brand">Navn *</label>
              <input type="text" id="mini_check_name" name="name" required autocomplete="name" class="w-full rounded-[0.95rem] border border-border-soft bg-surface px-4 py-3 text-brand placeholder:text-muted/45 transition-colors focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/16" />
            </div>

            <div>
              <label for="mini_check_email" class="mb-2 block text-sm font-semibold text-brand">Email *</label>
              <input type="email" id="mini_check_email" name="email" required autocomplete="email" class="w-full rounded-[0.95rem] border border-border-soft bg-surface px-4 py-3 text-brand placeholder:text-muted/45 transition-colors focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/16" />
            </div>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="mini_check_website" class="mb-2 block text-sm font-semibold text-brand">Hjemmeside-link *</label>
              <input type="text" id="mini_check_website" name="website" required inputmode="url" autocomplete="url" autocapitalize="none" spellcheck="false" placeholder="dinvirksomhed.dk" class="w-full rounded-[0.95rem] border border-border-soft bg-surface px-4 py-3 text-brand placeholder:text-muted/45 transition-colors focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/16" />
            </div>

            <div>
              <label for="mini_check_industry" class="mb-2 block text-sm font-semibold text-brand">Branche</label>
              <input type="text" id="mini_check_industry" name="branche" autocomplete="organization-title" placeholder="Fx klinik, rådgiver eller håndværker" class="w-full rounded-[0.95rem] border border-border-soft bg-surface px-4 py-3 text-brand placeholder:text-muted/45 transition-colors focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/16" />
            </div>
          </div>

          <div>
            <label for="mini_check_message" class="mb-2 block text-sm font-semibold text-brand">Kort besked</label>
            <textarea id="mini_check_message" name="message" rows="4" placeholder="Skriv gerne hvad siden især skal hjælpe med, eller hvilken side vi skal kigge mest på." class="w-full resize-y rounded-[0.95rem] border border-border-soft bg-surface px-4 py-3 text-brand placeholder:text-muted/45 transition-colors focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/16"></textarea>
          </div>

          <div>
            <label for="mini_check_goal" class="mb-2 block text-sm font-semibold text-brand">Hvad skal hjemmesiden helst skabe?</label>
            <select id="mini_check_goal" name="goal" class="w-full rounded-[0.95rem] border border-border-soft bg-surface px-4 py-3 text-brand transition-colors focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/16">
              <option value="">Vælg hvis du ved det</option>
              {goals.map((goal) => (
                <option value={goal}>{goal}</option>
              ))}
            </select>
            <p class="mt-2 text-sm leading-relaxed text-muted">
              Feltet hjælper os med at vurdere siden ud fra kundens vigtigste handling.
            </p>
          </div>

          <div>
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
              <button type="submit" data-ajax-submit class="inline-flex w-full items-center justify-center rounded-[0.9rem] border border-accent bg-accent px-6 py-3.5 text-sm font-semibold text-white shadow-[0_14px_30px_rgba(83,112,88,0.18)] transition duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] hover:border-accent-dark hover:bg-accent-dark focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent active:translate-y-px disabled:cursor-wait disabled:opacity-75 sm:w-auto">
                Send gratis mini-tjek
              </button>
              <a href={miniCheckDirectMailto} class="inline-flex w-full items-center justify-center rounded-[0.9rem] border border-border-soft bg-white px-6 py-3.5 text-sm font-semibold text-brand transition duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] hover:border-accent/35 hover:bg-accent-soft focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent active:translate-y-px sm:w-auto">
                Send direkte mail
              </a>
            </div>
            <p data-ajax-form-pending hidden aria-live="polite" class="mt-3 rounded-[0.85rem] border border-accent/22 bg-accent-soft/64 px-4 py-3 text-sm leading-relaxed text-brand/78">
              Sender dit mini-tjek sikkert...
            </p>
            <p data-ajax-form-success hidden aria-live="polite" class="mt-3 rounded-[0.85rem] border border-accent/22 bg-accent-soft/64 px-4 py-3 text-sm leading-relaxed text-brand/78">
              Tak. Vi har modtaget dit link og vender tilbage med 3 konkrete observationer.
            </p>
            <p data-ajax-form-error hidden aria-live="polite" data-default-error="Der skete en fejl. Prøv igen, eller brug direkte mail-linket." class="mt-3 rounded-[0.85rem] border border-[#e8cfc9] bg-[#fff8f5] px-4 py-3 text-sm leading-relaxed text-[#794035]">
              Der skete en fejl. Prøv igen, eller brug direkte mail-linket.
            </p>
            <p class="mt-3 text-sm leading-relaxed text-muted">
              Gratis og uforpligtende. Du får 3 konkrete observationer inden for 1–2 hverdage. Ingen salgsmøde kræves.
            </p>
            <p class="mt-3 rounded-[0.85rem] border border-accent/18 bg-accent-soft/45 px-4 py-3 text-sm leading-relaxed text-brand/74">
              Virker knappen ikke? Send direkte til info@sitedokai.com med link til din hjemmeside.
            </p>
          </div>
        </form>
      </div>
    </Container>
  </main>
  <Footer />
</Layout>
