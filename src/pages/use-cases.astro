---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AdvisoryPage from '../components/site/AdvisoryPage.astro';
import '../styles/global.css';
---

<Layout
  title="Hvornår agentic search betyder noget | SiteDokAI"
  description="Eksempler på hvornår virksomheder bør undersøge agentic search, AI-synlighed og AI-agenters valg af leverandører."
  canonical="/use-cases"
>
  <Nav />
  <AdvisoryPage
    eyebrow="Hvornår det giver mening"
    title="Når kunderne undersøger, sammenligner eller vælger med AI."
    text="Agentic search er især relevant, når kunden ikke bare søger efter et navn, men beder AI finde en leverandør, vurdere muligheder eller forklare hvem der virker mest troværdig."
    points={[
      'B2B-købere der laver shortlists med AI.',
      'Forbrugere der spørger efter lokale eller specialiserede valg.',
      'Virksomheder hvor tillid, dokumentation og tydelige ydelser afgør valget.',
    ]}
    note="Hvis I lever af at blive valgt på ekspertise, lokal relevans, dokumentation eller rådgivning, er det værd at få screenet."
  />
  <Footer />
</Layout>
