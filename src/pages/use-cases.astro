---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { absoluteUrl, useCases } from '../data/aiContent';
import '../styles/global.css';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${absoluteUrl('/use-cases')}#webpage`,
  url: absoluteUrl('/use-cases'),
  name: 'Use cases for procesoptimering | SiteDokAI',
  description:
    '10 konkrete eksempler på processer, hvor SiteDokAI kan kortlægge manuelt arbejde og bygge praktiske AI-workflows.',
  inLanguage: 'da-DK',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: useCases.map((useCase, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: useCase.title,
      url: absoluteUrl(useCase.path),
      description: useCase.description,
    })),
  },
};
---

<Layout
  title="Use cases for procesoptimering | SiteDokAI"
  description="10 konkrete eksempler på processer, hvor SiteDokAI kan kortlægge manuelt arbejde og bygge praktiske AI-workflows."
  canonical="/use-cases"
  structuredData={structuredData}
>
  <Nav />
  <main id="main" class="bg-canvas text-brand">
    <section class="mx-auto grid max-w-7xl gap-12 px-5 pb-16 pt-16 sm:px-6 md:pb-24 md:pt-24 lg:grid-cols-[0.72fr_1.28fr]">
      <aside class="text-sm leading-relaxed text-muted">
        <p class="font-mono text-xs uppercase tracking-[0.22em] text-accent">Use cases</p>
        <p class="mt-8 max-w-xs">
          10 konkrete procesforløb, der viser hvor manuelle opgaver kan blive til mere stabile AI-assisterede workflows.
        </p>
      </aside>

      <div>
        <h1 class="max-w-4xl font-display text-4xl font-semibold leading-[1.02] text-brand sm:text-5xl md:text-7xl">
          Use cases der starter i hverdagen.
        </h1>
        <p class="mt-8 max-w-2xl text-xl leading-relaxed text-brand/70">
          De bedste procescases starter sjældent med teknologi. De starter som gentagne opgaver i mails, møder, Excel, CRM, kundeservice, finance og drift, hvor mennesker bruger tid på at samle, sortere og formulere det samme igen.
        </p>

        <div class="mt-12 grid gap-4">
          {useCases.map((useCase, index) => (
            <a href={useCase.path} class="group grid gap-5 rounded-[1.35rem] border border-brand/10 bg-panel-soft p-5 transition-colors hover:border-accent/35 hover:bg-white/[0.06] md:grid-cols-[5.5rem_1fr] md:p-6">
              <div>
                <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent">Case {String(index + 1).padStart(2, '0')}</p>
              </div>
              <div>
                <h2 class="max-w-3xl text-2xl font-semibold text-brand group-hover:text-accent">{useCase.title}</h2>
                <p class="mt-4 max-w-3xl text-sm leading-relaxed text-muted">{useCase.description}</p>
                <div class="mt-5 flex flex-wrap gap-2">
                  {useCase.signals.slice(0, 3).map((signal) => (
                    <span class="rounded-full border border-brand/10 bg-canvas-soft px-3 py-1 text-xs font-medium text-brand/65">{signal}</span>
                  ))}
                </div>
                <p class="mt-6 text-sm font-semibold text-brand">Se workflow</p>
              </div>
            </a>
          ))}
        </div>

        <section class="mt-14 rounded-[1.5rem] border border-accent/25 bg-accent/10 p-6 md:p-8">
          <p class="font-mono text-xs uppercase tracking-[0.22em] text-accent">Sådan bruger vi dem</p>
          <h2 class="mt-5 max-w-3xl font-display text-3xl font-semibold leading-tight text-brand md:text-5xl">
            Hver use case svarer på problem, workflow, output og gode signaler.
          </h2>
          <p class="mt-6 max-w-3xl text-base leading-relaxed text-muted md:text-lg">
            Det gør det lettere at se, om en proces er moden nok til en Manual Work Audit, en AI Workflow Sprint eller en mindre workflow-skitse først.
          </p>
        </section>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
