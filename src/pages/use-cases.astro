---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AdvisoryPage from '../components/site/AdvisoryPage.astro';
import '../styles/global.css';
---

<Layout
  title="Eksempler på AI-workflows | SiteDokAI"
  description="Konkrete eksempler på manuelle workflows, som SiteDokAI kan kortlægge og gøre smartere med praktisk AI."
  canonical="/use-cases"
>
  <Nav />
  <AdvisoryPage
    eyebrow="Eksempler"
    title="AI-workflows der starter i hverdagen."
    text="De bedste cases er sjældent abstrakte. De starter som konkrete opgaver, der bliver gentaget for ofte og håndteret forskelligt fra person til person."
    points={[
      'Mødenoter til actions, ansvarlige, deadlines og opfølgningsmail.',
      'Kundehenvendelser til kategorisering, svarudkast og eskalering.',
      'Excel/Sheets til ledelsesrapport med afvigelser og anbefalinger.',
    ]}
    note="Andre oplagte cases er leverandørstatus, projektupdates, supporthenvendelser, salgsnoter og handovers."
    ctaLabel="Send workflow"
  />
  <Footer />
</Layout>
