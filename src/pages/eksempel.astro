---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const scores = [
  { label: 'Klarhed', value: '62/100', text: 'Det er for svært at se, hvem virksomheden hjælper, og hvad næste skridt er.' },
  { label: 'Tillid', value: '58/100', text: 'Der mangler beviser, konkrete cases og tydelige tryghedssignaler tæt på CTAerne.' },
  { label: 'Handling', value: '64/100', text: 'Næste skridt er nævnt, men kontaktvejen kan gøres tydeligere og mere tryg.' },
];

const problems = [
  'Heroen siger for lidt om konkret værdi og målgruppe.',
  'CTAerne konkurrerer med hinanden og bruger uklare formuleringer.',
  'Serviceafsnittet forklarer aktiviteter, men ikke kundens udbytte.',
  'Tillid ligger for langt nede på siden og er for generisk.',
  'Visuelt udtryk virker pænere end før, men ikke så professionelt som ydelsen.',
];

const fixes = [
  'Ny hero med klar målgruppe, problem og primær handling.',
  'Servicestruktur med 3 tydelige ydelser i kundens sprog.',
  'Trust-sektion med cases, billeder, proces og lokale signaler.',
  'Kort FAQ der fjerner de mest almindelige barrierer.',
];
---

<Layout
  title="Eksempel på Hjemmeside-tjek | SiteDokAI"
  description="Se et kort eksempel på hvordan SiteDokAI finder problemer med klarhed, tillid, handling, CTA, struktur og visuelt udtryk."
>
  <Nav />
  <main id="main">
    <section class="border-b border-[#e6ddd1] bg-white">
      <div class="mx-auto max-w-6xl px-6 py-20 md:py-28">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-accent">Eksempel</p>
        <div class="mt-5 grid gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-end">
          <div>
            <h1 class="font-display text-4xl font-extrabold tracking-tight text-brand md:text-6xl">
              Et Hjemmeside-tjek viser hvad der får kunderne til at tøve.
            </h1>
            <p class="mt-6 max-w-2xl text-lg leading-relaxed text-brand/70">
              Eksemplet her er fiktivt, men viser formatet: en hurtig, konkret gennemgang af klarhed, tillid, handling, tekst, struktur, CTA og visuelt førstehåndsindtryk.
            </p>
          </div>
          <div class="rounded-[2rem] border border-[#dfd3c2] bg-[#f6efe3] p-6">
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-accent">Fiktiv virksomhed</p>
            <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-brand">Nordkyst Byg</h2>
            <p class="mt-3 text-sm leading-relaxed text-brand/70">
              En lille håndværksvirksomhed med god faglighed, men en hjemmeside der gør det uklart, hvilke opgaver de helst vil have.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="border-b border-[#e6ddd1] bg-[#f6f1e8]">
      <div class="mx-auto max-w-6xl px-6 py-16 md:py-24">
        <div class="grid gap-5 md:grid-cols-3">
          {scores.map((score) => (
            <article class="rounded-[1.8rem] border border-[#ddd1bf] bg-white p-7">
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-accent">{score.label}</p>
              <div class="mt-4 font-display text-4xl font-extrabold tracking-tight text-brand">{score.value}</div>
              <p class="mt-4 text-sm leading-relaxed text-brand/70">{score.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="border-b border-[#e6ddd1] bg-white">
      <div class="mx-auto grid max-w-6xl gap-10 px-6 py-16 md:py-24 lg:grid-cols-[0.95fr_1.05fr]">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-accent">Top 5 problemer</p>
          <h2 class="mt-4 font-display text-3xl font-bold tracking-tight text-brand md:text-5xl">
            Rapporten prioriterer det, der koster mest tillid først.
          </h2>
          <p class="mt-5 text-base leading-relaxed text-brand/70">
            Pointen er ikke at lave en lang liste med småfejl. Pointen er at gøre de vigtigste beslutninger lette at tage.
          </p>
        </div>
        <ol class="grid gap-3">
          {problems.map((problem, index) => (
            <li class="flex gap-4 rounded-[1.4rem] border border-[#e6ddd1] bg-[#fbf8f3] p-5">
              <span class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full bg-brand text-sm font-bold text-white">{index + 1}</span>
              <span class="text-base leading-relaxed text-brand/72">{problem}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="border-b border-[#e6ddd1] bg-[#fcfaf6]">
      <div class="mx-auto grid max-w-6xl gap-8 px-6 py-16 md:py-24 lg:grid-cols-2">
        <article class="rounded-[2rem] border border-[#ddd1bf] bg-white p-8">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-accent">Ny hero-tekst</p>
          <h2 class="mt-4 font-display text-3xl font-bold tracking-tight text-brand">
            “Få renovering og tømrerarbejde gjort ordentligt, uden at projektet bliver tungt at styre.”
          </h2>
          <p class="mt-5 text-base leading-relaxed text-brand/70">
            En god hero gør det straks tydeligt, hvem siden er for, hvilket problem den løser, og hvad besøgende skal gøre bagefter.
          </p>
        </article>

        <article class="rounded-[2rem] border border-[#ddd1bf] bg-[#1f2a33] p-8 text-white">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[#d9b27a]">Forslag til servicestruktur</p>
          <div class="mt-5 grid gap-3">
            {fixes.map((fix) => (
              <div class="rounded-[1rem] border border-white/10 bg-white/6 px-4 py-3 text-sm leading-relaxed text-white/74">{fix}</div>
            ))}
          </div>
        </article>
      </div>
    </section>

    <section class="bg-white">
      <div class="mx-auto max-w-5xl px-6 py-16 text-center md:py-24">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-accent">Næste skridt</p>
        <h2 class="mt-4 font-display text-3xl font-bold tracking-tight text-brand md:text-5xl">
          Vil du se, hvor din egen hjemmeside mister kunder?
        </h2>
        <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-brand/70">
          Start med Hjemmeside-tjekket, hvis du vil have problemerne gjort konkrete, før du beslutter hvad der skal rettes.
        </p>
        <div class="mt-8 flex flex-col justify-center gap-4 sm:flex-row">
          <a href="/hjemmeside-tjek#bestil" class="inline-flex items-center justify-center rounded-full bg-brand px-7 py-3 text-sm font-bold text-white transition-colors hover:bg-brand-light">
            Bestil Hjemmeside-tjek
          </a>
          <a href="/hjemmeside-tjek" class="inline-flex items-center justify-center rounded-full border border-[#d9cfbf] bg-[#fbf8f3] px-7 py-3 text-sm font-bold text-brand transition-colors hover:bg-white">
            Se hvad du får
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
