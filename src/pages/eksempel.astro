---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AdvisoryPage from '../components/site/AdvisoryPage.astro';
import '../styles/global.css';
---

<Layout
  title="Eksempel på Manual Work Audit | SiteDokAI"
  description="Et enkelt eksempel på hvordan en Manual Work Audit kan prioritere manuelle workflows og vælge første AI-pilot."
  canonical="/eksempel"
>
  <Nav />
  <AdvisoryPage
    eyebrow="Eksempel"
    title="Et audit-output skal gøre næste skridt tydeligt."
    text="En Manual Work Audit ender med en prioriteret backlog, top 3 anbefalede pilots og en konkret skitse til den første workflow."
    points={[
      'Ugentlig statusrapport: høj effekt og lav kompleksitet.',
      'Kundehenvendelser: høj effekt og medium kompleksitet.',
      'Handover mellem salg og levering: medium effekt og lav kompleksitet.',
    ]}
    note="Anbefalet første pilot kunne være mødenoter til actions og opfølgning med 4-8 timer sparet pr. uge."
    ctaLabel="Book audit"
  />
  <Footer />
</Layout>
