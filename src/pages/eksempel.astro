---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AdvisoryPage from '../components/site/AdvisoryPage.astro';
import '../styles/global.css';
---

<Layout
  title="Eksempel på agentic search-screening | SiteDokAI"
  description="Et enkelt eksempel på hvad SiteDokAI kigger efter i en agentic search-screening."
  canonical="/eksempel"
>
  <Nav />
  <AdvisoryPage
    eyebrow="Eksempel"
    title="Et eksempel er ikke et dashboard. Det er en bedre samtale om valgbarhed."
    text="I en screening kigger vi på om AI kan forstå virksomheden, finde troværdige kilder og forklare hvorfor kunden bør vælge jer frem for andre."
    points={[
      'Hvilke spørgsmål får jer frem eller væk?',
      'Hvilke kilder bruger AI til at begrunde svaret?',
      'Hvad mangler for at gøre jer lettere at anbefale?',
    ]}
    note="Det konkrete format afhænger af virksomheden. Målet er ikke mere data. Målet er klarhed nok til at træffe en beslutning."
  />
  <Footer />
</Layout>
