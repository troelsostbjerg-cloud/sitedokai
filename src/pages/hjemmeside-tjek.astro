---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/site/Button.astro';
import Container from '../components/site/Container.astro';
import FeatureCard from '../components/site/FeatureCard.astro';
import SecondaryOfferCard from '../components/site/SecondaryOfferCard.astro';
import SectionHeader from '../components/site/SectionHeader.astro';
import '../styles/global.css';

const checkoutAction = 'https://sitedokai-checkout.pages.dev/api/checkout';
const contactEmail = 'info@sitedokai.com';
const checkoutFallbackMailto = `mailto:${contactEmail}?subject=${encodeURIComponent('Hjemmeside-tjek - manuel bestilling')}&body=${encodeURIComponent(`Hej SiteDokAI,

Jeg vil gerne bestille eller høre om Hjemmeside-tjek til 2.495 kr.

Firmanavn:
Kontaktperson:
Email:
Hjemmeside:
Kort note:

Tak.`)}`;
const siteOrigin = 'https://sitedokai.com';

const included = [
  {
    title: 'Klarheds-score',
    text: 'Forstår kunderne hurtigt hvad du tilbyder?',
  },
  {
    title: 'Tillids-score',
    text: 'Virker siden tryg og professionel?',
  },
  {
    title: 'Synligheds-score',
    text: 'Er siden let at forstå for Google?',
  },
  {
    title: 'Top 5 problemer',
    text: 'Det vigtigste at rette først',
  },
  {
    title: 'Ny hero-tekst',
    text: 'Bedre første skærm',
  },
  {
    title: 'Servicestruktur',
    text: 'Gør dine ydelser lettere at vælge',
  },
  {
    title: 'PDF-rapport',
    text: 'Samlet overblik',
  },
  {
    title: 'Video',
    text: '5–10 min gennemgang',
  },
];

const exampleRows = [
  {
    label: 'Score',
    value: 'Klarhed: 54/100',
    text: 'Kunden skal bruge for lang tid på at forstå, hvad virksomheden konkret hjælper med.',
  },
  {
    label: 'Problem',
    value: 'Heroen er for bred og intern',
    text: 'Første skærm forklarer processen, men ikke resultatet kunden køber.',
  },
  {
    label: 'Løsning',
    value: 'Ny tekst og tydeligt næste skridt',
    text: 'Start med kundens problem, nævn ydelsen direkte og gør næste skridt synligt.',
  },
];

const process = [
  {
    title: 'Du bestiller',
    text: 'Du sender firmanavn, mail, website og eventuelle noter. Betaling sker sikkert via Stripe.',
  },
  {
    title: 'Vi analyserer',
    text: 'Vi gennemgår forsiden, vigtigste servicesider, kontaktflow, tekst, struktur, tillid og synlighed.',
  },
  {
    title: 'Du får rapport + video',
    text: 'Du får en PDF-rapport, top 5 problemer, konkrete tekstforslag og en kort video med prioriteringen.',
  },
];

const audience = [
  'Små virksomheder',
  'Få henvendelser',
  'Uklart budskab',
];

const outcomes = [
  'Flere henvendelser',
  'Klarere budskab',
  'Mere tillid',
];

const rightForYou = [
  'Du har besøgende, men for få henvendelser.',
  'Du er i tvivl om siden virker professionel nok.',
  'Du vil vide præcis, hvad der bør rettes før du bruger penge på nyt design eller annoncer.',
];

const faqs = [
  {
    question: 'Skal jeg starte med Gratis mini-tjek først?',
    answer: 'Hvis du er i tvivl, ja. Mini-tjekket giver en hurtig vurdering. Hjemmeside-tjekket er til dig, der vil have fuld rapport, scores og konkret prioritering.',
  },
  {
    question: 'Hvad betyder de tre scores?',
    answer: 'Klarhed handler om, om kunden hurtigt forstår dit tilbud. Tillid handler om, om siden føles tryg og professionel. Synlighed handler om, om siden er let at forstå for kunder og søgning.',
  },
  {
    question: 'Hvad kan jeg bruge videoen til?',
    answer: 'Videoen viser prioriteringen i almindeligt sprog, så du hurtigt kan se, hvad der bør rettes først — enten selv eller sammen med SiteDok.',
  },
  {
    question: 'Er der binding bagefter?',
    answer: 'Nej. Rapporten kan bruges som beslutningsgrundlag. Hvis du vil have hjælp bagefter, kan Hjemmeside-fix eller Visuelt løft være næste skridt.',
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Hjemmeside-tjek',
  provider: {
    '@type': 'Organization',
    name: 'SiteDokAI',
    url: 'https://sitedokai.com',
  },
  areaServed: {
    '@type': 'Country',
    name: 'Danmark',
  },
  offers: {
    '@type': 'Offer',
    price: '2495',
    priceCurrency: 'DKK',
    availability: 'https://schema.org/InStock',
  },
  description: 'Fuld gennemgang af klarhed, tillid, synlighed, top 5 problemer, ny hero-tekst, servicestruktur, PDF-rapport og kort video.',
};
---

<Layout
  title="Hjemmeside-tjek til 2.495 kr. | SiteDokAI"
  description="Få en konkret gennemgang af din hjemmeside. Vi finder det, der får siden til at miste kunder, og viser præcis hvad du skal gøre."
  canonical="/hjemmeside-tjek"
  structuredData={structuredData}
>
  <Nav />
  <main id="main" class="bg-canvas text-brand">
    <section class="relative mx-auto max-w-[1480px] px-4 pb-7 pt-4 sm:px-6 lg:px-10">
      <div class="relative overflow-hidden rounded-[1.8rem] border border-border-soft bg-surface/82 shadow-soft">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_14%_10%,rgba(255,255,255,0.94),transparent_33%),radial-gradient(circle_at_85%_14%,rgba(223,232,220,0.72),transparent_30%)]"></div>
        <div class="relative grid gap-10 px-6 py-10 md:grid-cols-[0.95fr_1.05fr] md:items-center md:px-12 md:py-14 lg:px-14">
          <div class="max-w-3xl">
            <p class="text-xs font-semibold uppercase tracking-[0.28em] text-accent-dark">Hjemmeside-tjek</p>
            <h1 class="mt-5 text-balance font-display text-5xl font-medium leading-[0.97] tracking-tight text-brand sm:text-6xl lg:text-7xl">
              Få en konkret gennemgang af din hjemmeside
            </h1>
            <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">
              Vi gennemgår din hjemmeside for uklart budskab, svag tillid, dårlig struktur og skjulte friktioner — og giver dig en konkret prioriteret liste over det vigtigste at rette først.
            </p>

            <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:items-center">
              <div class="rounded-[1rem] border border-accent/28 bg-white/72 px-5 py-3">
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-muted">Pris</p>
                <p class="font-display text-3xl font-medium leading-none text-brand">2.495 kr.</p>
              </div>
              <p class="max-w-sm text-sm leading-relaxed text-muted">
                Fast pris. Ingen abonnementer. Betal sikkert med kort via Stripe og få rapporten som beslutningsgrundlag.
              </p>
            </div>

            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
              <Button href="#bestil">Bestil Hjemmeside-tjek</Button>
              <Button href="/gratis-mini-tjek" variant="secondary">Start med gratis mini-tjek</Button>
            </div>
          </div>

          <div class="relative">
            <div class="rounded-[1.55rem] border border-border-soft bg-white/74 p-4 shadow-[0_24px_70px_rgba(32,38,34,0.07)] md:p-5">
              <div class="rounded-[1.25rem] border border-border-soft bg-surface p-5">
                <div class="flex items-center justify-between gap-4 border-b border-border-soft pb-4">
                  <div>
                    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent-dark">Rapportudsnit</p>
                    <h2 class="mt-2 font-display text-3xl font-medium leading-tight tracking-tight text-brand">Overblik på én side</h2>
                  </div>
                  <div class="rounded-[0.9rem] border border-accent/24 bg-accent-soft px-3 py-2 text-right">
                    <p class="text-xs font-semibold text-accent-dark">Samlet</p>
                    <p class="font-display text-3xl font-medium text-brand">61</p>
                  </div>
                </div>

                <div class="mt-5 grid gap-3">
                  <div>
                    <div class="mb-2 flex items-center justify-between text-sm text-brand/72">
                      <span>Klarhed</span>
                      <span>54/100</span>
                    </div>
                    <div class="h-2 rounded-full bg-border-soft">
                      <div class="h-2 w-[54%] rounded-full bg-accent-dark"></div>
                    </div>
                  </div>
                  <div>
                    <div class="mb-2 flex items-center justify-between text-sm text-brand/72">
                      <span>Tillid</span>
                      <span>68/100</span>
                    </div>
                    <div class="h-2 rounded-full bg-border-soft">
                      <div class="h-2 w-[68%] rounded-full bg-accent-dark"></div>
                    </div>
                  </div>
                  <div>
                    <div class="mb-2 flex items-center justify-between text-sm text-brand/72">
                      <span>Synlighed</span>
                      <span>59/100</span>
                    </div>
                    <div class="h-2 rounded-full bg-border-soft">
                      <div class="h-2 w-[59%] rounded-full bg-accent-dark"></div>
                    </div>
                  </div>
                </div>

                <div class="mt-6 rounded-[1rem] border border-accent/24 bg-accent-soft/62 p-4">
                  <p class="text-xs font-semibold uppercase tracking-[0.18em] text-accent-dark">Prioritet 1</p>
                  <p class="mt-2 font-display text-2xl font-medium leading-tight text-brand">Heroen forklarer ikke værdien hurtigt nok</p>
                  <p class="mt-2 text-sm leading-relaxed text-muted">
                    Første skærm skal fortælle hvem I hjælper, med hvad, og hvad kunden skal gøre nu.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <Container id="hvad-du-faar" class="pb-7 pt-2">
      <SectionHeader
        label="Hvad du får"
        title="En rapport du kan handle på med det samme."
        text="Tjekket samler både scores, problemer og konkrete forslag, så du ikke kun får kritik, men en klar prioritering."
      />
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {included.map((item) => (
          <div class="rounded-[1.1rem] border border-border-soft bg-white/68 px-5 py-4 shadow-soft">
            <h3 class="text-base font-semibold leading-snug text-brand">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{item.text}</p>
          </div>
        ))}
      </div>
    </Container>

    <Container id="eksempel-output" class="py-7">
      <div class="grid gap-8 rounded-[1.55rem] border border-border-soft bg-white/68 p-6 shadow-soft md:p-10 lg:grid-cols-[0.84fr_1.16fr] lg:items-center">
        <SectionHeader
          label="Eksempel på output"
          title="Så konkret bliver rapporten."
          text="Hver vigtig observation kobles til en konsekvens og et næste skridt. Du kan bruge det selv eller give det videre til den, der retter hjemmesiden."
          align="left"
        />

        <div class="grid gap-4">
          {exampleRows.map((row) => (
            <article class="rounded-[1.15rem] border border-border-soft bg-surface p-5">
              <p class="text-xs font-semibold uppercase tracking-[0.22em] text-accent-dark">{row.label}</p>
              <h3 class="mt-2 font-display text-2xl font-medium leading-tight tracking-tight text-brand">{row.value}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{row.text}</p>
            </article>
          ))}
        </div>
      </div>
    </Container>

    <Container id="det-kigger-vi-efter" class="py-7">
      <SectionHeader label="Hvad vi kigger efter" />
      <div class="mt-6 grid gap-5 md:grid-cols-3">
        <FeatureCard
          icon="clarity"
          title="Klarhed"
          text="Forstår kunden hurtigt, hvad du tilbyder, hvem det er til, og hvorfor de skal vælge dig?"
        />
        <FeatureCard
          icon="trust"
          title="Tillid"
          text="Virker siden professionel, tryg og konkret nok til at kunden tør tage kontakt?"
        />
        <FeatureCard
          icon="visibility"
          title="Synlighed"
          text="Er tekst, struktur og services tydelige for både kunder og Google?"
        />
      </div>
    </Container>

    <Container id="saadan-foregaar-det" class="py-7">
      <SectionHeader label="Sådan foregår det" />
      <div class="mt-7 grid gap-5 md:grid-cols-3">
        {process.map((step, index) => (
          <article class="rounded-[1.25rem] border border-border-soft bg-white/68 p-6 shadow-soft">
            <span class="flex h-11 w-11 items-center justify-center rounded-[0.9rem] border border-accent/24 bg-accent-soft font-display text-2xl font-medium text-accent-dark">
              {index + 1}
            </span>
            <h3 class="mt-5 font-display text-3xl font-medium leading-tight tracking-tight text-brand">{step.title}</h3>
            <p class="mt-3 text-base leading-relaxed text-muted">{step.text}</p>
          </article>
        ))}
      </div>
    </Container>

    <Container id="hvem-det-er-til" class="py-7">
      <div class="grid gap-7 rounded-[1.55rem] border border-border-soft bg-surface/74 p-6 shadow-soft md:p-10 lg:grid-cols-2 lg:items-center">
        <SectionHeader
          label="Hvem det er til"
          title="Til virksomheder hvor hjemmesiden skal skabe flere henvendelser."
          text="Det er især relevant, hvis siden findes, men ikke forklarer virksomheden tydeligt nok, ikke føles tillidsvækkende nok, eller ikke får kunder videre til kontakt."
          align="left"
        />
        <div class="grid gap-3">
          {audience.map((item) => (
            <div class="rounded-[1rem] border border-accent/20 bg-white/72 px-5 py-4 text-lg font-semibold text-brand">
              {item}
            </div>
          ))}
        </div>
      </div>
    </Container>

    <Container id="resultat" class="py-7">
      <SectionHeader
        label="Resultat"
        title="Du står tilbage med en kort liste over det vigtigste at rette først."
        text="Formålet er ikke en lang rapport for rapportens skyld. Formålet er at gøre næste beslutning lettere."
      />
      <div class="mt-8 grid gap-5 md:grid-cols-3">
        {outcomes.map((item) => (
          <div class="rounded-[1.2rem] border border-border-soft bg-white/68 p-6 text-center shadow-soft">
            <p class="font-display text-3xl font-medium leading-tight tracking-tight text-brand">{item}</p>
          </div>
        ))}
      </div>
    </Container>

    <Container id="er-det-rigtigt" class="py-7">
      <div class="grid gap-7 rounded-[1.55rem] border border-border-soft bg-white/68 p-6 shadow-soft md:p-10 lg:grid-cols-[0.86fr_1.14fr] lg:items-center">
        <SectionHeader
          label="Før du bestiller"
          title="Er Hjemmeside-tjekket rigtigt for dig?"
          align="left"
        />
        <div class="grid gap-3">
          {rightForYou.map((item) => (
            <div class="rounded-[1rem] border border-accent/20 bg-accent-soft/54 px-5 py-4 text-base font-semibold leading-relaxed text-brand">
              {item}
            </div>
          ))}
        </div>
      </div>
    </Container>

    <Container id="faq" class="py-7">
      <SectionHeader label="FAQ" title="Kort før du bestiller." />
      <div class="mt-7 grid gap-4 md:grid-cols-2">
        {faqs.map((item) => (
          <article class="rounded-[1.25rem] border border-border-soft bg-white/68 p-5 shadow-[0_14px_36px_rgba(32,38,34,0.035)] md:p-6">
            <h3 class="font-display text-2xl font-medium leading-tight tracking-tight text-brand">{item.question}</h3>
            <p class="mt-3 text-sm leading-relaxed text-muted">{item.answer}</p>
          </article>
        ))}
      </div>
    </Container>

    <Container id="bestil" class="py-7">
      <div class="grid gap-8 rounded-[1.6rem] border border-accent/28 bg-[linear-gradient(135deg,rgba(255,253,248,0.97),rgba(237,243,234,0.78))] p-6 shadow-soft md:p-10 lg:grid-cols-[0.82fr_1.18fr] lg:items-start">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.28em] text-accent-dark">Bestil hjemmeside-tjek</p>
          <h2 class="mt-5 font-display text-4xl font-medium leading-[1.02] tracking-tight text-brand md:text-5xl">
            Få rapporten for 2.495 kr.
          </h2>
          <p class="mt-5 max-w-lg text-base leading-relaxed text-muted md:text-lg">
            Udfyld formularen, så sender vi dig videre til sikker betaling. Når betalingen er gennemført, starter vi gennemgangen og leverer rapport og video inden for 48 timer på hverdage.
          </p>
          <p class="mt-4 max-w-lg rounded-[0.95rem] border border-accent/20 bg-white/66 px-4 py-3 text-sm leading-relaxed text-brand/76">
            Driller betalingssiden? Skriv direkte til <a href={checkoutFallbackMailto} class="font-semibold text-brand underline decoration-accent/45 underline-offset-4 hover:decoration-accent">{contactEmail}</a>, så sender vi et manuelt betalingslink eller en faktura.
          </p>
          <div class="mt-6 grid gap-3">
            <div class="rounded-[1rem] border border-accent/20 bg-white/66 px-4 py-3 text-sm text-brand/72">PDF-rapport med scores og top 5 problemer.</div>
            <div class="rounded-[1rem] border border-accent/20 bg-white/66 px-4 py-3 text-sm text-brand/72">Ny hero-tekst og forslag til servicestruktur.</div>
            <div class="rounded-[1rem] border border-accent/20 bg-white/66 px-4 py-3 text-sm text-brand/72">5–10 min video med de vigtigste fund.</div>
          </div>
        </div>

        <form action={checkoutAction} method="POST" class="grid gap-4 rounded-[1.25rem] border border-border-soft bg-white/76 p-5 shadow-[0_14px_36px_rgba(32,38,34,0.045)] md:p-6">
          <input type="hidden" name="source_page" value="hjemmeside_tjek_page" />
          <input type="hidden" name="return_path" value="/hjemmeside-tjek#bestil" />
          <input type="hidden" name="site_origin" value={siteOrigin} />

          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="company_name" class="mb-2 block text-sm font-semibold text-brand">Firmanavn *</label>
              <input type="text" id="company_name" name="company_name" required aria-required="true" autocomplete="organization" class="w-full rounded-[0.95rem] border border-border-soft bg-surface px-4 py-3 text-brand placeholder:text-muted/45 transition-colors focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/16" />
            </div>

            <div>
              <label for="name" class="mb-2 block text-sm font-semibold text-brand">Kontaktperson *</label>
              <input type="text" id="name" name="name" required aria-required="true" autocomplete="name" class="w-full rounded-[0.95rem] border border-border-soft bg-surface px-4 py-3 text-brand placeholder:text-muted/45 transition-colors focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/16" />
            </div>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="email" class="mb-2 block text-sm font-semibold text-brand">Email-adresse *</label>
              <input type="email" id="email" name="email" required aria-required="true" autocomplete="email" class="w-full rounded-[0.95rem] border border-border-soft bg-surface px-4 py-3 text-brand placeholder:text-muted/45 transition-colors focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/16" />
            </div>

            <div>
              <label for="website" class="mb-2 block text-sm font-semibold text-brand">Website URL *</label>
              <input type="text" inputmode="url" autocomplete="url" autocapitalize="none" spellcheck="false" id="website" name="website" placeholder="www.dinvirksomhed.dk" required aria-required="true" class="w-full rounded-[0.95rem] border border-border-soft bg-surface px-4 py-3 text-brand placeholder:text-muted/45 transition-colors focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/16" />
            </div>
          </div>

          <div>
            <label for="message" class="mb-2 block text-sm font-semibold text-brand">Noter (valgfri)</label>
            <textarea id="message" name="message" rows="4" placeholder="Fx primær ydelse, område eller sider vi skal kigge ekstra på." class="w-full resize-y rounded-[0.95rem] border border-border-soft bg-surface px-4 py-3 text-brand placeholder:text-muted/45 transition-colors focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/16"></textarea>
          </div>

          <div class="flex items-start gap-3">
            <input type="checkbox" id="gdpr" name="gdpr" required aria-required="true" class="mt-1" />
            <label for="gdpr" class="text-sm leading-relaxed text-muted">
              Jeg accepterer at SiteDok bruger mine data til at levere Hjemmeside-tjekket og kontakte mig om ordren.
            </label>
          </div>

          <button type="submit" class="inline-flex w-full items-center justify-center rounded-[0.9rem] border border-accent bg-accent px-6 py-3.5 text-sm font-semibold text-white shadow-[0_14px_30px_rgba(83,112,88,0.18)] transition duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] hover:border-accent-dark hover:bg-accent-dark focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent active:translate-y-px">
            Bestil Hjemmeside-tjek
          </button>

          <p class="text-sm font-semibold leading-relaxed text-brand/76">
            Ingen abonnementer. Ingen binding. Du får en konkret rapport, du kan bruge med det samme.
          </p>

          <p class="text-xs leading-relaxed text-muted">
            Når du klikker, opretter vi en Stripe-checkout med dine ordreoplysninger. Stripe sender kvittering, og SiteDok sender rapport og video.
          </p>
          <p class="rounded-[0.85rem] border border-accent/18 bg-accent-soft/45 px-4 py-3 text-sm leading-relaxed text-brand/74">
            Hvis checkout ikke åbner, kan du stadig bestille manuelt: send firmanavn, website og kort note til <a href={checkoutFallbackMailto} class="font-semibold text-brand underline decoration-accent/45 underline-offset-4 hover:decoration-accent">{contactEmail}</a>.
          </p>
        </form>
      </div>
    </Container>

    <Container id="naeste-skridt" class="pb-16 pt-7 md:pb-20">
      <SectionHeader
        label="Hvis du vil have os til at rette det bagefter"
        title="To naturlige næste skridt efter rapporten."
      />
      <div class="mt-7 grid gap-5 lg:grid-cols-2">
        <SecondaryOfferCard
          id="hjemmeside-fix"
          icon="fix"
          title="Hjemmeside-fix"
          price="6.500-12.500 kr."
          text="Vi retter tekst, struktur og kontaktknapper, så siden bliver lettere at forstå og handle på."
        />
        <SecondaryOfferCard
          id="visuelt-loeft"
          icon="visual"
          title="Visuelt løft"
          price="Fra 9.500 kr."
          text="Vi forbedrer design, billeder og førstehåndsindtryk, så siden føles mere professionel."
        />
      </div>
