---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AdvisoryPage from '../components/site/AdvisoryPage.astro';
import '../styles/global.css';
---

<Layout
  title="Agentic search-diagnose | SiteDokAI"
  description="En rolig diagnose af om virksomheden bliver fundet, forstået og valgt i AI-søgning og agentic search."
  canonical="/hjemmeside-tjek"
>
  <Nav />
  <AdvisoryPage
    eyebrow="Diagnose"
    title="En agentic search-diagnose, ikke endnu en tung rapport."
    text="Når screeningen viser et reelt hul, kan vi gå dybere med de spørgsmål, kilder, konkurrenter og website-signaler, der afgør om AI kan anbefale jer."
    points={[
      'Vi tester de vigtigste research- og købsspørgsmål.',
      'Vi ser på kilder, beviser, struktur og konkurrenter.',
      'Du får et prioriteret beslutningsgrundlag for et muligt forløb.',
    ]}
    note="Det kan være nok med rådgivning. Det kan også blive et implementeringsforløb, hvor vi hjælper med tekst, struktur, schema og beviser."
  />
  <Footer />
</Layout>
