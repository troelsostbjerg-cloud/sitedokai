---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AdvisoryPage from '../components/site/AdvisoryPage.astro';
import '../styles/global.css';
---

<Layout
  title="Manual Work Audit | SiteDokAI"
  description="På 5 arbejdsdage kortlægger SiteDokAI manuelle workflows og prioriterer de 3 bedste AI-pilots."
  canonical="/hjemmeside-tjek"
>
  <Nav />
  <AdvisoryPage
    eyebrow="Manual Work Audit"
    title="Find de manuelle workflows, der stjæler mest tid."
    text="På 5 arbejdsdage kortlægger vi jeres mest tidskrævende manuelle arbejdsgange og prioriterer de 3 bedste AI-pilots."
    points={[
      'Interview med 3-6 nøglepersoner og kortlægning af gentagne opgaver.',
      'Proceskort, automationsvurdering og prioriteret backlog med 10 muligheder.',
      'Top 3 anbefalede pilots og en simpel workflow-skitse på bedste case.',
    ]}
    note="Pris fra 15.000 kr. ekskl. moms. Målet er et beslutningsgrundlag, ikke en tung rapport til skuffen."
    ctaLabel="Book audit"
  />
  <Footer />
</Layout>
