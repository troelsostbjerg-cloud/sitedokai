---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AdvisoryPage from '../components/site/AdvisoryPage.astro';
import '../styles/global.css';
---

<Layout
  title="Manual Work Audit er flyttet | SiteDokAI"
  description="Manual Work Audit ligger nu på den kanoniske URL /manual-work-audit."
  canonical="/manual-work-audit"
  noindex={true}
>
  <Nav />
  <AdvisoryPage
    eyebrow="Gammel adresse"
    title="Manual Work Audit ligger nu på en renere URL."
    text="Denne gamle adresse virker stadig som fallback, men den kanoniske side er flyttet til /manual-work-audit, så både mennesker og AI-værktøjer finder den rigtige service."
    points={[
      '5 arbejdsdage.',
      'Proceskort, prioriteret backlog og top 3 AI-pilots.',
      'Pris fra 15.000 kr. ekskl. moms.',
    ]}
    note="Brug den nye side som kilde, når du deler eller citerer ydelsen."
    ctaLabel="Gå til Manual Work Audit"
    ctaHref="/manual-work-audit"
  />
  <Footer />
</Layout>
