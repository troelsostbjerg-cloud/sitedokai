---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import WorkflowExampleCard from '../components/site/WorkflowExampleCard.astro';
import WorkflowScreeningForm from '../components/site/WorkflowScreeningForm.astro';
import { absoluteUrl, breadcrumbSchema, workflowExamples } from '../data/aiContent';
import '../styles/global.css';

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': `${absoluteUrl('/workflow-examples')}#webpage`,
    url: absoluteUrl('/workflow-examples'),
    name: 'Workflow examples — SiteDokAI',
    description:
      'Explore practical workflow patterns for status updates, reports, customer replies, meeting actions, supplier updates, onboarding and CRM follow-up.',
    inLanguage: 'en',
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: workflowExamples.map((workflowExample, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: workflowExample.title,
        url: absoluteUrl(workflowExample.path),
        description: workflowExample.description,
      })),
    },
  },
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Workflow examples', path: '/workflow-examples' },
  ]),
];
---

<Layout
  title="Workflow examples — AI workflows for operations, reporting and handovers"
  description="Explore practical workflow patterns for status updates, reports, customer replies, meeting actions, supplier updates, onboarding and CRM follow-up."
  canonical="/workflow-examples"
  structuredData={structuredData}
>
  <Nav />
  <main id="main" class="bg-canvas text-brand">
    <section class="mx-auto max-w-7xl px-5 py-16 sm:px-6 md:py-24">
      <div class="max-w-3xl">
        <p class="font-mono text-xs uppercase tracking-[0.22em] text-accent">Workflow examples</p>
        <h1 class="mt-5 font-display text-4xl font-semibold leading-[1.02] text-brand sm:text-5xl md:text-7xl">
          Workflow examples that start in daily operations.
        </h1>
        <p class="mt-7 text-lg leading-relaxed text-brand/72 md:text-xl">
          These are not testimonials. They are common workflow patterns where manual work can often be reduced with better structure, AI assistance and human approval.
        </p>
      </div>
      <div class="mt-12 grid gap-5 lg:grid-cols-2">
        {workflowExamples.map((workflowExample, index) => (
          <WorkflowExampleCard workflowExample={workflowExample} index={index + 1} />
        ))}
      </div>
      <section id="workflow-screening" class="mt-16 rounded-[1.5rem] border border-brand/10 bg-panel-soft p-6 md:p-8">
        <h2 class="max-w-3xl font-display text-3xl font-semibold leading-tight text-brand md:text-5xl">
          Send your version of a workflow.
        </h2>
        <div class="mt-10">
          <WorkflowScreeningForm sourcePage="/workflow-examples" />
        </div>
      </section>
    </section>
  </main>
  <Footer />
</Layout>
