---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AdvisoryPage from '../components/site/AdvisoryPage.astro';
import '../styles/global.css';
---

<Layout
  title="Om SiteDokAI"
  description="SiteDokAI er bygget af Troels Østbjerg som en praktisk AI operations practice for procesoptimering og brugbare AI-workflows."
  canonical="/om"
>
  <Nav />
  <AdvisoryPage
    eyebrow="Om"
    title="Bygget af en operationsmand, ikke en AI-teoretiker."
    text="SiteDokAI er bygget af Troels Østbjerg. Min styrke er at finde det arbejde, der burde være smartere, kortlægge hvordan det faktisk foregår og bygge løsninger, mennesker kan bruge i en travl hverdag."
    points={[
      '10+ års erfaring med operations, supply chain og procesoptimering.',
      'Hands-on AI power-user med praktisk workflow-bygning.',
      'Fokus på adoption: løsningen skal bruges, ikke bare vises.',
    ]}
    note="AI er værktøjet. Processen er startpunktet."
    ctaLabel="Send workflow"
  />
  <Footer />
</Layout>
