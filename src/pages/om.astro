---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AdvisoryPage from '../components/site/AdvisoryPage.astro';
import '../styles/global.css';
---

<Layout
  title="Om SiteDokAI"
  description="SiteDokAI rådgiver virksomheder om agentic search, AI-synlighed og hvordan website-indhold bliver lettere at forstå og citere."
  canonical="/om"
>
  <Nav />
  <AdvisoryPage
    eyebrow="Om"
    title="SiteDokAI hjælper virksomheder med at blive læsbare for AI-agenter."
    text="Vi arbejder i krydsfeltet mellem website-klarhed, kilder, søgeadfærd og AI-agenters måde at undersøge markedet på. Vores opgave er at gøre det lettere at forstå, om virksomheden bliver fundet og valgt."
    points={[
      'Dansk rådgivning, kort vej fra analyse til handling.',
      'Menneskelig klarhed før teknisk jargon.',
      'Første samtale og screening uden beregning.',
    ]}
  />
  <Footer />
</Layout>
