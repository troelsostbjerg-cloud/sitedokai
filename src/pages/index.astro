---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ScreeningForm from '../components/site/ScreeningForm.astro';
import Button from '../components/site/Button.astro';
import '../styles/global.css';

const focusAreas = [
  {
    title: 'Bliver virksomheden fundet?',
    text: 'Vi tester de spørgsmål, kunder, indkøbere og AI-assistenter bruger, når de leder efter løsninger som jeres.',
  },
  {
    title: 'Kan AI forstå jer?',
    text: 'Vi ser på ydelser, målgrupper, beviser, cases, priser, lokationer og de kilder en agent kan citere.',
  },
  {
    title: 'Bliver I valgt?',
    text: 'Vi vurderer om I bliver anbefalet, fravalgt eller erstattet af konkurrenter i de svar, der former kundens shortlist.',
  },
];

const advisoryProcess = [
  ['01', 'Screening', 'Første samtale og kort screening uden beregning. Vi afklarer om der er et relevant problem at arbejde med.'],
  ['02', 'Diagnose', 'Vi tester agentic search, AI-svar, kilder og konkurrentbillede omkring jeres vigtigste ydelser.'],
  ['03', 'Forløb', 'Hvis det giver mening, rådgiver vi om struktur, indhold, beviser og website-ændringer, der gør jer lettere at vælge.'],
];

const signals = [
  'AI-svar i ChatGPT, Gemini, Claude og Google AI',
  'Kilder, schema, FAQ, cases og beslutningssvar',
  'Konkurrenter der bliver nævnt før jer',
  'B2B-research, lokale valg og forbrugerbeslutninger',
];

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://sitedokai.com/#organization',
      name: 'SiteDokAI',
      url: 'https://sitedokai.com',
      logo: 'https://sitedokai.com/favicon.svg',
      email: 'info@sitedokai.com',
      contactPoint: {
        '@type': 'ContactPoint',
        email: 'info@sitedokai.com',
        contactType: 'customer service',
        availableLanguage: ['da-DK'],
        areaServed: 'DK',
      },
    },
    {
      '@type': 'ProfessionalService',
      '@id': 'https://sitedokai.com/#service',
      name: 'SiteDokAI',
      serviceType: 'Rådgivning om agentic search og AI-synlighed',
      provider: {
        '@id': 'https://sitedokai.com/#organization',
      },
      areaServed: {
        '@type': 'Country',
        name: 'Danmark',
      },
      email: 'info@sitedokai.com',
      knowsAbout: [
        'Agentic search',
        'AI-synlighed',
        'AI-agenter',
        'Answer Engine Optimization',
        'Generative Engine Optimization',
        'ChatGPT',
        'Gemini',
        'Google AI',
        'Claude',
      ],
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'DKK',
        itemOffered: {
          '@type': 'Service',
          name: 'Første samtale og screening',
          description: 'Uforpligtende første screening af om virksomheden har et relevant agentic search-problem.',
        },
      },
    },
  ],
};
---

<Layout
  title="SiteDokAI | Rådgivning om agentic search"
  description="SiteDokAI rådgiver virksomheder om agentic search, AI-synlighed og hvordan de bliver fundet, forstået og valgt af AI-agenter. Første samtale og screening er uden beregning."
  structuredData={structuredData}
>
  <Nav />
  <main id="main" class="bg-canvas text-brand">
    <section class="mx-auto grid min-w-0 max-w-6xl gap-12 px-5 pb-16 pt-16 sm:px-6 md:pb-24 md:pt-24 lg:grid-cols-[0.72fr_1.28fr]">
      <aside class="min-w-0 text-sm leading-relaxed text-muted">
        <p class="font-mono text-xs uppercase tracking-[0.22em] text-brand/50">Agentic search rådgivning</p>
        <p class="mt-8 max-w-xs">
          For virksomheder der vil forstå, hvordan AI-agenter ændrer synlighed, research og valg af leverandører.
        </p>
      </aside>

      <div class="min-w-0">
        <h1 class="max-w-5xl font-display text-5xl font-semibold leading-[0.94] tracking-[-0.045em] text-brand sm:text-6xl md:text-8xl md:tracking-[-0.055em]">
          <span class="block">Bliv forstået</span>
          <span class="block">og valgt i</span>
          <span class="block">agentic search.</span>
        </h1>
        <p class="mt-8 max-w-[21rem] text-lg leading-relaxed text-brand/68 md:max-w-3xl md:text-2xl">
          SiteDokAI rådgiver om AI-søgning, AI-agenter og Googles nye Search. Vi hjælper jer med at blive lettere at finde, sammenligne og vælge.
        </p>
        <div class="mt-10 flex flex-col gap-3 sm:flex-row">
          <Button href="/kontakt#screening">Book gratis screening</Button>
          <Button href="/blog/google-agentic-search-2026" variant="secondary">Læs om Google-skiftet</Button>
        </div>
      </div>
    </section>

    <section id="agentic-search" class="border-y border-brand/10">
      <div class="mx-auto grid min-w-0 max-w-6xl gap-10 px-5 py-16 sm:px-6 md:py-24 lg:grid-cols-[0.72fr_1.28fr]">
        <div class="min-w-0">
          <p class="font-mono text-xs uppercase tracking-[0.22em] text-brand/45">Hvad vi rådgiver om</p>
        </div>
        <div class="grid min-w-0 gap-10">
          <div>
            <h2 class="max-w-3xl font-display text-3xl font-semibold leading-tight tracking-[-0.03em] text-brand md:text-6xl">
              Søgemaskinen bliver en agent. Det gør jeres website til et kildegrundlag.
            </h2>
            <p class="mt-6 max-w-[21rem] text-lg leading-relaxed text-muted md:max-w-2xl">
              Det handler ikke kun om private spørgsmål i ChatGPT. Både virksomheder og forbrugere bruger AI til research, sammenligning, shortlist og næste handling. Hvis jeres information er uklar, bliver I svære at anbefale.
            </p>
          </div>

          <div class="grid border-t border-brand/12 md:grid-cols-3">
            {focusAreas.map((area) => (
              <article class="border-b border-brand/12 py-7 md:border-b-0 md:border-r md:px-6 md:first:pl-0 md:last:border-r-0 md:last:pr-0">
                <h3 class="text-lg font-semibold tracking-[-0.015em] text-brand">{area.title}</h3>
                <p class="mt-3 text-sm leading-relaxed text-muted">{area.text}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="forloeb" class="border-b border-brand/10">
      <div class="mx-auto grid min-w-0 max-w-6xl gap-10 px-5 py-16 sm:px-6 md:py-24 lg:grid-cols-[0.72fr_1.28fr]">
        <div class="min-w-0">
          <p class="font-mono text-xs uppercase tracking-[0.22em] text-brand/45">Forløbet</p>
        </div>
        <div class="min-w-0">
          <h2 class="max-w-3xl font-display text-3xl font-semibold leading-tight tracking-[-0.03em] text-brand md:text-6xl">
            Først afklarer vi, om der overhovedet er noget at løse.
          </h2>
          <div class="mt-10 divide-y divide-brand/12 border-y border-brand/12">
            {advisoryProcess.map(([number, title, text]) => (
              <article class="grid gap-5 py-7 md:grid-cols-[5rem_0.8fr_1.4fr] md:items-start">
                <p class="font-mono text-xs uppercase tracking-[0.18em] text-brand/38">{number}</p>
                <h3 class="text-xl font-semibold tracking-[-0.018em] text-brand">{title}</h3>
                <p class="max-w-2xl text-base leading-relaxed text-muted">{text}</p>
              </article>
            ))}
          </div>
          <p class="mt-8 max-w-[21rem] text-base leading-relaxed text-muted md:max-w-2xl">
            Der er ingen fast pakke, vi presser ned over alle. Nogle har brug for en strategisk workshop. Andre har brug for at få omskrevet centrale sider, FAQ, schema, cases og beviser, så AI faktisk har noget at arbejde med.
          </p>
        </div>
      </div>
    </section>

    <section class="border-b border-brand/10">
      <div class="mx-auto grid min-w-0 max-w-6xl gap-10 px-5 py-16 sm:px-6 md:py-24 lg:grid-cols-[0.72fr_1.28fr]">
        <div class="min-w-0">
          <p class="font-mono text-xs uppercase tracking-[0.22em] text-brand/45">Signalområder</p>
        </div>
        <div class="grid min-w-0 gap-4 sm:grid-cols-2">
          {signals.map((signal) => (
            <p class="border-t border-brand/12 pt-4 text-base leading-relaxed text-brand/72">{signal}</p>
          ))}
        </div>
      </div>
    </section>

    <section id="screening" class="mx-auto grid min-w-0 max-w-6xl gap-10 px-5 py-16 sm:px-6 md:py-24 lg:grid-cols-[0.72fr_1.28fr]">
      <div class="min-w-0">
        <p class="font-mono text-xs uppercase tracking-[0.22em] text-brand/45">Gratis start</p>
      </div>
      <div class="min-w-0">
        <h2 class="max-w-3xl font-display text-3xl font-semibold leading-tight tracking-[-0.03em] text-brand md:text-6xl">
          Første samtale og screening er uden beregning.
        </h2>
        <p class="mt-6 max-w-[21rem] text-lg leading-relaxed text-muted md:max-w-2xl">
          Send jeres hjemmeside og en kort note. Vi vender tilbage med en nøgtern vurdering af, om agentic search bør være et konkret fokus for jer nu.
        </p>
        <div class="mt-12">
          <ScreeningForm sourcePage="/" />
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
