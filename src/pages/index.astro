---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Container from '../components/site/Container.astro';
import FeatureCard from '../components/site/FeatureCard.astro';
import HeroSection from '../components/site/HeroSection.astro';
import MiniCheckPreview from '../components/site/MiniCheckPreview.astro';
import MiniCheckBenefitStrip from '../components/site/MiniCheckBenefitStrip.astro';
import ClientRoomPreview from '../components/ClientRoomPreview.astro';
import PaidAuditCard from '../components/site/PaidAuditCard.astro';
import SecondaryOfferCard from '../components/site/SecondaryOfferCard.astro';
import SectionHeader from '../components/site/SectionHeader.astro';
import TrustProofStrip from '../components/site/TrustProofStrip.astro';
import Button from '../components/site/Button.astro';
import '../styles/global.css';

const methodPoints = [
  ['1. AI-spørgsmål', 'Hvilke købsspørgsmål stiller kunderne i ChatGPT, Gemini, Claude og Google AI?'],
  ['2. Synlighed', 'Bliver virksomheden nævnt, anbefalet eller kun brugt som kilde?'],
  ['3. Konkurrenter', 'Hvem bliver valgt i stedet, og hvilke beviser bruger AI til at vælge dem?'],
  ['4. Handling', 'Hvilke sider, kilder og tekster bør rettes først for at lukke hullet?'],
];

const startPath = [
  {
    eyebrow: 'Start her',
    title: 'Gratis AI-tjek',
    price: '0 kr.',
    text: 'Første vurdering af om virksomheden dukker op i relevante AI-søgninger.',
  },
  {
    eyebrow: 'Næste naturlige skridt',
    title: 'AI Audit + Client Room',
    price: '2.495 kr.',
    text: 'Fuld test af spørgsmål, platforme, konkurrenter, kilder og næste handlinger.',
  },
  {
    eyebrow: 'Hvis du vil have det rettet',
    title: 'Visibility Sprint eller fix',
    price: 'fra 6.500 kr.',
    text: 'Tekst, struktur, kilder, schema, landing pages og beviser, så AI har noget bedre at vælge.',
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://sitedokai.com/#organization',
      name: 'SiteDokAI',
      url: 'https://sitedokai.com',
      logo: 'https://sitedokai.com/favicon.svg',
      email: 'info@sitedokai.com',
      contactPoint: {
        '@type': 'ContactPoint',
        email: 'info@sitedokai.com',
        contactType: 'customer service',
        availableLanguage: ['da-DK'],
        areaServed: 'DK',
      },
    },
    {
      '@type': 'WebSite',
      '@id': 'https://sitedokai.com/#website',
      url: 'https://sitedokai.com',
      name: 'SiteDokAI',
      inLanguage: 'da-DK',
    },
    {
      '@type': 'ProfessionalService',
      '@id': 'https://sitedokai.com/#service',
      name: 'SiteDokAI',
      serviceType: 'AI-synlighedstjek, AI Audit, Client Room, Hjemmeside-fix og Visuelt løft for små virksomheder',
      provider: {
        '@id': 'https://sitedokai.com/#organization',
      },
      areaServed: {
        '@type': 'Country',
        name: 'Danmark',
      },
      email: 'info@sitedokai.com',
      knowsAbout: [
        'AI-synlighed',
        'Generative Engine Optimization',
        'Client Room',
        'ChatGPT',
        'Gemini',
        'Google AI',
        'Claude',
        'små virksomheders digitale synlighed',
      ],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'SiteDokAI ydelser',
        itemListElement: [
          {
            '@type': 'Offer',
            price: '0',
            priceCurrency: 'DKK',
            itemOffered: {
              '@type': 'Service',
              name: 'Gratis AI-tjek',
              description: 'Første vurdering af om virksomheden bliver fundet i relevante AI-søgninger.',
            },
          },
          {
            '@type': 'Offer',
            price: '2495',
            priceCurrency: 'DKK',
            itemOffered: {
              '@type': 'Service',
              name: 'AI Audit + Client Room',
              description: 'Fuld gennemgang af AI-synlighed, søgninger, platforme, konkurrenter, kilder og prioriterede handlinger.',
            },
          },
          {
            '@type': 'Offer',
            priceSpecification: {
              '@type': 'PriceSpecification',
              minPrice: '6500',
              maxPrice: '12500',
              priceCurrency: 'DKK',
            },
            itemOffered: {
              '@type': 'Service',
              name: 'Hjemmeside-fix',
              description: 'Ret tekst, struktur, kilder og kontaktveje, så virksomheden står klarere for kunder og AI.',
            },
          },
          {
            '@type': 'Offer',
            priceSpecification: {
              '@type': 'PriceSpecification',
              minPrice: '9500',
              priceCurrency: 'DKK',
            },
            itemOffered: {
              '@type': 'Service',
              name: 'Visuelt løft',
              description: 'Forbedr design, billeder og førstehåndsindtryk.',
            },
          },
        ],
      },
    },
    {
      '@type': 'FAQPage',
      '@id': 'https://sitedokai.com/#faq',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'Hvad får jeg i et gratis AI-tjek?',
          acceptedAnswer: {
            '@type': 'Answer',
