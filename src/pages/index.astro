---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ScreeningForm from '../components/site/ScreeningForm.astro';
import Button from '../components/site/Button.astro';
import RoiCalculator from '../components/site/RoiCalculator.astro';
import { useCases } from '../data/aiContent';
import '../styles/global.css';

const problemCards = [
  ['01', 'Status skal jagtes manuelt', 'Folk bruger tid på at finde seneste status i mails, møder og løse beskeder.'],
  ['02', 'Data flyttes mellem systemer', 'Excel, CRM, Teams og rapporter holdes sammen af copy-paste og menneskelig hukommelse.'],
  ['03', 'Rapporter bygges fra bunden', 'De samme tal, noter og afvigelser samles igen og igen uden fast flow.'],
  ['04', 'Møder bruges på opdateringer', 'Beslutningstid bliver spist af statusrunder, fordi overblikket ikke findes før mødet.'],
  ['05', 'Handover sker i løse noter', 'Vigtig kontekst forsvinder mellem salg, levering, support, finance eller projektteams.'],
  ['06', 'Kunder behandles forskelligt', 'Svar, vurderinger og næste skridt afhænger for meget af hvem der sidder med sagen.'],
  ['07', 'Viden ligger hos én person', 'Processen virker, så længe den rigtige person husker detaljerne.'],
  ['08', 'AI bruges kun som ad hoc-chat', 'Der er testet lidt, men AI er ikke blevet en del af den faktiske drift.'],
];

const beforeAfterExamples = [
  {
    before: 'Status jagtes i mails, Teams og løse noter.',
    after: 'Én samlet AI-status med actions, ansvarlige og deadlines.',
    effect: 'Færre statusmøder og hurtigere beslutning.',
  },
  {
    before: 'Excel-tal kopieres manuelt ind i ledelsesrapporten.',
    after: 'Rapportkladde med afvigelser, forklaring og næste beslutning.',
    effect: 'Mindre formatarbejde og mere tid til vurdering.',
  },
  {
    before: 'Kundehenvendelser besvares forskelligt fra person til person.',
    after: 'Svarudkast med kontekst, kategori og human approval.',
    effect: 'Mere ens kvalitet uden at fjerne ansvar.',
  },
];

const maturitySignals = [
  'Gentages den ugentligt eller dagligt?',
  'Bruger flere personer tid på den?',
  'Flytter I data mellem systemer?',
  'Opstår der fejl eller ventetid?',
  'Kan output beskrives i en fast skabelon?',
];

const targetTeams = [
  ['Operations', 'Status, ansvar, afvigelser og opfølgninger på tværs af hverdagen.'],
  ['Supply chain', 'Leverandørstatus, undtagelser, forecast-noter og handovers.'],
  ['Kundeservice', 'Henvendelser, svarudkast, kategorisering og eskalering.'],
  ['Projektteams', 'Mødenoter, beslutninger, risici, actions og ugerytme.'],
  ['Finance', 'Rapportering, afvigelser, datakontrol og faste forklaringer.'],
  ['Salg/Customer Success', 'CRM-noter, næste skridt, tilbudsafklaring og kundeoverdragelse.'],
  ['Ledelse', 'Beslutningsoplæg, statusoverblik og bedre ejerskab uden flere møder.'],
];

const methodSteps = [
  ['01', 'Manuel friktion', 'Find hvor tid, kvalitet og ejerskab forsvinder i mails, Excel, Teams, CRM og rapporter.'],
  ['02', 'Workflow mapping', 'Kortlæg den faktiske arbejdsgang, input, undtagelser og menneskerne omkring processen.'],
  ['03', 'Prioritering', 'Scor muligheder efter tid sparet, fejlrisiko, kompleksitet og chance for adoption.'],
  ['04', 'AI-assisteret workflow', 'Byg én lille arbejdsgang med tydelig input, logik, output og brugssituation.'],
  ['05', 'Human approval', 'Læg menneskelig godkendelse ind, hvor risiko, kvalitet eller tone kræver det.'],
  ['06', 'Målt effekt', 'Mål på timer sparet, færre fejl, hurtigere beslutning og faktisk brug i hverdagen.'],
];

const services = [
  {
    name: 'Manual Work Audit',
    price: 'Fra 15.000 kr. ekskl. moms',
    duration: '5 arbejdsdage',
    step: '1. Find friktionen',
    bestFor: 'Nye kunder og teams, der vil vide hvor AI giver mening først.',
    text: 'Vi kortlægger jeres manuelle workflows, finder hvor tiden forsvinder og prioriterer de 3 bedste AI-pilots.',
    cta: 'Se Manual Work Audit',
    highlighted: true,
    includes: ['workshop/interviews', 'proceskort', 'prioriteret backlog', 'top 3 AI-pilots', 'første workflow-skitse', 'målepunkter'],
    notIncluded: 'Ingen bygget automation, tool-indkøb eller stort roadmap.',
    nextStep: 'Beslut om første workflow skal bygges i en sprint.',
  },
  {
    name: 'AI Workflow Sprint',
    price: 'Fra 35.000 kr. ekskl. moms',
    duration: '10 arbejdsdage',
    step: '2. Byg første workflow',
    bestFor: 'Teams med én konkret proces, der allerede er værd at løse.',
    text: 'Vi bygger én konkret AI-workflow på et hverdagsproblem, tester den med brugerne og gør den klar til drift.',
    cta: 'Byg første workflow',
    highlighted: false,
    includes: ['workflow-design', 'AI-logik/promptstruktur', 'automation/prototype', 'test', 'dokumentation', 'træning og effektmåling'],
    notIncluded: 'Ingen fuld systemudskiftning eller blind fuldautomatisering.',
    nextStep: 'Test i hverdagen, mål effekt og beslut næste forbedring.',
  },
  {
    name: 'AI Operations Partner',
    price: 'Fra 10.000 kr./md. ekskl. moms',
    duration: 'Løbende',
    step: '3. Hold forbedringer i gang',
    bestFor: 'Virksomheder med de første workflows og behov for løbende drift.',
    text: 'Fast hjælp til at holde forbedringerne i gang, optimere workflows og sikre adoption.',
    cta: 'Tal om løbende hjælp',
    highlighted: false,
    includes: ['månedlig backlog', 'workflow-forbedringer', 'dokumentation', 'træning', 'adoption', 'status på effekt'],
    notIncluded: 'Ingen passiv rådgiverretainer uden konkrete forbedringer.',
    nextStep: 'Fast rytme for prioritering, forbedring, dokumentation og måling.',
  },
];

const auditOutputPanels = [
  ['Proceskort', 'Hvem gør hvad, hvornår, med hvilke input og hvor ventetiden opstår.'],
  ['Prioriteret backlog', 'Muligheder sorteret efter effekt, kompleksitet, risiko og adoption.'],
  ['Top 3 AI-pilots', 'De første workflow-kandidater med tydelig begrundelse.'],
  ['Workflow-skitse', 'Input, AI-logik, human approval, output og næste brugerhandling.'],
  ['Estimeret effekt', 'Et nøgternt estimat på tid, fejl, beslutningstid og brugbarhed.'],
];

const faqItems = [
  ['Skal vi have valgt AI-værktøj først?', 'Nej. Vi starter med arbejdet, ikke værktøjet. Når processen er klar, vælger vi den enkleste løsning, ofte i værktøjer I allerede bruger.'],
  ['Hvad hvis vores proces er rodet?', 'Så er auditten ofte endnu mere relevant. Hvis processen er uklar, bliver AI bare hurtigere rod. Først gør vi arbejdet forståeligt.'],
  ['Kan I arbejde med vores eksisterende systemer?', 'Ja, hvis det er praktisk og sikkert. Typisk starter vi med mails, Excel/Sheets, Teams/Slack, SharePoint/Drive, CRM eller faste eksportfiler.'],
  ['Er det fuldautomatisering?', 'Ikke nødvendigvis. Mange gode workflows er AI-assisterede med human approval, så tempoet stiger uden at ansvar og kvalitet forsvinder.'],
  ['Hvordan måler vi effekt?', 'Vi måler på tid sparet, færre fejl, mindre ventetid, hurtigere beslutning og om workflowet faktisk bliver brugt.'],
  ['Hvor meget tid skal vores team bruge?', 'En Manual Work Audit kræver typisk korte interviews med 3-6 nøglepersoner og adgang til eksempler på det manuelle arbejde.'],
  ['Hvad sker der efter auditten?', 'I får et beslutningsgrundlag: proceskort, backlog, top 3 pilots og anbefaling til første workflow. I kan bygge videre med os eller selv.'],
  ['Hvad hvis processen ikke egner sig til AI?', 'Så siger vi det. Nogle flows skal fjernes, forenkles eller dokumenteres før AI giver mening.'],
];

const servicePages: Record<string, { id: string; path: string; url: string; price: string }> = {
  'Manual Work Audit': {
    id: 'manual-work-audit',
    path: '/manual-work-audit',
    url: 'https://sitedokai.com/manual-work-audit',
    price: '15000',
  },
  'AI Workflow Sprint': {
    id: 'ai-workflow-sprint',
    path: '/ai-workflow-sprint',
    url: 'https://sitedokai.com/ai-workflow-sprint',
    price: '35000',
  },
  'AI Operations Partner': {
    id: 'ai-operations-partner',
    path: '/ai-operations-partner',
    url: 'https://sitedokai.com/ai-operations-partner',
    price: '10000',
  },
};

const serviceSchema = services.map((service) => {
  const page = servicePages[service.name];
  return {
    '@type': 'Service',
    '@id': `https://sitedokai.com/#${page.id}`,
    name: service.name,
    url: page.url,
    serviceType: service.name,
    description: service.text,
    provider: {
      '@id': 'https://sitedokai.com/#organization',
    },
    areaServed: {
      '@type': 'Country',
      name: 'Danmark',
    },
    audience: {
      '@type': 'BusinessAudience',
      audienceType: 'Virksomheder med manuelle workflows, gentagne driftsopgaver og praktiske AI-implementeringsbehov',
    },
    offers: {
      '@type': 'Offer',
      url: page.url,
      price: page.price,
      priceCurrency: 'DKK',
      availability: 'https://schema.org/InStock',
    },
  };
});

const aiProofItems = [
  ['AI-klar side', 'Synlig dokumentation af hvordan vi tester vores egen AI-discoverability.', '/ai-klar'],
  ['llms.txt', 'Kort, maskinlæsbar profil for AI-agenter og research-værktøjer.', '/llms.txt'],
  ['Schema', 'Struktureret data for organisation, website og de tre ydelser.', null],
  ['Sitemap', 'Indekserbare servicesider, cases og proof-of-work samlet i sitemap.', '/sitemap.xml'],
  ['Konkret copy', 'Klare svar på hvad vi gør, hvem det er for, prisniveau og næste skridt.', null],
];

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://sitedokai.com/#organization',
      name: 'SiteDokAI',
      url: 'https://sitedokai.com',
      logo: 'https://sitedokai.com/favicon.svg',
      email: 'info@sitedokai.com',
      founder: {
