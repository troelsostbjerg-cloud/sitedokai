      inLanguage: 'da-DK',
      publisher: {
        '@id': 'https://sitedokai.com/#organization',
      },
      description: 'Dansk website om AI-drevet procesoptimering, Manual Work Audit og praktiske AI-workflows.',
    },
    {
      '@type': 'WebPage',
      '@id': 'https://sitedokai.com/#webpage',
      url: 'https://sitedokai.com/',
      name: 'SiteDokAI — Find manuelt arbejde og byg AI-workflows, folk bruger',
      isPartOf: {
        '@id': 'https://sitedokai.com/#website',
      },
      about: {
        '@id': 'https://sitedokai.com/#service',
      },
      primaryImageOfPage: {
        '@type': 'ImageObject',
        url: 'https://sitedokai.com/og-image.svg',
        width: 1200,
        height: 630,
      },
      inLanguage: 'da-DK',
    },
    {
      '@type': 'ProfessionalService',
      '@id': 'https://sitedokai.com/#service',
