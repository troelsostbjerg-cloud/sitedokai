---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Container from '../components/site/Container.astro';
import FeatureCard from '../components/site/FeatureCard.astro';
import HeroSection from '../components/site/HeroSection.astro';
import MiniCheckPreview from '../components/site/MiniCheckPreview.astro';
import MiniCheckBenefitStrip from '../components/site/MiniCheckBenefitStrip.astro';
import ClientRoomPreview from '../components/ClientRoomPreview.astro';
import PaidAuditCard from '../components/site/PaidAuditCard.astro';
import SecondaryOfferCard from '../components/site/SecondaryOfferCard.astro';
import SectionHeader from '../components/site/SectionHeader.astro';
import TrustProofStrip from '../components/site/TrustProofStrip.astro';
import Button from '../components/site/Button.astro';
import '../styles/global.css';

const methodPoints = [
  ['1. Agent-opgaver', 'Hvilke opgaver kan kunder, indkøbere eller AI-assistenter give videre til en agent?'],
  ['2. Kildegrundlag', 'Kan agenten finde entydige sider, priser, ydelser, beviser, cases og næste skridt?'],
  ['3. Shortlist', 'Bliver virksomheden valgt, citeret eller sammenlignet korrekt med konkurrenterne?'],
  ['4. Handling', 'Hvilke sider, data, tekster og trust-signaler bør rettes først for at lukke hullet?'],
];

const startPath = [
  {
    eyebrow: 'Start her',
    title: 'Gratis AI-tjek',
    price: '0 kr.',
    text: 'Første vurdering af om virksomheden dukker op i relevante AI-søgninger.',
  },
  {
    eyebrow: 'Næste naturlige skridt',
    title: 'AI Audit + Client Room',
    price: '2.495 kr.',
    text: 'Fuld test af spørgsmål, platforme, konkurrenter, kilder og næste handlinger.',
  },
  {
    eyebrow: 'Hvis du vil have det rettet',
    title: 'Visibility Sprint eller fix',
    price: 'fra 6.500 kr.',
    text: 'Tekst, struktur, kilder, schema, landing pages og beviser, så AI har noget bedre at vælge.',
  },
];

const agentMoments = [
  {
    label: 'B2B research',
    title: 'Når en virksomhed beder en agent finde leverandører',
    text: 'Agenten leder efter klare ydelser, branchematch, beviser, cases, kontaktveje og konkrete næste skridt.',
  },
  {
    label: 'Forbruger-valg',
    title: 'Når en kunde spørger efter det bedste lokale valg',
    text: 'Agenten sammenligner muligheder, anmeldelser, priser, tilgængelighed og om hjemmesiden virker troværdig nok.',
  },
  {
    label: 'Booking og handling',
    title: 'Når Search går fra svar til handling',
    text: 'Google har nu annonceret agentic booking, Search agents og en intelligent Search box. Det flytter synlighed tættere på beslutningen.',
  },
];

const searchShiftFacts = [
  {
    source: 'Google I/O 2026',
    metric: '1 mia.+',
    text: 'Google skriver, at AI Mode har passeret 1 milliard månedlige brugere, og at Search agents kan arbejde i baggrunden.',
    href: 'https://blog.google/products-and-platforms/products/search/search-io-2026/',
  },
  {
    source: 'Gartner',
    metric: '25%',
    text: 'Gartner forudsagde, at traditionel søgevolumen ville falde 25% i 2026 på grund af AI-chatbots og virtuelle agenter.',
    href: 'https://www.gartner.com/en/newsroom/press-releases/2024-02-19-gartner-predicts-search-engine-volume-will-drop-25-percent-by-2026-due-to-ai-chatbots-and-other-virtual-agents',
  },
  {
    source: 'BrightEdge',
    metric: '88%',
    text: 'BrightEdge rapporterer, at AI-agent requests i april 2026 nåede 88% af menneskelig organisk søgeaktivitet.',
    href: 'https://www.brightedge.com/news/press-releases/brightedge-data-ai-search-reaching-tipping-point-ai-agents-2026',
  },
  {
    source: 'Deloitte',
    metric: '25% / 55%',
    text: 'Deloitte fremhæver, at 25% af global e-commerce kan blive AI-agent enabled i 2030, og at 55% af digitale forbrugere vil starte produktresearch i LLM-platforme.',
    href: 'https://www.deloitte.com/us/en/industries/consumer/articles/agentic-commerce-ai-shopping-agents-guide.html',
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://sitedokai.com/#organization',
      name: 'SiteDokAI',
