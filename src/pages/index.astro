    <section id="kontakt" class="mx-auto grid max-w-7xl gap-10 px-5 py-16 sm:px-6 md:py-24 lg:grid-cols-[0.72fr_1.28fr]">
      <div>
        <p class="font-mono text-xs uppercase tracking-[0.22em] text-accent">Kontakt</p>
      </div>
      <div>
        <h2 class="max-w-4xl font-display text-3xl font-semibold leading-tight text-brand md:text-6xl">
          Send det workflow, der irriterer jer mest
        </h2>
        <p class="mt-6 max-w-3xl text-lg leading-relaxed text-muted">
          Beskriv workflowet, hvor ofte det sker, hvilke værktøjer I bruger, hvem der er involveret, hvad der går galt, og hvad et godt output ville være. Vi svarer med en nøgtern vurdering, også hvis AI ikke er første skridt.
        </p>
        <div class="mt-12">
          <ScreeningForm
            sourcePage="/"
            title="Workflow til vurdering"
