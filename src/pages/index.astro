---
import Layout from '../layouts/Layout.astro';
import HighlightCard from '../components/HighlightCard.astro';
import HorizontalTimeline from '../components/HorizontalTimeline.astro';
import {
  thisWeek,
  months,
  totalHighlights,
  firstMonth,
  latestMonth,
  CATEGORIES,
} from '../data/timeline';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'AI-tidslinjen',
  url: 'https://sitedokai.com/',
  description:
    'En tidslinje over den vigtigste udvikling i kunstig intelligens, måned for måned.',
  inLanguage: 'da-DK',
};
---

<Layout title="AI-tidslinjen — udviklingen i kunstig intelligens, måned for måned">
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline />

  <!-- HERO (kompakt) -->
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 bg-aurora"></div>
    <div class="container-page relative pb-8 pt-12 sm:pt-16">
      <div class="mx-auto max-w-3xl text-center animate-fade-up">
        <span class="mono-label inline-flex items-center gap-2 rounded-full border border-line bg-white/[0.03] px-3 py-1.5">
          <span class="h-1.5 w-1.5 rounded-full bg-cyan animate-pulse-dot"></span>
          Opdateret · {latestMonth.monthLabel}
        </span>
        <h1 class="mt-5 font-display text-4xl font-extrabold leading-[1.05] tracking-tight sm:text-5xl">
          Den mest revolutionerende tidsalder —
          <span class="text-gradient">måned for måned</span>
        </h1>
        <p class="mx-auto mt-4 max-w-2xl text-base leading-relaxed text-text-soft sm:text-lg">
          Følg hele rejsen gennem AI-kapløbet — fra {firstMonth.monthLabel.toLowerCase()} til i dag.
          Klik ind i en måned og genoplev præcis, hvad der flyttede verden.
        </p>
        <p class="mt-5 flex flex-wrap items-center justify-center gap-x-2 gap-y-1 font-mono text-xs text-text-dim">
          <span class="text-text-soft">{months.length}</span> måneder
          <span class="text-line-strong">·</span>
          <span class="text-text-soft">{totalHighlights}</span> milepæle
          <span class="text-line-strong">·</span>
          <span class="text-text-soft">{Object.keys(CATEGORIES).length}</span> spor
        </p>
      </div>
    </div>
  </section>

  <!-- DET VANDRETTE TIDSLINJEBÅND -->
  <HorizontalTimeline />

  <!-- DENNE UGE -->
  <section id="denne-uge" class="container-page scroll-mt-20 py-10">
    <div class="glass relative overflow-hidden p-6 sm:p-8" style="box-shadow:0 0 0 1px rgba(34,211,238,0.18)">
      <div class="pointer-events-none absolute -right-20 -top-20 h-56 w-56 rounded-full bg-cyan/10 blur-3xl"></div>
      <div class="relative flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-2.5">
          <span class="h-2 w-2 rounded-full bg-cyan animate-pulse-dot"></span>
          <h2 class="font-display text-xl font-bold sm:text-2xl">Denne uge i AI</h2>
        </div>
        <span class="mono-label">{thisWeek.weekLabel} · {thisWeek.dateRange}</span>
      </div>
      <p class="relative mt-3 max-w-2xl text-sm leading-relaxed text-text-soft">{thisWeek.intro}</p>
      <div class="relative mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {thisWeek.items.map((item) => <HighlightCard highlight={item} />)}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="container-page py-8">
    <div class="glass relative overflow-hidden p-8 text-center sm:p-10">
      <div class="pointer-events-none absolute inset-0 bg-aurora opacity-60"></div>
      <h2 class="relative font-display text-2xl font-extrabold sm:text-3xl">Sæt et bogmærke</h2>
      <p class="relative mx-auto mt-3 max-w-xl text-text-soft">
        Tidslinjen opdateres løbende. Kig forbi igen — om en uge eller om et år —
        og se præcis, hvad der skete i kapløbet, mens du var væk.
      </p>
      <div class="relative mt-7 flex flex-wrap justify-center gap-3">
        <a href="#tidslinje" class="btn-primary">Udforsk tidslinjen</a>
        <a href="/om" class="btn-ghost">Læs om projektet</a>
      </div>
    </div>
  </section>
</Layout>
