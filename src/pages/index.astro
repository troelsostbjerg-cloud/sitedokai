            </article>
          </div>

          <div class="mt-14">
            <RoiCalculator />
          </div>

          <div class="mt-14">
            <p class="font-mono text-xs uppercase tracking-[0.22em] text-accent">Typiske teams vi hjælper</p>
            <div class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
              {targetTeams.map(([title, text]) => (
                <article class="conversion-card rounded-[1.2rem] border border-brand/10 bg-panel-soft p-5">
