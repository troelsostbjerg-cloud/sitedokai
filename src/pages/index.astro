---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AIFitChecker from '../components/lab/AIFitChecker.astro';
import LabHeroVisual from '../components/lab/LabHeroVisual.astro';
import WorkflowTypeSelector from '../components/lab/WorkflowTypeSelector.astro';
import {
  absoluteUrl,
  caseStudies,
  labMeta,
  messySubmissions,
  outputSteps,
  siteBaseUrl,
} from '../data/labContent';
import '../styles/global.css';

const featuredCases = caseStudies.slice(0, 4);

const howItWorks = [
  'Submit a workflow',
  'Troels reviews it',
  'You receive a mini-review',
  'If allowed, it becomes an anonymized case in the public library',
  'Hiring teams can see how Troels thinks',
];

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteBaseUrl}/#website`,
      url: siteBaseUrl,
      name: labMeta.name,
      description: labMeta.description,
      inLanguage: 'en',
    },
    {
      '@type': 'Person',
      '@id': `${siteBaseUrl}/#troels`,
      name: 'Troels Østbjerg',
      url: absoluteUrl('/about'),
      knowsAbout: [
        'AI implementation',
        'AI adoption',
        'Operations transformation',
        'Workflow automation',
        'Process improvement',
        'Digital transformation',
      ],
    },
    {
      '@type': 'WebPage',
      '@id': `${siteBaseUrl}/#webpage`,
      url: siteBaseUrl,
      name: labMeta.title,
      description: labMeta.description,
      inLanguage: 'en',
      isPartOf: {
        '@id': `${siteBaseUrl}/#website`,
      },
      about: {
        '@id': `${siteBaseUrl}/#troels`,
      },
      primaryImageOfPage: {
        '@type': 'ImageObject',
        url: absoluteUrl('/og-image.svg'),
        width: 1200,
        height: 630,
      },
    },
  ],
};
---

<Layout
  title={labMeta.title}
  description={labMeta.description}
  canonical="/"
  structuredData={structuredData}
>
  <Nav />
  <main id="main" class="bg-canvas text-brand">
    <section class="relative overflow-hidden border-b border-brand/10">
      <div class="absolute inset-0 bg-[linear-gradient(rgba(30,38,31,0.045)_1px,transparent_1px),linear-gradient(90deg,rgba(30,38,31,0.045)_1px,transparent_1px)] bg-[size:56px_56px]" aria-hidden="true"></div>
      <div class="relative mx-auto grid max-w-7xl gap-10 px-5 pb-12 pt-14 sm:px-6 md:pb-20 md:pt-20 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
        <div>
          <p class="max-w-2xl font-mono text-xs uppercase tracking-[0.22em] text-accent">
            Free workflow reviews for teams drowning in manual work.
          </p>
          <h1 class="mt-6 max-w-4xl font-display text-4xl font-semibold leading-[1.02] text-brand sm:text-5xl md:text-7xl">
            Send me your messy workflow. I will tell you where AI can actually help.
          </h1>
          <p class="mt-7 max-w-2xl text-lg leading-relaxed text-brand/72 md:text-xl">
            SiteDokAILab is a free process lab for companies stuck in recurring manual work, messy handovers, repeated status updates, spreadsheet chaos, email ping-pong or AI ideas that have not become useful yet.
          </p>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row">
            <a href="/submit" class="inline-flex min-h-12 items-center justify-center rounded-xl border border-accent/50 bg-accent px-6 py-3 text-sm font-semibold text-canvas transition-colors hover:bg-accent-bright focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent active:translate-y-px">
              Submit a workflow
            </a>
            <a href="/cases" class="inline-flex min-h-12 items-center justify-center rounded-xl border border-brand/20 px-6 py-3 text-sm font-semibold text-brand transition-colors hover:border-brand/30 hover:bg-panel-soft focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent active:translate-y-px">
              See example reviews
            </a>
          </div>
          <p class="mt-6 max-w-xl text-sm leading-relaxed text-brand/58">
            Free while I am looking for my next role. No sales pitch. No AI hype. Just practical workflow thinking.
          </p>
        </div>
        <LabHeroVisual />
      </div>
    </section>

    <section class="px-5 py-16 sm:px-6 md:py-24">
      <div class="mx-auto max-w-7xl">
        <WorkflowTypeSelector />
      </div>
    </section>

    <section class="border-y border-brand/10 bg-canvas-soft px-5 py-16 sm:px-6 md:py-24">
      <div class="mx-auto max-w-7xl">
        <div class="grid gap-10 lg:grid-cols-[0.72fr_1.28fr]">
          <aside>
            <p class="font-mono text-xs uppercase tracking-[0.22em] text-accent">What you can submit</p>
            <h2 class="mt-5 max-w-xl font-display text-4xl font-semibold leading-[1.02] text-brand md:text-6xl">
              What kind of mess can you send?
            </h2>
            <p class="mt-6 max-w-xl text-base leading-relaxed text-brand/70 md:text-lg">
              The best AI use case usually starts as a boring repeated task. Send the work that keeps coming back and still somehow belongs to three people and one spreadsheet.
            </p>
          </aside>

          <div class="grid gap-4 md:grid-cols-2">
            {messySubmissions.map((item) => (
              <article class="conversion-card rounded-[1.25rem] border border-brand/10 bg-panel p-5">
                <h3 class="text-xl font-semibold leading-tight text-brand">{item.title}</h3>
                <p class="mt-3 text-sm leading-relaxed text-brand/64">{item.pain}</p>
                <p class="mt-4 text-sm leading-relaxed text-brand/72"><span class="font-semibold text-brand">Why it matters:</span> {item.why}</p>
                <p class="mt-3 text-sm leading-relaxed text-brand/72"><span class="font-semibold text-brand">I would look for:</span> {item.lookFor}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="px-5 py-16 sm:px-6 md:py-24">
      <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-start">
        <aside>
          <p class="font-mono text-xs uppercase tracking-[0.22em] text-accent">What you get back</p>
          <h2 class="mt-5 max-w-xl font-display text-4xl font-semibold leading-[1.02] text-brand md:text-6xl">
            A practical mini-review, not AI theatre.
          </h2>
          <p class="mt-6 max-w-xl text-base leading-relaxed text-brand/70 md:text-lg">
            This is a mini-review, not a full implementation project. The goal is clarity, not a 58-slide deck with a lighthouse on page one.
          </p>
        </aside>

        <div class="rounded-[1.6rem] border border-brand/10 bg-panel p-5 shadow-soft md:p-7">
          <div class="grid gap-4">
            {outputSteps.map((step, index) => (
              <article class="grid gap-4 rounded-[1.15rem] border border-brand/10 bg-canvas p-4 sm:grid-cols-[3rem_1fr]">
                <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand font-mono text-sm font-semibold text-canvas">
                  {index + 1}
                </div>
                <div>
                  <h3 class="text-xl font-semibold text-brand">{step.title}</h3>
                  <p class="mt-1 text-sm leading-relaxed text-brand/66">{step.text}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="border-y border-brand/10 bg-brand-dark px-5 py-16 text-canvas sm:px-6 md:py-24">
      <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:items-start">
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.22em] text-accent-light">Why this exists</p>
          <h2 class="mt-5 max-w-2xl font-display text-4xl font-semibold leading-[1.02] md:text-6xl">
            I am using the job search phase to stay sharp.
          </h2>
        </div>
        <div class="grid gap-5 text-lg leading-relaxed text-canvas/72">
          <p>
            I am looking for my next role in AI implementation, operations transformation or workflow automation. While I am doing that, I am using SiteDokAILab as a live process lab: companies send in real workflow problems, and I turn them into practical mini-reviews.
          </p>
          <p>
            It keeps me sharp. It helps companies see what AI could actually do. And it gives hiring teams a much better view of how I think than a normal CV ever could.
          </p>
          <p class="rounded-[1.2rem] border border-white/10 bg-white/[0.07] p-5 text-base text-canvas/78">
            No sales pitch. No magic AI dust. Just a practical look at where the process breaks, where AI might help, and what the first sensible step could be.
          </p>
        </div>
      </div>
    </section>

    <section class="px-5 py-16 sm:px-6 md:py-24">
      <div class="mx-auto max-w-7xl">
        <div class="mb-10 max-w-3xl">
          <p class="font-mono text-xs uppercase tracking-[0.22em] text-accent">How it works</p>
          <h2 class="mt-5 font-display text-4xl font-semibold leading-[1.02] text-brand md:text-6xl">
            Simple enough to actually use.
          </h2>
          <p class="mt-6 max-w-2xl text-base leading-relaxed text-brand/70 md:text-lg">
            If your process contains sensitive data, remove it before submitting. I do not need customer names, employee names, prices or confidential documents to spot workflow friction.
          </p>
        </div>

        <div class="grid gap-4 md:grid-cols-5">
          {howItWorks.map((item, index) => (
            <article class="rounded-[1.25rem] border border-brand/10 bg-panel p-5">
              <p class="font-mono text-[0.68rem] uppercase tracking-[0.2em] text-accent">{String(index + 1).padStart(2, '0')}</p>
              <h3 class="mt-4 text-lg font-semibold leading-tight text-brand">{item}</h3>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="border-y border-brand/10 bg-canvas-soft px-5 py-16 sm:px-6 md:py-24">
      <div class="mx-auto max-w-7xl">
        <div class="mb-10 flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
          <div>
            <p class="font-mono text-xs uppercase tracking-[0.22em] text-accent">Case library</p>
            <h2 class="mt-5 max-w-3xl font-display text-4xl font-semibold leading-[1.02] text-brand md:text-6xl">
              Example reviews, clearly labelled.
            </h2>
          </div>
          <a href="/cases" class="inline-flex min-h-12 w-fit items-center justify-center rounded-xl border border-brand/20 px-6 py-3 text-sm font-semibold text-brand transition-colors hover:border-brand/30 hover:bg-panel focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent active:translate-y-px">
            Open case library
          </a>
        </div>

        <div class="grid gap-5 lg:grid-cols-2">
          {featuredCases.map((item) => (
            <article class="conversion-card rounded-[1.35rem] border border-brand/10 bg-panel p-5 md:p-6">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <p class="font-mono text-[0.68rem] uppercase tracking-[0.2em] text-accent">{item.category}</p>
                  <h3 class="mt-3 text-2xl font-semibold leading-tight text-brand">{item.title}</h3>
                </div>
                <span class="rounded-lg border border-brand/10 bg-canvas px-3 py-2 font-mono text-[0.66rem] uppercase tracking-[0.18em] text-brand/[0.52]">
                  Example
                </span>
              </div>
              <p class="mt-5 text-sm leading-relaxed text-brand/66"><span class="font-semibold text-brand">Problem:</span> {item.problem}</p>
              <p class="mt-3 text-sm leading-relaxed text-brand/66"><span class="font-semibold text-brand">AI opportunity:</span> {item.aiOpportunity}</p>
              <p class="mt-3 text-sm leading-relaxed text-brand/72"><span class="font-semibold text-brand">First fix:</span> {item.firstStep}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="px-5 py-16 sm:px-6 md:py-24">
      <div class="mx-auto max-w-7xl">
        <AIFitChecker />
      </div>
    </section>

    <section class="border-t border-brand/10 bg-panel px-5 py-16 sm:px-6 md:py-24">
      <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-center">
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.22em] text-accent">About / hire</p>
          <h2 class="mt-5 max-w-3xl font-display text-4xl font-semibold leading-[1.02] text-brand md:text-6xl">
            I turn operational mess into usable systems.
          </h2>
        </div>
        <div>
          <p class="text-lg leading-relaxed text-brand/72">
            I am Troels Østbjerg, an operations leader turned AI implementation builder. I have spent 10+ years inside real operational complexity, from FMCG scale-up work to global CMO coordination, and now I use AI to build faster, clearer workflows.
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href="/about" class="inline-flex min-h-12 items-center justify-center rounded-xl border border-brand/20 px-6 py-3 text-sm font-semibold text-brand transition-colors hover:border-brand/30 hover:bg-canvas focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent active:translate-y-px">
              Read more about Troels
            </a>
            <a href="/hire" class="inline-flex min-h-12 items-center justify-center rounded-xl border border-accent/50 bg-accent px-6 py-3 text-sm font-semibold text-canvas transition-colors hover:bg-accent-bright focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent active:translate-y-px">
              Talk about a role
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
