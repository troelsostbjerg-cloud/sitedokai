          },
        },
        {
          '@type': 'Question',
          name: 'Er gratis AI-tjek bindende?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Nej. AI-tjekket er gratis og uforpligtende. Hvis der ikke er et oplagt næste skridt, siger vi det direkte.',
          },
        },
        {
          '@type': 'Question',
          name: 'Hvad koster en fuld AI Audit?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'En fuld AI Audit koster 2.495 kr. og leveres som Client Room med søgninger, platforme, konkurrenter, kilder, score og prioriterede handlinger.',
