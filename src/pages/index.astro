        'Agentic search',
        'AI-agenter',
        'Answer Engine Optimization',
        'Generative Engine Optimization',
        'Client Room',
        'ChatGPT',
        'Gemini',
        'Google AI',
        'Claude',
        'små virksomheders digitale synlighed',
      ],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'SiteDokAI ydelser',
        itemListElement: [
          {
            '@type': 'Offer',
            price: '0',
            priceCurrency: 'DKK',
            itemOffered: {
              '@type': 'Service',
              name: 'Gratis AI-tjek',
              description: 'Første vurdering af om virksomheden bliver fundet i relevante AI-søgninger.',
            },
          },
          {
            '@type': 'Offer',
            price: '2495',
            priceCurrency: 'DKK',
            itemOffered: {
              '@type': 'Service',
              name: 'AI Audit + Client Room',
              description: 'Fuld gennemgang af AI-synlighed, søgninger, platforme, konkurrenter, kilder og prioriterede handlinger.',
            },
          },
          {
            '@type': 'Offer',
            priceSpecification: {
              '@type': 'PriceSpecification',
              minPrice: '6500',
              maxPrice: '12500',
              priceCurrency: 'DKK',
            },
            itemOffered: {
              '@type': 'Service',
              name: 'Hjemmeside-fix',
              description: 'Ret tekst, struktur, kilder og kontaktveje, så virksomheden står klarere for kunder og AI.',
            },
          },
          {
            '@type': 'Offer',
            priceSpecification: {
              '@type': 'PriceSpecification',
              minPrice: '9500',
              priceCurrency: 'DKK',
            },
            itemOffered: {
              '@type': 'Service',
