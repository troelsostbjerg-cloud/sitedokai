          },
        },
        {
          '@type': 'Question',
          name: 'Hvad koster en fuld AI Audit?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'En fuld AI Audit koster 2.495 kr. og leveres som Client Room med søgninger, platforme, konkurrenter, kilder, score og prioriterede handlinger.',
