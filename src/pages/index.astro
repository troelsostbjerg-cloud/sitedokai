      ],
      contactPoint: {
        '@type': 'ContactPoint',
        email: 'info@sitedokai.com',
        contactType: 'customer service',
        availableLanguage: ['da-DK'],
        areaServed: 'DK',
      },
    },
    {
      '@type': 'Person',
      '@id': 'https://sitedokai.com/#troels-ostbjerg',
      name: 'Troels Østbjerg',
      jobTitle: 'Founder og AI operations partner',
      worksFor: {
        '@id': 'https://sitedokai.com/#organization',
      },
      knowsAbout: ['operations', 'supply chain', 'procesoptimering', 'AI workflows', 'praktisk AI-implementering'],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://sitedokai.com/#website',
      name: 'SiteDokAI',
