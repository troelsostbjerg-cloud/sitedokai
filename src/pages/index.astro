                <div class="mt-7">
                  <p class="font-mono text-xs uppercase tracking-[0.18em] text-muted">Output</p>
                </div>
                <ul class="mt-3 grid gap-2 text-sm text-brand/75">
                  {service.includes.map((item) => (
                    <li class="flex gap-2">
                      <span class="mt-2 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-accent"></span>
