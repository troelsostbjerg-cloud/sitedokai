      serviceType: 'Agentic search optimering, AI-synlighedstjek, AI Audit, Client Room, Hjemmeside-fix og Visuelt løft for små virksomheder',
      provider: {
        '@id': 'https://sitedokai.com/#organization',
      },
      areaServed: {
        '@type': 'Country',
        name: 'Danmark',
      },
