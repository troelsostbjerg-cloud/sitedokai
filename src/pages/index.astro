---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Container from '../components/site/Container.astro';
import FeatureCard from '../components/site/FeatureCard.astro';
import HeroSection from '../components/site/HeroSection.astro';
import MiniCheckPreview from '../components/site/MiniCheckPreview.astro';
import MiniCheckBenefitStrip from '../components/site/MiniCheckBenefitStrip.astro';
import PaidAuditCard from '../components/site/PaidAuditCard.astro';
import SecondaryOfferCard from '../components/site/SecondaryOfferCard.astro';
import SectionHeader from '../components/site/SectionHeader.astro';
import TrustProofStrip from '../components/site/TrustProofStrip.astro';
import '../styles/global.css';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://sitedokai.com/#organization',
      name: 'SiteDokAI',
      url: 'https://sitedokai.com',
      logo: 'https://sitedokai.com/favicon.svg',
      email: 'info@sitedokai.com',
      contactPoint: {
        '@type': 'ContactPoint',
        email: 'info@sitedokai.com',
        contactType: 'customer service',
        availableLanguage: ['da-DK'],
        areaServed: 'DK',
      },
    },
    {
      '@type': 'WebSite',
      '@id': 'https://sitedokai.com/#website',
      url: 'https://sitedokai.com',
      name: 'SiteDokAI',
      inLanguage: 'da-DK',
    },
    {
      '@type': 'ProfessionalService',
      '@id': 'https://sitedokai.com/#service',
      name: 'SiteDokAI',
      serviceType: 'Gratis mini-tjek, Hjemmeside-tjek, Hjemmeside-fix og Visuelt løft for små virksomheder',
      provider: {
        '@id': 'https://sitedokai.com/#organization',
      },
      areaServed: {
        '@type': 'Country',
        name: 'Danmark',
      },
      email: 'info@sitedokai.com',
      knowsAbout: [
        'klarhed på hjemmesider',
        'tillid på hjemmesider',
        'kontaktknapper',
        'servicestruktur',
        'førstehåndsindtryk',
        'små virksomheders hjemmesider',
      ],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'SiteDokAI ydelser',
        itemListElement: [
          {
            '@type': 'Offer',
            price: '0',
            priceCurrency: 'DKK',
            itemOffered: {
              '@type': 'Service',
              name: 'Gratis mini-tjek',
              description: 'Tre konkrete observationer og en anbefaling til næste skridt.',
            },
          },
          {
            '@type': 'Offer',
            price: '2495',
            priceCurrency: 'DKK',
            itemOffered: {
              '@type': 'Service',
              name: 'Hjemmeside-tjek',
              description: 'Fuld gennemgang af klarhed, tillid, handling, tekst, struktur, kontaktknapper og kundens førstehåndsindtryk.',
            },
          },
          {
            '@type': 'Offer',
            priceSpecification: {
              '@type': 'PriceSpecification',
              minPrice: '6500',
              maxPrice: '12500',
              priceCurrency: 'DKK',
            },
            itemOffered: {
              '@type': 'Service',
              name: 'Hjemmeside-fix',
              description: 'Ret tekst, struktur og kontaktknapper.',
            },
          },
          {
            '@type': 'Offer',
            priceSpecification: {
              '@type': 'PriceSpecification',
              minPrice: '9500',
              priceCurrency: 'DKK',
            },
            itemOffered: {
              '@type': 'Service',
              name: 'Visuelt løft',
              description: 'Forbedr design, billeder og førstehåndsindtryk.',
            },
          },
        ],
      },
    },
    {
      '@type': 'FAQPage',
      '@id': 'https://sitedokai.com/#faq',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'Hvad får jeg i et gratis mini-tjek?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Du får 3 konkrete observationer om klarhed, tillid og næste skridt på din hjemmeside.',
          },
        },
        {
          '@type': 'Question',
          name: 'Er gratis mini-tjek bindende?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Nej. Mini-tjekket er gratis og uforpligtende. Hvis der ikke er et oplagt næste skridt, siger vi det direkte.',
          },
        },
        {
          '@type': 'Question',
          name: 'Hvad koster et fuldt Hjemmeside-tjek?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Et fuldt Hjemmeside-tjek koster 2.495 kr. og gennemgår klarhed, tillid, handling, tekst, struktur, kontaktknapper og førstehåndsindtryk.',
          },
        },
      ],
    },
  ],
};
---

<Layout
  title="SiteDokAI | Få gratis mini-tjek af din hjemmeside"
  description="SiteDokAI hjælper små virksomheder med at finde og rette det, der får hjemmesiden til at miste kunder. Start med et gratis mini-tjek, og gå videre til Hjemmeside-tjek hvis problemerne er tydelige."
  structuredData={structuredData}
>
  <Nav />
  <main id="main" class="bg-canvas text-brand">
    <HeroSection />
    <TrustProofStrip class="pb-5 pt-1" />

    <Container id="det-kigger-vi-efter" class="pb-4 pt-1">
      <SectionHeader
        label="Kundens oplevelse"
        title="Vi tjekker ikke kun hjemmesiden. Vi tjekker kundens oplevelse."
        text="Når en kunde lander på din hjemmeside, vurderer de hurtigt om de forstår dig, stoler på dig og vil kontakte dig. SiteDokAI er funderet i principper fra hjernevidenskab, beslutningspsykologi og adfærdsdesign — omsat til et konkret og praktisk Hjemmeside-tjek for små danske virksomheder."
      />
      <div class="mt-6 grid gap-5 md:grid-cols-[1.18fr_0.91fr_0.91fr]">
        <FeatureCard icon="clarity" title="Klarhed" text="Forstår kunden hurtigt, hvad du tilbyder?" />
        <FeatureCard icon="trust" title="Tillid" text="Virker siden professionel og tryg nok til kontakt?" />
        <FeatureCard icon="visibility" title="Handling" text="Er det nemt og naturligt at kontakte dig?" />
      </div>
    </Container>

    <Container id="metode" class="py-7">
      <SectionHeader
        label="Metode"
        title="Vi vurderer din hjemmeside på 4 afgørende punkter"
        text="SEO får folk ind på siden. SiteDokAI viser, hvorfor de ikke kontakter dig."
      />
      <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
        {[
          ['1. Opmærksomhed', 'Ser kunden hurtigt det vigtigste?'],
          ['2. Forståelse', 'Forstår kunden hvad du tilbyder, hvem du hjælper, og hvorfor de skal vælge dig?'],
          ['3. Tillid', 'Føles virksomheden professionel, tryg og troværdig?'],
          ['4. Handling', 'Er det nemt og naturligt at kontakte dig?'],
        ].map(([title, text]) => (
          <article class="rounded-[1.15rem] border border-border-soft bg-white/68 p-5 shadow-soft">
            <h3 class="font-display text-2xl font-medium leading-tight text-brand">{title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-muted">{text}</p>
          </article>
        ))}
      </div>
    </Container>

    <Container id="gratis-mini" class="pb-7 pt-3">
      <SectionHeader label="Det får du gratis" uppercase={false} />
      <div class="mt-6">
        <MiniCheckBenefitStrip />
      </div>
    </Container>

    <MiniCheckPreview class="pb-7 pt-3" />

    <Container id="fuld-gennemgang" class="py-7">
      <PaidAuditCard />
    </Container>

    <Container id="rette-det" class="pb-8 pt-7 md:pb-10">
      <SectionHeader label="Hvis du vil have os til at rette det" />
      <div class="mt-7 grid gap-5 lg:grid-cols-2">
        <SecondaryOfferCard
          id="hjemmeside-fix"
          icon="fix"
          title="Hjemmeside-fix"
          price="6.500-12.500 kr."
          text="Retter tekst, struktur og kontaktknapper"
          href="/hjemmeside-fix"
        />
        <SecondaryOfferCard
          id="visuelt-loeft"
          icon="visual"
          title="Visuelt løft"
          price="Fra 9.500 kr."
          text="Forbedrer design, billeder og førstehåndsindtryk"
          href="/visuelt-loeft"
        />
      </div>
    </Container>

    <Container id="klar-til-start" class="pb-16 pt-6 md:pb-20">
      <div class="rounded-[1.6rem] border border-accent/28 bg-brand px-6 py-10 text-white shadow-[0_24px_70px_rgba(32,38,34,0.12)] md:px-10 md:py-12">
        <div class="grid gap-7 lg:grid-cols-[1fr_auto] lg:items-center">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.28em] text-white/62">Klar til første skridt?</p>
            <h2 class="mt-5 max-w-3xl font-display text-4xl font-medium leading-[1.02] tracking-tight md:text-5xl">
              Start med et gratis mini-tjek af din hjemmeside.
            </h2>
            <p class="mt-5 max-w-2xl text-base leading-relaxed text-white/68 md:text-lg">
              Du får 3 konkrete observationer og en klar vurdering af, hvad der bør rettes først.
            </p>
          </div>
          <a href="/gratis-mini-tjek" class="inline-flex items-center justify-center rounded-[0.9rem] border border-white bg-white px-6 py-3.5 text-sm font-semibold text-brand transition duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] hover:border-accent-light hover:bg-accent-light focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white active:translate-y-px">
            Få gratis mini-tjek
          </a>
        </div>
      </div>
    </Container>
  </main>
  <Footer />
</Layout>
