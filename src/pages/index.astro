          </h2>
          <div class="mt-10 grid gap-4">
            {faqItems.map(([question, answer]) => (
              <article class="rounded-[1.2rem] border border-brand/10 bg-panel p-5">
                <h3 class="text-lg font-semibold text-brand">{question}</h3>
                <p class="mt-3 max-w-3xl text-sm leading-relaxed text-muted">{answer}</p>
              </article>
