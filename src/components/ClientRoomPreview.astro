---
const agentTasks = [
  {
    category: 'Discovery',
    question: 'Kan agenten finde virksomheden som relevant leverandør?',
    status: 'Fundet',
    tone: 'good',
    proof: 'Forside, serviceside og Google-resultater giver nok til at forstå kategorien.',
    missing: 'Mangler tydelig side om områder og typiske kundesituationer.',
    action: 'Gør ydelse, geografi og kundeproblem tydeligt på forsiden.',
  },
  {
    category: 'Shortlist',
    question: 'Kommer virksomheden med i de første valg?',
    status: 'Delvist',
    tone: 'watch',
    proof: 'Agenten nævner virksomheden på brand-spørgsmål, men ikke stabilt på kategorispørgsmål.',
    missing: 'Mangler sammenlignelige beviser: cases, anmeldelser og konkrete resultater.',
    action: 'Tilføj shortlist-beviser tæt på ydelser og CTAer.',
  },
  {
    category: 'Comparison',
    question: 'Hvem vinder, når agenten sammenligner alternativer?',
    status: 'Konkurrent vandt',
    tone: 'lost',
    proof: 'Konkurrenten har flere klare servicesider, anmeldelser og eksterne omtaler.',
    missing: 'Mangler direkte sammenligningsgrundlag og svar på valgkriterier.',
    action: 'Opret en kort valgside med prisramme, proces, beviser og FAQ.',
  },
  {
    category: 'Trust check',
    question: 'Kan agenten dokumentere, at virksomheden er tryg at vælge?',
    status: 'Mangler bevis',
    tone: 'lost',
    proof: 'CVR og kontaktoplysninger findes, men sociale beviser er spredte.',
    missing: 'Mangler synlige anmeldelser, cases og opdaterede profiler.',
    action: 'Saml trust-signaler på website og strukturer dem i schema.',
  },
  {
    category: 'Fit check',
    question: 'Forstår agenten hvem virksomheden passer bedst til?',
    status: 'Uklart fit',
    tone: 'watch',
    proof: 'Ydelsen kan forstås, men målgruppe og situation er for bredt beskrevet.',
    missing: 'Mangler eksempler på kunder, opgavetyper og fravalg.',
    action: 'Skriv tydelige fit-kriterier og eksempler på rigtige opgaver.',
  },
  {
    category: 'Action',
    question: 'Kan agenten pege kunden mod et trygt næste skridt?',
    status: 'Kan rettes',
    tone: 'good',
    proof: 'Kontaktmuligheder findes, men de er ikke koblet direkte til kundens valgproces.',
    missing: 'Mangler handlings-CTA for de situationer agenten opdager.',
    action: 'Kobl hver kritisk side til en tydelig, lav-friktion CTA.',
  },
];

const statusClass = {
  good: 'border-accent/24 bg-accent-soft text-accent-dark',
  watch: 'border-[#e0c489]/34 bg-[#fbf2df] text-[#7b6331]',
  lost: 'border-[#e7c9b6] bg-[#fff4ee] text-[#965c36]',
};

const summary = [
  { label: 'Fundet', value: '4/6' },
  { label: 'Shortlist', value: '2/6' },
  { label: 'Anbefalet', value: '1/6' },
  { label: 'Konkurrent vandt', value: '2/6' },
];
---

<section class="bg-[#f6f1e8] border-y border-[#e6ddd1]">
  <div class="mx-auto max-w-[1480px] px-4 py-16 sm:px-6 md:py-20 lg:px-10">
    <div class="grid gap-9 lg:grid-cols-[0.82fr_1.18fr] lg:items-start">
      <div class="max-w-2xl">
        <p class="text-xs font-semibold uppercase tracking-[0.28em] text-accent-dark">Client Room demo</p>
        <h2 class="mt-5 font-display text-4xl font-medium leading-[1.02] tracking-tight text-brand md:text-5xl">
          Et beslutningsrum for agentens køb.
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-muted">
          Client Room viser ikke bare almindelige prompts. Det viser agent-opgaverne i en kundes research: bliver virksomheden fundet, shortlistet, anbefalet eller fravalgt, og hvilket bevis afgør det?
        </p>

        <div class="mt-7 grid grid-cols-2 gap-3 sm:grid-cols-4">
          {summary.map((item) => (
            <div class="rounded-[1rem] border border-border-soft bg-white/72 px-4 py-3 shadow-[0_12px_32px_rgba(32,38,34,0.045)]">
              <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-brand/48">{item.label}</p>
              <p class="mt-2 font-display text-2xl font-medium leading-none text-brand">{item.value}</p>
            </div>
          ))}
        </div>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="/eksempel" class="inline-flex items-center justify-center rounded-[0.9rem] bg-brand px-6 py-3.5 text-sm font-semibold text-white transition duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] hover:bg-brand-light focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand active:translate-y-px">
            Se hele demoen
          </a>
          <a href="/hjemmeside-tjek" class="inline-flex items-center justify-center rounded-[0.9rem] border border-border-soft bg-white px-6 py-3.5 text-sm font-semibold text-brand transition duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] hover:border-accent/35 hover:bg-accent-soft focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent active:translate-y-px">
            Se AI Audit
          </a>
        </div>
      </div>

      <div class="rounded-[1.55rem] border border-border-soft bg-white/76 p-4 shadow-[0_28px_70px_rgba(31,42,51,0.08)] md:p-5">
        <div class="rounded-[1.25rem] border border-[#e6ddd1] bg-[#fcfaf6] p-4 md:p-5">
          <div class="mb-4 flex flex-col gap-3 border-b border-[#ebe1d4] pb-4 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <p class="text-[0.68rem] font-semibold uppercase tracking-[0.2em] text-accent-dark">Fiktivt internt testdata</p>
              <h3 class="mt-2 font-display text-3xl font-medium leading-tight tracking-tight text-brand">Agent-opgaver for Nordlys Klinik</h3>
            </div>
            <p class="max-w-sm text-sm leading-relaxed text-muted">Bevis vises før anbefaling, så teamet kan se hvorfor agenten vælger eller fravælger.</p>
          </div>

          <div class="grid gap-3">
            {agentTasks.map((task) => (
              <article class="conversion-card rounded-[1.05rem] border border-border-soft bg-white/74 p-4">
                <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                  <div>
                    <div class="flex flex-wrap items-center gap-2">
                      <span class="rounded-[0.72rem] border border-accent/18 bg-accent-soft/66 px-2.5 py-1 text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-accent-dark">{task.category}</span>
                      <span class:list={['rounded-[0.72rem] border px-2.5 py-1 text-[0.68rem] font-semibold uppercase tracking-[0.16em]', statusClass[task.tone]]}>{task.status}</span>
                    </div>
                    <h4 class="mt-3 text-base font-semibold leading-snug text-brand">{task.question}</h4>
                  </div>
                </div>

                <div class="mt-4 grid gap-3 md:grid-cols-[1fr_1fr_1fr]">
                  <div class="rounded-[0.85rem] border border-[#e8ded0] bg-[#fbf8f3] p-3">
                    <p class="text-[0.66rem] font-semibold uppercase tracking-[0.18em] text-brand/45">Bevis agenten brugte</p>
                    <p class="mt-2 text-sm leading-relaxed text-brand/72">{task.proof}</p>
                  </div>
                  <div class="rounded-[0.85rem] border border-[#e8ded0] bg-[#fbf8f3] p-3">
                    <p class="text-[0.66rem] font-semibold uppercase tracking-[0.18em] text-brand/45">Manglende bevis</p>
                    <p class="mt-2 text-sm leading-relaxed text-brand/72">{task.missing}</p>
                  </div>
                  <div class="rounded-[0.85rem] border border-accent/18 bg-accent-soft/46 p-3">
                    <p class="text-[0.66rem] font-semibold uppercase tracking-[0.18em] text-accent-dark">Rettes først</p>
                    <p class="mt-2 text-sm font-medium leading-relaxed text-brand/78">{task.action}</p>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
