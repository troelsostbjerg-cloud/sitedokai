---
import { workflowTypeOptions } from '../../data/labContent';
---

<section
  class="rounded-[1.6rem] border border-brand/10 bg-panel p-5 shadow-soft md:p-7"
  aria-labelledby="workflow-selector-title"
  data-workflow-selector
>
  <div class="grid gap-7 lg:grid-cols-[0.85fr_1.15fr] lg:items-start">
    <div>
      <p class="font-mono text-xs uppercase tracking-[0.22em] text-accent">Workflow selector</p>
      <h2 id="workflow-selector-title" class="mt-4 font-display text-3xl font-semibold leading-tight text-brand md:text-4xl">
        Pick the mess. See what I would check first.
      </h2>
      <p class="mt-4 max-w-xl text-sm leading-relaxed text-brand/66">
        This is a quick way to translate fuzzy process pain into a useful first review angle.
      </p>

      <div class="mt-6 flex flex-wrap gap-2" role="group" aria-label="Workflow types">
        {workflowTypeOptions.map((item, index) => (
          <button
            type="button"
            class="lab-chip"
            data-workflow-option={item.id}
            aria-pressed={index === 0 ? 'true' : 'false'}
          >
            {item.label}
          </button>
        ))}
      </div>
    </div>

    <div class="relative min-h-[22rem]">
      {workflowTypeOptions.map((item, index) => (
        <article
          class="lab-selector-panel rounded-[1.35rem] border border-brand/10 bg-canvas p-5 md:p-6"
          data-workflow-panel={item.id}
          hidden={index !== 0}
        >
          <p class="font-mono text-[0.7rem] uppercase tracking-[0.2em] text-accent">{item.label}</p>
          <div class="mt-5 grid gap-4">
            <div>
              <h3 class="text-sm font-semibold text-brand">Typical pain</h3>
              <p class="mt-2 text-sm leading-relaxed text-brand/66">{item.pain}</p>
            </div>
            <div>
              <h3 class="text-sm font-semibold text-brand">What I would check</h3>
              <p class="mt-2 text-sm leading-relaxed text-brand/66">{item.check}</p>
            </div>
            <div>
              <h3 class="text-sm font-semibold text-brand">Possible AI assist</h3>
              <p class="mt-2 text-sm leading-relaxed text-brand/66">{item.aiAssist}</p>
            </div>
            <div class="rounded-xl border border-accent/20 bg-accent-soft p-4">
              <h3 class="text-sm font-semibold text-brand">First step</h3>
              <p class="mt-2 text-sm leading-relaxed text-brand/72">{item.firstStep}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  (function() {
    var roots = document.querySelectorAll('[data-workflow-selector]');
    roots.forEach(function(root) {
      var buttons = root.querySelectorAll('[data-workflow-option]');
      var panels = root.querySelectorAll('[data-workflow-panel]');

      function activate(id) {
        buttons.forEach(function(button) {
          button.setAttribute('aria-pressed', button.getAttribute('data-workflow-option') === id ? 'true' : 'false');
        });
        panels.forEach(function(panel) {
          panel.hidden = panel.getAttribute('data-workflow-panel') !== id;
        });
      }

      buttons.forEach(function(button) {
        button.addEventListener('click', function() {
          activate(button.getAttribute('data-workflow-option'));
        });
      });
    });
  })();
</script>
