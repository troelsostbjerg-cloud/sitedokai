<section class="rounded-[1.6rem] border border-brand/10 bg-brand-dark p-5 text-canvas shadow-card md:p-7" data-ai-fit-checker>
  <div class="grid gap-7 lg:grid-cols-[0.75fr_1.25fr]">
    <div>
      <p class="font-mono text-xs uppercase tracking-[0.22em] text-accent-light">Quick heuristic</p>
      <h2 class="mt-4 font-display text-3xl font-semibold leading-tight md:text-4xl">Mini AI fit checker</h2>
      <p class="mt-4 max-w-md text-sm leading-relaxed text-canvas/68">
        Not scientific. Useful as a first smell test before anyone buys another tool or calls it a strategy.
      </p>
    </div>

    <div class="grid gap-5">
      <div class="grid gap-4 md:grid-cols-2">
        <label class="grid gap-2 text-sm font-medium text-canvas">
          Frequency
          <select name="frequency" class="lab-dark-input">
            <option value="daily">Daily</option>
            <option value="weekly" selected>Weekly</option>
            <option value="monthly">Monthly</option>
          </select>
        </label>
        <label class="grid gap-2 text-sm font-medium text-canvas">
          Repetition
          <select name="repetition" class="lab-dark-input">
            <option value="low">Low</option>
            <option value="medium" selected>Medium</option>
            <option value="high">High</option>
          </select>
        </label>
        <label class="grid gap-2 text-sm font-medium text-canvas">
          Risk
          <select name="risk" class="lab-dark-input">
            <option value="low">Low</option>
            <option value="medium" selected>Medium</option>
            <option value="high">High</option>
          </select>
        </label>
        <label class="grid gap-2 text-sm font-medium text-canvas">
          Data quality
          <select name="data_quality" class="lab-dark-input">
            <option value="poor">Poor</option>
            <option value="okay" selected>Okay</option>
            <option value="good">Good</option>
          </select>
        </label>
        <label class="grid gap-2 text-sm font-medium text-canvas md:col-span-2">
          Human judgment required
          <select name="judgment" class="lab-dark-input">
            <option value="low">Low</option>
            <option value="medium" selected>Medium</option>
            <option value="high">High</option>
          </select>
        </label>
      </div>

      <div class="rounded-[1.25rem] border border-white/10 bg-white/[0.08] p-5" aria-live="polite">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
          <div>
            <p class="font-mono text-[0.7rem] uppercase tracking-[0.2em] text-canvas/50">AI fit</p>
            <p class="mt-2 text-3xl font-semibold" data-ai-fit-result>Medium</p>
          </div>
          <p class="rounded-xl border border-white/10 bg-canvas px-3 py-2 text-sm font-semibold text-brand" data-ai-fit-score>
            Assist, do not automate
          </p>
        </div>
        <p class="mt-4 text-sm leading-relaxed text-canvas/72" data-ai-fit-explanation>
          AI may help draft, classify or summarize, but the workflow needs human approval and cleaner input first.
        </p>
        <p class="mt-4 rounded-xl border border-accent-light/20 bg-accent-light/10 p-4 text-sm leading-relaxed text-canvas/78" data-ai-fit-recommendation>
          First recommendation: map the workflow and define the approval point before building.
        </p>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function() {
    var roots = document.querySelectorAll('[data-ai-fit-checker]');

    var points = {
      frequency: { daily: 2, weekly: 1, monthly: 0 },
      repetition: { low: 0, medium: 1, high: 2 },
      risk: { low: 2, medium: 1, high: -1 },
      data_quality: { poor: -1, okay: 1, good: 2 },
      judgment: { low: 2, medium: 1, high: 0 },
    };

    function value(root, name) {
      var field = root.querySelector('[name="' + name + '"]');
      return field instanceof HTMLSelectElement ? field.value : '';
    }

    function score(root) {
      return (
        points.frequency[value(root, 'frequency')] +
        points.repetition[value(root, 'repetition')] +
        points.risk[value(root, 'risk')] +
        points.data_quality[value(root, 'data_quality')] +
        points.judgment[value(root, 'judgment')]
      );
    }

    function update(root) {
      var nextScore = score(root);
      var result = root.querySelector('[data-ai-fit-result]');
      var badge = root.querySelector('[data-ai-fit-score]');
      var explanation = root.querySelector('[data-ai-fit-explanation]');
      var recommendation = root.querySelector('[data-ai-fit-recommendation]');

      var label = 'Medium';
      var badgeText = 'Assist, do not automate';
      var copy = 'AI may help draft, classify or summarize, but the workflow needs human approval and cleaner input first.';
      var next = 'First recommendation: map the workflow and define the approval point before building.';

      if (nextScore >= 7) {
        label = 'High';
        badgeText = 'Good pilot candidate';
        copy = 'This looks like repeated work with enough structure to test an AI-assisted workflow.';
        next = 'First recommendation: choose one narrow output, define success, and test with real users.';
      } else if (nextScore <= 2) {
        label = 'Low';
        badgeText = 'Simplify first';
        copy = 'AI is probably not the first move yet. The process may be too rare, risky or messy.';
        next = 'First recommendation: remove unnecessary steps and define clean inputs before adding AI.';
      }

      if (result) result.textContent = label;
      if (badge) badge.textContent = badgeText;
      if (explanation) explanation.textContent = copy;
      if (recommendation) recommendation.textContent = next;
    }

    roots.forEach(function(root) {
      root.querySelectorAll('select').forEach(function(field) {
        field.addEventListener('change', function() {
          update(root);
        });
      });
      update(root);
    });
  })();
</script>
