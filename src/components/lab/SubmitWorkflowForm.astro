---
import { contactEmail, permissionOptions } from '../../data/labContent';

interface Props {
  sourcePage?: string;
}

const { sourcePage = Astro.url.pathname } = Astro.props;
const workflowSubmitEndpoint = 'https://sitedokai-checkout.pages.dev/api/submit-workflow';

const directMailto = `mailto:${contactEmail}?subject=${encodeURIComponent('Workflow for SiteDokAILab')}&body=${encodeURIComponent(`Hi Troels,

I would like to send a workflow for a practical mini-review.

Name:
Email:
Company:
Role/title:
Workflow title:
What is the workflow/process?
What makes it annoying or slow?
How often does it happen?
Who is involved?
Which tools are involved?
What would a better version look like?
Permission to anonymize:

Optional context:

Thanks.`)}`;

const inputClass =
  'h-12 rounded-xl border border-brand/10 bg-canvas px-4 text-base text-brand outline-none transition-colors placeholder:text-muted/50 focus:border-accent/70 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent';
const textAreaClass =
  'resize-y rounded-xl border border-brand/10 bg-canvas px-4 py-3 text-base leading-relaxed text-brand outline-none transition-colors placeholder:text-muted/50 focus:border-accent/70 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent';
const labelClass = 'grid gap-2 text-sm font-medium text-brand';
---

<form
  action={workflowSubmitEndpoint}
  method="POST"
  class="grid gap-5"
  data-submit-workflow
  data-pending-label="Sending..."
>
  <input type="hidden" name="source_page" value={sourcePage} />
  <input type="text" name="website_extra" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

  <p data-local-submit-note hidden class="rounded-xl border border-accent/20 bg-accent-soft px-4 py-3 text-sm leading-relaxed text-brand/72">
    Local preview mode: submissions are stored in this browser for QA. Production storage uses the Cloudflare Pages function when the database binding is configured.
  </p>

  <div class="grid gap-4 md:grid-cols-2">
    <label class={labelClass}>
      Name
      <input required type="text" name="name" autocomplete="name" class={inputClass} />
    </label>

    <label class={labelClass}>
      Email
      <input required type="email" name="email" autocomplete="email" class={inputClass} />
    </label>
  </div>

  <div class="grid gap-4 md:grid-cols-[1fr_0.9fr]">
    <label class={labelClass}>
      Company
      <input required type="text" name="company" autocomplete="organization" class={inputClass} />
    </label>

    <label class={labelClass}>
      Role/title
      <input required type="text" name="role_title" autocomplete="organization-title" class={inputClass} />
    </label>
  </div>

  <div class="grid gap-4 md:grid-cols-[0.9fr_1.1fr]">
    <label class={labelClass}>
      Website <span class="font-normal text-brand/48">(optional)</span>
      <input type="url" name="website" inputmode="url" autocomplete="url" placeholder="https://company.com" class={inputClass} />
    </label>

    <label class={labelClass}>
      LinkedIn/company page <span class="font-normal text-brand/48">(optional)</span>
      <input type="url" name="linkedin" inputmode="url" placeholder="https://www.linkedin.com/company/..." class={inputClass} />
    </label>
  </div>

  <label class={labelClass}>
    Workflow title
    <input required type="text" name="workflow_title" placeholder="Weekly reporting chaos, supplier follow-up, shared inbox triage..." class={inputClass} />
  </label>

  <label class={labelClass}>
    What is the workflow/process?
    <textarea required name="workflow_description" rows="5" class:list={[textAreaClass, 'min-h-36']} placeholder="Describe what happens today, where the information starts, who touches it, and what output is supposed to appear."></textarea>
  </label>

  <label class={labelClass}>
    What makes it annoying or slow?
    <textarea required name="workflow_pain" rows="4" class:list={[textAreaClass, 'min-h-28']} placeholder="Waiting, chasing, duplicate work, unclear ownership, errors, awkward copy-paste, too many meetings..."></textarea>
  </label>

  <div class="grid gap-4 md:grid-cols-3">
    <label class={labelClass}>
      How often does it happen?
      <select required name="frequency" class={inputClass}>
        <option value="">Choose frequency</option>
        <option value="daily">Daily</option>
        <option value="weekly">Weekly</option>
        <option value="monthly">Monthly</option>
        <option value="quarterly">Quarterly</option>
        <option value="not sure">Not sure</option>
      </select>
    </label>

    <label class:list={[labelClass, 'md:col-span-2']}>
      Who is involved?
      <input required type="text" name="people_involved" placeholder="Operations, support, finance, sales, suppliers, leadership..." class={inputClass} />
    </label>
  </div>

  <label class={labelClass}>
    Which tools are involved?
    <input required type="text" name="tools_involved" placeholder="Email, Excel, Teams, Slack, CRM, SharePoint, ERP, Notion..." class={inputClass} />
  </label>

  <label class={labelClass}>
    What would a better version look like?
    <textarea required name="better_version" rows="4" class:list={[textAreaClass, 'min-h-28']} placeholder="For example: one clean weekly summary with owners, missing input, risks and decisions ready for review."></textarea>
  </label>

  <div class="grid gap-4 md:grid-cols-2">
    <label class={labelClass}>
      What have you already tried? <span class="font-normal text-brand/48">(optional)</span>
      <textarea name="already_tried" rows="3" class:list={[textAreaClass, 'min-h-24']}></textarea>
    </label>

    <label class={labelClass}>
      Is AI already involved? <span class="font-normal text-brand/48">(optional)</span>
      <textarea name="ai_involved" rows="3" class:list={[textAreaClass, 'min-h-24']} placeholder="No, yes, sort of, someone made a prompt once..."></textarea>
    </label>
  </div>

  <label class={labelClass}>
    Anything Troels should avoid mentioning? <span class="font-normal text-brand/48">(optional)</span>
    <textarea name="avoid_mentions" rows="3" class:list={[textAreaClass, 'min-h-24']} placeholder="Company names, customer names, financial details, internal systems, sensitive context..."></textarea>
  </label>

  <fieldset class="grid gap-3 rounded-[1.2rem] border border-brand/10 bg-canvas p-4">
    <legend class="px-1 text-sm font-semibold text-brand">Permission to anonymize case</legend>
    <p class="text-sm leading-relaxed text-brand/60">
      Public cases only happen with permission. Remove confidential data before submitting.
    </p>
    <div class="grid gap-2">
      {permissionOptions.map((option, index) => (
        <label class="flex gap-3 rounded-xl border border-brand/10 bg-panel px-4 py-3 text-sm leading-relaxed text-brand/72">
          <input required={index === 0} type="radio" name="permission_to_publish" value={option} class="mt-1 h-4 w-4 accent-[#557461]" />
          <span>{option}</span>
        </label>
      ))}
    </div>
  </fieldset>

  <div class="grid gap-4 sm:grid-cols-[auto_auto] sm:items-center">
    <button
      type="submit"
      data-submit-workflow-button
      class="inline-flex min-h-12 items-center justify-center rounded-xl border border-accent/50 bg-accent px-6 py-3 text-sm font-semibold text-canvas transition-colors hover:bg-accent-bright focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent active:translate-y-px disabled:cursor-wait disabled:opacity-70"
    >
      Submit workflow
    </button>
    <a
      href={directMailto}
      class="inline-flex min-h-12 items-center justify-center rounded-xl border border-brand/20 px-6 py-3 text-center text-sm font-semibold text-brand transition-colors hover:border-brand/30 hover:bg-panel-soft focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent active:translate-y-px"
    >
      Email instead
    </a>
  </div>

  <div data-submit-workflow-pending hidden aria-live="polite" class="rounded-xl border border-brand/10 bg-canvas px-4 py-3 text-sm leading-relaxed text-brand/72">
    Sending workflow...
  </div>

  <div data-submit-workflow-success hidden tabindex="-1" class="rounded-[1.2rem] border border-accent/25 bg-accent-soft p-5" aria-live="polite">
    <h2 class="text-2xl font-semibold text-brand">Workflow received.</h2>
    <p class="mt-3 text-sm leading-relaxed text-brand/72">
      Thanks - I will take a look and reply with a practical mini-review if the case is a good fit. Please remember: no confidential data is needed here. The best process problems are usually obvious even after removing names, numbers and internal secrets.
    </p>
  </div>

  <div data-submit-workflow-error hidden class="rounded-[1.2rem] border border-[#b95a54]/35 bg-[#b95a54]/10 p-4 text-sm leading-relaxed text-brand" aria-live="polite">
    The form could not be stored right now. Please email the workflow instead, or try again after the submission backend is configured.
  </div>
</form>

<script is:inline>
  (function() {
    var forms = document.querySelectorAll('[data-submit-workflow]');
    var localHosts = ['localhost', '127.0.0.1', '::1'];

    function isLocalPreview() {
      return localHosts.indexOf(window.location.hostname) !== -1;
    }

    function show(form, state) {
      ['pending', 'success', 'error'].forEach(function(name) {
        var element = form.querySelector('[data-submit-workflow-' + name + ']');
        if (element) element.hidden = state !== name;
      });
    }

    function setButton(form, isSubmitting) {
      var button = form.querySelector('[data-submit-workflow-button]');
      if (!(button instanceof HTMLButtonElement)) return;
      if (!button.dataset.defaultLabel) button.dataset.defaultLabel = button.textContent.trim();
      button.disabled = isSubmitting;
      button.textContent = isSubmitting
        ? (form.getAttribute('data-pending-label') || 'Sending...')
        : button.dataset.defaultLabel;
    }

    function toObject(formData) {
      var payload = {};
      formData.forEach(function(value, key) {
        payload[key] = String(value);
      });
      return payload;
    }

    function storeLocal(payload) {
      var key = 'sitedokailab.workflowSubmissions';
      var existing = [];
      try {
        existing = JSON.parse(window.localStorage.getItem(key) || '[]');
      } catch (error) {
        existing = [];
      }
      existing.unshift({
        id: 'local-' + Date.now(),
        status: 'new',
        created_at: new Date().toISOString(),
        payload: payload,
      });
      window.localStorage.setItem(key, JSON.stringify(existing.slice(0, 50)));
    }

    forms.forEach(function(form) {
      var note = form.querySelector('[data-local-submit-note]');
      if (note && isLocalPreview()) note.hidden = false;

      form.addEventListener('submit', async function(event) {
        event.preventDefault();
        if (!form.reportValidity()) return;

        show(form, 'pending');
        setButton(form, true);

        var formData = new FormData(form);
        var payload = toObject(formData);

        try {
          if (isLocalPreview()) {
            storeLocal(payload);
          } else {
            var response = await fetch(form.action, {
              method: 'POST',
              headers: { accept: 'application/json' },
              body: formData,
            });

            var result = await response.json().catch(function() {
              return {};
            });

            if (!response.ok || !result.ok) {
              throw new Error(result.error || 'submit_failed');
            }
          }

          form.reset();
          show(form, 'success');
          var success = form.querySelector('[data-submit-workflow-success]');
          if (success instanceof HTMLElement) success.focus();
        } catch (error) {
          show(form, 'error');
        } finally {
          setButton(form, false);
        }
      });
    });
  })();
</script>
