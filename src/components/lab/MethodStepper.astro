---
import { methodSteps } from '../../data/labContent';
---

<div class="relative">
  <div class="absolute left-5 top-8 hidden h-[calc(100%-4rem)] w-px bg-brand/12 md:block" aria-hidden="true"></div>
  <div class="grid gap-4">
    {methodSteps.map((step, index) => (
      <article class="relative grid gap-4 rounded-[1.35rem] border border-brand/10 bg-panel p-5 md:grid-cols-[4rem_1fr] md:p-6">
        <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand font-mono text-sm font-semibold text-canvas md:relative md:z-[1]">
          {String(index + 1).padStart(2, '0')}
        </div>
        <div>
          <h2 class="text-2xl font-semibold leading-tight text-brand">{step.title}</h2>
          <p class="mt-2 max-w-2xl text-base leading-relaxed text-brand/68">{step.text}</p>
        </div>
      </article>
    ))}
  </div>
</div>
