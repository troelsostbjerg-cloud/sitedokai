---
const navItems = [
  { label: 'Gratis mini-tjek', href: '/gratis-mini-tjek' },
  { label: 'Hjemmeside-tjek', href: '/hjemmeside-tjek' },
  { label: 'Agentic search', href: '/blog/google-agentic-search-2026' },
  { label: 'Hjemmeside-fix', href: '/hjemmeside-fix' },
  { label: 'Visuelt løft', href: '/visuelt-loeft' },
  { label: 'Kontakt', href: '/kontakt' },
];

const legalItems = [
  { label: 'Privatlivspolitik', href: '/privatlivspolitik' },
  { label: 'Tilgængelighed', href: '/tilgaengelighed' },
];
---

<footer class="bg-canvas px-4 pb-8 pt-6 text-brand sm:px-6 lg:px-10" role="contentinfo">
  <div class="mx-auto max-w-[1480px] rounded-[1.35rem] border border-border-soft bg-white/58 px-6 py-12 shadow-soft md:px-10">
    <div class="mb-10 grid grid-cols-1 gap-10 md:grid-cols-[1.3fr_0.8fr_0.9fr]">
      <div>
        <div class="mb-4 font-display text-3xl font-medium tracking-tight">SiteDokAI</div>
        <p class="max-w-md text-sm leading-relaxed text-brand/62">
          SiteDokAI hjælper små virksomheder med at se om de bliver fundet, forstået og anbefalet, når kunder og virksomheder bruger AI-agenter til research og valg.
        </p>
        <p class="mt-3 text-sm text-brand/62">
          Vi tester agentic search, konkurrenter, kilder og digitale trust-signaler, og samler det i et konkret Client Room.
        </p>
        <a href="/gratis-mini-tjek" class="mt-6 inline-flex items-center justify-center rounded-[0.9rem] border border-accent bg-accent px-5 py-3 text-sm font-semibold text-white transition duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] hover:border-accent-dark hover:bg-accent-dark focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent active:translate-y-px">
          Få gratis mini-tjek
        </a>
      </div>

      <div>
        <h3 class="mb-4 text-xs font-semibold uppercase tracking-[0.24em] text-brand/72">Navigation</h3>
        <div class="space-y-2">
          {navItems.map((item) => (
            <p><a href={item.href} class="text-sm text-brand/62 transition-colors hover:text-accent-dark">{item.label}</a></p>
          ))}
        </div>
      </div>

      <div>
        <h3 class="mb-4 text-xs font-semibold uppercase tracking-[0.24em] text-brand/72">Kontakt</h3>
        <p class="mb-2 text-sm text-brand/62">
          Email: <a href="mailto:info@sitedokai.com" class="text-accent-dark transition-colors hover:text-brand">info@sitedokai.com</a>
        </p>
        <p class="text-sm text-brand/62">Danmark</p>
        <p class="mt-2 text-sm text-brand/62">Svar inden for 1–2 hverdage</p>
      </div>
    </div>

    <div class="flex flex-col gap-4 border-t border-border-soft pt-7 text-center md:flex-row md:items-center md:justify-between md:text-left">
      <p class="text-sm text-brand/62">&copy; 2026 SiteDokAI. Alle rettigheder forbeholdt.</p>
      <div class="flex flex-wrap justify-center gap-4 md:justify-end">
        {legalItems.map((item) => (
          <a href={item.href} class="text-sm text-brand/62 transition-colors hover:text-accent-dark">
            {item.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>
