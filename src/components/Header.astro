---
import Button from './site/Button.astro';

const navItems = [
  { label: 'Gratis mini-tjek', href: '/#gratis-mini' },
  { label: 'Hjemmeside-tjek', href: '/#hjemmeside-tjek' },
  { label: 'Hjemmeside-fix', href: '/#hjemmeside-fix' },
  { label: 'Visuelt løft', href: '/#visuelt-loeft' },
  { label: 'Kontakt', href: '/kontakt' },
];
---

<a
  href="#main"
  class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-white focus:px-4 focus:py-3 focus:text-brand"
>
  Gå til hovedindhold
</a>

<header class="relative z-20 px-4 pb-2 pt-5 sm:px-6 lg:px-10">
  <nav class="mx-auto flex max-w-[1480px] items-center justify-between gap-4 rounded-[1.25rem] border border-border-soft bg-white/76 px-5 py-3 shadow-soft backdrop-blur-md" aria-label="Hovednavigation">
    <a href="/" class="font-display text-3xl font-medium tracking-tight text-brand md:text-[2rem]">
      SiteDokAI
    </a>

    <div class="hidden items-center gap-8 lg:flex">
      {navItems.map((item) => (
        <a href={item.href} class="text-sm font-medium text-brand/78 transition-colors hover:text-accent-dark">
          {item.label}
        </a>
      ))}
    </div>

    <div class="hidden lg:block">
      <Button href="/kontakt?ydelse=gratis-mini-tjek" size="sm">Få gratis mini-tjek</Button>
    </div>

    <details class="group relative lg:hidden">
      <summary class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-[0.85rem] border border-border-soft bg-surface text-brand [&::-webkit-details-marker]:hidden" aria-label="Åbn menu">
        <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" aria-hidden="true">
          <path d="M5 7h14M5 12h14M5 17h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
      </summary>
      <div class="absolute right-0 top-14 w-[min(20rem,calc(100vw-2rem))] rounded-[1rem] border border-border-soft bg-white p-3 shadow-card">
        <div class="grid gap-1">
          {navItems.map((item) => (
            <a href={item.href} class="rounded-[0.8rem] px-4 py-3 text-sm font-medium text-brand/78 transition-colors hover:bg-accent-soft hover:text-brand">
              {item.label}
            </a>
          ))}
          <Button href="/kontakt?ydelse=gratis-mini-tjek" class="mt-2 w-full">Få gratis mini-tjek</Button>
        </div>
      </div>
    </details>
  </nav>
</header>
