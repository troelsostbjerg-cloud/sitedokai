---
import Button from './site/Button.astro';

const navItems = [
  { label: 'Problemet', href: '/#problemet' },
  { label: 'Sådan virker det', href: '/#metode' },
  { label: 'Ydelser', href: '/#ydelser' },
  { label: 'Use cases', href: '/use-cases' },
  { label: 'Om', href: '/#om-troels' },
  { label: 'Kontakt', href: '/#kontakt' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const ctaHref = Astro.url.pathname === '/kontakt' ? '#screening' : '/#kontakt';
---

<a
  href="#main"
  class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-panel focus:px-4 focus:py-3 focus:text-brand"
>
  Gå til hovedindhold
</a>

<header class="sticky top-0 z-20 border-b border-brand/10 bg-canvas/88 px-5 backdrop-blur-xl sm:px-6">
  <nav class="mx-auto flex max-w-7xl items-center justify-between gap-4 py-4" aria-label="Hovednavigation">
    <a href="/" class="min-w-0 text-brand">
      <span class="block font-display text-2xl font-semibold leading-none">SiteDokAI</span>
      <span class="mt-1 hidden font-mono text-[10px] uppercase tracking-[0.18em] text-muted sm:block">AI operations i praksis</span>
    </a>

    <div class="hidden items-center gap-5 lg:flex">
      {navItems.map((item) => {
        const isActive = currentPath === item.href;
        return (
          <a
            href={item.href}
            aria-current={isActive ? 'page' : undefined}
            class:list={[
              'text-sm font-medium transition-colors hover:text-brand',
              isActive ? 'text-brand' : 'text-brand/60',
            ]}
          >
            {item.label}
          </a>
        );
      })}
    </div>

    <div class="hidden lg:block">
      <Button href={ctaHref} size="sm">Send workflow</Button>
    </div>

    <details class="group relative lg:hidden" data-mobile-menu>
      <summary
        class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-xl border border-brand/10 bg-panel-soft text-brand transition-colors hover:bg-panel focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent [&::-webkit-details-marker]:hidden"
        aria-label="Åbn menu"
        aria-expanded="false"
        aria-controls="site-mobile-menu-panel"
      >
        <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" aria-hidden="true">
          <path d="M5 7h14M5 12h14M5 17h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
      </summary>
      <div id="site-mobile-menu-panel" class="absolute right-0 top-14 z-30 max-h-[min(31rem,calc(100dvh-8rem))] w-[min(21rem,calc(100vw-2rem))] overflow-y-auto rounded-2xl border border-brand/10 bg-canvas-soft p-3 shadow-card">
        <div class="grid gap-1">
          {navItems.map((item) => {
            const isActive = currentPath === item.href;
            return (
              <a
                href={item.href}
                aria-current={isActive ? 'page' : undefined}
                class:list={[
                  'rounded-xl px-4 py-3 text-sm font-medium transition-colors hover:bg-panel-soft hover:text-brand',
                  isActive ? 'bg-panel-soft text-brand' : 'text-brand/70',
                ]}
              >
                {item.label}
              </a>
            );
          })}
          <Button href={ctaHref} class="mt-2 w-full">Send workflow</Button>
        </div>
      </div>
    </details>
  </nav>
</header>

<script is:inline>
  (function() {
    var menus = document.querySelectorAll('[data-mobile-menu]');
    if (!menus.length) return;

    menus.forEach(function(menu) {
      var summary = menu.querySelector('summary');

      function syncExpandedState() {
        if (summary) {
          summary.setAttribute('aria-expanded', menu.hasAttribute('open') ? 'true' : 'false');
        }
      }

      function closeMenu() {
        if (!menu.hasAttribute('open')) return;
        menu.removeAttribute('open');
        syncExpandedState();
        if (summary instanceof HTMLElement) {
          summary.blur();
        }
      }

      menu.addEventListener('toggle', syncExpandedState);

      menu.addEventListener('click', function(event) {
        var target = event.target;
        if (!(target instanceof Element)) return;

        var link = target.closest('a[href]');
        if (!link || !menu.contains(link)) return;

        window.setTimeout(closeMenu, 0);
      });

      document.addEventListener('click', function(event) {
        var target = event.target;
        if (!(target instanceof Node)) return;
        if (!menu.hasAttribute('open') || menu.contains(target)) return;

        closeMenu();
      });

      document.addEventListener('keydown', function(event) {
        if (event.key !== 'Escape') return;
        closeMenu();
      });

      syncExpandedState();
    });
  })();
</script>
