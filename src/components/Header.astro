---
import Button from './site/Button.astro';

const navItems = [
  { label: 'Problemet', href: '/#problemet' },
  { label: 'Det fikser vi', href: '/#det-fikser-vi' },
  { label: 'Metode', href: '/#metode' },
  { label: 'Ydelser', href: '/#ydelser' },
  { label: 'Eksempler', href: '/#eksempler' },
  { label: 'Om Troels', href: '/#om-troels' },
  { label: 'Kontakt', href: '/#kontakt' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const ctaHref = Astro.url.pathname === '/kontakt' ? '#screening' : '/#kontakt';
---

<a
  href="#main"
  class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-white focus:px-4 focus:py-3 focus:text-brand"
>
  Gå til hovedindhold
</a>

<header class="sticky top-0 z-20 border-b border-brand/10 bg-canvas/90 px-5 backdrop-blur-xl sm:px-6">
  <nav class="mx-auto flex max-w-7xl items-center justify-between gap-4 py-4" aria-label="Hovednavigation">
    <a href="/" class="min-w-0 text-brand">
      <span class="block font-display text-2xl font-semibold leading-none">SiteDokAI</span>
      <span class="mt-1 hidden font-mono text-[10px] uppercase tracking-[0.18em] text-muted sm:block">AI-drevet procesoptimering</span>
    </a>

    <div class="hidden items-center gap-5 lg:flex">
      {navItems.map((item) => {
        const isActive = currentPath === item.href;
        return (
          <a
            href={item.href}
            aria-current={isActive ? 'page' : undefined}
            class:list={[
              'text-sm font-medium transition-colors hover:text-brand',
              isActive ? 'text-brand' : 'text-brand/60',
            ]}
          >
            {item.label}
          </a>
        );
      })}
    </div>

    <div class="hidden lg:block">
      <Button href={ctaHref} size="sm">Book audit</Button>
    </div>

    <details class="group relative lg:hidden">
      <summary class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-xl border border-brand/10 bg-panel-soft text-brand [&::-webkit-details-marker]:hidden" aria-label="Åbn menu">
        <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" aria-hidden="true">
          <path d="M5 7h14M5 12h14M5 17h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
      </summary>
      <div class="absolute right-0 top-14 w-[min(21rem,calc(100vw-2rem))] rounded-2xl border border-brand/10 bg-canvas-soft p-3 shadow-card">
        <div class="grid gap-1">
          {navItems.map((item) => {
            const isActive = currentPath === item.href;
            return (
              <a
                href={item.href}
                aria-current={isActive ? 'page' : undefined}
                class:list={[
                  'rounded-xl px-4 py-3 text-sm font-medium transition-colors hover:bg-panel-soft hover:text-brand',
                  isActive ? 'bg-panel-soft text-brand' : 'text-brand/70',
                ]}
              >
                {item.label}
              </a>
            );
          })}
          <Button href={ctaHref} class="mt-2 w-full">Book audit</Button>
        </div>
      </div>
    </details>
  </nav>
</header>
