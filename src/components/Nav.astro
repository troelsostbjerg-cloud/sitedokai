---
const links = [
  { href: '/#ydelser', label: 'Samarbejdet' },
  { href: '/#metode', label: 'Metoden' },
  { href: '/#arbejdseksempel', label: 'Arbejdseksempel' },
  { href: '/om/', label: 'Om mig' },
];
const path = Astro.url.pathname;
const contactHref = 'mailto:info@sitedokai.com?subject=Afklarende%20samtale%20om%20AI-adoption';

function isActive(href: string) {
  return !href.includes('#') && path === href;
}
---

<header class="sticky top-0 z-50 border-b border-line/80 bg-canvas/90 backdrop-blur-xl">
  <nav class="container-page flex min-h-[4.75rem] items-center justify-between gap-5" aria-label="Primær navigation">
    <a href="/" class="group flex shrink-0 items-center gap-3 no-underline" aria-label="SiteDokAI, gå til forsiden">
      <span class="grid h-9 w-9 place-items-center rounded-full bg-brand text-paper transition-transform duration-200 group-hover:-rotate-6" aria-hidden="true">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none">
          <path d="M6.2 7.1c1.8-2 4-2.8 6.3-2.3 2.1.4 3.8 1.7 5.3 3.7M5 16c2 2.5 4.5 3.5 7.1 2.9 2.1-.5 3.8-1.8 5.2-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          <path d="M7.8 12h8.4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
      </span>
      <span class="font-display text-[1.3rem] font-semibold tracking-[-0.04em] text-brand">SiteDok<span class="italic text-sage-dark">AI</span></span>
    </a>

    <div class="hidden items-center gap-0.5 lg:flex">
      {links.map((link) => (
        <a
          href={link.href}
          aria-current={isActive(link.href) ? 'page' : undefined}
          class:list={[
            'rounded-full px-3.5 py-2 text-sm font-medium no-underline transition-colors duration-150 hover:bg-paper hover:text-brand',
            isActive(link.href) ? 'bg-paper text-brand' : 'text-muted',
          ]}
        >
          {link.label}
        </a>
      ))}
    </div>

    <div class="hidden lg:block">
      <a href={contactHref} class="btn btn-primary min-h-10 px-4 py-2">Tag en uforpligtende snak</a>
    </div>

    <button
      type="button"
      data-menu-toggle
      class="grid h-11 w-11 place-items-center rounded-full border border-line-strong bg-paper/70 text-brand lg:hidden"
      aria-label="Åbn menu"
      aria-controls="mobile-navigation"
      aria-expanded="false"
    >
      <svg width="21" height="21" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M4 8h16M4 16h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      </svg>
    </button>
  </nav>

  <div id="mobile-navigation" data-mobile-menu hidden class="border-t border-line bg-canvas lg:hidden">
    <div class="container-page flex flex-col py-4">
      {links.map((link) => (
        <a data-menu-link href={link.href} class="border-b border-line py-3.5 text-base font-medium text-brand no-underline">
          {link.label}
        </a>
      ))}
      <a data-menu-link href="/kontakt/" class="border-b border-line py-3.5 text-base font-medium text-brand no-underline">Kontakt</a>
      <a data-menu-link href={contactHref} class="btn btn-primary mt-5">Tag en uforpligtende snak</a>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const toggle = document.querySelector('[data-menu-toggle]');
    const menu = document.querySelector('[data-mobile-menu]');
    if (!(toggle instanceof HTMLButtonElement) || !(menu instanceof HTMLElement)) return;

    const close = () => {
      menu.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Åbn menu');
    };

    toggle.addEventListener('click', () => {
      const willOpen = menu.hidden;
      menu.hidden = !willOpen;
      toggle.setAttribute('aria-expanded', String(willOpen));
      toggle.setAttribute('aria-label', willOpen ? 'Luk menu' : 'Åbn menu');
    });

    menu.querySelectorAll('[data-menu-link]').forEach((link) => link.addEventListener('click', close));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        close();
        toggle.focus();
      }
    });
  })();
</script>
