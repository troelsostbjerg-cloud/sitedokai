---
// Altid-synlig "instrument"-widget i øverste højre hjørne.
// Viser et indikativt estimat for hvor tæt vi er på RSI, AGI og ASI.
// Tallene drives af en tidsbaseret model (logistiske kurver), så de kryber
// opad efterhånden som tiden går — det er et skøn, ikke en kendsgerning.
//
// Vil du justere kurverne: ret k (stejlhed) og t0 (midtpunkts-år) nedenfor.
const metrics = [
  { key: 'RSI', full: 'Rekursiv selv-forbedring', color: '#a78bfa', k: 0.55, t0: 2025.77 },
  { key: 'AGI', full: 'Generel kunstig intelligens', color: '#22d3ee', k: 0.5, t0: 2026.82 },
  { key: 'ASI', full: 'Superintelligens', color: '#f472b6', k: 0.45, t0: 2029.27 },
];
---

<div
  id="asi-widget"
  class="fixed right-2 top-[4.6rem] z-40 w-[190px] sm:right-3 sm:w-[230px]"
  aria-label="Estimat: vejen mod superintelligens"
>
  <!-- Minimeret knap -->
  <button
    type="button"
    data-asi-open
    hidden
    class="ml-auto flex items-center gap-1.5 rounded-full border border-line bg-ink-panel/85 px-3 py-1.5 text-[11px] font-semibold text-text-soft shadow-card backdrop-blur transition-colors hover:text-text"
  >
    <span class="h-1.5 w-1.5 rounded-full bg-cat-produkt animate-pulse-dot"></span>
    Mod ASI
  </button>

  <!-- Panel -->
  <div data-asi-panel class="glass overflow-hidden p-3 shadow-card">
    <div class="flex items-center justify-between gap-2">
      <div class="flex items-center gap-1.5">
        <span class="h-1.5 w-1.5 rounded-full bg-cat-produkt animate-pulse-dot"></span>
        <span class="font-mono text-[10px] font-semibold uppercase tracking-[0.14em] text-text-soft">Vejen mod ASI</span>
      </div>
      <div class="flex items-center gap-0.5">
        <button type="button" data-asi-graph aria-label="Vis/skjul graf" class="grid h-6 w-6 place-items-center rounded-md text-text-dim transition-colors hover:bg-white/10 hover:text-text">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 19V5m0 14h16M4 15l4-4 4 3 6-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button type="button" data-asi-min aria-label="Minimér" class="grid h-6 w-6 place-items-center rounded-md text-text-dim transition-colors hover:bg-white/10 hover:text-text">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </button>
      </div>
    </div>

    <!-- Målere -->
    <div class="mt-3 space-y-2.5">
      {
        metrics.map((m) => (
          <div title={`${m.key} — ${m.full}`}>
            <div class="flex items-center justify-between">
              <span class="font-mono text-[11px] font-bold" style={`color:${m.color}`}>{m.key}</span>
              <span data-num={m.key} class="font-mono text-[11px] font-semibold tabular-nums text-text">–</span>
            </div>
            <div class="mt-1 h-1.5 w-full overflow-hidden rounded-full bg-white/10">
              <div
                data-bar={m.key}
                class="h-full rounded-full"
                style={`width:0%; background:${m.color}; box-shadow:0 0 8px ${m.color}99; transition:width 1.2s cubic-bezier(0.16,1,0.3,1)`}
              />
            </div>
          </div>
        ))
      }
    </div>

    <!-- Graf (foldes ud) -->
    <div data-asi-graphwrap hidden class="mt-3 border-t border-line pt-3">
      <svg data-graph viewBox="0 0 214 96" class="w-full" role="img" aria-label="Estimeret udvikling mod RSI, AGI og ASI over tid"></svg>
      <div class="mt-2 flex flex-wrap gap-x-2.5 gap-y-1">
        {
          metrics.map((m) => (
            <span class="flex items-center gap-1 text-[9px] leading-tight text-text-soft">
              <span class="h-1.5 w-1.5 rounded-full" style={`background:${m.color}`} />
              {m.full}
            </span>
          ))
        }
      </div>
    </div>

    <p class="mt-2.5 text-[9px] leading-tight text-text-dim">Indikativt estimat · opdateres løbende</p>
  </div>
</div>

<script is:inline define:vars={{ metrics }}>
  (function () {
    var el = document.getElementById('asi-widget');
    if (!el) return;

    var panel = el.querySelector('[data-asi-panel]');
    var openBtn = el.querySelector('[data-asi-open]');
    var minBtn = el.querySelector('[data-asi-min]');
    var graphBtn = el.querySelector('[data-asi-graph]');
    var graphWrap = el.querySelector('[data-asi-graphwrap]');
    var svg = el.querySelector('[data-graph]');

    function nowYear() {
      var d = new Date();
      var s = Date.UTC(d.getUTCFullYear(), 0, 1);
      var e = Date.UTC(d.getUTCFullYear() + 1, 0, 1);
      return d.getUTCFullYear() + (d.getTime() - s) / (e - s);
    }
    function val(m, t) {
      return 100 / (1 + Math.exp(-m.k * (t - m.t0)));
    }

    // Tæl-op-animation ved start (giver "levende" fornemmelse)
    var started = 0;
    function animateIn() {
      started = performance.now();
      requestAnimationFrame(tick);
    }
    function tick(ts) {
      var p = Math.min((ts - started) / 1400, 1);
      var ease = 1 - Math.pow(1 - p, 3);
      var t = nowYear();
      metrics.forEach(function (m) {
        var target = val(m, t);
        var shown = target * ease;
        var num = el.querySelector('[data-num="' + m.key + '"]');
        var bar = el.querySelector('[data-bar="' + m.key + '"]');
        if (num) num.textContent = shown.toFixed(1) + '%';
        if (bar) bar.style.width = shown.toFixed(2) + '%';
      });
      if (p < 1) requestAnimationFrame(tick);
    }

    function render() {
      var t = nowYear();
      metrics.forEach(function (m) {
        var v = val(m, t);
        var num = el.querySelector('[data-num="' + m.key + '"]');
        var bar = el.querySelector('[data-bar="' + m.key + '"]');
        if (num) num.textContent = v.toFixed(1) + '%';
        if (bar) bar.style.width = v.toFixed(2) + '%';
      });
      if (graphWrap && !graphWrap.hasAttribute('hidden')) drawGraph(t);
    }

    function drawGraph(t) {
      if (!svg) return;
      var W = 214, H = 96, padL = 4, padR = 4, padT = 6, padB = 14;
      var x0 = 2025, x1 = 2030;
      function X(yr) { return padL + ((yr - x0) / (x1 - x0)) * (W - padL - padR); }
      function Y(v) { return padT + (1 - v / 100) * (H - padT - padB); }
      var p = [];
      p.push('<line x1="' + padL + '" y1="' + Y(0) + '" x2="' + (W - padR) + '" y2="' + Y(0) + '" stroke="rgba(255,255,255,0.12)"/>');
      [2025, 2027, 2029].forEach(function (yr) {
        p.push('<text x="' + X(yr) + '" y="' + (H - 4) + '" fill="rgba(255,255,255,0.32)" font-size="7" text-anchor="middle" font-family="monospace">’' + String(yr).slice(2) + '</text>');
      });
      p.push('<line x1="' + X(t).toFixed(1) + '" y1="' + padT + '" x2="' + X(t).toFixed(1) + '" y2="' + Y(0) + '" stroke="rgba(255,255,255,0.28)" stroke-dasharray="2 2"/>');
      p.push('<text x="' + X(t).toFixed(1) + '" y="' + (H - 4) + '" fill="rgba(255,255,255,0.5)" font-size="7" text-anchor="middle" font-family="monospace">nu</text>');
      metrics.forEach(function (m) {
        var pts = [];
        for (var yr = x0; yr <= x1 + 0.001; yr += 0.25) pts.push(X(yr).toFixed(1) + ',' + Y(val(m, yr)).toFixed(1));
        p.push('<polyline points="' + pts.join(' ') + '" fill="none" stroke="' + m.color + '" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>');
        p.push('<circle cx="' + X(t).toFixed(1) + '" cy="' + Y(val(m, t)).toFixed(1) + '" r="2.2" fill="' + m.color + '"/>');
      });
      svg.innerHTML = p.join('');
    }

    // Fold ind/ud
    function setMin(min) {
      try { localStorage.setItem('asi-min', min ? '1' : '0'); } catch (e) {}
      if (min) { panel.setAttribute('hidden', ''); openBtn.removeAttribute('hidden'); }
      else { openBtn.setAttribute('hidden', ''); panel.removeAttribute('hidden'); animateIn(); }
    }
    if (minBtn) minBtn.addEventListener('click', function () { setMin(true); });
    if (openBtn) openBtn.addEventListener('click', function () { setMin(false); });

    if (graphBtn) graphBtn.addEventListener('click', function () {
      if (!graphWrap) return;
      if (graphWrap.hasAttribute('hidden')) { graphWrap.removeAttribute('hidden'); drawGraph(nowYear()); try { localStorage.setItem('asi-graph', '1'); } catch (e) {} }
      else { graphWrap.setAttribute('hidden', ''); try { localStorage.setItem('asi-graph', '0'); } catch (e) {} }
    });

    // Gendan tidligere valg
    try {
      if (localStorage.getItem('asi-graph') === '1' && graphWrap) graphWrap.removeAttribute('hidden');
    } catch (e) {}
    var stored = null;
    try { stored = localStorage.getItem('asi-min'); } catch (e) {}
    // Mobil: start som lille chip (fylder ikke). Desktop: vis målerne.
    var startMin = stored === '1' || (stored === null && window.matchMedia('(max-width: 639px)').matches);

    if (startMin) { setMin(true); }
    else { animateIn(); if (graphWrap && !graphWrap.hasAttribute('hidden')) drawGraph(nowYear()); }

    // Opdaterer sig løbende
    setInterval(render, 1000);
  })();
</script>
