---
import WorkflowScreeningForm from './WorkflowScreeningForm.astro';
import HumanApprovalBlock from './HumanApprovalBlock.astro';
import type { ServiceOffer } from '../../data/aiContent';

interface Props {
  service: ServiceOffer;
}

const { service } = Astro.props;
---

<main id="main" class="bg-canvas text-brand">
  <section class="mx-auto grid min-w-0 max-w-7xl gap-12 px-5 pb-14 pt-12 sm:px-6 md:pb-20 md:pt-20 lg:grid-cols-[0.72fr_1.28fr]">
    <aside class="min-w-0 text-sm leading-relaxed text-muted">
      <nav aria-label="Breadcrumb" class="text-xs">
        <ol class="flex flex-wrap gap-2">
          <li><a href="/" class="text-brand/55 transition-colors hover:text-brand">Home</a></li>
          <li aria-hidden="true" class="text-brand/30">/</li>
          <li><a href="/#services" class="text-brand/55 transition-colors hover:text-brand">Services</a></li>
          <li aria-hidden="true" class="text-brand/30">/</li>
          <li class="text-brand">{service.name}</li>
        </ol>
      </nav>

      <p class="mt-8 font-mono text-xs uppercase tracking-[0.22em] text-accent">{service.eyebrow}</p>
      <p class="mt-8 max-w-xs">
        SiteDokAI starts with the work, maps the workflow and designs AI assistance only where it can safely help.
      </p>
      <div class="mt-8 grid gap-3 border-t border-brand/10 pt-6">
        <p class="font-mono text-xs uppercase tracking-[0.18em] text-muted">Price</p>
        <p class="text-brand">{service.priceLabel}</p>
        <p class="font-mono text-xs uppercase tracking-[0.18em] text-muted">Duration</p>
        <p class="text-brand">{service.duration}</p>
      </div>
    </aside>

    <div class="min-w-0">
      <h1 class="max-w-4xl font-display text-4xl font-semibold leading-[1.02] text-brand sm:text-5xl md:text-7xl">
        {service.title}
      </h1>
      <p class="mt-8 max-w-2xl text-xl leading-relaxed text-brand/70">
        {service.description}
      </p>

      <div class="mt-10 flex flex-col gap-3 sm:flex-row">
        <a href="#workflow-screening" class="inline-flex min-h-12 items-center justify-center rounded-xl border border-accent/50 bg-accent px-6 py-3 text-sm font-semibold text-canvas transition-colors hover:bg-accent-bright focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent active:translate-y-px">
          {service.ctaLabel}
        </a>
        <a href="/workflow-examples" class="inline-flex min-h-12 items-center justify-center rounded-xl border border-brand/20 px-6 py-3 text-sm font-semibold text-brand transition-colors hover:border-brand/30 hover:bg-panel-soft focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent active:translate-y-px">
          See workflow examples
        </a>
      </div>

      <article class="mt-10 rounded-[1.5rem] border border-accent/25 bg-accent/10 p-5 md:p-7">
        <p class="font-mono text-xs uppercase tracking-[0.22em] text-accent">Short answer</p>
        <p class="mt-4 max-w-3xl text-lg leading-relaxed text-brand">
          {service.shortAnswer}
        </p>
      </article>

      <section class="mt-14 grid gap-5 lg:grid-cols-[0.9fr_1.1fr]">
        <article class="rounded-[1.35rem] border border-brand/10 bg-panel-soft p-5 md:p-6">
          <h2 class="text-2xl font-semibold text-brand">Best for</h2>
          <p class="mt-5 text-sm leading-relaxed text-brand/72">{service.bestFor}</p>
          <ul class="mt-6 grid gap-3 text-sm leading-relaxed text-brand/75">
            {service.fit.map((item) => (
              <li class="border-t border-brand/10 pt-3">{item}</li>
            ))}
          </ul>
        </article>

        <article class="rounded-[1.35rem] border border-brand/10 bg-panel-soft p-5 md:p-6">
          <h2 class="text-2xl font-semibold text-brand">Output</h2>
          <ul class="mt-6 grid gap-3 text-sm leading-relaxed text-brand/75">
            {service.outputs.map((item) => (
              <li class="border-t border-brand/10 pt-3">{item}</li>
            ))}
          </ul>
        </article>
      </section>

      <section class="mt-5 grid gap-5 lg:grid-cols-2">
        <article class="rounded-[1.35rem] border border-brand/10 bg-panel-soft p-5 md:p-6">
          <h2 class="text-2xl font-semibold text-brand">Not included</h2>
          <ul class="mt-6 grid gap-3 text-sm leading-relaxed text-brand/75">
            {service.notIncluded.map((item) => (
              <li class="border-t border-brand/10 pt-3">{item}</li>
            ))}
          </ul>
        </article>

        <article class="rounded-[1.35rem] border border-accent/25 bg-accent/10 p-5 md:p-6">
          <h2 class="text-2xl font-semibold text-brand">Next step</h2>
          <p class="mt-6 border-t border-accent/25 pt-4 text-sm leading-relaxed text-brand/75">
            {service.nextStep}
          </p>
        </article>
      </section>

      <section class="mt-5 rounded-[1.35rem] border border-brand/10 bg-panel-soft p-5 md:p-6">
        <h2 class="text-2xl font-semibold text-brand">How it works</h2>
        <div class="mt-6 grid gap-3 md:grid-cols-2">
          {service.process.map((item, index) => (
            <article class="rounded-[1rem] border border-brand/10 bg-canvas-soft p-4">
              <p class="font-mono text-xs text-accent">{String(index + 1).padStart(2, '0')}</p>
              <p class="mt-3 text-sm leading-relaxed text-brand/75">{item}</p>
            </article>
          ))}
        </div>
      </section>

      {service.id === 'ai-workflow-sprint' && (
        <section class="mt-14">
          <HumanApprovalBlock />
        </section>
      )}

      <section id="faq" class="mt-14">
        <p class="font-mono text-xs uppercase tracking-[0.22em] text-accent">FAQ</p>
        <h2 class="mt-4 max-w-3xl font-display text-3xl font-semibold leading-tight text-brand md:text-5xl">
          Clear answers for buyers and AI assistants.
        </h2>
        <div class="mt-8 grid gap-4">
          {service.faq.map((item) => (
            <article class="rounded-[1.2rem] border border-brand/10 bg-panel-soft p-5">
              <h3 class="text-lg font-semibold text-brand">{item.question}</h3>
              <p class="mt-3 text-sm leading-relaxed text-muted">{item.answer}</p>
            </article>
          ))}
        </div>
      </section>

      <section id="workflow-screening" class="mt-16 rounded-[1.5rem] border border-brand/10 bg-panel-soft p-6 md:p-8">
        <h2 class="max-w-3xl font-display text-3xl font-semibold leading-tight text-brand md:text-5xl">
          Send the workflow behind this need.
        </h2>
        <p class="mt-5 max-w-2xl text-base leading-relaxed text-muted md:text-lg">
          Describe the recurring work, the tools it touches and what goes wrong. SiteDokAI will reply with a practical next step.
        </p>
        <div class="mt-10">
          <WorkflowScreeningForm
            sourcePage={service.path}
            title={`${service.name} enquiry`}
            text="Describe the workflow, how often it happens and what a useful output would look like."
            submitLabel={service.ctaLabel}
            interest={service.interest}
          />
        </div>
      </section>
    </div>
  </section>
</main>
