---
interface Props {
  id?: string;
  class?: string;
  innerClass?: string;
}

const { id, class: className = '', innerClass = '' } = Astro.props;
---

<section id={id} class:list={['site-section', className]}>
  <div class:list={['mx-auto w-full max-w-[1480px] px-4 sm:px-6 lg:px-10', innerClass]}>
    <slot />
  </div>
</section>
