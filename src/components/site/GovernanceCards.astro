---
const cards = [
  ['Minimum necessary input', 'Start with the smallest useful set of examples, data and context.'],
  ['Existing tools first', 'Work around the tools the team already uses before adding another system.'],
  ['Clear human approval', 'Review sits where quality, risk, tone or responsibility matters.'],
  ['Documented workflow', 'The workflow is written down so people know how it works.'],
  ['Traceable output', 'Users can see the input, draft, changes and next action.'],
  ['No blind full automation', 'Full automation is not the default when judgement matters.'],
  ['No unnecessary system access', 'Do not connect systems unless the workflow needs it.'],
  ['No unsupported compliance claims', 'Security and compliance claims must be documented before they appear on the site.'],
];
---

<section id="governance" class="px-5 py-16 sm:px-6 md:py-24">
  <div class="mx-auto max-w-7xl">
    <div class="grid gap-10 lg:grid-cols-[0.72fr_1.28fr]">
      <aside>
        <p class="font-mono text-xs uppercase tracking-[0.22em] text-accent">Governance</p>
        <h2 class="mt-5 max-w-xl font-display text-4xl font-semibold leading-[1.02] text-brand md:text-6xl">
          Data, access and governance without drama.
        </h2>
        <p class="mt-6 max-w-xl text-base leading-relaxed text-brand/70 md:text-lg">
          SiteDokAI starts with the minimum data and access needed to understand the workflow. The goal is not to connect everything to AI. The goal is to design the safest useful workflow.
        </p>
      </aside>
      <div class="grid gap-4 md:grid-cols-2">
        {cards.map(([title, text]) => (
          <article class="rounded-[1.2rem] border border-brand/10 bg-panel-soft p-5">
            <h3 class="text-lg font-semibold text-brand">{title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-brand/66">{text}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
