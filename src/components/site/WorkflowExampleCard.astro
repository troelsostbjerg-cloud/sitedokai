---
import type { WorkflowExample } from '../../data/aiContent';

interface Props {
  workflowExample: WorkflowExample;
  index?: number;
}

const { workflowExample, index = 1 } = Astro.props;
---

<article class="group grid h-full gap-5 rounded-[1.35rem] border border-brand/10 bg-panel-soft p-5 transition duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] hover:border-accent/35 hover:bg-panel md:p-6">
  <div class="flex items-start justify-between gap-4">
    <p class="font-mono text-[0.68rem] uppercase tracking-[0.2em] text-accent">Workflow {String(index).padStart(2, '0')}</p>
    <span class="rounded-lg border border-brand/10 px-2.5 py-1 font-mono text-[0.64rem] uppercase tracking-[0.14em] text-brand/48">Example</span>
  </div>
  <div>
    <h3 class="text-2xl font-semibold leading-tight text-brand group-hover:text-accent">{workflowExample.title}</h3>
    <p class="mt-4 text-sm leading-relaxed text-brand/68">{workflowExample.description}</p>
  </div>
  <div class="grid gap-3">
    <div class="rounded-xl border border-brand/10 bg-canvas/60 p-4">
      <p class="font-mono text-[0.66rem] uppercase tracking-[0.16em] text-brand/42">Broken workflow</p>
      <p class="mt-2 text-sm leading-relaxed text-brand/70">{workflowExample.brokenWorkflow}</p>
    </div>
    <div class="rounded-xl border border-accent/22 bg-accent/10 p-4">
      <p class="font-mono text-[0.66rem] uppercase tracking-[0.16em] text-accent">AI-assisted workflow</p>
      <p class="mt-2 text-sm leading-relaxed text-brand/76">{workflowExample.aiAssistedWorkflow}</p>
    </div>
    <div class="rounded-xl border border-brand/10 bg-canvas/60 p-4">
      <p class="font-mono text-[0.66rem] uppercase tracking-[0.16em] text-brand/42">Output</p>
      <p class="mt-2 text-sm leading-relaxed text-brand/70">{workflowExample.output}</p>
    </div>
  </div>
  <div class="flex flex-wrap gap-2">
    {workflowExample.goodFitSignals.slice(0, 3).map((signal) => (
      <span class="rounded-lg border border-brand/10 bg-canvas/70 px-3 py-1.5 text-xs font-medium leading-relaxed text-brand/62">{signal}</span>
    ))}
  </div>
  <a href={workflowExample.path} class="mt-auto inline-flex min-h-11 items-center justify-center rounded-xl border border-brand/20 px-5 py-3 text-center text-sm font-semibold text-brand transition-colors hover:border-accent/35 hover:bg-accent/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent active:translate-y-px">
    Send your version of this workflow
  </a>
</article>
