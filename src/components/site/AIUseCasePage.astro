---
import WorkflowExamplePage from './WorkflowExamplePage.astro';
import type { WorkflowExample } from '../../data/aiContent';

interface Props {
  useCase?: WorkflowExample;
  workflowExample?: WorkflowExample;
}

const workflowExample = Astro.props.workflowExample || Astro.props.useCase;

if (!workflowExample) {
  throw new Error('Workflow example data missing');
}
---

<WorkflowExamplePage workflowExample={workflowExample} />
