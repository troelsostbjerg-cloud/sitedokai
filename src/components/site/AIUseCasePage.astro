---
import ScreeningForm from './ScreeningForm.astro';
import type { UseCase } from '../../data/aiContent';

interface Props {
  useCase: UseCase;
}

const { useCase } = Astro.props;

const useCaseDetails: Record<UseCase['id'], { pain: string; input: string; approval: string; effect: string; service: string }> = {
  'ai-statusrapport': {
    pain: 'Operations, projektledelse, ledelse og teams der bruger møder på at finde seneste status.',
    input: 'Statusmails, Teams-tråde, mødenoter, projektlister og faste opdateringsfelter.',
    approval: 'Mødeejer eller projektansvarlig godkender actions, deadlines og beslutningspunkter før de deles.',
    effect: 'Mindre statusjagt, færre opfølgningsmøder og hurtigere beslutninger.',
    service: 'Manual Work Audit som første skridt, AI Workflow Sprint hvis kilder og skabelon er klare.',
  },
  ledelsesrapport: {
    pain: 'Finance, operations og ledelse, hvor rapportering bliver samlet manuelt hver uge eller måned.',
    input: 'Excel/Sheets, eksportfiler, KPI-noter, afvigelser og tidligere rapporter.',
    approval: 'Fagansvarlig godkender forklaringer, anbefalinger og tal før rapporten sendes videre.',
    effect: 'Mindre copy-paste, mere ens forklaring af afvigelser og bedre beslutningsgrundlag.',
    service: 'Manual Work Audit hvis rapportflowet er uklart, AI Workflow Sprint hvis format og datakilder er faste.',
  },
  'kundehenvendelse-svarudkast': {
    pain: 'Kundeservice, salg og Customer Success, hvor mange henvendelser kræver samme vurdering igen og igen.',
    input: 'Kundemail, CRM-historik, produktregler, tidligere svar og interne retningslinjer.',
    approval: 'Medarbejder godkender svar, tone og eskalering før kunden får noget.',
    effect: 'Hurtigere første svar, mere ens kvalitet og tydeligere eskalering.',
    service: 'AI Workflow Sprint, typisk efter en kort audit af regler, tone og risikogrænser.',
  },
  'moede-actions-opfoelgning': {
    pain: 'Projektteams, ledere og mødeejere, der mister actions efter møder.',
    input: 'Mødenoter, transskription, agenda, deltagerliste og tidligere actionlog.',
    approval: 'Mødeejer godkender ansvarlige, deadlines og opfølgningsmail.',
    effect: 'Færre glemte aftaler, kortere opfølgningstid og tydeligere ejerskab.',
    service: 'AI Workflow Sprint hvis teamet allerede har en fast møderytme.',
  },
  'leverandoerstatus-undtagelser': {
    pain: 'Supply chain, indkøb og operations, hvor afvigelser gemmer sig i mails og statusark.',
    input: 'Leverandørmails, statusfiler, forsinkelsesnoter, ordrelister og kendte risikokategorier.',
    approval: 'Indkøb eller operations godkender foreslået handling, eskalering og intern besked.',
    effect: 'Mindre gennemlæsning, hurtigere reaktion på undtagelser og bedre overblik.',
    service: 'Manual Work Audit først, især hvis leverandørinput kommer i mange formater.',
  },
  'tilbudsanmodning-afklaring': {
    pain: 'Salg, projektledelse og rådgivere, der bruger tid på uklare forespørgsler.',
    input: 'Kundeforespørgsel, krav, bilag, tidligere tilbud, scope-kriterier og prislogik.',
    approval: 'Sælger eller projektansvarlig godkender afklaringsspørgsmål og næste skridt.',
    effect: 'Hurtigere kvalificering, færre manglende oplysninger og bedre tilbudsstart.',
    service: 'AI Workflow Sprint når vurderingskriterierne kan beskrives tydeligt.',
  },
  'ny-kunde-onboarding': {
    pain: 'Salg, delivery, kundeservice og ledelse, hvor viden går tabt mellem aftale og opstart.',
    input: 'Salgsnoter, kontrakt, scope, kundemail, interne aftaler og kendte risici.',
    approval: 'Delivery-ansvarlig godkender onboarding-plan, mangler og første kundebesked.',
    effect: 'Færre misforståelser, hurtigere opstart og mere ens handover.',
    service: 'Manual Work Audit hvis handover er forskellig fra kunde til kunde.',
  },
  'crm-opfoelgning-naeste-skridt': {
    pain: 'Salg og Customer Success, hvor muligheder går kolde, fordi næste handling ligger i løse noter.',
    input: 'CRM-noter, mails, seneste kontakt, tilbudsstatus og aftaler.',
    approval: 'Sælger godkender prioritering, mailudkast og næste handling.',
    effect: 'Mindre tabt opfølgning, bedre prioritering og mere stabil salgsrytme.',
    service: 'AI Workflow Sprint hvis CRM-data er tilgængelige og næste-skridt-logikken er tydelig.',
  },
  'reklamation-sagsoverblik': {
    pain: 'Kundeservice, kvalitet og finance, hvor sager kræver manuel læsning af historik og regler.',
    input: 'Kundebesked, billeder, ordredata, tidligere mails, betingelser og interne noter.',
    approval: 'Ansvarlig medarbejder godkender vurdering og svar, før kunden kontaktes.',
    effect: 'Hurtigere sagsforståelse, mere ens vurdering og færre oversete detaljer.',
    service: 'Manual Work Audit først, fordi data, ansvar og risiko skal afklares.',
  },
  'procesdokumentation-interviews': {
    pain: 'Operations, HR, ledelse og teams, hvor vigtig viden ligger hos få erfarne personer.',
    input: 'Interviews, skærmoptagelser, eksisterende SOPer, noter og undtagelser.',
    approval: 'Procesejer godkender trin, regler og undtagelser før dokumentationen bruges til træning.',
    effect: 'Hurtigere oplæring, mindre personafhængighed og bedre grundlag for forbedringer.',
    service: 'Manual Work Audit som naturligt første skridt.',
  },
};

const detail = useCaseDetails[useCase.id];

const workflowBlocks = [
  ['Problemet', useCase.problem],
  ['Hvem mærker smerten?', detail.pain],
  ['Input', detail.input],
  ['Workflow', useCase.workflow],
  ['Human approval', detail.approval],
  ['Output', useCase.output],
  ['Typisk effekt', detail.effect],
  ['Relevant ydelse', detail.service],
];
---

<main id="main" class="bg-canvas text-brand">
  <section class="mx-auto grid min-w-0 max-w-7xl gap-12 px-5 pb-14 pt-12 sm:px-6 md:pb-20 md:pt-20 lg:grid-cols-[0.72fr_1.28fr]">
    <aside class="min-w-0 text-sm leading-relaxed text-muted">
      <nav aria-label="Brødkrumme" class="text-xs">
        <ol class="flex flex-wrap gap-2">
          <li><a href="/" class="text-brand/55 transition-colors hover:text-brand">Forside</a></li>
          <li aria-hidden="true" class="text-brand/30">/</li>
          <li><a href="/use-cases" class="text-brand/55 transition-colors hover:text-brand">Use cases</a></li>
          <li aria-hidden="true" class="text-brand/30">/</li>
          <li class="text-brand">{useCase.title}</li>
        </ol>
      </nav>
      <p class="mt-8 font-mono text-xs uppercase tracking-[0.22em] text-accent">{useCase.eyebrow}</p>
      <p class="mt-8 max-w-xs">
        Brug disse sider som konkrete eksempler på, hvor AI-workflows giver mening i drift, rapportering og kundeprocesser.
      </p>
    </aside>

    <div class="min-w-0">
      <h1 class="max-w-4xl font-display text-4xl font-semibold leading-[1.02] text-brand sm:text-5xl md:text-7xl">
        {useCase.title}
      </h1>
      <p class="mt-8 max-w-2xl text-xl leading-relaxed text-brand/70">
        {useCase.description}
      </p>

      <div class="mt-12 grid gap-4">
        {workflowBlocks.map(([title, text], index) => (
          <article class:list={[
            'rounded-[1.35rem] border p-5 md:p-6',
            title === 'Workflow' || title === 'Human approval' ? 'border-accent/25 bg-accent/10' : 'border-brand/10 bg-panel-soft',
          ]}>
            <div class="grid gap-4 md:grid-cols-[7rem_1fr]">
              <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent">{String(index + 1).padStart(2, '0')} / {title}</p>
              <p class="max-w-3xl text-base leading-relaxed text-brand/80 md:text-lg">{text}</p>
            </div>
          </article>
        ))}
      </div>

      <section class="mt-14">
        <h2 class="font-display text-3xl font-semibold leading-tight text-brand md:text-5xl">
          Gode signaler på at casen er værd at teste
        </h2>
        <div class="mt-7 grid gap-3 md:grid-cols-2">
          {useCase.signals.map((signal) => (
            <p class="rounded-[1rem] border border-brand/10 bg-panel-soft p-4 text-sm leading-relaxed text-brand/75">{signal}</p>
          ))}
        </div>
      </section>

      <section class="mt-16 rounded-[1.5rem] border border-brand/10 bg-panel-soft p-6 md:p-8">
        <h2 class="max-w-3xl font-display text-3xl font-semibold leading-tight text-brand md:text-5xl">
          Har I en version af den her proces?
        </h2>
        <p class="mt-5 max-w-2xl text-base leading-relaxed text-muted md:text-lg">
          Send en kort beskrivelse. Vi vurderer om den passer til en Manual Work Audit eller en mindre workflow-skitse først.
        </p>
        <div class="mt-10">
          <ScreeningForm
            sourcePage={useCase.path}
            title="Use case til vurdering"
            text="Beskriv jeres version af processen, og hvor ofte den gentager sig."
            submitLabel="Send use case"
            interest={useCase.title}
          />
        </div>
      </section>
    </div>
  </section>
</main>
