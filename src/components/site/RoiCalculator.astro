---
interface Props {
  id?: string;
}

const { id = 'roi-beregner' } = Astro.props;
---

<article id={id} class="rounded-[1.6rem] border border-brand/10 bg-panel p-5 shadow-soft md:p-7" data-roi-calculator>
  <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
    <div>
      <p class="font-mono text-xs uppercase tracking-[0.22em] text-accent">Tidsberegner</p>
      <h3 class="mt-4 max-w-xl font-display text-3xl font-semibold leading-tight text-brand md:text-5xl">
        Hvad koster det manuelle flow om året?
      </h3>
      <p class="mt-5 max-w-xl text-sm leading-relaxed text-muted md:text-base">
        Regnestykket er bevidst simpelt. Antal personer x timer pr. uge x intern timepris. Det er ofte nok til at se, om en Manual Work Audit er et lavrisiko første skridt.
      </p>
    </div>

    <div class="grid gap-5">
      <div class="grid gap-4 md:grid-cols-3">
        <label class="grid gap-2 text-sm font-medium text-brand">
          Personer
          <input data-roi-people type="number" min="1" value="4" inputmode="numeric" class="h-12 rounded-xl border border-brand/10 bg-canvas-soft px-4 text-base font-normal text-brand outline-none transition-colors focus:border-accent/70" />
        </label>
        <label class="grid gap-2 text-sm font-medium text-brand">
          Timer pr. uge
          <input data-roi-hours type="number" min="1" value="3" inputmode="decimal" class="h-12 rounded-xl border border-brand/10 bg-canvas-soft px-4 text-base font-normal text-brand outline-none transition-colors focus:border-accent/70" />
        </label>
        <label class="grid gap-2 text-sm font-medium text-brand">
          Intern timepris
          <input data-roi-rate type="number" min="100" step="50" value="650" inputmode="numeric" class="h-12 rounded-xl border border-brand/10 bg-canvas-soft px-4 text-base font-normal text-brand outline-none transition-colors focus:border-accent/70" />
        </label>
      </div>

      <div class="grid gap-4 rounded-[1.35rem] border border-accent/25 bg-accent/10 p-5 md:grid-cols-[1fr_0.9fr] md:items-end">
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent">Estimeret årligt spild</p>
          <p class="mt-3 font-display text-4xl font-semibold leading-none text-brand md:text-6xl" data-roi-output>358.800 kr.</p>
          <p class="mt-3 text-sm leading-relaxed text-muted" data-roi-detail>4 personer bruger 3 timer pr. uge til 650 kr. i 46 arbejdsuger.</p>
        </div>
        <div class="rounded-[1rem] border border-brand/10 bg-canvas-soft p-4">
          <p class="font-mono text-xs uppercase tracking-[0.18em] text-muted">Audit som første skridt</p>
          <p class="mt-3 text-sm leading-relaxed text-brand/75">
            Hvis flowet gentages hver uge, er første opgave ikke at vælge AI-værktøj. Først skal arbejdet kortlægges, forenkles og prioriteres.
          </p>
          <a href="/manual-work-audit" class="mt-4 inline-flex text-sm font-semibold text-accent underline decoration-accent/30 underline-offset-4 hover:text-brand">
            Se Manual Work Audit
          </a>
        </div>
      </div>
    </div>
  </div>
</article>

<script is:inline>
  (function() {
    var calculators = document.querySelectorAll('[data-roi-calculator]');
    if (!calculators.length) return;

    var formatter = new Intl.NumberFormat('da-DK', {
      style: 'currency',
      currency: 'DKK',
      maximumFractionDigits: 0,
    });

    calculators.forEach(function(calculator) {
      var peopleInput = calculator.querySelector('[data-roi-people]');
      var hoursInput = calculator.querySelector('[data-roi-hours]');
      var rateInput = calculator.querySelector('[data-roi-rate]');
      var output = calculator.querySelector('[data-roi-output]');
      var detail = calculator.querySelector('[data-roi-detail]');

      function readNumber(input, fallback) {
        if (!(input instanceof HTMLInputElement)) return fallback;
        var value = Number(input.value);
        return Number.isFinite(value) && value > 0 ? value : fallback;
      }

      function update() {
        var people = readNumber(peopleInput, 1);
        var hours = readNumber(hoursInput, 1);
        var rate = readNumber(rateInput, 500);
        var weeks = 46;
        var annualWaste = people * hours * rate * weeks;

        if (output) {
          output.textContent = formatter.format(annualWaste).replace(',00', '');
        }
        if (detail) {
          detail.textContent = people + ' personer bruger ' + hours + ' timer pr. uge til ' + formatter.format(rate).replace(',00', '') + ' i ' + weeks + ' arbejdsuger.';
        }
      }

      [peopleInput, hoursInput, rateInput].forEach(function(input) {
        if (input) input.addEventListener('input', update);
      });

      update();
    });
  })();
</script>
