---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'text';
  size?: 'sm' | 'md';
  class?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  class: className = '',
} = Astro.props;

const baseClass =
  'inline-flex items-center justify-center gap-2 font-semibold transition duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand active:translate-y-px';

const sizeClass = {
  sm: 'px-4 py-2.5 text-sm',
  md: 'px-6 py-3.5 text-sm',
};

const variantClass = {
  primary: 'border border-brand bg-brand text-white hover:bg-brand-light hover:border-brand-light',
  secondary: 'border border-brand/14 bg-transparent text-brand hover:border-brand/35 hover:bg-white',
  text: 'border border-transparent bg-transparent px-0 text-brand/72 hover:text-brand',
};

const classes = [baseClass, sizeClass[size], variantClass[variant], className];
---

{href ? (
  <a href={href} class:list={classes}>
    <slot />
  </a>
) : (
  <button type="button" class:list={classes}>
    <slot />
  </button>
)}
