---
interface Props {
  before: string;
  after: string;
  effect: string;
  index?: number;
}

const { before, after, effect, index = 1 } = Astro.props;
---

<article class="grid h-full gap-4 rounded-[1.35rem] border border-brand/10 bg-panel-soft p-5 transition duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] hover:border-accent/35 hover:bg-panel md:p-6">
  <div class="flex items-start justify-between gap-4">
    <p class="font-mono text-[0.7rem] uppercase tracking-[0.2em] text-accent">Example {String(index).padStart(2, '0')}</p>
    <span class="rounded-lg border border-brand/10 px-2.5 py-1 font-mono text-[0.66rem] uppercase tracking-[0.14em] text-brand/48">Before / after</span>
  </div>
  <div class="grid gap-3">
    <div class="rounded-xl border border-brand/10 bg-canvas/60 p-4">
      <p class="font-mono text-[0.68rem] uppercase tracking-[0.18em] text-brand/42">Before</p>
      <p class="mt-2 text-sm leading-relaxed text-brand/72">{before}</p>
    </div>
    <div class="rounded-xl border border-accent/24 bg-accent/10 p-4">
      <p class="font-mono text-[0.68rem] uppercase tracking-[0.18em] text-accent">After</p>
      <p class="mt-2 text-sm leading-relaxed text-brand/78">{after}</p>
    </div>
  </div>
  <p class="border-t border-brand/10 pt-4 text-sm font-semibold leading-relaxed text-brand">{effect}</p>
</article>
