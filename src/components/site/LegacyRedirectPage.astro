---
interface Props {
  destination: string;
  label: string;
}

const { destination, label } = Astro.props;
---

<main id="main" class="bg-canvas text-brand">
  <section class="mx-auto grid min-h-[70dvh] max-w-4xl content-center px-5 py-16 sm:px-6 md:py-24">
    <p class="font-mono text-xs uppercase tracking-[0.22em] text-accent">Legacy URL</p>
    <h1 class="mt-5 font-display text-4xl font-semibold leading-[1.04] text-brand md:text-6xl">
      This page has moved.
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-brand/70">
      SiteDokAI is now an English AI operations practice. The current page is <a href={destination} class="font-semibold text-brand underline decoration-brand/30 underline-offset-4">{label}</a>.
    </p>
    <div class="mt-9">
      <a href={destination} class="inline-flex min-h-12 items-center justify-center rounded-xl border border-accent/50 bg-accent px-6 py-3 text-sm font-semibold text-canvas transition-colors hover:bg-accent-bright focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent active:translate-y-px">
        Go to {label}
      </a>
    </div>
  </section>
</main>
