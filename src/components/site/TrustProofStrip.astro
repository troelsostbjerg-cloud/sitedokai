---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

const proofs = [
  {
    title: 'Se før du køber',
    text: 'Du får et konkret eksempel på formatet: kort vurdering, 3 observationer og anbefalet næste skridt.',
    icon: 'preview',
  },
  {
    title: 'Ingen binding',
    text: 'Mini-tjekket er gratis. Hvis der ikke er et oplagt næste skridt, siger vi det direkte.',
    icon: 'check',
  },
  {
    title: 'Svar inden 1-2 hverdage',
    text: 'Du får en manuel første vurdering, ikke et automatisk standardsvar.',
    icon: 'clock',
  },
  {
    title: 'Ægte tillid først',
    text: 'Kundeudtalelser, anmeldelser og cases bliver kun vist, når de er ægte.',
    icon: 'trust',
  },
];
---

<section class:list={['mx-auto max-w-[1480px] px-4 sm:px-6 lg:px-10', className]} aria-label="Tryghed før gratis mini-tjek">
  <div class="rounded-[1.35rem] border border-border-soft bg-white/64 px-4 py-4 shadow-soft backdrop-blur-sm md:px-5">
    <div class="grid gap-3 md:grid-cols-2 xl:grid-cols-4">
      {proofs.map((proof) => (
        <article class="grid grid-cols-[2.75rem_1fr] gap-3 rounded-[1rem] border border-transparent px-3 py-3 transition duration-200 hover:border-accent/18 hover:bg-accent-soft/40">
          <span class="flex h-11 w-11 items-center justify-center rounded-[0.85rem] border border-accent/18 bg-accent-soft/78 text-accent-dark">
            {proof.icon === 'preview' && (
              <svg viewBox="0 0 28 28" class="h-6 w-6" fill="none" aria-hidden="true">
                <path d="M7 5.5h14v17H7v-17Z" stroke="currentColor" stroke-width="1.45" stroke-linejoin="round" />
                <path d="M10 10h8M10 14h8M10 18h5" stroke="currentColor" stroke-width="1.45" stroke-linecap="round" />
              </svg>
            )}
            {proof.icon === 'check' && (
              <svg viewBox="0 0 28 28" class="h-6 w-6" fill="none" aria-hidden="true">
                <path d="m8.2 14.4 3.7 3.7 8-8.4" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round" />
                <circle cx="14" cy="14" r="9.2" stroke="currentColor" stroke-width="1.25" opacity="0.48" />
              </svg>
            )}
            {proof.icon === 'clock' && (
              <svg viewBox="0 0 28 28" class="h-6 w-6" fill="none" aria-hidden="true">
                <circle cx="14" cy="14" r="8.7" stroke="currentColor" stroke-width="1.45" />
                <path d="M14 9.2V14l3.2 2.4" stroke="currentColor" stroke-width="1.45" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            )}
            {proof.icon === 'trust' && (
              <svg viewBox="0 0 28 28" class="h-6 w-6" fill="none" aria-hidden="true">
                <path d="M14 5.2 21.2 8v5.6c0 4.5-2.8 8.2-7.2 9.4-4.4-1.2-7.2-4.9-7.2-9.4V8L14 5.2Z" stroke="currentColor" stroke-width="1.45" stroke-linejoin="round" />
                <path d="M10.6 14.1h6.8M11.8 17h4.4" stroke="currentColor" stroke-width="1.45" stroke-linecap="round" />
              </svg>
            )}
          </span>
          <div>
            <h3 class="font-display text-xl font-medium leading-tight tracking-tight text-brand">{proof.title}</h3>
            <p class="mt-1 text-sm leading-relaxed text-muted">{proof.text}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

