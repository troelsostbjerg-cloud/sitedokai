---
import AuditOutputMockup from './AuditOutputMockup.astro';
import OperationsWorkflowCockpit from './OperationsWorkflowCockpit.astro';

const proofCards = [
  ['AI-readable structure', 'Sitemap, schema, llms.txt and clear service pages make the site easier to understand and cite.'],
  ['Founder experience', '10+ years in operations, supply chain and process improvement.'],
  ['No invented metrics', 'No invented customer logos, testimonials, revenue numbers or performance claims.'],
];
---

<section id="proof" class="border-y border-brand/10 bg-canvas-soft px-5 py-16 sm:px-6 md:py-24">
  <div class="mx-auto max-w-7xl">
    <div class="grid gap-10 lg:grid-cols-[0.72fr_1.28fr]">
      <aside>
        <p class="font-mono text-xs uppercase tracking-[0.22em] text-accent">Proof layer</p>
        <h2 class="mt-5 max-w-xl font-display text-4xl font-semibold leading-[1.02] text-brand md:text-6xl">
          Proof without inflated claims.
        </h2>
        <p class="mt-6 max-w-xl text-base leading-relaxed text-brand/70 md:text-lg">
          SiteDokAI does not invent customer logos, testimonials or results. Until there are public client cases, the proof is in the operating model: clear service pages, workflow examples, audit outputs, AI-readable documentation and practical implementation logic.
        </p>
      </aside>

      <div class="grid gap-5">
        <AuditOutputMockup />
        <OperationsWorkflowCockpit />
        <div class="grid gap-4 md:grid-cols-3">
          {proofCards.map(([title, text]) => (
            <article class="rounded-[1.2rem] border border-brand/10 bg-panel-soft p-5">
              <h3 class="text-lg font-semibold text-brand">{title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-brand/66">{text}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
