---
import type { ServiceOffer } from '../../data/aiContent';

interface Props {
  service: ServiceOffer;
}

const { service } = Astro.props;
---

<article class:list={[
  'flex h-full flex-col rounded-[1.45rem] border p-5 md:p-6',
  service.recommended ? 'border-accent/34 bg-[linear-gradient(145deg,rgba(220,232,223,0.74),rgba(255,250,241,0.96))] shadow-soft' : 'border-brand/10 bg-panel-soft',
]}>
  <div>
    <div class="flex flex-wrap items-center justify-between gap-3">
      <p class="font-mono text-[0.68rem] uppercase tracking-[0.2em] text-accent">{service.eyebrow}</p>
      {service.recommended && (
        <span class="rounded-lg border border-accent/25 bg-canvas/70 px-2.5 py-1 font-mono text-[0.64rem] uppercase tracking-[0.14em] text-accent">
          First step
        </span>
      )}
    </div>
    <h3 class="mt-5 text-2xl font-semibold leading-tight text-brand">{service.name}</h3>
    <div class="mt-5 grid grid-cols-2 gap-3 border-y border-brand/10 py-4">
      <div>
        <p class="font-mono text-[0.66rem] uppercase tracking-[0.16em] text-brand/42">Price</p>
        <p class="mt-1 text-sm font-semibold leading-relaxed text-brand">{service.priceLabel}</p>
      </div>
      <div>
        <p class="font-mono text-[0.66rem] uppercase tracking-[0.16em] text-brand/42">Duration</p>
        <p class="mt-1 text-sm font-semibold leading-relaxed text-brand">{service.duration}</p>
      </div>
    </div>
    <p class="mt-5 text-sm leading-relaxed text-brand/72">{service.bestFor}</p>
  </div>

  <div class="mt-6 grid gap-5">
    <div>
      <p class="font-mono text-[0.68rem] uppercase tracking-[0.18em] text-brand/42">Output</p>
      <ul class="mt-3 grid gap-2 text-sm leading-relaxed text-brand/72">
        {service.outputs.slice(0, 5).map((item) => (
          <li class="border-t border-brand/10 pt-2">{item}</li>
        ))}
      </ul>
    </div>
    <div>
      <p class="font-mono text-[0.68rem] uppercase tracking-[0.18em] text-brand/42">Not included</p>
      <p class="mt-3 text-sm leading-relaxed text-brand/62">{service.notIncluded.join('. ')}.</p>
    </div>
  </div>

  <div class="mt-auto pt-7">
    <p class="mb-4 text-sm leading-relaxed text-brand/70">{service.nextStep}</p>
    <a href={service.path} class="inline-flex min-h-12 w-full items-center justify-center rounded-xl border border-accent/50 bg-accent px-5 py-3 text-center text-sm font-semibold text-canvas transition-colors hover:border-accent-bright hover:bg-accent-bright focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent active:translate-y-px">
      {service.ctaLabel}
    </a>
  </div>
</article>
