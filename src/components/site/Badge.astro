---
interface Props {
  tone?: 'sage' | 'plain';
  class?: string;
}

const { tone = 'sage', class: className = '' } = Astro.props;

const toneClass = {
  sage: 'border-accent/18 bg-accent-soft/72 text-accent-dark',
  plain: 'border-brand/12 bg-white/70 text-brand/68',
};
---

<span
  class:list={[
    'inline-flex items-center gap-2 rounded-[0.85rem] border px-3.5 py-2 text-sm leading-none',
    toneClass[tone],
    className,
  ]}
>
  <slot />
</span>
