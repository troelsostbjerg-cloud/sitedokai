---
interface Props {
  href?: string;
  label?: string;
}

const { href = '/contact#workflow-screening', label = 'Send your workflow' } = Astro.props;
---

<div class="fixed inset-x-0 bottom-0 z-30 border-t border-brand/10 bg-canvas/94 px-4 py-3 shadow-[0_-14px_40px_rgba(42,35,24,0.10)] backdrop-blur lg:hidden">
  <a href={href} class="mx-auto flex min-h-12 max-w-md items-center justify-center rounded-xl border border-accent/50 bg-accent px-5 py-3 text-center text-sm font-semibold text-canvas transition-colors hover:bg-accent-bright focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent active:translate-y-px">
    {label}
  </a>
</div>
