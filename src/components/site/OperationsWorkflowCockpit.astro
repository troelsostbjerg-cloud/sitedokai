---
const inputs = ['Emails', 'Spreadsheet rows', 'CRM notes', 'Meeting notes'];
const assistance = ['Summarize', 'Classify', 'Extract actions', 'Identify missing information', 'Draft next step'];
const outputs = ['Status report', 'Action list', 'Reply draft', 'Handover brief', 'Decision note'];
const metrics = ['Time saved', 'Fewer follow-ups', 'Clearer ownership', 'Faster decisions'];
---

<figure class="relative overflow-hidden rounded-[1.75rem] border border-brand/10 bg-[linear-gradient(145deg,rgba(255,250,241,0.96),rgba(235,227,214,0.72))] p-4 shadow-soft md:p-6" aria-label="Operations Workflow Cockpit mockup">
  <div class="absolute inset-0 bg-[linear-gradient(rgba(30,38,31,0.045)_1px,transparent_1px),linear-gradient(90deg,rgba(30,38,31,0.045)_1px,transparent_1px)] bg-[size:34px_34px]" aria-hidden="true"></div>
  <div class="relative">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-brand/10 pb-4">
      <div>
        <p class="font-mono text-[0.68rem] uppercase tracking-[0.2em] text-accent">Operations Workflow Cockpit</p>
        <p class="mt-2 text-sm leading-relaxed text-brand/68">Input to approval to output to measurement.</p>
      </div>
      <div class="rounded-xl border border-accent/25 bg-accent/10 px-3 py-2 font-mono text-[0.68rem] uppercase tracking-[0.16em] text-accent">
        Human approved
      </div>
    </div>

    <div class="mt-5 grid gap-3 md:grid-cols-2">
      <section class="rounded-[1.2rem] border border-brand/10 bg-panel/78 p-4">
        <p class="font-mono text-[0.68rem] uppercase tracking-[0.18em] text-brand/48">Input</p>
        <div class="mt-4 grid gap-2">
          {inputs.map((item) => (
            <p class="rounded-lg border border-brand/10 bg-canvas/70 px-3 py-2 text-sm font-medium text-brand/76">{item}</p>
          ))}
        </div>
      </section>

      <section class="rounded-[1.2rem] border border-accent/22 bg-accent/10 p-4">
        <p class="font-mono text-[0.68rem] uppercase tracking-[0.18em] text-accent">AI assistance</p>
        <div class="mt-4 grid gap-2 sm:grid-cols-2">
          {assistance.map((item, index) => (
            <p class:list={[
              'rounded-lg border px-3 py-2 text-sm font-medium',
              index === assistance.length - 1 ? 'border-accent/35 bg-canvas/80 text-brand' : 'border-accent/20 bg-canvas/55 text-brand/72',
            ]}>
              {item}
            </p>
          ))}
        </div>
      </section>

      <section class="rounded-[1.2rem] border border-brand/10 bg-panel/78 p-4">
        <p class="font-mono text-[0.68rem] uppercase tracking-[0.18em] text-brand/48">Approval</p>
        <div class="mt-4 rounded-xl border border-brand/10 bg-canvas/70 p-4">
          <p class="text-sm font-semibold text-brand">Review, edit, approve</p>
          <p class="mt-3 text-sm leading-relaxed text-brand/62">People stay responsible where tone, risk, quality or decisions matter.</p>
        </div>
      </section>

      <section class="rounded-[1.2rem] border border-brand/10 bg-panel/78 p-4">
        <p class="font-mono text-[0.68rem] uppercase tracking-[0.18em] text-brand/48">Output</p>
        <div class="mt-4 grid gap-2">
          {outputs.map((item) => (
            <p class="rounded-lg border border-brand/10 bg-canvas/70 px-3 py-2 text-sm font-medium text-brand/76">{item}</p>
          ))}
        </div>
      </section>
    </div>

    <div class="mt-3 grid gap-3 sm:grid-cols-2">
      {metrics.map((item) => (
        <div class="rounded-xl border border-brand/10 bg-brand/[0.04] px-4 py-3">
          <p class="font-mono text-[0.66rem] uppercase tracking-[0.16em] text-brand/42">Metric</p>
          <p class="mt-1 text-sm font-semibold text-brand">{item}</p>
        </div>
      ))}
    </div>
  </div>
</figure>
