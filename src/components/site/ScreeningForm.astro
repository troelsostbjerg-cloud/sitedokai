---
interface Props {
  sourcePage?: string;
  title?: string;
  text?: string;
  submitLabel?: string;
  interest?: string;
}

const {
  sourcePage = Astro.url.pathname,
  title = 'Workflow til vurdering',
  text = 'Skriv kort hvad I bruger for meget tid på. Vi svarer med en nøgtern vurdering af, om det egner sig til en AI-workflow.',
  submitLabel = 'Send workflow',
  interest = 'Manual Work Audit',
} = Astro.props;

const contactEmail = 'info@sitedokai.com';
const formAction = `https://formsubmit.co/${contactEmail}`;
const ajaxAction = `https://formsubmit.co/ajax/${contactEmail}`;
const nextUrl = 'https://sitedokai.com/tak-for-henvendelsen?type=workflow';
const directMailto = `mailto:${contactEmail}?subject=${encodeURIComponent('Workflow til SiteDokAI')}&body=${encodeURIComponent(`Hej SiteDokAI,

Jeg vil gerne høre om en manuel proces, der måske kan blive til en praktisk AI-workflow.

Navn:
Firma:
Hjemmeside:
Workflow der irriterer os:
Hvor ofte sker det:
Værktøjer vi bruger i dag:
Hvem er involveret:
Hvad går galt i dag:
Godt output ville være:

Tak.`)}`;
---

<form
  action={formAction}
  method="POST"
  data-ajax-email-form
  data-ajax-action={ajaxAction}
  data-lead-backup-action="/api/leads"
  data-lead-type="workflow"
  data-pending-label="Sender..."
  class="grid gap-5 border-t border-brand/10 pt-7"
>
  <input type="hidden" name="_subject" value="Ny workflow-henvendelse fra sitedokai.com" />
  <input type="hidden" name="_template" value="table" />
  <input type="hidden" name="_captcha" value="false" />
  <input type="hidden" name="_next" value={nextUrl} />
  <input type="hidden" name="source_page" value={sourcePage} />
  <input type="hidden" name="interest" value={interest} />
  <input type="text" name="_honey" tabindex="-1" autocomplete="off" class="hidden" />

  <div>
    <p class="text-sm font-semibold text-brand">{title}</p>
    <p class="mt-2 max-w-xl text-sm leading-relaxed text-muted">{text}</p>
  </div>

  <noscript>
    <p class="rounded-xl border border-brand/10 bg-panel-soft px-4 py-3 text-sm leading-relaxed text-brand/75">
      Formularen virker bedst med JavaScript. Du kan også sende direkte til <a href={directMailto} class="font-semibold underline decoration-brand/30 underline-offset-4">info@sitedokai.com</a>.
    </p>
  </noscript>

  <div class="grid gap-4 md:grid-cols-2">
    <label class="grid gap-2 text-sm font-medium text-brand">
      Navn
      <input required type="text" name="name" autocomplete="name" class="h-12 rounded-xl border border-brand/10 bg-panel-soft px-4 text-base font-normal text-brand outline-none transition-colors placeholder:text-muted/50 focus:border-accent/70" />
    </label>

    <label class="grid gap-2 text-sm font-medium text-brand">
      Email
      <input required type="email" name="email" autocomplete="email" class="h-12 rounded-xl border border-brand/10 bg-panel-soft px-4 text-base font-normal text-brand outline-none transition-colors placeholder:text-muted/50 focus:border-accent/70" />
    </label>
  </div>

  <div class="grid gap-4 md:grid-cols-[1.1fr_0.9fr]">
    <label class="grid gap-2 text-sm font-medium text-brand">
      Hjemmeside
      <input type="text" name="website" inputmode="url" autocomplete="url" autocapitalize="none" spellcheck="false" placeholder="dinvirksomhed.dk" class="h-12 rounded-xl border border-brand/10 bg-panel-soft px-4 text-base font-normal text-brand outline-none transition-colors placeholder:text-muted/50 focus:border-accent/70" />
    </label>

    <label class="grid gap-2 text-sm font-medium text-brand">
      Firma
      <input type="text" name="company" autocomplete="organization" class="h-12 rounded-xl border border-brand/10 bg-panel-soft px-4 text-base font-normal text-brand outline-none transition-colors placeholder:text-muted/50 focus:border-accent/70" />
    </label>
  </div>

  <label class="grid gap-2 text-sm font-medium text-brand">
    Hvilket workflow irriterer jer mest?
    <textarea required name="workflow" rows="5" placeholder="Fx statusmails, rapporter, kundehenvendelser, handovers eller opfølgninger der hele tiden skal jagtes manuelt." class="min-h-36 resize-y rounded-xl border border-brand/10 bg-panel-soft px-4 py-3 text-base font-normal leading-relaxed text-brand outline-none transition-colors placeholder:text-muted/50 focus:border-accent/70"></textarea>
  </label>

  <div class="grid gap-4 md:grid-cols-2">
    <label class="grid gap-2 text-sm font-medium text-brand">
      Hvor ofte sker det?
      <select name="frequency" class="h-12 rounded-xl border border-brand/10 bg-panel-soft px-4 text-base font-normal text-brand outline-none transition-colors focus:border-accent/70">
        <option value="">Vælg frekvens</option>
        <option value="dagligt">Dagligt</option>
        <option value="ugentligt">Ugentligt</option>
        <option value="månedligt">Månedligt</option>
        <option value="ved ikke">Ved ikke</option>
      </select>
    </label>

    <label class="grid gap-2 text-sm font-medium text-brand">
      Hvilke værktøjer bruger I i dag?
      <input type="text" name="current_tools" placeholder="Fx Excel, Teams, CRM, SharePoint, Outlook" class="h-12 rounded-xl border border-brand/10 bg-panel-soft px-4 text-base font-normal text-brand outline-none transition-colors placeholder:text-muted/50 focus:border-accent/70" />
    </label>
  </div>

  <div class="grid gap-4 md:grid-cols-2">
    <label class="grid gap-2 text-sm font-medium text-brand">
      Hvem er involveret?
      <input type="text" name="involved_people" placeholder="Fx operations, finance, kundeservice, ledelse" class="h-12 rounded-xl border border-brand/10 bg-panel-soft px-4 text-base font-normal text-brand outline-none transition-colors placeholder:text-muted/50 focus:border-accent/70" />
    </label>

    <label class="grid gap-2 text-sm font-medium text-brand">
      Hvad går galt i dag?
      <input type="text" name="current_failure" placeholder="Fx fejl, ventetid, dobbeltarbejde, uklart ejerskab" class="h-12 rounded-xl border border-brand/10 bg-panel-soft px-4 text-base font-normal text-brand outline-none transition-colors placeholder:text-muted/50 focus:border-accent/70" />
    </label>
  </div>

  <label class="grid gap-2 text-sm font-medium text-brand">
    Hvad ville et godt output være?
    <textarea name="desired_output" rows="3" placeholder="Fx én status med actions, ansvarlige, deadlines og beslutninger." class="min-h-28 resize-y rounded-xl border border-brand/10 bg-panel-soft px-4 py-3 text-base font-normal leading-relaxed text-brand outline-none transition-colors placeholder:text-muted/50 focus:border-accent/70"></textarea>
  </label>

  <div>
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
      <button type="submit" data-ajax-submit class="inline-flex h-12 items-center justify-center rounded-xl border border-accent/50 bg-accent px-6 text-sm font-semibold text-canvas transition-colors hover:bg-accent-bright focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent active:translate-y-px disabled:cursor-wait disabled:opacity-70">
        {submitLabel}
      </button>
      <a href={directMailto} class="inline-flex h-12 items-center justify-center rounded-xl border border-brand/20 bg-transparent px-6 text-sm font-semibold text-brand transition-colors hover:border-brand/30 hover:bg-panel-soft focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent active:translate-y-px">
        Send direkte mail
      </a>
    </div>

    <p data-ajax-form-pending hidden aria-live="polite" class="mt-4 rounded-xl border border-brand/10 bg-panel-soft px-4 py-3 text-sm leading-relaxed text-brand/75">
      Sender din henvendelse...
    </p>
    <p data-ajax-form-success hidden aria-live="polite" class="mt-4 rounded-xl border border-brand/10 bg-panel-soft px-4 py-3 text-sm leading-relaxed text-brand/75">
      Tak. Vi har modtaget dit workflow og vender tilbage med et roligt næste skridt.
    </p>
    <p data-ajax-form-error hidden aria-live="polite" data-default-error="Der skete en fejl. Prøv igen, eller skriv direkte til info@sitedokai.com." class="mt-4 rounded-xl border border-[#ff8c8c]/40 bg-[#ff8c8c]/10 px-4 py-3 text-sm leading-relaxed text-brand">
      Der skete en fejl. Prøv igen, eller skriv direkte til info@sitedokai.com.
    </p>
    <p class="mt-4 text-xs leading-relaxed text-muted">
      Vi svarer med en nøgtern vurdering, også hvis AI ikke er første skridt. Du kan også skrive direkte til <a href={directMailto} class="font-semibold text-brand underline decoration-brand/30 underline-offset-4">info@sitedokai.com</a>.
    </p>
  </div>
</form>
