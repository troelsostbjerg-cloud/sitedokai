---
interface Props {
  icon: 'clarity' | 'trust' | 'visibility';
  title: string;
  text: string;
}

const { icon, title, text } = Astro.props;
---

<article class="group rounded-[1.25rem] border border-border-soft bg-white/72 p-5 shadow-soft transition duration-200 hover:-translate-y-0.5 hover:border-accent/28 hover:bg-white md:p-6">
  <div class="flex gap-4">
    <span class="flex h-14 w-14 flex-shrink-0 items-center justify-center rounded-full border border-accent/20 bg-accent-soft text-accent-dark">
      {icon === 'clarity' && (
        <svg viewBox="0 0 32 32" class="h-7 w-7" fill="none" aria-hidden="true">
          <path d="M7 18c4.8-8.2 10.9-11 18-11-1 7.1-4 13.1-12.3 17.7" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M18.6 13.4 8 24M13.8 18.2l-5.8-.1.1 5.8" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      )}
      {icon === 'trust' && (
        <svg viewBox="0 0 32 32" class="h-7 w-7" fill="none" aria-hidden="true">
          <path d="M16 5.5 24 8v6.7c0 5.2-3.1 9.8-8 11.8-4.9-2-8-6.6-8-11.8V8l8-2.5Z" stroke="currentColor" stroke-width="1.55" stroke-linejoin="round" />
          <path d="m12.3 16 2.4 2.5 5-5.3" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      )}
      {icon === 'visibility' && (
        <svg viewBox="0 0 32 32" class="h-7 w-7" fill="none" aria-hidden="true">
          <path d="M7 24V14h5v10H7ZM14 24V8h5v16h-5ZM21 24V11h5v13h-5Z" stroke="currentColor" stroke-width="1.55" stroke-linejoin="round" />
          <path d="M5 24.5h23" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" />
        </svg>
      )}
    </span>
    <div>
      <h3 class="font-display text-[1.45rem] font-medium leading-tight text-brand">{title}</h3>
      <p class="mt-1.5 max-w-[22rem] text-base leading-snug text-muted">{text}</p>
    </div>
  </div>
</article>
