---
interface Props {
  step: number;
  title: string;
  text?: string;
}

const { step, title, text } = Astro.props;
---

<article class="flex min-h-28 items-start gap-4 rounded-[1.25rem] border border-border-soft bg-surface/76 p-5 shadow-soft md:p-6">
  <span class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full border border-accent/20 bg-accent-soft font-mono text-sm font-semibold text-accent-dark">
    {step}
  </span>
  <div>
    <h3 class="font-display text-2xl font-medium leading-tight tracking-tight text-brand">{title}</h3>
    {text && <p class="mt-2 text-sm leading-relaxed text-muted">{text}</p>}
  </div>
</article>
