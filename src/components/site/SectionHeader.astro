---
interface Props {
  label: string;
  title?: string;
  text?: string;
  align?: 'center' | 'left';
  uppercase?: boolean;
  class?: string;
}

const {
  label,
  title,
  text,
  align = 'center',
  uppercase = true,
  class: className = '',
} = Astro.props;

const isCenter = align === 'center';
---

<div class:list={[isCenter ? 'mx-auto text-center' : '', className]}>
  <div class:list={['flex items-center gap-6', isCenter ? 'justify-center' : 'justify-start']}>
    {isCenter && <span class="hidden h-px w-48 max-w-[24vw] bg-border-soft sm:block"></span>}
    <p
      class:list={[
        'font-semibold text-brand/72',
        uppercase ? 'text-xs uppercase tracking-[0.28em]' : 'text-sm tracking-[0.12em] md:text-base',
      ]}
    >
      {label}
    </p>
    {isCenter && <span class="hidden h-px w-48 max-w-[24vw] bg-border-soft sm:block"></span>}
  </div>
  {title && (
    <h2 class:list={['mt-5 font-display text-3xl font-medium leading-[1.04] tracking-tight text-brand md:text-5xl', isCenter ? 'mx-auto max-w-3xl' : 'max-w-3xl']}>
      {title}
    </h2>
  )}
  {text && (
    <p class:list={['mt-4 text-base leading-relaxed text-muted md:text-lg', isCenter ? 'mx-auto max-w-2xl' : 'max-w-2xl']}>
      {text}
    </p>
  )}
</div>
