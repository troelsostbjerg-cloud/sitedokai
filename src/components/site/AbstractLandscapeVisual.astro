---
interface ProblemCard {
  title: string;
  text: string;
  icon: 'message' | 'shield' | 'search';
  position: string;
}

interface Props {
  problemCards?: ProblemCard[];
}

const defaultProblemCards: ProblemCard[] = [
  {
    title: 'Uklart budskab',
    text: 'Kunden forstår dig ikke hurtigt',
    icon: 'message',
    position: 'left-[5%] top-[9%] md:left-[14%] md:top-[8%]',
  },
  {
    title: 'Tillid kan styrkes',
    text: 'Siden virker ikke helt tryg',
    icon: 'shield',
    position: 'left-[5%] top-[39%] md:left-[3%] md:top-[39%]',
  },
  {
    title: 'Svær at forstå i Google',
    text: 'Struktur og signaler er uklare',
    icon: 'search',
    position: 'right-[5%] bottom-[9%] md:right-[3%] md:bottom-[11%]',
  },
];

const { problemCards = defaultProblemCards } = Astro.props;
---

<div class="relative min-h-[340px] min-w-0 max-w-full overflow-hidden md:min-h-[450px] md:overflow-visible" aria-label="Abstrakt grønt landskab med typiske website-problemer">
  <div class="absolute inset-[-8%] rounded-[2rem] bg-[radial-gradient(circle_at_54%_8%,rgba(255,255,255,0.72),transparent_34%),radial-gradient(circle_at_76%_70%,rgba(111,138,114,0.16),transparent_42%)]"></div>
  <svg class="absolute inset-x-0 bottom-0 h-full w-full opacity-[0.82] [mask-image:radial-gradient(ellipse_at_62%_58%,black_0%,black_56%,transparent_86%)]" viewBox="0 0 760 520" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <defs>
      <linearGradient id="hillA" x1="0" x2="1" y1="0" y2="1">
        <stop offset="0%" stop-color="#eef4eb" />
        <stop offset="58%" stop-color="#cdd9ca" />
        <stop offset="100%" stop-color="#8fa08d" />
      </linearGradient>
      <linearGradient id="hillB" x1="0" x2="1" y1="0" y2="1">
        <stop offset="0%" stop-color="#f7faf4" />
        <stop offset="64%" stop-color="#d6e0d2" />
        <stop offset="100%" stop-color="#9cac98" />
      </linearGradient>
      <linearGradient id="mountain" x1="0" x2="0.8" y1="0" y2="1">
        <stop offset="0%" stop-color="#a5b5a6" stop-opacity="0.92" />
        <stop offset="100%" stop-color="#e7eee3" stop-opacity="0.15" />
      </linearGradient>
      <filter id="soften" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="0.8" />
      </filter>
    </defs>
    <path d="M-30 284c94-26 171-21 270 18 95 38 184 57 286 10 76-35 146-53 264-39l4 84c-118-10-198 11-282 43-104 40-220 33-332-12-92-37-152-39-214-16Z" fill="url(#hillB)" opacity="0.58" />
    <path d="M-35 354c130-61 248-70 372-18 114 48 240 64 456-26l4 118c-188 64-322 79-462 29-127-46-244-40-370 13Z" fill="url(#hillA)" opacity="0.72" />
    <path d="M-30 426c112-62 210-72 330-24 158 64 290 43 492-28l3 95c-180 52-330 67-492 21-128-36-220-29-333 28Z" fill="#7f927c" opacity="0.25" />
    <path d="M425 178 506 72l76 134 53-68 96 163H360Z" fill="url(#mountain)" opacity="0.42" filter="url(#soften)" />
    <path d="M506 72 486 169l35-27 37 64 24-33-76-101Z" fill="#ffffff" opacity="0.42" />
    <path d="M-40 306c157-42 278-34 408 24 138 61 246 41 444-47" stroke="#ffffff" stroke-opacity="0.44" stroke-width="4" fill="none" />
    <path d="M-20 398c115-48 235-47 375 2 120 42 246 31 432-31" stroke="#f9fbf7" stroke-opacity="0.46" stroke-width="3" fill="none" />
    <path d="M112 446c124-35 246-27 365 13" stroke="#5e765f" stroke-opacity="0.1" stroke-width="2" fill="none" />
  </svg>
  {problemCards.map((card) => (
    <article class:list={['absolute w-[min(17.5rem,82vw)] rounded-[1.05rem] border border-border-soft/80 bg-white/74 p-3.5 shadow-[0_12px_30px_rgba(32,38,34,0.055)] backdrop-blur-sm', card.position]}>
      <div class="flex items-center gap-3.5">
        <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full border border-accent/18 bg-accent-soft/76 text-accent-dark">
          {card.icon === 'message' && (
            <svg viewBox="0 0 28 28" class="h-6 w-6" fill="none" aria-hidden="true">
              <path d="M7 8.5h14v9H12l-5 4v-13Z" stroke="currentColor" stroke-width="1.45" stroke-linejoin="round" />
              <path d="M11 12.5h6M11 15h4" stroke="currentColor" stroke-width="1.45" stroke-linecap="round" />
            </svg>
          )}
          {card.icon === 'shield' && (
            <svg viewBox="0 0 28 28" class="h-6 w-6" fill="none" aria-hidden="true">
              <path d="M14 5.5 21 8v5.7c0 4.3-2.7 8.1-7 9.8-4.3-1.7-7-5.5-7-9.8V8l7-2.5Z" stroke="currentColor" stroke-width="1.45" stroke-linejoin="round" />
              <path d="m10.8 14.2 2.1 2.1 4.5-4.7" stroke="currentColor" stroke-width="1.45" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          )}
          {card.icon === 'search' && (
            <svg viewBox="0 0 28 28" class="h-6 w-6" fill="none" aria-hidden="true">
              <circle cx="12.5" cy="12.5" r="6.5" stroke="currentColor" stroke-width="1.45" />
              <path d="m17.3 17.3 5 5" stroke="currentColor" stroke-width="1.45" stroke-linecap="round" />
            </svg>
          )}
        </span>
        <div>
          <h3 class="font-display text-lg font-medium leading-tight tracking-tight text-brand/92">{card.title}</h3>
          <p class="mt-1 text-sm leading-relaxed text-muted/86">{card.text}</p>
        </div>
      </div>
    </article>
  ))}
</div>
