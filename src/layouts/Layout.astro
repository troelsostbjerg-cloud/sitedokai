---
interface StructuredData {
  [key: string]: unknown;
}

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  structuredData?: StructuredData | StructuredData[];
  noindex?: boolean;
}

const {
  title,
  description = 'SiteDokAI hjælper små virksomheder med at finde og rette det, der får hjemmesiden til at miste kunder. Klarhed, tillid, synlighed, tekst, struktur, CTA og visuelt udtryk.',
  canonical = Astro.url.href,
  ogImage = '/og-image.svg',
  structuredData,
  noindex = false,
} = Astro.props;

const siteUrl = Astro.site?.href ?? 'https://sitedokai.com/';
const canonicalUrl = canonical.startsWith('http') ? canonical : new URL(canonical, siteUrl).href;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : new URL(ogImage, siteUrl).href;
const ogImageType = ogImageUrl.endsWith('.png') ? 'image/png' : ogImageUrl.endsWith('.jpg') || ogImageUrl.endsWith('.jpeg') ? 'image/jpeg' : undefined;
const schemaBlocks = !structuredData ? [] : Array.isArray(structuredData) ? structuredData : [structuredData];
const robotsContent = noindex ? 'noindex, nofollow' : 'index, follow';
---

<!doctype html>
<html lang="da">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="SiteDokAI" />
    <meta name="robots" content={robotsContent} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SiteDokAI" />
    <meta property="og:locale" content="da_DK" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    {ogImageType && <meta property="og:image:type" content={ogImageType} />}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=20260427" />
    <link rel="preconnect" href="https://fonts.bunny.net" />
    <link href="https://fonts.bunny.net/css?family=newsreader:400,500,600,700&family=jetbrains-mono:400,600&family=outfit:400,500,600,700" rel="stylesheet" />
    {schemaBlocks.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
    <title>{title}</title>
  </head>
  <body class="bg-[#faf7f2] text-brand">
    <section id="cookie-banner" aria-label="Cookie-information" class="z-50 hidden border-b border-[#d9cfbf] bg-[#f7f2e8]/96 px-3 py-2 text-brand backdrop-blur sm:px-6 sm:py-2.5">
      <div class="mx-auto flex max-w-5xl items-center justify-between gap-2.5">
        <p class="min-w-0 text-[12px] leading-tight text-brand/72 sm:text-sm sm:leading-relaxed">
          Kun nødvendige cookies. <span class="hidden sm:inline">Ingen tracking.</span> <a href="/privatlivspolitik" class="text-accent underline decoration-[rgba(159,106,36,0.35)] underline-offset-4 hover:text-brand">Læs mere</a>
        </p>
        <div class="flex flex-shrink-0 gap-1.5 sm:gap-2">
          <button id="cookie-decline" class="whitespace-nowrap rounded-[0.65rem] border border-[#d9cfbf] px-2.5 py-1.5 text-[11px] font-bold leading-none text-brand/70 transition-colors hover:bg-white sm:px-4 sm:py-2 sm:text-sm sm:leading-normal">
            Afvis
          </button>
          <button id="cookie-accept" class="whitespace-nowrap rounded-[0.65rem] bg-brand px-3 py-1.5 text-[11px] font-bold leading-none text-white transition-colors hover:bg-brand-light sm:px-4 sm:py-2 sm:text-sm sm:leading-normal">
            OK
          </button>
        </div>
      </div>
    </section>

    <slot />

    <script is:inline>
      (function() {
        var banner = document.getElementById('cookie-banner');
        if (!(banner instanceof HTMLElement)) return;

        var root = document.documentElement;
        var accept = document.getElementById('cookie-accept');
        var decline = document.getElementById('cookie-decline');

        function readChoice() {
          try {
            return localStorage.getItem('cookie-choice');
          } catch (error) {
            return null;
          }
        }

        function writeChoice(choice) {
          try {
            localStorage.setItem('cookie-choice', choice);
          } catch (error) {
            // Ignore storage failures and still let the user continue.
          }
        }

        function syncBannerSpacing() {
          root.style.setProperty('--cookie-banner-space', '0px');
        }

        function scheduleSpacingSync() {
          window.requestAnimationFrame(syncBannerSpacing);
        }

        function hideBanner(choice) {
          writeChoice(choice);
          banner.classList.add('hidden');
          scheduleSpacingSync();
        }

        if (!readChoice()) {
          banner.classList.remove('hidden');
        }

        scheduleSpacingSync();
        window.addEventListener('load', scheduleSpacingSync, { once: true });
        window.addEventListener('resize', scheduleSpacingSync);

        if (accept) accept.addEventListener('click', function() { hideBanner('accepted'); });
        if (decline) decline.addEventListener('click', function() { hideBanner('declined'); });
      })();
    </script>

    <script is:inline>
      document.addEventListener('submit', (event) => {
        const form = event.target;
        if (!(form instanceof HTMLFormElement)) return;

        const websiteInput = form.querySelector('input[name="website"]');
        if (!(websiteInput instanceof HTMLInputElement)) return;

        const value = websiteInput.value.trim();
        if (!value) return;

        if (!/^[a-zA-Z][a-zA-Z\d+\-.]*:\/\//.test(value)) {
          websiteInput.value = `https://${value.replace(/^\/+/, '')}`;
        }
      });
    </script>

    <script is:inline>
      (function() {
        var composers = document.querySelectorAll('[data-mailto-composer]');
        if (!composers.length) return;

        function normalizeUrl(value) {
          var trimmed = value.trim();
          if (!trimmed) return '';
          if (/^[a-zA-Z][a-zA-Z\d+\-.]*:\/\//.test(trimmed)) return trimmed;
          return 'https://' + trimmed.replace(/^\/+/, '');
        }

        function getFieldValue(field) {
          var value = field.value ? field.value.trim() : '';
          if (field.getAttribute('data-mailto-normalize') === 'url') {
            return normalizeUrl(value);
          }
          return value;
        }

        function composeMailto(root) {
          var email = root.getAttribute('data-mailto-to') || 'info@sitedokai.com';
          var subject = root.getAttribute('data-mailto-subject') || 'SiteDokAI henvendelse';
          var message = root.getAttribute('data-mailto-message') || 'Jeg vil gerne høre om:';
          var fields = root.querySelectorAll('[data-mailto-field]');
          var lines = ['Hej SiteDokAI,', '', message, ''];

          fields.forEach(function(field) {
            var label = field.getAttribute('data-mailto-label') || field.getAttribute('name') || field.id || 'Felt';
            lines.push(label + ': ' + getFieldValue(field));
          });

          lines.push('', 'Tak.');
          return 'mailto:' + email + '?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(lines.join('\n'));
        }

        function updateLinks(root) {
          var href = composeMailto(root);
          root.querySelectorAll('[data-mailto-link]').forEach(function(link) {
            link.setAttribute('href', href);
          });
        }

        function getMissingRequired(root) {
          return Array.from(root.querySelectorAll('[data-mailto-field][data-mailto-required="true"]')).filter(function(field) {
            return !field.value || !field.value.trim();
          });
        }

        function showError(root) {
          var error = root.querySelector('[data-mailto-error]');
          var status = root.querySelector('[data-mailto-status]');
          if (status) status.hidden = true;
          if (error) error.hidden = false;
        }

        function showStatus(root) {
          var error = root.querySelector('[data-mailto-error]');
          var status = root.querySelector('[data-mailto-status]');
          if (error) error.hidden = true;
          if (status) status.hidden = false;
        }

        function prepareMailtoOpen(root, link) {
          updateLinks(root);

          if (link.hasAttribute('data-mailto-validate')) {
            var missing = getMissingRequired(root);
            if (missing.length) {
              showError(root);
              return false;
            }
          }

          showStatus(root);
          return true;
        }

        composers.forEach(function(root) {
          updateLinks(root);

          root.querySelectorAll('[data-mailto-field]').forEach(function(field) {
            field.addEventListener('input', function() {
              updateLinks(root);
            });
            field.addEventListener('change', function() {
              updateLinks(root);
            });
          });

          root.querySelectorAll('[data-mailto-link]').forEach(function(link) {
            link.addEventListener('pointerdown', function() {
              prepareMailtoOpen(root, link);
            });

            link.addEventListener('keydown', function(event) {
              if (event.key === 'Enter' || event.key === ' ') {
                prepareMailtoOpen(root, link);
              }
            });

            link.addEventListener('click', function(event) {
              if (!prepareMailtoOpen(root, link)) {
                var missing = getMissingRequired(root);
                event.preventDefault();
                if (missing.length) missing[0].focus();
              }
            });
          });
        });
      })();
    </script>

    <script is:inline>
      (function() {
        function getHashTarget() {
          var rawHash = window.location.hash;
          if (!rawHash || rawHash.length <= 1) return null;

          var id = decodeURIComponent(rawHash.slice(1));
          return document.getElementById(id);
        }

        function alignHashTarget(forceImmediate) {
          var target = getHashTarget();
          if (!(target instanceof HTMLElement)) return;

          var rootStyle = window.getComputedStyle(document.documentElement);
          var scrollPaddingTop = parseFloat(rootStyle.scrollPaddingTop || '0') || 0;
          var prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          var nextTop = Math.max(target.getBoundingClientRect().top + window.scrollY - scrollPaddingTop - 16, 0);

          window.scrollTo({
            top: nextTop,
            behavior: forceImmediate || prefersReducedMotion ? 'auto' : 'smooth',
          });
        }

        function scheduleHashAlignment(forceImmediate) {
          window.requestAnimationFrame(function() {
            alignHashTarget(forceImmediate);
            window.setTimeout(function() { alignHashTarget(forceImmediate); }, 180);
          });
        }

        window.addEventListener('hashchange', function() { scheduleHashAlignment(false); });
        window.addEventListener('load', function() { scheduleHashAlignment(true); }, { once: true });
      })();
    </script>
  </body>
</html>
